                                <td>
                                    <label class="ty_rdo" for="CHK_Thermal_Resistance_1">
                                        <input type="radio" id="CHK_Thermal_Resistance_1" name="CHK_Thermal_Resistance" value="1" checked>
                                        <span>1.0 이하</span>
                                    </label>
                                </td>
                                <td>-</td>
                                <td>
                                    <label class="ty_rdo" for="CHK_Thermal_Resistance_3">
                                        <input type="radio" id="CHK_Thermal_Resistance_3" name="CHK_Thermal_Resistance" value="3">
                                        <span>1.0~1.2</span>
                                    </label>
                                </td>
                                <td>
                                    <label class="ty_rdo" for="CHK_Thermal_Resistance_4">
                                        <input type="radio" id="CHK_Thermal_Resistance_4" name="CHK_Thermal_Resistance" value="4">
                                        <span>1.2~1.25</span>
                                    </label>
                                </td>
                                <td>
                                    <label class="ty_rdo" for="CHK_Thermal_Resistance_5">
                                        <input type="radio" id="CHK_Thermal_Resistance_5" name="CHK_Thermal_Resistance" value="5">
                                        <span>1.25 초과</span>
                                    </label>
                                </td>
                                <td>1 P.U = 제조사 권장값</td>
                            </tr>

                            <tr>
                                <td>
                                    C 전류(Ic)
                                </td>
                                <td>P.U</td>
                                <td>
                                    <label class="ty_rdo" for="CHK_C_Current_1">
                                        <input type="radio" id="CHK_C_Current_1" name="CHK_C_Current" value="1" checked>
                                        <span>1.0 이하</span>
                                    </label>
                                </td>
                                <td>-</td>
                                <td>
                                    <label class="ty_rdo" for="CHK_C_Current_3">
                                        <input type="radio" id="CHK_C_Current_3" name="CHK_C_Current" value="3">
                                        <span>1.0~1.2</span>
                                    </label>
                                </td>
                                <td>
                                    <label class="ty_rdo" for="CHK_C_Current_4">
                                        <input type="radio" id="CHK_C_Current_4" name="CHK_C_Current" value="4">
                                        <span>1.2~1.25</span>
                                    </label>
                                </td>
                                <td>
                                    <label class="ty_rdo" for="CHK_C_Current_5">
                                        <input type="radio" id="CHK_C_Current_5" name="CHK_C_Current" value="5">
                                        <span>1.25 초과</span>
                                    </label>
                                </td>
                                <td> 1 P.U 정격 콜렉터 전류</td>
                            </tr>

                            <tr>
                                <td>
                                    On/Off 전류(Ton, Toff)
                                </td>
                                <td>P.U</td>
                                <td>
                                    <label class="ty_rdo" for="CHK_OnOff_Time_1">
                                        <input type="radio" id="CHK_OnOff_Time_1" name="CHK_OnOff_Time" value="1" checked>
                                        <span>1.0 이하</span>
                                    </label>
                                </td>
                                <td>-</td>
                                <td>
                                    <label class="ty_rdo" for="CHK_OnOff_Time_3">
                                        <input type="radio" id="CHK_OnOff_Time_3" name="CHK_OnOff_Time" value="3">
                                        <span>1.0~1.2</span>
                                    </label>
                                </td>
                                <td>
                                    <label class="ty_rdo" for="CHK_OnOff_Time_4">
                                        <input type="radio" id="CHK_OnOff_Time_4" name="CHK_OnOff_Time" value="4">
                                        <span>1.2~1.25</span>
                                    </label>
                                </td>
                                <td>
                                    <label class="ty_rdo" for="CHK_OnOff_Time_5">
                                        <input type="radio" id="CHK_OnOff_Time_5" name="CHK_OnOff_Time" value="5">
