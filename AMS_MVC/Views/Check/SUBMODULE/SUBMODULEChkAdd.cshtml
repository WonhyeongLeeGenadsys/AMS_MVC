@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var submoduleCode = Request.QueryString["SUBMODULE_Code"] ?? "";
}

@section LeftMenu {
    @Html.Partial("_CheckMenu")
}

@section MainContent {
    <h1>
        SUBMODULE 보통점검 추가: @ViewBag.SerialNo
    </h1>
    <div class="con_box">
        <div class="content_warp">
            <div class="btn_area top right">
                <p>
                    <a href="#" class="btn blue app" onclick="createSUBMODULEChk()">적용</a>
                </p>
            </div>
            <form id="submoduleChkForm" method="post" enctype="multipart/form-data">
                @* URL에 SUBMODULE_Code가 전달된 경우 hidden 필드로 사용, 그렇지 않으면 드롭다운 출력 *@
                @if (!string.IsNullOrEmpty(submoduleCode))
                {
                    <input type="hidden" name="SUBMODULE_Code" value="@submoduleCode" />
                }
                else
                {
                    <div style="margin-bottom: 15px;">
                        @Html.DropDownList("SUBMODULE_Code", (SelectList)ViewBag.SUBMODULEs, "SUBMODULE를 선택하세요.", new { @class = "form-control", @id = "SUBMODULE_Code" })
                    </div>
                }
                <div class="table_app" id="submoduleChk">
                    <table>
                        <colgroup>
                            <col style="width:100px;">
                            <col style="width:calc(33.3% - 100px);">
                            <col style="width:100px;">
                            <col style="width:calc(33.3% - 100px);">
                            <col style="width:100px;">
                            <col style="width:calc(33.3% - 100px);">
                        </colgroup>
                        <tr>
                            <th>공사명</th>
                            <td colspan="5">
                                <input type="text" id="chk_gongsa_name" name="chk_gongsa_name">
                            </td>
                        </tr>
                        <tr>
                            <th>날씨</th>
                            <td>
                                <input type="text" id="chk_weather" name="chk_weather">
                            </td>
                            <th>기온</th>
                            <td>
                                <input type="text" id="chk_temp" name="chk_temp"> <span>°C</span>
                            </td>
                            <th>습도</th>
                            <td>
                                <input type="text" id="chk_hum" name="chk_hum"> <span>%</span>
                            </td>
                        </tr>
                        <tr>
                            <th>업체명</th>
                            <td>
                                @Html.DropDownList("chk_company", new SelectList(ViewBag.Companies, "Com_Name", "Com_Name"), "제작사를 선택하세요.")
                            </td>
                            <th>점검자</th>
                            <td>
                                <input type="text" id="chk_worker" name="chk_worker">
                            </td>
                            <th>감독자</th>
                            <td>
                                <input type="text" id="chk_manager" name="chk_manager">
                            </td>
                        </tr>
                        <tr>
                            <th>급전번호</th>
                            <td>
                                <input type="text" id="chk_urgent_no" name="chk_urgent_no">
                            </td>
                            <th>형식</th>
                            <td>
                                <input type="text" id="chk_type" name="chk_type">
                            </td>
                            <th></th>
                            <td></td>
                        </tr>
                        <tr>
                            <th>점검 시작일</th>
                            <td>
                                <input type="date" id="chk_start_date" name="chk_start_date">
                            </td>
                            <th>점검 종료일</th>
                            <td>
                                <input type="date" id="chk_end_date" name="chk_end_date">
                            </td>
                            <th></th>
                            <td></td>
                        </tr>
                    </table>
                </div>
                <!--//입력테이블-->
                <div class="table_list_app">
                    <table>
                        <colgroup>
                            <col style="width:5%">
                            <col style="width:11%">
                            <col style="width:4%">
                            <col style="width:15%">
                            <col style="width:2%">
                            <col>
                        </colgroup>
                        <thead>
                            <tr>
                                <th rowspan="2">하위설비</th>
                                <th rowspan="2">입력 파라미터</th>
                                <th rowspan="2">단위</th>
                                <th colspan="5">판단기준</th>
                                <th rowspan="2">비고</th>
                            </tr>
                            <tr>
                                <th>Very Good</th>
                                <th>Good</th>
                                <th>Fair</th>
                                <th>Poor</th>
                                <th>Very Poor</th>
                            </tr>
                        </thead>

                        <tbody>
                            <tr>
                                <td rowspan="5">
                                    IGBT
                                </td>
                                <td>C-E 전압</td>
                                <td>P.U</td>
                                <td>
                                    <label class="ty_rdo" for="CHK_CE_Voltage_1">
                                        <input type="radio" id="CHK_CE_Voltage_1" name="CHK_CE_Voltage" value="1" checked>
