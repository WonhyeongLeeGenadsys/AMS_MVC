                            </tr>
                            <tr>
                                <td>
                                    G 전압(Vg)
                                </td>
                                <td>P.U</td>
                                <td>
                                    <label class="ty_rdo" for="CHK_G_Voltage_1">
                                        <input type="radio" id="CHK_G_Voltage_1" name="CHK_G_Voltage" value="1" checked>
                                        <span>1.0 이하</span>
                                    </label>
                                </td>
                                <td>-</td>
                                <td>
                                    <label class="ty_rdo" for="CHK_G_Voltage_3">
                                        <input type="radio" id="CHK_G_Voltage_3" name="CHK_G_Voltage" value="3">
                                        <span>1.0~1.5</span>
                                    </label>
                                </td>
                                <td>-</td>
                                <td>
