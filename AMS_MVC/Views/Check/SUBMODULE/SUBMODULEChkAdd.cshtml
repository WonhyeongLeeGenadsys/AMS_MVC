                                <td>
                                    <label class="ty_rdo" for="CHK_ESR_1">
                                        <input type="radio" id="CHK_ESR_1" name="CHK_ESR" value="1" checked>
                                        <span>초기값 대비 1.1배</span>
                                    </label>
                                </td>
                                <td>-</td>
                                <td>
                                    <label class="ty_rdo" for="CHK_ESR_3">
                                        <input type="radio" id="CHK_ESR_3" name="CHK_ESR" value="3">
                                        <span>초기값 대비 1.5배</span>
                                    </label>
                                </td>
                                <td>-</td>
                                <td>
                                    <label class="ty_rdo" for="CHK_TDR_5">
                                        <input type="radio" id="CHK_TDR_5" name="CHK_TDR" value="5">
                                        <span>초기값 대비 2배 초과</span>
                                    </label>
                                </td>
                                <td>-</td>
                            </tr>

                            <tr>
                                <td>커패시턴스</td>
                                <td>P.U</td>
                                <td>
                                    <label class="ty_rdo" for="CHK_Capacitance_1">
                                        <input type="radio" id="CHK_Capacitance_1" name="CHK_Capacitance" value="1" checked>
                                        <span>±5%이내</span>
                                    </label>
                                </td>
                                <td>-</td>
                                <td>
                                    <label class="ty_rdo" for="CHK_Capacitance_3">
                                        <input type="radio" id="CHK_Capacitance_3" name="CHK_Capacitance" value="3">
                                        <span>±10%이내</span>
                                    </label>
                                </td>
                                <td>-</td>
                                <td>
                                    <label class="ty_rdo" for="CHK_Capacitance_5">
                                        <input type="radio" id="CHK_Capacitance_5" name="CHK_Capacitance" value="5">
                                        <span>±10%초과</span>
                                    </label>
                                </td>
                                <td>1 P.U = 제조사 권장값</td>
                            </tr>

                            <tr>
                                <td>온도</td>
                                <td>℃</td>
                                <td>
                                    <label class="ty_rdo" for="CHK_Temperature_1">
                                        <input type="radio" id="CHK_Temperature_1" name="CHK_Temperature" value="1" checked>
                                        <span>90%이내</span>
                                    </label>
                                </td>
                                <td>-</td>
                                <td>
                                    <label class="ty_rdo" for="CHK_Temperature_3">
                                        <input type="radio" id="CHK_Temperature_3" name="CHK_Temperature" value="3">
                                        <span>100%이내</span>
                                    </label>
                                </td>
                                <td>-</td>
                                <td>

                                    <label class="ty_rdo" for="CHK_Temperature_5">
                                        <input type="radio" id="CHK_Temperature_5" name="CHK_Temperature" value="5">
                                        <span>100% 초과</span>
                                    </label>
                                </td>

                                <td>권장온도 기준</td>
                            </tr>

                        </tbody>
                    </table>
                </div>

            </form>
        </div>
    </div>

    <script>
    // SUBMODULE 점검 정보 수집 함수
        function createSUBMODULEChk() {
            submitSUBMODULEChkForm();
        }

        function submitSUBMODULEChkForm() {
            var form = document.getElementById("submoduleChkForm");
            var formData = new FormData(form);

            // 1) SUBMODULE_Code가 hidden인 경우(이미 URL에 있었음) => 바로 진행
            // 2) SUBMODULE_Code가 드롭다운인 경우 => 선택 체크
            var submoduleCodeDropdown = document.getElementById("SUBMODULE_Code");
            if (submoduleCodeDropdown) {
                // 사용자가 "SUBMODULE를 선택하세요."(기본값) 또는 빈 값("")을 선택한 경우 확인
                if (!submoduleCodeDropdown.value) {
                    alert("SUBMODULE를 선택하세요.");
                    return;
                }
            }

            // FormData 내용을 콘솔에 출력
            for (var pair of formData.entries()) {
                console.log(pair[0] + ": " + pair[1]);
            }

            $.ajax({
            url: '@Url.Action("SUBMODULEChkAdd", "SUBMODULEChk")',
            type: "POST",
            data: formData,
            processData: false,
            contentType: false,
            success: function (response) {
                console.log("서버 응답:", response);
                if (response.IsSuccess) {
                    alert("SUBMODULE 보통점검 정보가 저장되었습니다.");
                    window.location.href = '@Url.Action("SUBMODULEChkTotalList", "SUBMODULEChk")';
                } else {
                    alert("SUBMODULE 보통점검 정보를 추가하지 못했습니다.: " + response.message);
                }
            },
            error: function (xhr, status, error) {
                console.error("오류 발생:", xhr.responseText || status, error);
                alert("SUBMODULE 보통점검 정보 등록 중 오류가 발생했습니다." + xhr.responseText);
            }
        });
    }
    </script>
}