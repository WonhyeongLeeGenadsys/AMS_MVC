@model AMS_MVC.Models.ITRChk1

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section LeftMenu {
    @Html.Partial("_CheckMenu")
}

@section MainContent {
    <!--타이틀-->
    <h1>보통점검 <a href="#" class="btn_guide">가이드</a></h1>
    <!--//타이틀-->
    <!--컨텐츠-->
    <div class="con_box">
        <!--컨텐츠 inn-->
        <div class="content_warp">

            <!--버튼 영역 (예: 삭제/적용)-->
            <div class="btn_area top right">
                <p>
                    <a href="#" class="btn red del">삭제</a>
                    <a href="#" class="btn blue app">적용</a>
                </p>
            </div>
            <!--//버튼 영역-->
            <!-- MVC Form 시작 (예: POST로 전송) -->
            @using (Html.BeginForm("ITRChk1Add", "ITRChk1", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                <!--입력테이블-->
                <div class="table_app">
                    <table>
                        <colgroup>
                            <col style="width:100px;">
                            <col style="width:calc(33.3% - 100px);">
                            <col style="width:100px;">
                            <col style="width:calc(33.3% - 100px);">
                            <col style="width:100px;">
                            <col style="width:calc(33.3% - 100px);">
                        </colgroup>
                        <tr>
                            <th>공사명</th>
                            <td colspan="5">
                                @Html.TextBoxFor(m => m.CHK1_Gongsa_Name, new { @class = "w100" })
                            </td>
                        </tr>
                        <tr>
                            <th>날씨</th>
                            <td>
                                @Html.TextBoxFor(m => m.CHK1_Weather)
                            </td>
                            <th>기온</th>
                            <td>
                                @Html.TextBoxFor(m => m.CHK1_Temp) <span>°C</span>
                            </td>
                            <th>습도</th>
                            <td>
                                @Html.TextBoxFor(m => m.CHK1_Hum) <span>%</span>
                            </td>
                        </tr>
                        <tr>
                            <th>업체명</th>
                            <td>
                                @Html.TextBoxFor(m => m.CHK1_Company)
                            </td>
                            <th>점검자</th>
                            <td>
                                @Html.TextBoxFor(m => m.CHK1_Worker)
                            </td>
                            <th>감독자</th>
                            <td>
                                @Html.TextBoxFor(m => m.CHK1_Manager)
                            </td>
                        </tr>
                        <tr>
                            <th>점검 시작일</th>
                            <td>
                                @Html.TextBoxFor(m => m.CHK1_Start_Date, new { type = "date" })
                            </td>
                            <th>점검 종료일</th>
                            <td>
                                @Html.TextBoxFor(m => m.CHK1_End_Date, new { type = "date" })
                            </td>
                            <th></th>
                            <td></td>
                        </tr>
                    </table>
                </div>
                <!--//입력테이블-->

                <!--리스트형 입력테이블 (DGA)-->
                <div class="table_list_app">
                    <table>
                        <colgroup>
                            <col style="width:7%">
                            <col style="width:9%">
                            <col style="width:10%">
                            <col style="width:7%">
                            <col>
                            <col style="width:7%">
                        </colgroup>
                        <thead>
                            <tr>
                                <th>구분</th>
                                <th>Parameters</th>
                                <th>세부항목</th>
                                <th>단위</th>
                                <th>판정기준 및 score</th>
                                <th>가중치</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- DGA (유중가스) -->
                            <tr>
                                <td rowspan="7">DGA</td>
                                <td rowspan="7">유중가스 분석</td>
                                <td>H2</td>
                                <td>Ppm</td>
                                <td class="left">
                                    <label class="ty_rdo" for="select01_01">
                                        @Html.RadioButtonFor(m => m.CHK1_H2, "1", new { id = "select01_01", @checked = "checked" })
                                        <span>200이하(1)</span>
                                    </label>
                                    <label class="ty_rdo" for="select01_02">
                                        @Html.RadioButtonFor(m => m.CHK1_H2, "0.5", new { id = "select01_02" })
                                        <span>201~400(0.5)</span>
                                    </label>
                                    <label class="ty_rdo" for="select01_03">
                                        @Html.RadioButtonFor(m => m.CHK1_H2, "0.25", new { id = "select01_03" })
                                        <span>401~500(0.25)</span>
                                    </label>
                                    <label class="ty_rdo" for="select01_04">
                                        @Html.RadioButtonFor(m => m.CHK1_H2, "0", new { id = "select01_04" })
                                        <span>500초과(0)</span>
                                    </label>
                                </td>
                                <td></td>
                            </tr>
                            <tr>
                                <td>C2h2</td>
                                <td>Ppm</td>
                                <td class="left">
                                    <label class="ty_rdo" for="select02_01">
                                        @Html.RadioButtonFor(m => m.CHK1_C2H2, "1", new { id = "select02_01", @checked = "checked" })
                                        <span>10이하(1)</span>
                                    </label>
                                    <label class="ty_rdo" for="select02_02">
                                        @Html.RadioButtonFor(m => m.CHK1_C2H2, "0.5", new { id = "select02_02" })
                                        <span>11~20(0.5)</span>
                                    </label>
                                    <label class="ty_rdo" for="select02_03">
                                        @Html.RadioButtonFor(m => m.CHK1_C2H2, "0.5", new { id = "select02_03" })
                                        <span>21~60(0.5)</span>
                                    </label>
                                    <label class="ty_rdo" for="select02_04">
                                        @Html.RadioButtonFor(m => m.CHK1_C2H2, "0.25", new { id = "select02_04" })
                                        <span>61~120(0.25)</span>
                                    </label>
                                    <label class="ty_rdo" for="select02_05">
                                        @Html.RadioButtonFor(m => m.CHK1_C2H2, "0", new { id = "select02_05" })
                                        <span>120초과(0)</span>
                                    </label>
                                </td>
                                <td></td>
                            </tr>
                            <tr>
                                <td>C2h4</td>
                                <td>Ppm</td>
                                <td class="left">
                                    <label class="ty_rdo" for="select03_01">
                                        @Html.RadioButtonFor(m => m.CHK1_C2H4, "1", new { id = "select03_01", @checked = "checked" })
                                        <span>100이하(1)</span>
                                    </label>
                                    <label class="ty_rdo" for="select03_02">
                                        @Html.RadioButtonFor(m => m.CHK1_C2H4, "0.5", new { id = "select03_02" })
                                        <span>101~200(0.5)</span>
                                    </label>
                                    <label class="ty_rdo" for="select03_03">
                                        @Html.RadioButtonFor(m => m.CHK1_C2H4, "0.25", new { id = "select03_03" })
                                        <span>201~500(0.25)</span>
                                    </label>
                                    <label class="ty_rdo" for="select03_04">
                                        @Html.RadioButtonFor(m => m.CHK1_C2H4, "0", new { id = "select03_04" })
                                        <span>500초과(0)</span>
                                    </label>
                                </td>
                                <td></td>
                            </tr>
                            <tr>
                                <td>Ch4</td>
                                <td>Ppm</td>
                                <td class="left">
                                    <label class="ty_rdo" for="select04_01">
                                        @Html.RadioButtonFor(m => m.CHK1_CH4, "1", new { id = "select04_01", @checked = "checked" })
                                        <span>150이하(1)</span>
                                    </label>
                                    <label class="ty_rdo" for="select04_02">
                                        @Html.RadioButtonFor(m => m.CHK1_CH4, "0.5", new { id = "select04_02" })
                                        <span>151~200(0.5)</span>
                                    </label>
                                    <label class="ty_rdo" for="select04_03">
                                        @Html.RadioButtonFor(m => m.CHK1_CH4, "0.25", new { id = "select04_03" })
                                        <span>201~750(0.25)</span>
                                    </label>
                                    <label class="ty_rdo" for="select04_04">
                                        @Html.RadioButtonFor(m => m.CHK1_CH4, "0", new { id = "select04_04" })
                                        <span>750초과(0)</span>
                                    </label>
                                </td>
                                <td></td>
                            </tr>
                            <tr>
                                <td>C2h6</td>
                                <td>Ppm</td>
                                <td class="left">
                                    <label class="ty_rdo" for="select05_01">
                                        @Html.RadioButtonFor(m => m.CHK1_C2H6, "1", new { id = "select05_01", @checked = "checked" })
                                        <span>200이하(1)</span>
                                    </label>
                                    <label class="ty_rdo" for="select05_02">
                                        @Html.RadioButtonFor(m => m.CHK1_C2H6, "0.5", new { id = "select05_02" })
                                        <span>201~350(0.5)</span>
                                    </label>
                                    <label class="ty_rdo" for="select05_03">
                                        @Html.RadioButtonFor(m => m.CHK1_C2H6, "0.25", new { id = "select05_03" })
                                        <span>351~750(0.25)</span>
                                    </label>
                                    <label class="ty_rdo" for="select05_04">
                                        @Html.RadioButtonFor(m => m.CHK1_C2H6, "0", new { id = "select05_04" })
                                        <span>750초과(0)</span>
                                    </label>
                                </td>
                                <td></td>
                            </tr>
                            <tr>
                                <td>Co</td>
                                <td>Ppm</td>
                                <td class="left">
                                    <label class="ty_rdo" for="select06_01">
                                        @Html.RadioButtonFor(m => m.CHK1_CO, "1", new { id = "select06_01", @checked = "checked" })
                                        <span>800이하(1)</span>
                                    </label>
                                    <label class="ty_rdo" for="select06_02">
                                        @Html.RadioButtonFor(m => m.CHK1_CO, "0.5", new { id = "select06_02" })
                                        <span>801~1200(0.5)</span>
                                    </label>
                                    <label class="ty_rdo" for="select06_03">
                                        @Html.RadioButtonFor(m => m.CHK1_CO, "0", new { id = "select06_03" })
                                        <span>1200초과(0)</span>
                                    </label>
                                </td>
                                <td></td>
                            </tr>
                            <tr>
                                <td>co2</td>
                                <td>Ppm</td>
                                <td class="left">
                                    <label class="ty_rdo" for="select07_01">
                                        @Html.RadioButtonFor(m => m.CHK1_CO2, "1", new { id = "select07_01", @checked = "checked" })
                                        <span>5000이하(1)</span>
                                    </label>
                                    <label class="ty_rdo" for="select07_02">
                                        @Html.RadioButtonFor(m => m.CHK1_CO2, "0.5", new { id = "select07_02" })
                                        <span>5001~7000(0.5)</span>
                                    </label>
                                    <label class="ty_rdo" for="select07_03">
                                        @Html.RadioButtonFor(m => m.CHK1_CO2, "0", new { id = "select07_03" })
                                        <span>7000초과(0)</span>
                                    </label>
                                </td>
                                <td></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <!--//리스트형 입력테이블 (DGA)-->

                <!--리스트형 입력테이블 (Oil Quality)-->
                <div class="table_list_app">
                    <table>
                        <colgroup>
                            <col style="width:10%">
                            <col style="width:10%">
                            <col style="width:10%">
                            <col>
                            <col style="width:10%">
                        </colgroup>
                        <thead>
                            <tr>
                                <th>구분</th>
                                <th>Parameters</th>
                                <th>단위</th>
                                <th>판정기준 및 score</th>
                                <th>가중치</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Oil Quality</td>
                                <td>절연유 내압시험</td>
                                <td>kv</td>
                                <td class="left">
                                    <label class="ty_rdo" for="select08_01">
                                        <!-- 모델에 해당 속성이 없다면, 새 프로퍼티를 추가하거나 name 속성만 둡니다 -->
                                        @Html.RadioButton("OilBreakdown", "1", true, new { id = "select08_01" })
                                        <span>40초과(1)</span>
                                    </label>
                                    <label class="ty_rdo" for="select08_02">
                                        @Html.RadioButton("OilBreakdown", "0.5", false, new { id = "select08_02" })
                                        <span>30~40(0.5)</span>
                                    </label>
                                    <label class="ty_rdo" for="select08_03">
                                        @Html.RadioButton("OilBreakdown", "0", false, new { id = "select08_03" })
                                        <span>30미만(0)</span>
                                    </label>
                                </td>
                                <td>1.5</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <!--//리스트형 입력테이블 (Oil Quality)-->

                <!--리스트형 입력테이블 (Measure)-->
                <div class="table_list_app">
                    <table>
                        <colgroup>
                            <col style="width:10%">
                            <col style="width:10%">
                            <col style="width:10%">
                            <col style="width:10%">
                            <col>
                            <col style="width:10%">
                        </colgroup>
                        <thead>
                            <tr>
                                <th>구분</th>
                                <th>Parameters</th>
                                <th>세부항목</th>
                                <th>단위</th>
                                <th>판정기준 및 score</th>
                                <th>가중치</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- 절연열화 측정(Doble Test) -->
                            <tr>
                                <td rowspan="3">Measure</td>
                                <td>절연열화 측정<br>(Doble Test)</td>
                                <td></td>
                                <td>
                                    Ma<br />
                                    Watts<br />
                                    %PF<br />
                                    Cap(pF)
                                </td>
                                <td class="left">
                                    <div class="flex">
                                        <span>1-(검출횟수/2)</span>
                                        <!-- CHK1_Doble에 측정값을 기입한다면: -->
                                        @Html.TextBoxFor(m => m.CHK1_Doble)
                                    </div>
                                </td>
                                <td>3</td>
                            </tr>
                            <!-- SFRA -->
                            <tr>
                                <td>SFRA</td>
                                <td></td>
                                <td>dB</td>
                                <td class="left">
                                    <div class="flex">
                                        <span>0.2dB이상 1-(검출횟수/2)</span>
                                        @Html.TextBoxFor(m => m.CHK1_SFRA)
                                    </div>
                                </td>
                                <td>3.5</td>
                            </tr>
                            <!-- 절연 저항 시험 -->
                            <tr>
                                <td>절연 저항 시험</td>
                                <td></td>
                                <td>MΩ</td>
                                <td class="left">
                                    <div class="flex">
                                        <span>1000MΩ 미만 불량</span>
                                        <!-- 모델에 대응 속성이 없다면 추가하세요 -->
                                        @Html.TextBox("CHK1_InsulationTest", null, new { @class = "w50" })
                                    </div>
                                </td>
                                <td>3</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <!--//리스트형 입력테이블 (Measure)-->

                <!--리스트형 입력테이블 (사용기간수 등)-->
                <div class="table_list_app">
                    <table>
                        <colgroup>
                            <col style="width:10%">
                            <col style="width:10%">
                            <col>
                            <col style="width:10%">
                        </colgroup>
                        <thead>
                            <tr>
                                <th>Parameters</th>
                                <th>단위</th>
                                <th>판정기준 및 score</th>
                                <th>가중치</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>사용기간수</td>
                                <td>년</td>
                                <td>
                                    <div class="flex">
                                        <span>실제사용기간수</span>
                                        <!-- CHK1_Age에 기입할 수도 있음 -->
                                        @Html.TextBoxFor(m => m.CHK1_Age)
                                    </div>
                                </td>
                                <td>3.5</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <!--//리스트형 입력테이블 (사용기간수 등)-->

            }
            <!-- MVC Form 끝 -->
        </div>
    </div>
    <!--//컨텐츠-->
}
