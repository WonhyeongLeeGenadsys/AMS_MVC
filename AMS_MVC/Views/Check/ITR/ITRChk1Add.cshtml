    <script>
    // ITR 점검 정보 수집 함수
        function createITRChk() {
            submitITRChkForm();
        }

        function submitITRChkForm() {
            var form = document.getElementById("itrChkForm");
            var formData = new FormData(form);

            var itrCodeDropdown = document.getElementById("ITR_Code");
            if (itrCodeDropdown) {
                if (!itrCodeDropdown.value) {
                    alert("InterfaceTR를 선택하세요.");
                    return;
                }
            }

            // FormData 내용을 콘솔에 출력
            for (var pair of formData.entries()) {
                console.log(pair[0] + ": " + pair[1]);
            }
            $.ajax({
            url: '@Url.Action("ITRChkAdd1", "ITRChk", new { ITR_Code = itrCode } )',
            type: "POST",
            data: formData,
            processData: false,
            contentType: false,
            success: function (response) {
                console.log("서버 응답:", response);
                if (response.IsSuccess) {
                    alert("InterfaceTR 보통점검 정보가 저장되었습니다.");
                    window.location.href = '@Url.Action("ITRChkTotalList", "ITRChk", new { type = 1 } )';
                } else {
                    alert("InterfaceTR 보통점검 정보를 추가하지 못했습니다.: " + response.message);
                }
            },
            error: function (xhr, status, error) {
                console.error("오류 발생:", xhr.responseText || status, error);
                alert("InterfaceTR 보통점검 정보 등록 중 오류가 발생했습니다." + xhr.responseText);
            }
        });
    }
    </script>
