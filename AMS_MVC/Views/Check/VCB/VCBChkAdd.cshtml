                                    </label>
                                    <label class="ty_rdo" for="chkVacuumLeakCurrent_3">
                                        <input type="radio" id="chkVacuumLeakCurrent_3" name="CHK_VacuumLeakCurrent" value="3" >
                                        <span>0.1~0.2</span>
                                    </label>
                                    <label class="ty_rdo" for="chkVacuumLeakCurrent_5">
                                        <input type="radio" id="chkVacuumLeakCurrent_5" name="CHK_VacuumLeakCurrent" value="5">
