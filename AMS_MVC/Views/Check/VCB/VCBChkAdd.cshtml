                                        <input type="radio" id="accumSCC_4" name="CHK_AccumShortCircuitCurrent" value="4">
                                        <span>70% ~ 100%</span>
                                    </label>
                                    <label class="ty_rdo" for="accumSCC_5">
                                        <input type="radio" id="accumSCC_5" name="CHK_AccumShortCircuitCurrent" value="5">
                                        <span>> Limit</span>
                                    </label>
                                </td>
                                <td rowspan="1">-</td>
                            </tr>

                            <!-- 2) 단락전류 -->
