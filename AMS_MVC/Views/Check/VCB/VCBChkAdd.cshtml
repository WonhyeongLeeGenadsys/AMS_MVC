                                </td>
                                <td></td>
                                <td>mA</td>
                                <td>
                                    <label class="ty_rdo" for="chkVacuumLeakCurrent_1">
                                        <input type="radio" id="chkVacuumLeakCurrent_1" name="CHK_VacuumLeakCurrent" value="1" checked>
