                                        <input type="radio" id="chkInsulationResistance_4" name="CHK_InsulationResistance" value="4">
                                        <span>200~300</span>
                                    </label>
                                    <label class="ty_rdo" for="chkInsulationResistance_5">
                                        <input type="radio" id="chkInsulationResistance_5" name="CHK_InsulationResistance" value="5">
                                        <span>200 미만</span>
                                    </label>
                                </td>
                            </tr>
