@model Web.Common.VCBChk

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section LeftMenu {
    @Html.Partial("_CheckMenu")
}

@section MainContent {
    <h1>
        VCB 보통점검 수정
    </h1>
    <div class="con_box">
        <div class="content_warp">
            <div class="btn_area top right">
                <p>
                    <a href="#" class="btn blue app" onclick="updateVCBChk()">적용</a>
                </p>
            </div>
            <form id="vcbChkUpdateForm" method="post" enctype="multipart/form-data">
                <input type="hidden" name="Tbl_Idx" value="@Model.Tbl_Idx" />
                <input type="hidden" name="VCB_Code" value="@Model.VCB_Code" />

                <div class="table_app" id="vcbChk">
