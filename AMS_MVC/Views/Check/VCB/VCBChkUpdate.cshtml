@model AMS_MVC.Models.VCBChk

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section LeftMenu {
    @Html.Partial("_CheckMenu")
}

@section MainContent {
    <h1>
        VCB 보통점검 수정 
    </h1>
    <div class="con_box">
        <div class="content_warp">
            <div class="btn_area top right">
                <p>
                    <a href="#" class="btn blue app" onclick="updateVCBChk()">적용</a>
                </p>
            </div>

            <form id="vcbChkUpdateForm" method="post" enctype="multipart/form-data">
                <input type="hidden" name="Tbl_Idx" value="@Model.Tbl_Idx" />
                <input type="hidden" name="VCB_Code" value="@Model.VCB_Code" />

                <div class="table_app" id="vcbChk">
                    <table>
                        <colgroup>
                            <col style="width:100px;">
                            <col style="width:calc(33.3% - 100px);">
                            <col style="width:100px;">
                            <col style="width:calc(33.3% - 100px);">
                            <col style="width:100px;">
                            <col style="width:calc(33.3% - 100px);">
                        </colgroup>
                        <tr>
                            <th>공사명</th>
                            <td colspan="5">
                                <input type="text" id="chk_gongsa_name" name="chk_gongsa_name" value="@Model.CHK_Gongsa_Name">
                            </td>
                        </tr>
                        <tr>
                            <th>날씨</th>
                            <td>
                                <input type="text" id="chk_weather" name="chk_weather" value="@Model.CHK_Weather">
                            </td>
                            <th>기온</th>
                            <td>
                                <input type="text" id="chk_temp" name="chk_temp" value="@Model.CHK_Temp"> <span>°C</span>
                            </td>
                            <th>습도</th>
                            <td>
                                <input type="text" id="chk_hum" name="chk_hum" value="@Model.CHK_Hum"> <span>%</span>
                            </td>
                        </tr>
                        <tr>
                            <th>업체명</th>
                            <td>
                                @Html.DropDownList("chk_company", new SelectList(ViewBag.Companies, "Com_Name", "Com_Name", Model.CHK_Company), "제작사를 선택하세요.")
                            </td>
                            <th>점검자</th>
                            <td>
                                <input type="text" id="chk_worker" name="chk_worker" value="@Model.CHK_Worker">
                            </td>
                            <th>감독자</th>
                            <td>
                                <input type="text" id="chk_manager" name="chk_manager" value="@Model.CHK_Manager">
                            </td>
                        </tr>
                        <tr>
                            <th>급전번호</th>
                            <td>
                                <input type="text" id="chk_urgent_no" name="chk_urgent_no" value="@Model.CHK_Urgent_No">
                            </td>
                            <th>형식</th>
                            <td>
                                <input type="text" id="chk_type" name="chk_type" value="@Model.CHK_Type">
                            </td>
                            <th></th>
                            <td></td>
                        </tr>
                        <tr>
                            <th>점검 시작일</th>
                            <td>
                                <input type="date" id="chk_start_date" name="chk_start_date" value="@(Model.CHK_Start_Date.HasValue ? Model.CHK_Start_Date.Value.ToString("yyyy-MM-dd") : "")">
                            </td>
                            <th>점검 종료일</th>
                            <td>
                                <input type="date" id="chk_end_date" name="chk_end_date" value="@(Model.CHK_End_Date.HasValue ? Model.CHK_End_Date.Value.ToString("yyyy-MM-dd") : "")">
                            </td>
                            <th></th>
                            <td></td>
                        </tr>
                    </table>
                </div>
                @model AMS_MVC.Models.VCBChk

                @{
                    Layout = "~/Views/Shared/_Layout.cshtml";
                    var vcbCode = Request.QueryString["VCB_Code"] ?? "";
                }

                @section LeftMenu {
                    @Html.Partial("_CheckMenu")
                }

                @section MainContent {
                    <h1>VCB 보통점검 추가: @ViewBag.SerialNo</h1>
                    <div class="con_box">
                        <div class="content_warp">
                            <div class="btn_area top right">
                                <a href="javascript:void(0);" class="btn blue app" onclick="createVCBChk()">적용</a>
                            </div>
                            <form id="vcbChkForm" method="post" enctype="multipart/form-data">
                                @* VCB_Code 처리 *@
                                @if (!string.IsNullOrEmpty(vcbCode))
                                {
                                    <input type="hidden" name="VCB_Code" value="@vcbCode" />
                                }
                                else
                                {
                                    <div style="margin-bottom:15px;">
                                        @Html.DropDownList(
                                            "VCB_Code",
                                            (SelectList)ViewBag.VCBs,
                                            "VCB를 선택하세요.",
                                            new { @class = "form-control", id = "VCB_Code" }
                                        )
                                    </div>
                                }

                                <!-- 기본 정보 -->
                                <div class="table_app" id="vcbChk">
                                    <table>
                                        <colgroup>
                                            <col style="width:100px;" />
                                            <col style="width:calc(33.3% - 100px);" />
                                            <col style="width:100px;" />
                                            <col style="width:calc(33.3% - 100px);" />
                                            <col style="width:100px;" />
                                            <col style="width:calc(33.3% - 100px);" />
                                        </colgroup>
                                        <tr>
                                            <th>공사명</th>
                                            <td colspan="5">
                                                <input type="text" name="CHK_Gongsa_Name" class="w100" />
                                            </td>
                                        </tr>
                                        <tr>
                                            <th>날씨</th>
                                            <td><input type="text" name="CHK_Weather" class="w100" /></td>
                                            <th>기온</th>
                                            <td><input type="number" step="0.1" name="CHK_Temp" class="w80" /> °C</td>
                                            <th>습도</th>
                                            <td><input type="number" step="0.1" name="CHK_Hum" class="w80" /> %</td>
                                        </tr>
                                        <tr>
                                            <th>업체명</th>
                                            <td>
                                                @Html.DropDownList(
                                                    "CHK_Company",
                                                    new SelectList(ViewBag.Companies, "Com_Name", "Com_Name"),
                                                    "제작사를 선택하세요."
                                                )
                                            </td>
                                            <th>점검자</th>
                                            <td><input type="text" name="CHK_Worker" class="w100" /></td>
                                            <th>감독자</th>
                                            <td><input type="text" name="CHK_Manager" class="w100" /></td>
                                        </tr>
                                        <tr>
                                            <th>급전번호</th>
                                            <td><input type="text" name="CHK_Urgent_No" class="w100" /></td>
                                            <th>형식</th>
                                            <td><input type="text" name="CHK_Type" class="w100" /></td>
                                            <th></th>
                                            <td></td>
                                        </tr>
                                        <tr>
                                            <th>점검 시작일</th>
                                            <td><input type="date" name="CHK_Start_Date" /></td>
                                            <th>점검 종료일</th>
                                            <td><input type="date" name="CHK_End_Date" /></td>
                                            <th></th>
                                            <td></td>
                                        </tr>
                                    </table>
                                </div>
                                <!--// 기본 정보 -->
                                <!-- 알고리즘 파라미터 (라디오 버튼) -->
                                <div class="table_list_app">
                                    <table>
                                        <colgroup>
                                            <col style="width:15%;" />
                                            <col style="width:15%;" />
                                            <col style="width:12%;" />
                                            <col style="width:8%;" />
                                            <col />
                                            <col style="width:6%;" />
                                        </colgroup>
                                        <thead>
                                            <tr>
                                                <th>구분</th>
                                                <th>Parameters</th>
                                                <th>단위</th>
                                                <th></th>
                                                <th>판정기준 및 score</th>
                                                <th>가중치</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <!-- 차단부 1: 접점 소모량 -->
                                            <tr>
                                                <td rowspan="6">차단부</td>
                                                <td>접점 소모량</td>
                                                <td>mm</td>
                                                <td></td>
                                                <td>
                                                    <label class="ty_rdo">
                                                        <input type="radio" name="CHK_ContactWearPercent" value="1" checked /> 2 미만
                                                    </label>
                                                    <label class="ty_rdo">
                                                        <input type="radio" name="CHK_ContactWearPercent" value="3" /> 2 ~ 3
                                                    </label>
                                                    <label class="ty_rdo">
                                                        <input type="radio" name="CHK_ContactWearPercent" value="5" /> 3 초과
                                                    </label>
                                                </td>
                                                <td rowspan="6">-</td>
                                            </tr>
                                            <!-- 차단부 2: 진공(누설전류) -->
                                            <tr>
                                                <td>진공(누설전류)</td>
                                                <td>mA</td>
                                                <td></td>
                                                <td>
                                                    <label class="ty_rdo">
                                                        <input type="radio" name="CHK_VacuumLeakCurrent" value="1" checked /> 0.1 미만
                                                    </label>
                                                    <label class="ty_rdo">
                                                        <input type="radio" name="CHK_VacuumLeakCurrent" value="3" /> 0.1 ~ 0.2
                                                    </label>
                                                    <label class="ty_rdo">
                                                        <input type="radio" name="CHK_VacuumLeakCurrent" value="5" /> 0.3 초과
                                                    </label>
                                                </td>
                                            </tr>
                                            <!-- 차단부 3: 접촉저항 -->
                                            <tr>
                                                <td>접촉저항</td>
                                                <td>초기값 대비</td>
                                                <td></td>
                                                <td>
                                                    <label class="ty_rdo">
                                                        <input type="radio" name="CHK_ContactResistance" value="1" checked /> ≤ 5%
                                                    </label>
                                                    <label class="ty_rdo">
                                                        <input type="radio" name="CHK_ContactResistance" value="3" /> 5~10%
                                                    </label>
                                                    <label class="ty_rdo">
                                                        <input type="radio" name="CHK_ContactResistance" value="4" /> 10~20%
                                                    </label>
                                                    <label class="ty_rdo">
                                                        <input type="radio" name="CHK_ContactResistance" value="5" /> > 20%
                                                    </label>
                                                </td>
                                            </tr>
                                            <!-- 차단부 4: 절연저항 -->
                                            <tr>
                                                <td>절연저항</td>
                                                <td>MΩ</td>
                                                <td></td>
                                                <td>
                                                    <label class="ty_rdo"><input type="radio" name="CHK_InsulationResistance" value="1" checked /> ≥ 500</label>
                                                    <label class="ty_rdo"><input type="radio" name="CHK_InsulationResistance" value="2" />400~500</label>
                                                    <label class="ty_rdo"><input type="radio" name="CHK_InsulationResistance" value="3" />300~400</label>
                                                    <label class="ty_rdo"><input type="radio" name="CHK_InsulationResistance" value="4" />200~300</label>
                                                    <label class="ty_rdo"><input type="radio" name="CHK_InsulationResistance" value="5" />< 200</label>
                                                </td>
                                            </tr>
                                            <!-- 차단부 5: 핫스팟 -->
                                            <tr>
                                                <td>핫스팟</td>
                                                <td>-</td>
                                                <td></td>
                                                <td>
                                                    <label class="ty_rdo"><input type="radio" name="CHK_HotSpot" value="1" checked /> 없음</label>
                                                    <label class="ty_rdo"><input type="radio" name="CHK_HotSpot" value="5" /> 발견</label>
                                                </td>
                                            </tr>
                                            <!-- 차단부 6: PD 패턴 및 성장 -->
                                            <tr>
                                                <td>PD 패턴 및 성장</td>
                                                <td>-</td>
                                                <td></td>
                                                <td>
                                                    <label class="ty_rdo"><input type="radio" name="CHK_PdPatternValue" value="1" checked /> 없음</label>
                                                    <label class="ty_rdo"><input type="radio" name="CHK_PdPatternValue" value="4" /> 있음(성장X)</label>
                                                    <label class="ty_rdo"><input type="radio" name="CHK_PdPatternValue" value="5" /> 있음</label>
                                                </td>
                                            </tr>

                                            <!-- 구동모터 -->
                                            <tr>
                                                <td>구동모터</td>
                                                <td>구동모터 전류</td>
                                                <td>초기값 대비</td>
                                                <td></td>
                                                <td>
                                                    <label class="ty_rdo"><input type="radio" name="CHK_MotorCurrent" value="1" checked /> ≤ 2%</label>
                                                    <label class="ty_rdo"><input type="radio" name="CHK_MotorCurrent" value="3" />2~5%</label>
                                                    <label class="ty_rdo"><input type="radio" name="CHK_MotorCurrent" value="4" />5~10%</label>
                                                    <label class="ty_rdo"><input type="radio" name="CHK_MotorCurrent" value="5" />>10%</label>
                                                </td>
                                                <td>-</td>
                                            </tr>

                                            <!-- 누적단락전류 -->
                                            <tr>
                                                <td>누적단락전류</td>
                                                <td>누적 단락전류량</td>
                                                <td>설계 한계치</td>
                                                <td></td>
                                                <td>
                                                    <label class="ty_rdo"><input type="radio" name="CHK_AccumShortCircuitCurrent" value="1" checked /> ≤20%</label>
                                                    <label class="ty_rdo"><input type="radio" name="CHK_AccumShortCircuitCurrent" value="2" />20~40%</label>
                                                    <label class="ty_rdo"><input type="radio" name="CHK_AccumShortCircuitCurrent" value="3" />40~70%</label>
                                                    <label class="ty_rdo"><input type="radio" name="CHK_AccumShortCircuitCurrent" value="4" />70~100%</label>
                                                    <label class="ty_rdo"><input type="radio" name="CHK_AccumShortCircuitCurrent" value="5" />>Limit</label>
                                                </td>
                                                <td>-</td>
                                            </tr>

                                            <!-- 기타 그룹 -->
                                            <tr>
                                                <td rowspan="4">기타</td>
                                                <td>단락전류</td>
                                                <td>설계 한계치</td>
                                                <td></td>
                                                <td>
                                                    <label class="ty_rdo"><input type="radio" name="CHK_ShortCircuitCount" value="1" checked /> ≤20%</label>
                                                    <label class="ty_rdo"><input type="radio" name="CHK_ShortCircuitCount" value="2" />20~40%</label>
                                                    <label class="ty_rdo"><input type="radio" name="CHK_ShortCircuitCount" value="3" />40~70%</label>
                                                    <label class="ty_rdo"><input type="radio" name="CHK_ShortCircuitCount" value="4" />70~100%</label>
                                                    <label class="ty_rdo"><input type="radio" name="CHK_ShortCircuitCount" value="5" />>Limit</label>
                                                </td>
                                                <td rowspan="4">-</td>
                                            </tr>
                                            <tr>
                                                <td>동작 횟수</td>
                                                <td>설계 한계치</td>
                                                <td></td>
                                                <td>
                                                    <label class="ty_rdo"><input type="radio" name="CHK_OperationCount" value="1" checked /> ≤20%</label>
                                                    <label class="ty_rdo"><input type="radio" name="CHK_OperationCount" value="2" />20~40%</label>
                                                    <label class="ty_rdo"><input type="radio" name="CHK_OperationCount" value="3" />40~70%</label>
                                                    <label class="ty_rdo"><input type="radio" name="CHK_OperationCount" value="4" />70~100%</label>
                                                    <label class="ty_rdo"><input type="radio" name="CHK_OperationCount" value="5" />>Limit</label>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>개폐 시간</td>
                                                <td>초기값 대비</td>
                                                <td></td>
                                                <td>
                                                    <label class="ty_rdo"><input type="radio" name="CHK_OpenCloseTime" value="1" checked /> ≤20%</label>
                                                    <label class="ty_rdo"><input type="radio" name="CHK_OpenCloseTime" value="3" />40~70%</label>
                                                    <label class="ty_rdo"><input type="radio" name="CHK_OpenCloseTime" value="4" />70~100%</label>
                                                    <label class="ty_rdo"><input type="radio" name="CHK_OpenCloseTime" value="5" />>Limit</label>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>외관 점검</td>
                                                <td>-</td>
                                                <td></td>
                                                <td>
                                                    <label class="ty_rdo"><input type="radio" name="CHK_VisualCheck" value="1" checked /> 오염·부식·균열 없음</label>
                                                    <label class="ty_rdo"><input type="radio" name="CHK_VisualCheck" value="3" /> 오염·부식·미약한 균열</label>
                                                    <label class="ty_rdo"><input type="radio" name="CHK_VisualCheck" value="4" /> 오염·부식 축적</label>
                                                    <label class="ty_rdo"><input type="radio" name="CHK_VisualCheck" value="5" /> 성능 영향</label>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                <!--리스트형 입력테이블-->
                                <div class="table_list_app">
                                    <table>
                                        <colgroup>
                                            <col style="width:15%">
                                            <col style="width:15%">
                                            <col style="width:12%">
                                            <col style="width:8%">
                                            <col>
                                            <col style="width:6%">
                                        </colgroup>
                                        <thead>
                                            <tr>
                                                <th>구분</th>
                                                <th>Parameters</th>
                                                <th>한전기준</th>
                                                <th>단위</th>
                                                <th>판정기준 및 score</th>
                                                <th>가중치</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td rowspan="4">일반육안점검</td>
                                                <td>개폐표시기 정위치</td>
                                                <td></td>
                                                <td></td>
                                                <td>
                                                    @*개폐표시기 정위치*@
                                                    <label class="ty_rdo" for="chk_loc_normal">
                                                        <input type="radio" id="chk_loc_normal" name="chk_loc" checked>
                                                        <span>정상(0)</span>
                                                    </label>
                                                    <label class="ty_rdo" for="chk_loc_abnormal">
                                                        <input type="radio" id="chk_loc_abnormal" name="chk_loc">
                                                        <span>이상(5)</span>
                                                    </label>
                                                </td>
                                                <td rowspan="4">7</td>
                                            </tr>
                                            <tr>
                                                <td>축세표시 정위치(Charge, Discharge)</td>
                                                <td></td>
                                                <td></td>
                                                <td>
                                                    <label class="ty_rdo" for="chk_chuk_loc_normal">
                                                        <input type="radio" id="chk_chuk_loc_normal" name="chk_chuk_loc" checked>
                                                        <span>정상(0)</span>
                                                    </label>
                                                    <label class="ty_rdo" for="chk_chuk_loc_abnormal">
                                                        <input type="radio" id="chk_chuk_loc_abnormal" name="chk_chuk_loc">
                                                        <span>이상(5)</span>
                                                    </label>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>주 전도부 단자의 연결상태</td>
                                                <td></td>
                                                <td></td>
                                                <td>
                                                    <label class="ty_rdo" for="chk_con_status_normal">
                                                        <input type="radio" id="chk_con_status_normal" name="chk_con_status" checked>
                                                        <span>정상(0)</span>
                                                    </label>
                                                    <label class="ty_rdo" for="chk_con_status_abnormal">
                                                        <input type="radio" id="chk_con_status_abnormal" name="chk_con_status">
                                                        <span>이상(5)</span>
                                                    </label>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>각종Bolt-Nut의 이완여부</td>
                                                <td></td>
                                                <td></td>
                                                <td>
                                                    <label class="ty_rdo" for="chk_bolt_nut_status_normal">
                                                        <input type="radio" id="chk_bolt_nut_status_normal" name="chk_bolt_nut_status" checked>
                                                        <span>정상(0)</span>
                                                    </label>
                                                    <label class="ty_rdo" for="chk_bolt_nut_status_abnormal">
                                                        <input type="radio" id="chk_bolt_nut_status_abnormal" name="chk_bolt_nut_status">
                                                        <span>이상(5)</span>
                                                    </label>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td rowspan="2">Vacumm Interrupt 점검</td>
                                                <td>접점 마모량</td>
                                                <td>소모량 3mm이하</td>
                                                <td>mm</td>
                                                <td>
                                                    <label class="ty_rdo" for="chk_contact_volume_up">
                                                        <input type="radio" id="chk_contact_volume_up" name="chk_contact_volume" checked>
                                                        <span>12mm이상(0)</span>
                                                    </label>
                                                    <label class="ty_rdo" for="chk_contact_volume_down">
                                                        <input type="radio" id="chk_contact_volume_down" name="chk_contact_volume">
                                                        <span>3mm이하(5)</span>
                                                    </label>
                                                </td>
                                                <td rowspan="2">9</td>
                                            </tr>
                                            <tr>
                                                <td>진공도 측정(VI누설전류측정)</td>
                                                <td>내전압:50kV   누설전류:0.3mA 이하</td>
                                                <td>mA</td>
                                                <td>
                                                    <label class="ty_rdo" for="chk_vacuum_degree_down">
                                                        <input type="radio" id="chk_vacuum_degree_down" name="chk_vacuum_degree" checked>
                                                        <span>0.3mA이하(0)</span>
                                                    </label>
                                                    <label class="ty_rdo" for="chk_vacuum_degree_up">
                                                        <input type="radio" id="chk_vacuum_degree_up" name="chk_vacuum_degree">
                                                        <span>0.3mA이상(5)</span>
                                                    </label>
