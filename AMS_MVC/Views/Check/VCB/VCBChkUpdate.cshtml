                                <td>P.U</td>
                                <td>
                                    <label class="ty_rdo" for="accumSCC_1">
                                        <input type="radio" id="accumSCC_1" name="CHK_AccumShortCircuitCurrent" value="1" @(Model.CHK_AccumShortCircuitCurrent == 1 ? "checked" : "")>
