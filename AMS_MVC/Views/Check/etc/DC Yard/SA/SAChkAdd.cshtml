@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var saCode = Request.QueryString["SA_Code"] ?? "";
}

@section LeftMenu {
    @Html.Partial("_CheckMenu")
}

@section MainContent {
    <h1>
        SA 보통점검 추가: @ViewBag.SerialNo
    </h1>
    <div class="con_box">
        <div class="content_warp">
            <div class="btn_area top right">
                <p>
                    <a href="#" class="btn blue app" onclick="createSAChk()">적용</a>
                </p>
            </div>
            <form id="saChkForm" method="post" enctype="multipart/form-data">
                @* URL에 SA_Code가 전달된 경우 hidden 필드로 사용, 그렇지 않으면 드롭다운 출력 *@
                @if (!string.IsNullOrEmpty(saCode))
                {
                    <input type="hidden" name="SA_Code" value="@saCode" />
                }
                else
                {
                    <div style="margin-bottom: 15px;">
                        @Html.DropDownList("SA_Code", (SelectList)ViewBag.SAs, "SA를 선택하세요.", new { @class = "form-control", @id = "SA_Code" })
                    </div>
                }
                <div class="table_app" id="saChk">
                    <table>
                        <colgroup>
                            <col style="width:100px;">
                            <col style="width:calc(33.3% - 100px);">
                            <col style="width:100px;">
                            <col style="width:calc(33.3% - 100px);">
                            <col style="width:100px;">
                            <col style="width:calc(33.3% - 100px);">
                        </colgroup>
                        <tr>
                            <th>공사명</th>
                            <td colspan="5">
                                <input type="text" id="chk_gongsa_name" name="chk_gongsa_name">
                            </td>
                        </tr>
                        <tr>
                            <th>날씨</th>
                            <td>
                                <input type="text" id="chk_weather" name="chk_weather">
                            </td>
                            <th>기온</th>
                            <td>
                                <input type="text" id="chk_temp" name="chk_temp"> <span>°C</span>
                            </td>
                            <th>습도</th>
                            <td>
                                <input type="text" id="chk_hum" name="chk_hum"> <span>%</span>
                            </td>
                        </tr>
                        <tr>
                            <th>업체명</th>
                            <td>
                                @Html.DropDownList("chk_company", new SelectList(ViewBag.Companies, "Com_Name", "Com_Name"), "제작사를 선택하세요.")
                            </td>
                            <th>점검자</th>
                            <td>
                                <input type="text" id="chk_worker" name="chk_worker">
                            </td>
                            <th>감독자</th>
                            <td>
                                <input type="text" id="chk_manager" name="chk_manager">
                            </td>
                        </tr>
                        <tr>
                            <th>급전번호</th>
                            <td>
                                <input type="text" id="chk_urgent_no" name="chk_urgent_no">
                            </td>
                            <th>형식</th>
                            <td>
                                <input type="text" id="chk_type" name="chk_type">
                            </td>
                            <th></th>
                            <td></td>
                        </tr>
                        <tr>
                            <th>점검 시작일</th>
                            <td>
                                <input type="date" id="chk_start_date" name="chk_start_date">
                            </td>
                            <th>점검 종료일</th>
                            <td>
                                <input type="date" id="chk_end_date" name="chk_end_date">
                            </td>
                            <th></th>
                            <td></td>
                        </tr>
                    </table>
                </div>
                <!--//입력테이블-->
            </form>
        </div>
    </div>

    <script>
    // SA 점검 정보 수집 함수
        function createSAChk() {
            submitSAChkForm();
        }

        function submitSAChkForm() {
            var form = document.getElementById("saChkForm");
            var formData = new FormData(form);

            var saCodeDropdown = document.getElementById("SA_Code");
            if (saCodeDropdown) {
                if (!saCodeDropdown.value) {
                    alert("SA를 선택하세요.");
                    return;
                }
            }

            // FormData 내용을 콘솔에 출력
            for (var pair of formData.entries()) {
                console.log(pair[0] + ": " + pair[1]);
            }

            $.ajax({
            url: '@Url.Action("SAChkAdd", "SAChk")',
            type: "POST",
            data: formData,
            processData: false,
            contentType: false,
            success: function (response) {
                console.log("서버 응답:", response);
                if (response.IsSuccess) {
                    alert("SA 보통점검 정보가 저장되었습니다.");
                    window.location.href = '@Url.Action("SAChkTotalList", "SAChk")';
                } else {
                    alert("SA 보통점검 정보를 추가하지 못했습니다.: " + response.message);
                }
            },
            error: function (xhr, status, error) {
                console.error("오류 발생:", xhr.responseText || status, error);
                alert("SA 보통점검 정보 등록 중 오류가 발생했습니다." + xhr.responseText);
            }
        });
    }
    </script>
}