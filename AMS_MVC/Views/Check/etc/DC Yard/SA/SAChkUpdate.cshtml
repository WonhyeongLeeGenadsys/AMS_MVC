    <script>
        function updateSAChk() {
            var form = document.getElementById("saChkUpdateForm");
            var formData = new FormData(form);

            // FormData 내용을 콘솔에 출력
            for (var pair of formData.entries()) {
                console.log(pair[0] + ": " + pair[1]);
            }

            $.ajax({
                url: '@Url.Action("SAChkUpdate", "SAChk")',
                type: "POST",
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {
                    console.log("서버 응답:", response);
                    if (response.IsSuccess) {
                        alert("SA 보통점검 정보가 수정되었습니다.");
                        window.location.href = '@Url.Action("SAChkTotalList", "SAChk")';
                    } else {
                        alert("SA 보통점검 정보를 수정하지 못했습니다.: " + response.message);
                    }
                },
                error: function (xhr, status, error) {
                    console.error("오류 발생:", xhr.responseText || status, error);
                    alert("SA 보통점검 정보 수정중 오류가 발생했습니다." + xhr.responseText);
                }
            });
        }
    </script>
