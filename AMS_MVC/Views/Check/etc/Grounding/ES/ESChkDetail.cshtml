@model Web.Common.ESChk

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var esCode = Request.QueryString["esCode"] ?? "";
    var tblIdx = Request.QueryString["tblIdx"] ?? "";
}

@section LeftMenu {
    @Html.Partial("_CheckMenu")
}

@section MainContent {
    <h1>ES 보통점검 상세 정보</h1>

    <div class="con_box">
        <div class="content_warp">
            <div class="btn_area top right">
                <p>
                    <a href="javascript:void(0);" class="btn red del" onclick="deleteChk('@esCode', '@tblIdx');">삭제</a>
                    <a href="@Url.Action("ESChkUpdate", "ESChk", new { esCode = esCode, tblIdx = tblIdx })" class="btn blue edit">수정</a>
                </p>
            </div>

            <div class="table_app" id="esChk">
                <table>
                    <colgroup>
                        <col style="width:100px;">
                        <col style="width:calc(33.3% - 100px);">
                        <col style="width:100px;">
                        <col style="width:calc(33.3% - 100px);">
                        <col style="width:100px;">
                        <col style="width:calc(33.3% - 100px);">
                    </colgroup>
                    <tr>
                        <th>공사명</th>
                        <td colspan="5">@Model.CHK_Gongsa_Name</td>
                    </tr>
                    <tr>
                        <th>날씨</th>
                        <td>@Model.CHK_Weather</td>
                        <th>기온</th>
                        <td>@Model.CHK_Temp °C</td>
                        <th>습도</th>
                        <td>@Model.CHK_Hum %</td>
                    </tr>
                    <tr>
                        <th>업체명</th>
                        <td>@Model.CHK_Company</td>
                        <th>점검자</th>
                        <td>@Model.CHK_Worker</td>
                        <th>감독자</th>
                        <td>@Model.CHK_Manager</td>
                    </tr>
                    <tr>
                        <th>급전번호</th>
                        <td>@Model.CHK_Urgent_No</td>
                        <th>형식</th>
                        <td>@Model.CHK_Type</td>
                        <th></th>
                        <td></td>
                    </tr>
                    <tr>
                        <th>점검 시작일</th>
                        <td>@Model.CHK_Start_Date</td>
                        <th>점검 종료일</th>
                        <td>@Model.CHK_End_Date</td>
                        <th></th>
                        <td></td>
                    </tr>
                </table>
            </div>
            <div class="table_list_app">
                <table>
                    <colgroup>
                        <col style="width:15%">
                        <col style="width:15%">
                        <col style="width:12%">
                        <col style="width:8%">
                        <col>
                        <col style="width:6%">
                    </colgroup>
                    <thead>
                        <tr>
                            <th>구분</th>
                            <th>Parameters</th>
                            <th>한전기준</th>
                            <th>단위</th>
                            <th>판정기준 및 score</th>
                            <th>가중치</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td rowspan="4">외관 점검</td>
                            <td>케이스 손상, 부식, 변색 여부 확인</td>
                            <td>이상 없음 (손상, 부식, 변색 無)</td>
                            <td>-</td>
                            <td>@(Model.CHK_1_1)</td>
                            <td rowspan="4"></td>
                        </tr>
                        <tr>
                            <td>냉각 팬 및 통풍구 막힘 여부 확인</td>
                            <td>막힘 없음, 냉각 상태 양호</td>
                            <td>-</td>
                            <td>@(Model.CHK_1_2)</td>
                        </tr>
                        <tr>
                            <td>단자대 및 배선 손상 여부 점검</td>
                            <td>손상 없음, 단자 연결 양호</td>
                            <td>-</td>
                            <td>@(Model.CHK_1_3)</td>
                        </tr>
                        <tr>
                            <td>접지 상태 확인</td>
                            <td>접지 상태 양호</td>
                            <td>-</td>
                            <td>@(Model.CHK_1_4)</td>
                        </tr>

                        <tr>
                            <td rowspan="3">전기적 특성</td>
                            <td>전압, 전류, 저항 측정 및 정상 범위 확인</td>
                            <td>정격 범위 내 유지</td>
                            <td>V/A/Ω</td>
                            <td>@(Model.CHK_2_1)</td>
                            <td rowspan="3"></td>
                        </tr>
                        <tr>
                            <td>절연 저항 측정 및 정상 범위 확인</td>
                            <td>1MΩ 이상</td>
                            <td>MΩ</td>
                            <td>@(Model.CHK_2_2)</td>
                        </tr>
                        <tr>
                            <td>배터리 전압, 내부 저항 측정</td>
                            <td>정격 전압 및 내부 저항 기준 이내</td>
                            <td>V/mΩ</td>
                            <td>@(Model.CHK_2_3)</td>
                        </tr>

                        <tr>
                            <td rowspan="2">환경 점검</td>
                            <td>작동 온도 및 습도 확인</td>
                            <td>적정 범위 내 유지</td>
                            <td>℃/%<</td>
                            <td>@(Model.CHK_3_1)</td>
                            <td rowspan="2"></td>
                        </tr>
                        <tr>
                            <td>온도 센서 및 습도 센서 작동 확인</td>
                            <td>정상 작동</td>
                            <td>-</td>
                            <td>@(Model.CHK_3_2)</td>
                        </tr>

                        <tr>
                            <td rowspan="3">통신 및 제어</td>
                            <td>통신 프로토콜 작동 확인</td>
                            <td>통신 정상</td>
                            <td>-</td>
                            <td>@(Model.CHK_4_1)</td>
                            <td rowspan="3"></td>
                        </tr>
                        <tr>
                            <td>원격 제어 기능 점검</td>
                            <td>원격 제어 정상</td>
                            <td>-</td>
                            <td>@(Model.CHK_4_2)</td>
                        </tr>
                        <tr>
                            <td>안전 장치 (과전압, 과전류, 과열 등) 점검</td>
                            <td>보호 기능 정상 동작</td>
                            <td>-</td>
                            <td>@(Model.CHK_4_3)</td>
                        </tr>

                        <tr>
                            <td rowspan="2">환경 점검</td>
                            <td>부품 마모 및 노후화 점검</td>
                            <td>기준 수명 이내, 이상 없음</td>
                            <td>-</td>
                            <td>@(Model.CHK_5_1)</td>
                            <td rowspan="2"></td>
                        </tr>
                        <tr>
                            <td>먼지 및 이물질 축적 여부 확인</td>
                            <td>청결 상태 유지</td>
                            <td>-</td>
                            <td>@(Model.CHK_5_2)</td>
                        </tr>

                        <tr>
                            <td rowspan="2">운영 특성</td>
                            <td>계통 연계형: 전력 품질 및 계통 연계 상태 점검</td>
                            <td>전력 품질 기준 만족</td>
                            <td>-</td>
                            <td>@(Model.CHK_6_1)</td>
                            <td rowspan="2"></td>
                        </tr>
                        <tr>
                            <td>독립형: 배터리 충/방전 상태 및 수명 점검</td>
                            <td>충/방전 상태 정상, 수명 관리 적정</td>
                            <td>-</td>
                            <td>@(Model.CHK_6_2)</td>
                        </tr>

                        <tr>
                            <td rowspan="1">안전 점검</td>
                            <td>보호 장치 작동 여부 확인</td>
                            <td>과전압/과전류/과열 보호 동작 정상</td>
                            <td>-</td>
                            <td>@(Model.CHK_7_1)</td>
                            <td rowspan="1"></td>
                        </tr>

                    </tbody>
                </table>
            </div>

        </div>
        </div>
}
<script type="text/javascript">
        function deleteGojang(esCode, tblIdx) {
            if (confirm("정말 삭제하시겠습니까?")) {
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("ESChkDelete", "ESChk")',
                    data: JSON.stringify({ esCode: esCode, tblIdx: tblIdx }),
                    contentType: "application/json; charset=utf-8",
                    success: function (response) {
                        if (response.success) {
                            alert("ES 기본 정보가 삭제되었습니다.");
                            window.location.href = '@Url.Action("ESChkTotalList", "ESChk")';
                        } else {
                            alert("ES 기본 정보 삭제 실패: " + response.message);
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error("삭제 중 오류:", xhr.responseText || status, error);
                        alert("삭제 중 오류가 발생했습니다: " + xhr.responseText);
                    }
                });
            }
        }
</script>


