@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var bypassvalveCode = Request.QueryString["BYPASSVALVE_Code"] ?? "";
}

@section LeftMenu {
    @Html.Partial("_CheckMenu")
}

@section MainContent {
    <h1>
        BYPASSVALVE 보통점검 추가: @ViewBag.SerialNo
    </h1>
    <div class="con_box">
        <div class="content_warp">
            <div class="btn_area top right">
                <p>
                    <a href="#" class="btn blue app" onclick="createBYPASSVALVEChk()">적용</a>
                </p>
            </div>
            <form id="bypassvalveChkForm" method="post" enctype="multipart/form-data">
                @* URL에 BYPASSVALVE_Code가 전달된 경우 hidden 필드로 사용, 그렇지 않으면 드롭다운 출력 *@
                @if (!string.IsNullOrEmpty(bypassvalveCode))
                {
                    <input type="hidden" name="BYPASSVALVE_Code" value="@bypassvalveCode" />
                }
                else
                {
                    <div style="margin-bottom: 15px;">
                        @Html.DropDownList("BYPASSVALVE_Code", (SelectList)ViewBag.BYPASSVALVEs, "BYPASSVALVE를 선택하세요.", new { @class = "form-control", @id = "BYPASSVALVE_Code" })
                    </div>
                }
                <div class="table_app" id="bypassvalveChk">
                    <table>
                        <colgroup>
                            <col style="width:100px;">
                            <col style="width:calc(33.3% - 100px);">
                            <col style="width:100px;">
                            <col style="width:calc(33.3% - 100px);">
                            <col style="width:100px;">
                            <col style="width:calc(33.3% - 100px);">
                        </colgroup>
                        <tr>
                            <th>공사명</th>
                            <td colspan="5">
                                <input type="text" id="chk_gongsa_name" name="chk_gongsa_name">
                            </td>
                        </tr>
                        <tr>
                            <th>날씨</th>
                            <td>
                                <input type="text" id="chk_weather" name="chk_weather">
                            </td>
                            <th>기온</th>
                            <td>
                                <input type="text" id="chk_temp" name="chk_temp"> <span>°C</span>
                            </td>
                            <th>습도</th>
                            <td>
                                <input type="text" id="chk_hum" name="chk_hum"> <span>%</span>
                            </td>
                        </tr>
                        <tr>
                            <th>업체명</th>
                            <td>
                                @Html.DropDownList("chk_company", new SelectList(ViewBag.Companies, "Com_Name", "Com_Name"), "제작사를 선택하세요.")
                            </td>
                            <th>점검자</th>
                            <td>
                                <input type="text" id="chk_worker" name="chk_worker">
                            </td>
                            <th>감독자</th>
                            <td>
                                <input type="text" id="chk_manager" name="chk_manager">
                            </td>
                        </tr>
                        <tr>
                            <th>급전번호</th>
                            <td>
                                <input type="text" id="chk_urgent_no" name="chk_urgent_no">
                            </td>
                            <th>형식</th>
                            <td>
                                <input type="text" id="chk_type" name="chk_type">
                            </td>
                            <th></th>
                            <td></td>
                        </tr>
                        <tr>
                            <th>점검 시작일</th>
                            <td>
                                <input type="date" id="chk_start_date" name="chk_start_date">
                            </td>
                            <th>점검 종료일</th>
                            <td>
                                <input type="date" id="chk_end_date" name="chk_end_date">
                            </td>
                            <th></th>
                            <td></td>
                        </tr>
                    </table>
                </div>
                <!--//입력테이블-->
                <!--알고리즘 반영 파라미터-->
                <div class="table_list_app">
                    <table>
                        <colgroup>
                            <col style="width:10%">
                            <col style="width:10%">
                            <col style="width:8%">
                            <col style="width:6%">
                            <col>
                            <col style="width:3%">
                        </colgroup>
                        <thead>
                            <tr>
                                <th>구분</th>
                                <th>Parameters</th>
                                <th>한전기준</th>
                                <th>단위</th>
                                <th>판정기준 및 score</th>
                                <th>가중치</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td rowspan="1">
                                    외관 점검
                                </td>
                                <td>밸브 주변 누유, 손상, 부식 여부 확인</td>
                                <td>누유/부식/손상 없음</td>
                                <td>-</td>
                                <td>
                                    <label class="ty_rdo" for="chk_1_1_1">
                                        <input type="radio" id="chk_1_1_1" name="chk_1_1" checked>
                                        <span>정상(1)</span>
                                    </label>
                                    <label class="ty_rdo" for="chk_1_1_2">
                                        <input type="radio" id="chk_1_1_2" name="chk_1_1">
                                        <span>이상(5)</span>
                                    </label>
                                </td>
                                <td rowspan="1">-</td>
                            </tr>

                            <tr>
                                <td rowspan="1">
                                    작동 점검
                                </td>
                                <td>밸브 개폐 작동 상태 확인</td>
                                <td>정상 작동 및 개폐 상태 확인</td>
                                <td>-</td>
                                <td>
                                    <label class="ty_rdo" for="chk_2_1_1">
                                        <input type="radio" id="chk_2_1_1" name="chk_2_1" checked>
                                        <span>정상(1)</span>
                                    </label>
                                    <label class="ty_rdo" for="chk_2_1_2">
                                        <input type="radio" id="chk_2_1_2" name="chk_2_1">
                                        <span>이상(5)</span>
                                    </label>
                                </td>
                                <td rowspan="1">-</td>
                            </tr>

                            <tr>
                                <td rowspan="1">
                                    압력 점검
                                </td>
                                <td>밸브 개폐 압력 측정 및 설계 사양 부합 여부 확인</td>
                                <td>설계 사양 내 압력 유지</td>
                                <td>-</td>
                                <td>
                                    <label class="ty_rdo" for="chk_3_1_1">
                                        <input type="radio" id="chk_3_1_1" name="chk_3_1" checked>
                                        <span>정상(1)</span>
                                    </label>
                                    <label class="ty_rdo" for="chk_3_1_2">
                                        <input type="radio" id="chk_3_1_2" name="chk_3_1">
                                        <span>이상(5)</span>
                                    </label>
                                </td>
                                <td rowspan="1">-</td>
                            </tr>

                            <tr>
                                <td rowspan="1">
                                    필터 점검
                                </td>
                                <td>바이패스 경로 필터 막힘 여부 점검</td>
                                <td>필터 막힘 없을 것</td>
                                <td>-</td>
                                <td>
                                    <label class="ty_rdo" for="chk_4_1_1">
                                        <input type="radio" id="chk_4_1_1" name="chk_4_1" checked>
                                        <span>정상(1)</span>
                                    </label>
                                    <label class="ty_rdo" for="chk_4_1_2">
                                        <input type="radio" id="chk_4_1_2" name="chk_4_1">
                                        <span>이상(5)</span>
                                    </label>
                                </td>
                                <td rowspan="1">-</td>
                            </tr>

                            <tr>
                                <td rowspan="1">
                                    정비 이력
                                </td>
                                <td>정비 이력 및 교체 주기 확인</td>
                                <td>정기 정비 이력 확보 및 필요 시 정비 실시</td>
                                <td>-</td>
                                <td>
                                    <label class="ty_rdo" for="chk_5_1_1">
                                        <input type="radio" id="chk_5_1_1" name="chk_5_1" checked>
                                        <span>정상(1)</span>
                                    </label>
                                    <label class="ty_rdo" for="chk_5_1_2">
                                        <input type="radio" id="chk_5_1_2" name="chk_5_1">
                                        <span>이상(5)</span>
                                    </label>
                                </td>
                                <td rowspan="1">-</td>
                            </tr>

                    </table>
                </div>

            </form>
        </div>
    </div>

    <script>
    // BYPASSVALVE 점검 정보 수집 함수
        function createBYPASSVALVEChk() {
            submitBYPASSVALVEChkForm();
        }

        function submitBYPASSVALVEChkForm() {
            var form = document.getElementById("bypassvalveChkForm");
            var formData = new FormData(form);

            var bypassvalveCodeDropdown = document.getElementById("BYPASSVALVE_Code");
            if (bypassvalveCodeDropdown) {
                if (!bypassvalveCodeDropdown.value) {
                    alert("BYPASSVALVE를 선택하세요.");
                    return;
                }
            }

            // FormData 내용을 콘솔에 출력
            for (var pair of formData.entries()) {
                console.log(pair[0] + ": " + pair[1]);
            }

            $.ajax({
            url: '@Url.Action("BYPASSVALVEChkAdd", "BYPASSVALVEChk")',
            type: "POST",
            data: formData,
            processData: false,
            contentType: false,
            success: function (response) {
                console.log("서버 응답:", response);
                if (response.IsSuccess) {
                    alert("BYPASSVALVE 보통점검 정보가 저장되었습니다.");
                    window.location.href = '@Url.Action("BYPASSVALVEChkTotalList", "BYPASSVALVEChk")';
                } else {
                    alert("BYPASSVALVE 보통점검 정보를 추가하지 못했습니다.: " + response.message);
                }
            },
            error: function (xhr, status, error) {
                console.error("오류 발생:", xhr.responseText || status, error);
                alert("BYPASSVALVE 보통점검 정보 등록 중 오류가 발생했습니다." + xhr.responseText);
            }
        });
    }
    </script>
}