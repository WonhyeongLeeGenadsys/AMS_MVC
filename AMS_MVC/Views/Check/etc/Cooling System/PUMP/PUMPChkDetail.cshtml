@model Web.Common.PUMPChk

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var pumpCode = Request.QueryString["pumpCode"] ?? "";
    var tblIdx = Request.QueryString["tblIdx"] ?? "";
}

@section LeftMenu {
    @Html.Partial("_CheckMenu")
}

@section MainContent {
    <h1>PUMP 보통점검 상세 정보</h1>

    <div class="con_box">
        <div class="content_warp">
            <div class="btn_area top right">
                <p>
                    <a href="javascript:void(0);" class="btn red del" onclick="deleteChk('@pumpCode', '@tblIdx');">삭제</a>
                    <a href="@Url.Action("PUMPChkUpdate", "PUMPChk", new { pumpCode = pumpCode, tblIdx = tblIdx })" class="btn blue edit">수정</a>
                </p>
            </div>

            <div class="table_app" id="pumpChk">
                <table>
                    <colgroup>
                        <col style="width:100px;">
                        <col style="width:calc(33.3% - 100px);">
                        <col style="width:100px;">
                        <col style="width:calc(33.3% - 100px);">
                        <col style="width:100px;">
                        <col style="width:calc(33.3% - 100px);">
                    </colgroup>
                    <tr>
                        <th>공사명</th>
                        <td colspan="5">@Model.CHK_Gongsa_Name</td>
                    </tr>
                    <tr>
                        <th>날씨</th>
                        <td>@Model.CHK_Weather</td>
                        <th>기온</th>
                        <td>@Model.CHK_Temp °C</td>
                        <th>습도</th>
                        <td>@Model.CHK_Hum %</td>
                    </tr>
                    <tr>
                        <th>업체명</th>
                        <td>@Model.CHK_Company</td>
                        <th>점검자</th>
                        <td>@Model.CHK_Worker</td>
                        <th>감독자</th>
                        <td>@Model.CHK_Manager</td>
                    </tr>
                    <tr>
                        <th>급전번호</th>
                        <td>@Model.CHK_Urgent_No</td>
                        <th>형식</th>
                        <td>@Model.CHK_Type</td>
                        <th></th>
                        <td></td>
                    </tr>
                    <tr>
                        <th>점검 시작일</th>
                        <td>@Model.CHK_Start_Date</td>
                        <th>점검 종료일</th>
                        <td>@Model.CHK_End_Date</td>
                        <th></th>
                        <td></td>
                    </tr>
                </table>
            </div>
            <div class="table_list_app">
                <table>
                    <colgroup>
                        <col style="width:15%">
                        <col style="width:15%">
                        <col style="width:12%">
                        <col style="width:8%">
                        <col>
                    </colgroup>
                    <thead>
                        <tr>
                            <th>구분</th>
                            <th>Parameters</th>
                            <th>한전기준</th>
                            <th>단위</th>
                            <th>판정기준 및 score</th>
                        </tr>
                    </thead>
                    <tbody>

                        <tr>
                            <td rowspan="2">외관 점검</td>
                            <td>펌프 본체, 연결부, 베이스 부식/손상/누수 여부 확인</td>
                            <td>부식, 손상 및 누수 없음</td>
                            <td>-</td>
                            <td>@(Model.CHK_1_1_Text)</td>
                        </tr>
                        <tr>
                            <td>모터 표면의 부식 및 손상 확인</td>
                            <td>표면 손상 및 부식 없음</td>
                            <td>-</td>
                            <td>@(Model.CHK_1_2_Text)</td>
                        </tr>

                        <tr>
                            <td rowspan="2">작동 점검</td>
                            <td>정상 작동 여부 및 이상 소음, 진동 확인</td>
                            <td>이상 소음 및 진동 없음, 정상 작동</td>
                            <td>-</td>
                            <td>@(Model.CHK_2_1_Text)</td>
                        </tr>
                        <tr>
                            <td>흡입/토출 유량 및 압력, 탱크 내 액위 확인</td>
                            <td>설계 유량 및 압력 범위 유지</td>
                            <td>m³/h, kg/cm²</td>
                            <td>@(Model.CHK_2_2_Text)</td>
                        </tr>

                        <tr>
                            <td rowspan="1">성능 시험</td>
                            <td>제어반 수동 기동 후 전체 계통 정상 여부 확인</td>
                            <td>기동 후 제어반 및 계통 정상 작동</td>
                            <td>-</td>
                            <td>@(Model.CHK_3_1_Text)</td>
                        </tr>
                        <tr>
                            <td rowspan="1">부속품 점검</td>
                            <td>밸브, 필터, 압력계 등 부속품 작동 상태 점검</td>
                            <td>모든 부속품 정상 동작</td>
                            <td>-</td>
                            <td>@(Model.CHK_4_1_Text)</td>
                        </tr>
                        <tr>
                            <td rowspan="1">유량/압력 측정</td>
                            <td>흡입/토출 유량 및 압력 측정</td>
                            <td>설계 값과 일치 (기록 필수)</td>
                            <td>m³/h, kg/cm²</td>
                            <td>@(Model.CHK_5_1_Text)</td>
                        </tr>
                        <tr>
                            <td rowspan="1">점검 기록</td>
                            <td>점검 주기 및 결과 기록, 상태 변화 추적</td>
                            <td>정기 점검 및 결과 기록 유지</td>
                            <td>-</td>
                            <td>@(Model.CHK_6_1_Text)</td>
                        </tr>

                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
@section Scripts {
    <script type="text/javascript">
        function deleteGojang(pumpCode, tblIdx) {
            if (!confirm("Pump 보통점검 정보를 삭제하시겠습니까?")) return;
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("PUMPChkDelete", "PUMPChk")',
                    data: JSON.stringify({ pumpCode: pumpCode, tblIdx: tblIdx }),
                    contentType: "application/json; charset=utf-8",
                    success: function (response) {
                        if (response.success) {
                            alert("PUMP 기본 정보가 삭제되었습니다.");
                            window.location.href = '@Url.Action("PUMPChkTotalList", "PUMPChk")';
                        } else {
                            alert("PUMP 기본 정보 삭제 실패: " + response.message);
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error("삭제 중 오류:", xhr.responseText || status, error);
                        alert("삭제 중 오류가 발생했습니다: " + xhr.responseText);
                    }
                });
            }
    </script>
    }

