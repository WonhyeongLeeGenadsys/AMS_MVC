@model Web.Common.DSChk

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var dsCode = Request.QueryString["dsCode"] ?? "";
    var tblIdx = Request.QueryString["tblIdx"] ?? "";
}

@section LeftMenu {
    @Html.Partial("_CheckMenu")
}

@section MainContent {
    <h1>DS 보통점검 상세 정보</h1>

    <div class="con_box">
        <div class="content_warp">
            <div class="btn_area top right">
                <p>
                    <a href="javascript:void(0);" class="btn red del" onclick="deleteChk('@dsCode', '@tblIdx');">삭제</a>
                    <a href="@Url.Action("DSChkUpdate", "DSChk", new { dsCode = dsCode, tblIdx = tblIdx })" class="btn blue edit">수정</a>
                </p>
            </div>

            <div class="table_app" id="dsChk">
                <table>
                    <colgroup>
                        <col style="width:100px;">
                        <col style="width:calc(33.3% - 100px);">
                        <col style="width:100px;">
                        <col style="width:calc(33.3% - 100px);">
                        <col style="width:100px;">
                        <col style="width:calc(33.3% - 100px);">
                    </colgroup>
                    <tr>
                        <th>공사명</th>
                        <td colspan="5">@Model.CHK_Gongsa_Name</td>
                    </tr>
                    <tr>
                        <th>날씨</th>
                        <td>@Model.CHK_Weather</td>
                        <th>기온</th>
                        <td>@Model.CHK_Temp °C</td>
                        <th>습도</th>
                        <td>@Model.CHK_Hum %</td>
                    </tr>
                    <tr>
                        <th>업체명</th>
                        <td>@Model.CHK_Company</td>
                        <th>점검자</th>
                        <td>@Model.CHK_Worker</td>
                        <th>감독자</th>
                        <td>@Model.CHK_Manager</td>
                    </tr>
                    <tr>
                        <th>급전번호</th>
                        <td>@Model.CHK_Urgent_No</td>
                        <th>형식</th>
                        <td>@Model.CHK_Type</td>
                        <th></th>
                        <td></td>
                    </tr>
                    <tr>
                        <th>점검 시작일</th>
                        <td>@Model.CHK_Start_Date</td>
                        <th>점검 종료일</th>
                        <td>@Model.CHK_End_Date</td>
                        <th></th>
                        <td></td>
                    </tr>
                </table>
            </div>
            <div class="table_list_app">
                <table>
                    <colgroup>
                        <col style="width:15%">
                        <col style="width:15%">
                        <col style="width:12%">
                        <col style="width:8%">
                        <col>
                        <col style="width:6%">
                    </colgroup>
                    <thead>
                        <tr>
                            <th>구분</th>
                            <th>Parameters</th>
                            <th>한전기준</th>
                            <th>단위</th>
                            <th>판정기준 및 score</th>
                            <th>가중치</th>
                        </tr>
                    </thead>
                    <tbody>

                        @*동작 확인*@
                        <tr>
                            <td rowspan="1">동작 확인</td>
                            <td>개폐 동작 상태 확인</td>
                            <td>정상 개폐 동작 확인</td>
                            <td>-</td>
                            <td>@(Model.CHK_1_1)</td>
                            <td rowspan="1"></td>
                        </tr>

                        @*내부 점검*@
                        <tr>
                            <td rowspan="1">내부 점검</td>
                            <td>조작기구함 내 청소 및 볼트 조임</td>
                            <td>이물질 제거 및 체결 상태 양호</td>
                            <td>-</td>
                            <td>@(Model.CHK_2_1)</td>
                            <td rowspan="1"></td>
                        </tr>

                        @*접속부 점검*@
                        <tr>
                            <td rowspan="1">접속부 점검</td>
                            <td>접속부 마모 상태 점검 및 청소</td>
                            <td>접속 단자 마모 및 손상 없음</td>
                            <td>-</td>
                            <td>@(Model.CHK_3_1)</td>
                            <td rowspan="1"></td>
                        </tr>

                        @*절연물 점검*@
                        <tr>
                            <td rowspan="1">절연물 점검</td>
                            <td>애자 균열, 오손 여부 점검 및 청소</td>
                            <td>균열 및 오염 없을 것, 청소 완료</td>
                            <td>-</td>
                            <td>@(Model.CHK_4_1)</td>
                            <td rowspan="1"></td>
                        </tr>

                        @*기계 결합부*@
                        <tr>
                            <td rowspan="1">기계 결합부</td>
                            <td>각 연결부 볼트 조임</td>
                            <td>볼트 풀림 없이 견고히 체결</td>
                            <td>-</td>
                            <td>@(Model.CHK_5_1)</td>
                            <td rowspan="1"></td>
                        </tr>


                        @*시험*@
                        <tr>
                            <td rowspan="1">시험</td>
                            <td>각종 시험 (절연시험, 동작시험 등)</td>
                            <td>시험 결과 기준치 만족</td>
                            <td>-</td>
                            <td>@(Model.CHK_6_1)</td>
                            <td rowspan="1"></td>
                        </tr>

                        @*윤활 상태*@
                        <tr>
                            <td rowspan="1">윤활 상태</td>
                            <td>기어부의 그리스 제거 및 재도포</td>
                            <td>정상 윤활 상태 유지</td>
                            <td>-</td>
                            <td>@(Model.CHK_7_1)</td>
                            <td rowspan="1"></td>
                        </tr>
                    </tbody>
                </table>
            </div>

        </div>
        </div>
}
<script type="text/javascript">
        function deleteGojang(dsCode, tblIdx) {
            if (confirm("정말 삭제하시겠습니까?")) {
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("DSChkDelete", "DSChk")',
                    data: JSON.stringify({ dsCode: dsCode, tblIdx: tblIdx }),
                    contentType: "application/json; charset=utf-8",
                    success: function (response) {
                        if (response.success) {
                            alert("DS 기본 정보가 삭제되었습니다.");
                            window.location.href = '@Url.Action("DSChkTotalList", "DSChk")';
                        } else {
                            alert("DS 기본 정보 삭제 실패: " + response.message);
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error("삭제 중 오류:", xhr.responseText || status, error);
                        alert("삭제 중 오류가 발생했습니다: " + xhr.responseText);
                    }
                });
            }
        }
</script>


