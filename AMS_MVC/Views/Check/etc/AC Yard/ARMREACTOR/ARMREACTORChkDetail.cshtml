@model Web.Common.ARMREACTORChk

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var armreactorCode = Request.QueryString["armreactorCode"] ?? "";
    var tblIdx = Request.QueryString["tblIdx"] ?? "";
}

@section LeftMenu {
    @Html.Partial("_CheckMenu")
}

@section MainContent {
    <h1>ARMREACTOR 보통점검 상세 정보</h1>

    <div class="con_box">
        <div class="content_warp">
            <div class="btn_area top right">
                <p>
                    <a href="javascript:void(0);" class="btn red del" onclick="deleteChk('@armreactorCode', '@tblIdx');">삭제</a>
                    <a href="@Url.Action("ARMREACTORChkUpdate", "ARMREACTORChk", new { armreactorCode = armreactorCode, tblIdx = tblIdx })" class="btn blue edit">수정</a>
                </p>
            </div>

            <div class="table_app" id="armreactorChk">
                <table>
                    <colgroup>
                        <col style="width:100px;">
                        <col style="width:calc(33.3% - 100px);">
                        <col style="width:100px;">
                        <col style="width:calc(33.3% - 100px);">
                        <col style="width:100px;">
                        <col style="width:calc(33.3% - 100px);">
                    </colgroup>
                    <tr>
                        <th>공사명</th>
                        <td colspan="5">@Model.CHK_Gongsa_Name</td>
                    </tr>
                    <tr>
                        <th>날씨</th>
                        <td>@Model.CHK_Weather</td>
                        <th>기온</th>
                        <td>@Model.CHK_Temp °C</td>
                        <th>습도</th>
                        <td>@Model.CHK_Hum %</td>
                    </tr>
                    <tr>
                        <th>업체명</th>
                        <td>@Model.CHK_Company</td>
                        <th>점검자</th>
                        <td>@Model.CHK_Worker</td>
                        <th>감독자</th>
                        <td>@Model.CHK_Manager</td>
                    </tr>
                    <tr>
                        <th>급전번호</th>
                        <td>@Model.CHK_Urgent_No</td>
                        <th>형식</th>
                        <td>@Model.CHK_Type</td>
                        <th></th>
                        <td></td>
                    </tr>
                    <tr>
                        <th>점검 시작일</th>
                        <td>@Model.CHK_Start_Date</td>
                        <th>점검 종료일</th>
                        <td>@Model.CHK_End_Date</td>
                        <th></th>
                        <td></td>
                    </tr>
                </table>
            </div>
            <div class="table_list_app">
                <table>
                    <colgroup>
                        <col style="width:15%">
                        <col style="width:15%">
                        <col style="width:12%">
                        <col style="width:8%">
                        <col>
                    </colgroup>
                    <thead>
                        <tr>
                            <th>구분</th>
                            <th>Parameters</th>
                            <th>한전기준</th>
                            <th>단위</th>
                            <th>판정기준 및 score</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td rowspan="2">
                                외관 점검
                            </td>
                            <td>보조기기류의 외부 점검</td>
                            <td>이상 유무 외관 점검</td>
                            <td>-</td>
                            <td>@(Model.CHK_1_1_Text)</td>
                        </tr>
                        <tr>
                            <td>붓싱류의 균열, 오손 여부, 누유 확인 및 청소</td>
                            <td>오손/균열/누유 없을 것, 청소 완료</td>
                            <td>-</td>
                            <td>@(Model.CHK_1_2_Text)</td>
                        </tr>

                        <tr>
                            <td rowspan="1">전기 접속부</td>
                            <td>주회로 단자 조임 확인</td>
                            <td>풀림 및 손상 없을 것</td>
                            <td>-</td>
                            <td>@(Model.CHK_2_1_Text)</td>
                        </tr>

                        <tr>
                            <td rowspan="1">제어 회로</td>
                            <td>제어 회로 결선 상태 및 접속부 이완 여부 확인</td>
                            <td>정상 결선 및 접속부 이완 없음</td>
                            <td>-</td>
                            <td>@(Model.CHK_3_1_Text)</td>
                        </tr>

                        <tr>
                            <td rowspan="1">절연 측정</td>
                            <td>절연저항 측정 (BCT 포함)</td>
                            <td>정상 기준치 이상 (예: 1MΩ 이상)</td>
                            <td>-</td>
                            <td>@(Model.CHK_4_1_Text)</td>
                        </tr>

                        <tr>
                            <td rowspan="1">경보 기능</td>
                            <td>각종 경보 확인 시험</td>
                            <td>정상 동작 및 경보 출력 확인</td>
                            <td>-</td>
                            <td>@(Model.CHK_5_1_Text)</td>
                        </tr>

                        <tr>
                            <td rowspan="1">부속 장치</td>
                            <td>각종 부속장치 동작 상태 점검 및 청소</td>
                            <td>정상 작동 및 청결 유지</td>
                            <td>-</td>
                            <td>@(Model.CHK_6_1_Text)</td>
                        </tr>

                        <tr>
                            <td rowspan="1">가스 분석</td>
                            <td>가스 성분 분석 (가스변압기 경우)</td>
                            <td>허용 범위 이내 성분 유지</td>
                            <td>-</td>
                            <td>@(Model.CHK_7_1_Text)</td>
                        </tr>

                        <tr>
                            <td rowspan="1">가스 압력</td>
                            <td>GAS 압력 측정</td>
                            <td>정상 범위 내 압력 유지</td>
                            <td>kg/cm²</td>
                            <td>@(Model.CHK_8_1_Text)</td>
                        </tr>

                        @*시험*@
                        <tr>
                            <td rowspan="1">시험</td>
                            <td>각종 시험 (성능 및 보호 시험 등)</td>
                            <td>관련 기준에 따른 시험 수행</td>
                            <td>kg/cm²</td>
                            <td>@(Model.CHK_9_1_Text)</td>
                        </tr>

                        @*가스 계통*@
                        <tr>
                            <td rowspan="1">가스 계통</td>
                            <td>가스 블로워 동작 및 윤활유 교체 (가스변압기, 진공형)</td>
                            <td>정상 동작 및 오일 적정 상태 유지</td>
                            <td>-</td>
                            <td>@(Model.CHK_10_1_Text)</td>
                        </tr>

                        @*OLTC 장치*@
                        <tr>
                            <td rowspan="1">OLTC 장치</td>
                            <td>OLTC 구동장치 동작 상태 및 조작함 점검</td>
                            <td>정상 동작 및 조작 확인</td>
                            <td>-</td>
                            <td>@(Model.CHK_11_1_Text)</td>
                        </tr>

                        @*OLTC 절연유*@
                        <tr>
                            <td rowspan="1">OLTC 절연유</td>
                            <td>OLTC 절연유의 절연내력 시험 (진공형)</td>
                            <td>절연내력 기준 만족</td>
                            <td>kV</td>
                            <td>@(Model.CHK_12_1_Text)</td>
                        </tr>

                        @*기계 보호*@
                        <tr>
                            <td rowspan="1">기계 보호</td>
                            <td>기계적 보호장치 동작 특성 시험</td>
                            <td>보호 특성 기준 만족</td>
                            <td>-</td>
                            <td>@(Model.CHK_13_1_Text)</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
@section Scripts {
<script type="text/javascript">
        function deleteGojang(armreactorCode, tblIdx) {
            if (!confirm("Arm Reactor 보통점검 정보를 삭제하시겠습니까?")) return;
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("ARMREACTORChkDelete", "ARMREACTORChk")',
                    data: JSON.stringify({ armreactorCode: armreactorCode, tblIdx: tblIdx }),
                    contentType: "application/json; charset=utf-8",
                    success: function (response) {
                        if (response.success) {
                            alert("ARMREACTOR 기본 정보가 삭제되었습니다.");
                            window.location.href = '@Url.Action("ARMREACTORChkTotalList", "ARMREACTORChk")';
                        } else {
                            alert("ARMREACTOR 기본 정보 삭제 실패: " + response.message);
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error("삭제 중 오류:", xhr.responseText || status, error);
                        alert("삭제 중 오류가 발생했습니다: " + xhr.responseText);
                    }
                });
            }
</script>
    }

