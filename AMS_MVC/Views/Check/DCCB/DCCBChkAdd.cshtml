    <script>
    // DCCB 점검 정보 수집 함수
        function createDCCBChk() {
            submitDCCBChkForm();
        }

        function submitDCCBChkForm() {
            var form = document.getElementById("dccbChkForm");
            var formData = new FormData(form);

            // 1) DCCB_Code가 hidden인 경우(이미 URL에 있었음) => 바로 진행
            // 2) DCCB_Code가 드롭다운인 경우 => 선택 체크
            var dccbCodeDropdown = document.getElementById("DCCB_Code");
            if (dccbCodeDropdown) {
                // 사용자가 "DCCB를 선택하세요."(기본값) 또는 빈 값("")을 선택한 경우 확인
                if (!dccbCodeDropdown.value) {
                    alert("DCCB를 선택하세요.");
                    return;
                }
            }

            // FormData 내용을 콘솔에 출력
            for (var pair of formData.entries()) {
                console.log(pair[0] + ": " + pair[1]);
            }

            $.ajax({
            url: '@Url.Action("DCCBChkAdd", "DCCBChk")',
            type: "POST",
            data: formData,
            processData: false,
            contentType: false,
            success: function (response) {
                console.log("서버 응답:", response);
                if (response.IsSuccess) {
                    alert("DCCB 보통점검 정보가 저장되었습니다.");
                    window.location.href = '@Url.Action("DCCBChkTotalList", "DCCBChk")';
                } else {
                    alert("DCCB 보통점검 정보를 추가하지 못했습니다.: " + response.message);
                }
            },
            error: function (xhr, status, error) {
                console.error("오류 발생:", xhr.responseText || status, error);
                alert("DCCB 보통점검 정보 등록 중 오류가 발생했습니다." + xhr.responseText);
            }
        });
    }
    </script>
}