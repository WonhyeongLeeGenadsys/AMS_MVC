                                </td>
                                <td>
                                    <label class="ty_rdo" for="CHK_CE_Voltage_5">
                                        <input type="radio" id="CHK_CE_Voltage_5" name="CHK_CE_Voltage" value="5">
                                        <span>1.25초과</span>
                                    </label>
                                </td>
                                <td>1 P.U = 제조사 권장값</td>
                            </tr>
                            <tr>
                                <td>
                                    G 전압(Vg)
                                </td>
                                <td>P.U</td>
                                <td>
                                    <label class="ty_rdo" for="CHK_G_Voltage_1">
                                        <input type="radio" id="CHK_G_Voltage_1" name="CHK_G_Voltage" value="1" checked>
