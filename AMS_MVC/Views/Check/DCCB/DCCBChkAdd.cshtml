                                        <span>1.0 이내</span>
                                    </label>
                                </td>
                                <td>-</td>
                                <td>
                                    <label class="ty_rdo" for="CHK_RACR_3">
                                        <input type="radio" id="CHK_RACR_3" name="CHK_RACR" value="3">
                                        <span>1.0~1.25</span>
                                    </label>
                                </td>
                                <td>
                                    <label class="ty_rdo" for="CHK_RACR_4">
                                        <input type="radio" id="CHK_RACR_4" name="CHK_RACR" value="4">
                                        <span>1.25~1.5</span>
                                    </label>
                                </td>
                                <td>
                                    <label class="ty_rdo" for="CHK_RACR_5">
                                        <input type="radio" id="CHK_RACR_5" name="CHK_RACR" value="5">
                                        <span>1.5 초과</span>
                                    </label>
                                </td>
                                <td>1 P.U = 제조사 권장값</td>
                            </tr>
                            <tr>
                                <td rowspan="6">
