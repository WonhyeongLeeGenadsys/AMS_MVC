                            </tr>
                            <tr>
                                <td>
                                    기계부 진동/가속도
                                </td>
                                <td>P.U</td>
                                <td>
                                    <label class="ty_rdo" for="CHK_MVA_1">
                                        <input type="radio" id="CHK_MVA_1" name="CHK_MVA" value="1" checked>
                                        <span>1.1 이내</span>
                                    </label>
                                </td>
                                <td>-</td>
                                <td>
                                    <label class="ty_rdo" for="CHK_MVA_3">
                                        <input type="radio" id="CHK_MVA_3" name="CHK_MVA" value="3">
                                        <span>1.1~1.5</span>
                                    </label>
                                </td>
                                <td>
