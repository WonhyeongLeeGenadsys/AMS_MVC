@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var dccbCode = Request.QueryString["DCCB_Code"] ?? "";
}

@section LeftMenu {
    @Html.Partial("_CheckMenu")
}

@section MainContent {
    <h1>DCCB 보통점검이력: @ViewBag.Name, @ViewBag.SerialNo</h1>

    <div class="con_box">
        <div class="content_warp">
            <div class="btn_area top right">
                <a href="@Url.Action("DCCBChkAdd", "DCCBChk", new { DCCB_Code = dccbCode })" class="btn add blue">추가</a>
            </div>
            <div id="gridContainer" class="grid_wrap"></div>
        </div>

        <script>
            $(document).ready(function () {
                loadDCCBChkData();
            });

            function loadDCCBChkData() {
                var dccbCode = "@dccbCode";

                $.ajax({
                    type: "POST",
                    url: '@Url.Action("GetDCCBChkListData", "DCCBChk")',
                    data: JSON.stringify({ dccbCode: dccbCode }),
                    contentType: "application/json; charset=utf-8",
                    success: function (response) {
                        if (response.success == false) {
                            console.error("DCCBChk 데이터 로드 실패: " + response.message);
                            return;
                        }

                        // 작성일(Tbl_GetDate) 기준 내림차순 정렬
                        let data = response.sort((a, b) => new Date(b.Tbl_GetDate) - new Date(a.Tbl_GetDate));

                        // 순번 매기기
                        data = data.map((item, index) => {
                            item.RowNumber = data.length - index;
                            return item;
                        });

                        $("#gridContainer").dxDataGrid({
                            dataSource: data,
                            columnFixing: { enabled: true },
                            columns: [
                                { dataField: "RowNumber", caption: "순번", width: 80 },
                                { dataField: 'CHK_Gongsa_Name', caption: '공사명', alignment: 'center', width: 'auto' },
                                { dataField: 'CHK_Weather', caption: '날씨', alignment: 'center', width: 'auto' },
                                { dataField: 'CHK_Temp', caption: '기온(°C)', alignment: 'center', width: 'auto' },
                                { dataField: 'CHK_Hum', caption: '습도(%)', alignment: 'center', width: 'auto' },
                                { dataField: 'CHK_Company', caption: '업체명', alignment: 'center', width: 'auto' },
                                { dataField: 'CHK_Worker', caption: '점검자', alignment: 'center', width: 'auto' },
                                { dataField: 'CHK_Manager', caption: '감독자', alignment: 'center', width: 'auto' },
                                { dataField: 'CHK_Urgent_No', caption: '급전번호', alignment: 'center', width: 'auto' },
                                { dataField: 'CHK_Type', caption: '형식', alignment: 'center', width: 'auto' },
                                { dataField: 'CHK_Start_Date', caption: '점검시작일', alignment: 'center', width: 120},
                                { dataField: 'CHK_End_Date', caption: '점검 종료일', alignment: 'center', width: 120}
                            ],
                            showBorders: false,
                            searchPanel: { visible: true, width: 240, placeholder: "검색" },
                            filterRow: { visible: true, applyFilter: 'auto' },
                            headerFilter: { visible: true },
                            loadPanel: { enabled: true },
                            scrolling: { columnRenderingMode: 'virtual' },
                            onRowClick: function (e) {
                                const dccbCode = e.data.DCCB_Code;  // DCCB 코드만 필요함 (Tbl_Idx 필요 없음)

                                var baseUrl = window.location.origin; // 현재 사이트의 기본 URL
                                var detailUrl = '@Url.Action("DCCBChkDetail", "DCCBChk")';

                                 window.location.href = baseUrl + detailUrl + "?dccbCode=" + encodeURIComponent(dccbCode);
                                }
                        });
                    },
                        error: function (xhr, status, error) {
                            console.error("데이터 로드 중 오류", error);
                        }
                });
            }
        </script>
    </div>
}
