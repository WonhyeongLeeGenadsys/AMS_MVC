@model Web.Common.DCCBChk
@using Web.Common

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var dccbCode = Request.QueryString["dccbCode"] ?? "";
    var tblIdx = Request.QueryString["tblIdx"] ?? "";
}

@section LeftMenu {
    @Html.Partial("_CheckMenu")
}

@section MainContent {
    <h1>DCCB 보통점검 상세 정보</h1>

    <div class="con_box">
        <div class="content_warp">
            <div class="btn_area top right">
                <p>
                    <a href="javascript:void(0);" class="btn red del"
                       onclick="deleteChk('@dccbCode', '@tblIdx');">삭제</a>

                    <a href="@Url.Action("DCCBChkUpdate", "DCCBChk", new { dccbCode = dccbCode, tblIdx = tblIdx })" class="btn blue edit">수정</a>
                </p>
            </div>

            <div class="table_app" id="dccbChk">
                <table>
                    <colgroup>
                        <col style="width:100px;">
                        <col style="width:calc(33.3% - 100px);">
                        <col style="width:100px;">
                        <col style="width:calc(33.3% - 100px);">
                        <col style="width:100px;">
                        <col style="width:calc(33.3% - 100px);">
                    </colgroup>
                    <tr>
                        <th>공사명</th>
                        <td>@Model.CHK_Gongsa_Name</td>
                        <th>제품명</th>
                        <td>@ViewBag.Name</td>
                        <th>시리얼번호</th>
                        <td>@ViewBag.SerialNo</td>
                    </tr>
                    <tr>
                        <th>날씨</th>
                        <td>@Model.CHK_Weather</td>
                        <th>기온</th>
                        <td>@Model.CHK_Temp °C</td>
                        <th>습도</th>
                        <td>@Model.CHK_Hum %</td>
                    </tr>
                    <tr>
                        <th>업체명</th>
                        <td>@Model.CHK_Company</td>
                        <th>점검자</th>
                        <td>@Model.CHK_Worker</td>
                        <th>감독자</th>
                        <td>@Model.CHK_Manager</td>
                    </tr>
                    <tr>
                        <th>급전번호</th>
                        <td>@Model.CHK_Urgent_No</td>
                        <th>형식</th>
                        <td>@Model.CHK_Type</td>
                        <th></th>
                        <td></td>
                    </tr>
                    <tr>
                        <th>점검 시작일</th>
                        <td>@Model.CHK_Start_Date</td>
                        <th>점검 종료일</th>
                        <td>@Model.CHK_End_Date</td>
                        <th></th>
                        <td></td>
                    </tr>
                </table>
            </div>

            <div class="table_list_app">
                <table>
                    <colgroup>
                        <col style="width:15%">
                        <col style="width:15%">
                        <col style="width:12%">
                        <col style="width:8%">
                        <col>
                    </colgroup>
                    <thead>
                        <tr>
                            <th>구분</th>
                            <th>Parameters</th>
                            <th>한전기준</th>
                            <th>단위</th>
                            <th>판정기준</th>
                            <th>등급</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td rowspan="4">고속 개폐기</td>
                            <td>주회로 절연내력</td>
                            <td></td>
                            <td></td>
                            <td>@(Model.MainCircuitInsulationStrengthText)</td>
                            @Html.HiCell((int)Model.CHK_MainCircuit_InsulationStrength)

                        </tr>
                        <tr>
                            <td>기밀시험</td>
                            <td></td>
                            <td></td>
                            <td>@(Model.LeakTestText)</td>
                            @Html.HiCell((int)Model.CHK_LeakTest)

                        </tr>
                        <tr>
                            <td>기계적 동작(속도)</td>
                            <td></td>
                            <td></td>
                            <td>@(Model.MechanicalOperationText)</td>
                            @Html.HiCell((int)Model.CHK_MechanicalOperation)

                        </tr>
                        <tr>
                            <td>보조 및 제어회로(응답시간)</td>
                            <td></td>
                            <td></td>
                            <td>@(Model.AuxControlCircuitText)</td>
                            @Html.HiCell((int)Model.CHK_AuxControlCircuit)

                        </tr>

                        <tr>
                            <td rowspan="6">전자식 차단부</td>
                            <td>C-E 전압</td>
                            <td></td>
                            <td></td>
                            <td>@(Model.CE_VoltageText) </td>
                            @Html.HiCell((int)Model.CHK_CE_Voltage)

                        </tr>
                        <tr>
                            <td>G 전압</td>
                            <td></td>
                            <td>MΩ</td>
                            <td>@(Model.G_VoltageText)</td>
                            @Html.HiCell((int)Model.CHK_G_Voltage)

                        </tr>
                        <tr>
                            <td>On 저항</td>
                            <td></td>
                            <td></td>
                            <td>@(Model.OnResistanceText)</td>
                            @Html.HiCell((int)Model.CHK_On_Resistance)

                        </tr>
                        <tr>
                            <td>열 저항</td>
                            <td></td>
                            <td></td>
                            <td>@(Model.ThermalResistanceText)</td>
                            @Html.HiCell((int)Model.CHK_Thermal_Resistance)

                        </tr>
                        <tr>
                            <td>C 전류</td>
                            <td></td>
                            <td></td>
                            <td>@(Model.C_CurrentText)</td>
                            @Html.HiCell((int)Model.CHK_C_Current)

                        </tr>
                        <tr>
                            <td>On/Off 시간</td>
                            <td></td>
                            <td></td>
                            <td>@(Model.OnOffTimeText)</td>
                            @Html.HiCell((int)Model.CHK_OnOff_Time)

                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
@section Scripts {
    <script type="text/javascript">
  function deleteChk(dccbCode, tblIdx) {
      if (!confirm("DCCB 보통점검 정보를 삭제하시겠습니까?")) return;

    $.ajax({
      type: "POST",
      url: '@Url.Action("DeleteDCCBChk", "DCCBChk")',
      data: { dccbCode: dccbCode, tblIdx: tblIdx }, // 폼 인코딩 방식
      success: function (response) {
        if (response.success) {
          alert("DCCB 보통점검 정보가 삭제되었습니다.");
          window.location.href = '@Url.Action("DCCBChkTotalList", "DCCBChk")';
        } else {
          alert("DCCB 보통점검 정보 삭제 실패: " + (response.message || ""));
        }
      },
      error: function (xhr, status, error) {
        console.error("삭제 중 오류:", xhr.responseText || status, error);
        alert("삭제 중 오류가 발생했습니다: " + (xhr.responseText || error));
      }
    });
  }
    </script>
}