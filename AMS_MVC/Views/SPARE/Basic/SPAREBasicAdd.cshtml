@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section LeftMenu {
    @Html.Partial("_SPAREMenu")
}

@section MainContent {
    <h1>예비품 기본정보 추가</h1>

    <div class="con_box">
        <div class="content_warp">
            <div class="btn_area top right">
                <p>
                    <a href="javascript:void(0)" class="btn blue app" onclick="createSpareBasicInfo()">적용</a>
                </p>
            </div>

            <form id="spareForm" method="post">
                <div class="table_app">
                    <table>
                        <tr>
                            <th>부품번호</th>
                            <td><input type="text" name="PART_NUMBER" required></td>
                            <th>부품명</th>
                            <td><input type="text" name="PART_NAME" required></td>
                        </tr>
                        <tr>
                            <th>중요도 등급</th>
                            <td>
                                <select name="CRITICALITY_GRADE">
                                    <option value="CRITICAL">CRITICAL - 핵심 부품</option>
                                    <option value="HIGH">HIGH - 주요 부품</option>
                                    <option value="MEDIUM">MEDIUM - 일반 부품</option>
                                    <option value="LOW">LOW - 소모품</option>
                                </select>
                            </td>
                            <th>단가</th>
                            <td><input type="number" name="UNIT_PRICE" min="0" step="1" required><span>원</span></td>
                        </tr>
                        <tr>
                            <th>납기일</th>
                            <td><input type="number" name="LEAD_TIME_DAYS" min="0" step="1" required><span>일</span></td>
                            <th>사용 여부</th>
                            <td>
                                <label class="ty_rdo">
                                    <input type="radio" name="IS_ACTIVE" value="true" checked><span>사용</span>
                                </label>
                                <label class="ty_rdo">
                                    <input type="radio" name="IS_ACTIVE" value="false"><span>미사용</span>
                                </label>
                            </td>
                        </tr>
                        <tr>
                            <th>초기 현재재고</th>
                            <td><input type="number" name="INITIAL_CURRENT_QTY" min="0" step="1" value="0" required></td>
                            <th>초기 안전재고</th>
                            <td><input type="number" name="INITIAL_SAFETY_STOCK" min="0" step="1" value="0" required></td>
                        </tr>
                        <tr>
                            <th>기본 공급사</th>
                            <td><input type="text" name="SUPPLIER" maxlength="100"></td>
                            <th>비고</th>
                            <td><input type="text" name="NOTES" maxlength="500"></td>
                        </tr>
                        <tr>
                            <th>연결 설비유형 / 필요수량</th>
                            <td colspan="3">
                                <div class="spare-asset-map-list">
                                    @foreach (var assetType in new[]
                                    {
                                        new { Id = 1, Name = "VCB" },
                                        new { Id = 2, Name = "DCCB" },
                                        new { Id = 3, Name = "SUBMODULE" },
                                        new { Id = 4, Name = "DCCABLE" },
                                        new { Id = 5, Name = "INTERFACETR" },
                                        new { Id = 6, Name = "CONVERTER" },
                                        new { Id = 7, Name = "CIRCUIT BREAKER" },
                                        new { Id = 8, Name = "CABLE" },
                                        new { Id = 9, Name = "SWITCHGEAR" },
                                        new { Id = 10, Name = "PROTECTION RELAY" },
                                        new { Id = 11, Name = "COOLING SYSTEM" },
                                        new { Id = 12, Name = "ENERGY STORAGE" },
                                        new { Id = 13, Name = "SCADA" }
                                    })
                                    {
                                        <div class="spare-asset-map-row">
                                            <label class="ty_chk"><input type="checkbox" name="asset_type_ids" value="@assetType.Id"><span>@assetType.Name</span></label>
                                            <label class="spare-asset-map-qty"><span>필요수량</span><input type="number" name="required_qtys" value="1" min="1" step="1" disabled></label>
                                        </div>
                                    }
                                </div>
                            </td>
                        </tr>
                    </table>
                </div>
            </form>
        </div>
    </div>

    <style>
        .spare-asset-map-list {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(285px, 1fr));
            gap: 10px;
            width: 100%;
            min-width: 0;
        }

        .spare-asset-map-row {
            display: grid;
            grid-template-rows: auto auto;
            align-items: stretch;
            gap: 8px;
            min-width: 0;
            min-height: 76px;
            padding: 11px 13px;
            border: 1px solid #d8e0eb;
            border-radius: 6px;
            background: #f8fafc;
            box-sizing: border-box;
            transition: border-color .15s ease, background-color .15s ease, box-shadow .15s ease;
        }

        .spare-asset-map-row.is-selected {
            border-color: #1768ad;
            background: #eef6ff;
            box-shadow: inset 3px 0 #1768ad;
        }

        .spare-asset-map-row .ty_chk {
            display: flex;
            align-items: flex-start;
            width: 100%;
            min-width: 0;
            font-weight: 600;
        }

        .spare-asset-map-row .ty_chk span {
            min-width: 0;
            white-space: normal !important;
            overflow-wrap: anywhere;
            line-height: 1.3;
        }

        .spare-asset-map-qty {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 7px;
            padding-top: 7px;
            border-top: 1px solid #e4e9f0;
            white-space: nowrap;
            color: #5f6978;
            font-size: 13px;
        }

        .spare-asset-map-row input[type="number"] { width: 64px; }
    </style>

    <script>
        function syncRequiredQtyInput(checkbox) {
            var row = checkbox.closest(".spare-asset-map-row");
            var quantityInput = row.querySelector('input[name="required_qtys"]');
            quantityInput.disabled = !checkbox.checked;
            quantityInput.required = checkbox.checked;
            row.classList.toggle("is-selected", checkbox.checked);
        }

        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll('input[name="asset_type_ids"]').forEach(function (checkbox) {
                syncRequiredQtyInput(checkbox);
                checkbox.addEventListener("change", function () {
                    syncRequiredQtyInput(this);
                });
            });
        });

        function createSpareBasicInfo() {
            var form = document.getElementById("spareForm");

            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            if ($(form).find('input[name="asset_type_ids"]:checked').length === 0) {
                alert("연결 설비유형을 한 개 이상 선택하세요.");
                return;
            }

            var formData = new FormData(form);

            $.ajax({
                url: '@Url.Action("SPAREBasicAdd", "SPAREBasic")',
                type: "POST",
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {
                    if (response.success) {
                        alert("예비품 기본정보가 등록되었습니다.");
                        window.location.href = '@Url.Action("SPAREBasicList", "SPAREBasic")';
                    } else {
                        alert("등록 실패: " + response.message);
                    }
                },
                error: function (xhr) {
                    alert("오류 발생: " + xhr.responseText);
                }
            });
        }
    </script>
}
