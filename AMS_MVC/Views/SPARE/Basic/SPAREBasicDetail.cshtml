@model Web.Common.SPAREPartInfo
@using Web.Common
@using System.Collections.Generic

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var inventory = ViewBag.Inventory as InventoryInfo;
    var assetMaps = ViewBag.AssetMaps as List<SpareAssetMapInfo>;
    var procurements = ViewBag.Procurements as List<ProcurementInfo>;
    var costs = ViewBag.Costs as List<CostManagementInfo>;

    Func<int, string> getAssetTypeName = id =>
    {
        switch (id)
        {
            case 1: return "VCB";
            case 2: return "DCCB";
            case 3: return "SUBMODULE";
            case 4: return "DCCABLE";
            case 5: return "INTERFACETR";
            case 6: return "CONVERTER";
            case 7: return "CIRCUIT BREAKER";
            case 8: return "CABLE";
            case 9: return "SWITCHGEAR";
            case 10: return "PROTECTION RELAY";
            case 11: return "COOLING SYSTEM";
            case 12: return "ENERGY STORAGE";
            case 13: return "SCADA";
            default: return "UNKNOWN";
        }
    };
}

@section LeftMenu {
    @Html.Partial("_SPAREMenu")
}

@section MainContent {
    <h1>예비품 상세정보</h1>

    <div class="con_box">
        <div class="content_warp">
            @if (Model == null)
            {
                <p>@ViewBag.ErrorMessage</p>
            }
            else
            {
                <div class="btn_area top right">
                    <p class="mrR10">
                        <a href="@Url.Action("UpdateSpareBasic", "SpareBasic", new { spareId = Model.SPARE_ID })" class="btn gray">수정</a>
                    </p>
                    <p class="mrR10">
                        <a href="@Url.Action("SPAREInventoryEdit", "SPAREInventory", new { spareId = Model.SPARE_ID })" class="btn blue">재고 관리</a>
                    </p>
                    <p class="mrR10">
                        <a href="@Url.Action("SPAREProcurementAdd", "SPAREProcurement", new { spareId = Model.SPARE_ID })" class="btn blue">발주 등록</a>
                    </p>
                    <p class="mrR10">
                        <a href="@Url.Action("SPARECostAdd", "SPARECost", new { spareId = Model.SPARE_ID })" class="btn blue">비용 등록</a>
                    </p>
                    <p>
                        <a href="javascript:void(0)" class="btn red del" onclick="deleteSpareBasic(@Model.SPARE_ID)">미사용 처리</a>
                    </p>
                </div>

                <div class="table_app view">
                    <table>
                        <tr>
                            <th>부품번호</th>
                            <td>@Model.PART_NUMBER</td>
                            <th>부품명</th>
                            <td>@Model.PART_NAME</td>
                        </tr>
                        <tr>
                            <th>중요도 등급</th>
                            <td>@Model.CRITICALITY_GRADE</td>
                            <th>단가</th>
                            <td>@Model.UNIT_PRICE</td>
                        </tr>
                        <tr>
                            <th>리드타임</th>
                            <td>@Model.LEAD_TIME_DAYS 일</td>
                            <th>사용 여부</th>
                            <td>@(Model.IS_ACTIVE.HasValue && Model.IS_ACTIVE.Value ? "사용" : "미사용")</td>
                        </tr>
                        <tr>
                            <th>기본 공급사</th>
                            <td>@(string.IsNullOrWhiteSpace(Model.SUPPLIER) ? "-" : Model.SUPPLIER)</td>
                            <th>비고</th>
                            <td>@(string.IsNullOrWhiteSpace(Model.NOTES) ? "-" : Model.NOTES)</td>
                        </tr>
                        <tr>
                            <th>현재재고</th>
                            <td>@(inventory != null ? inventory.CURRENT_QTY : 0)</td>
                            <th>안전재고</th>
                            <td>@(inventory != null ? inventory.SAFETY_STOCK : 0)</td>
                        </tr>
                        <tr>
                            <th>EOQ</th>
                            <td>@(inventory != null ? inventory.EOQ : null)</td>
                            <th>재주문점</th>
                            <td>@(inventory != null ? inventory.REORDER_POINT : null)</td>
                        </tr>
                        <tr>
                            <th>최소/최대재고</th>
                            <td>@(inventory != null ? inventory.MIN_STOCK : null) / @(inventory != null ? inventory.MAX_STOCK : null)</td>
                            <th>재고정책</th>
                            <td>@(inventory != null ? inventory.POLICY_TYPE : null)</td>
                        </tr>
                        <tr>
                            <th>설비유형 / 필요수량</th>
                            <td colspan="3">
                                @if (assetMaps != null && assetMaps.Count > 0)
                                {
                                    @(string.Join(", ", assetMaps.Select(x => getAssetTypeName(x.ASSET_TYPE_ID) + " " + x.REQUIRED_QTY + "개")))
                                }
                                else
                                {
                                    @:-
                                }
                            </td>
                        </tr>
                    </table>
                </div>

                <div class="mrT30"></div>

                <h2>발주 이력</h2>
                <div class="table_list_app">
                    <table>
                        <thead>
                            <tr>
                                <th>발주수량</th>
                                <th>발주단가</th>
                                <th>총발주비용</th>
                                <th>발주일</th>
                                <th>상태</th>
                                <th>공급사</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (procurements != null && procurements.Count > 0)
                            {
                                foreach (var item in procurements)
                                {
                                    <tr>
                                        <td>@item.ORDER_QTY</td>
                                        <td>@item.UNIT_COST</td>
                                        <td>@item.TOTAL_PROC_COST</td>
                                        <td>@(item.ORDER_DATE.HasValue ? item.ORDER_DATE.Value.ToString("yyyy-MM-dd") : "")</td>
                                        <td>@item.STATUS</td>
                                        <td>@item.SUPPLIER</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="6">발주 이력 없음</td></tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="mrT30"></div>

                <h2>비용 관리</h2>
                <div class="table_list_app">
                    <table>
                        <thead>
                            <tr>
                                <th>회계연도</th>
                                <th>예산금액</th>
                                <th>실제금액</th>
                                <th>수정일</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (costs != null && costs.Count > 0)
                            {
                                foreach (var item in costs)
                                {
                                    <tr>
                                        <td>@item.FISCAL_YEAR</td>
                                        <td>@item.BUDGET_AMOUNT</td>
                                        <td>@item.ACTUAL_AMOUNT</td>
                                        <td>@(item.UPDATED_AT.HasValue ? item.UPDATED_AT.Value.ToString("yyyy-MM-dd") : "")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="4">비용 관리 데이터 없음</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <script>
        function deleteSpareBasic(spareId) {
            if (!confirm("이 예비품을 미사용 처리하시겠습니까? 기존 재고·발주·비용 이력은 보존됩니다.")) return;

            $.ajax({
                url: '@Url.Action("DeleteSpareBasicInfo", "SpareBasic")',
                type: 'POST',
                data: { spareId: spareId },
                success: function (response) {
                    if (response.success) {
                        alert(response.message);
                        location.href = '@Url.Action("SpareBasicList", "SpareBasic")';
                    } else {
                        alert(response.message);
                    }
                },
                error: function (xhr) {
                    alert("미사용 처리 중 오류가 발생했습니다: " + xhr.responseText);
                }
            });
        }
    </script>
}
