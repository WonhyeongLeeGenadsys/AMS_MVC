@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section LeftMenu {
    @Html.Partial("_SPAREMenu")
}

@section MainContent {
    <h1>예비품 RUL 기반 3개년 조달계획</h1>

    <div class="con_box">
        <div class="content_warp spare-costplan-dashboard">

            <div class="procurement-summary">
                <span>계획기간 <strong id="planPeriod">-</strong></span>
                <span>대상 품목 <strong id="planPartCount">0</strong>개</span>
                <span>총 발주수량 <strong id="planOrderQty">0</strong>개</span>
                <span>예상 발주비용 <strong id="planOrderCost">0원</strong></span>
                <span>장기계획 장비 <strong id="planExcludedAssets">0</strong>대</span>
            </div>

            <div class="costplan-chart-row">
                <div class="costplan-chart-box">
                    <div class="costplan-chart-header">
                        <h2>설비 유형별 예비품 비용</h2>
                    </div>
                    <div id="assetCostPieChart" class="costplan-chart-area"></div>
                </div>

                <div class="costplan-chart-box">
                    <div class="costplan-chart-header">
                        <h2>RUL 기반 3개년 예상 발주비용</h2>
                    </div>
                    <div id="yearlyBudgetChart" class="costplan-chart-area"></div>
                </div>
            </div>

            <div class="costplan-grid-box">
                <div class="costplan-chart-header">
                    <h2>연도별 조달 상세</h2>
                    <span>RUL 3년 이상 장비는 장기계획으로 분류됩니다.</span>
                </div>
                <div id="procurementPlanGrid" class="grid_wrap"></div>
            </div>

        </div>
    </div>

    <style>
        .spare-costplan-dashboard {
            padding-top: 10px;
        }

        .procurement-summary {
            display: flex;
            flex-wrap: wrap;
            gap: 10px 24px;
            margin-bottom: 14px;
            padding: 13px 16px;
            border-radius: 10px;
            background: #fff;
            box-shadow: 2px 2px 4px rgba(0,0,0,0.08);
            font-size: 13px;
        }

            .procurement-summary strong {
                color: #145DA0;
                font-size: 15px;
            }

        .costplan-chart-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
        }

        .costplan-chart-box {
            background: #fff;
            border-radius: 10px;
            padding: 12px 16px 16px 16px;
            box-shadow: 2px 2px 4px rgba(0,0,0,0.08);
        }

        .costplan-chart-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
        }

            .costplan-chart-header h2 {
                margin: 0;
                font-size: 16px;
                font-weight: 800;
            }

            .costplan-chart-header span {
                font-size: 11px;
                color: #3E6BC0;
                font-weight: 700;
            }

        .costplan-chart-area {
            height: 320px;
        }

        .costplan-grid-box {
            margin-top: 14px;
            padding: 12px 16px 16px 16px;
            border-radius: 10px;
            background: #fff;
            box-shadow: 2px 2px 4px rgba(0,0,0,0.08);
        }
    </style>

    <script>
        $(document).ready(function () {
            initCostPlanCharts();
            initProcurementPlanGrid();
            loadCostPlanData();
        });

        function initCostPlanCharts() {
            $("#assetCostPieChart").dxPieChart({
                type: "pie",
                palette: ["#E74C3C", "#27AE60", "#4A90E2", "#8E44AD", "#17A589", "#F39C12"],
                dataSource: [],
                legend: {
                    visible: true,
                    orientation: "vertical",
                    horizontalAlignment: "left",
                    verticalAlignment: "bottom"
                },
                series: [{
                    argumentField: "ASSET_TYPE_NAME",
                    valueField: "TOTAL_COST",
                    label: {
                        visible: true,
                        connector: { visible: true },
                        customizeText: function (arg) {
                            return arg.argumentText + "\n" + arg.percentText;
                        }
                    }
                }],
                tooltip: {
                    enabled: true,
                    customizeTooltip: function (arg) {
                        return {
                            text: arg.argumentText + "<br/>" + formatWon(arg.value)
                        };
                    }
                }
            });

            $("#yearlyBudgetChart").dxChart({
                dataSource: [],
                commonSeriesSettings: {
                    argumentField: "FISCAL_YEAR_TEXT",
                    type: "stackedBar",
                    ignoreEmptyPoints: false
                },
                series: [
                    { valueField: "LOW", name: "LOW", color: "#4A90E2" },
                    { valueField: "MEDIUM", name: "MEDIUM", color: "#27AE60" },
                    { valueField: "HIGH", name: "HIGH", color: "#F39C12" },
                    { valueField: "CRITICAL", name: "CRITICAL", color: "#E74C3C" }
                ],
                legend: {
                    verticalAlignment: "top",
                    horizontalAlignment: "center"
                },
                argumentAxis: {
                    type: "discrete"
                },
                valueAxis: {
                    title: "예산 (원)",
                    label: {
                        customizeText: function (arg) {
                            return Number(arg.value || 0).toLocaleString() + "원";
                        }
                    }
                },
                tooltip: {
                    enabled: true,
                    customizeTooltip: function (arg) {
                        return {
                            text: arg.seriesName + "<br/>" +
                                arg.argumentText + "년<br/>" +
                                formatWon(arg.value)
                        };
                    }
                }
            });
        }

        function initProcurementPlanGrid() {
            $("#procurementPlanGrid").dxDataGrid({
                dataSource: [],
                keyExpr: ["FISCAL_YEAR", "SPARE_ID"],
                showBorders: true,
                hoverStateEnabled: true,
                rowAlternationEnabled: true,
                columnAutoWidth: true,
                paging: { pageSize: 20 },
                pager: {
                    visible: true,
                    showPageSizeSelector: true,
                    allowedPageSizes: [10, 20, 50],
                    showInfo: true
                },
                columns: [
                    { dataField: "FISCAL_YEAR", caption: "조달연도", alignment: "center" },
                    { dataField: "PART_NUMBER", caption: "부품번호", alignment: "center" },
                    { dataField: "PART_NAME", caption: "부품명" },
                    { dataField: "ASSET_TYPE_NAME", caption: "설비유형", alignment: "center" },
                    { dataField: "ASSET_CODES", caption: "대상 장비", minWidth: 140 },
                    { dataField: "CRITICALITY_GRADE", caption: "중요도", alignment: "center" },
                    { dataField: "MIN_RUL_YEARS", caption: "최소 RUL(년)", alignment: "right", format: { type: "fixedPoint", precision: 2 } },
                    { dataField: "EXPECTED_DEMAND", caption: "예상수요", alignment: "right", format: { type: "fixedPoint", precision: 4 } },
                    { dataField: "ORDER_QTY", caption: "권장 발주수량", alignment: "center", format: "#,##0" },
                    { dataField: "UNIT_PRICE", caption: "단가(원)", alignment: "right", format: "#,##0" },
                    { dataField: "ORDER_COST", caption: "예상 발주비용(원)", alignment: "right", format: "#,##0" }
                ]
            });
        }

        function loadCostPlanData() {
            const currentYear = new Date().getFullYear();

            $.ajax({
                type: "POST",
                url: '@Url.Action("GetSPARECostPlanData", "SpareDashboard")',
                data: {
                    assetTypeId: null,
                    fiscalYear: currentYear
                },
                success: function (response) {
                    console.log("cost plan response:", response);

                    if (!response || !response.success) {
                        alert("비용계획 데이터를 불러오지 못했습니다.");
                        return;
                    }

                    renderCostPlan(response);
                },
                error: function (xhr) {
                    console.log("AJAX ERROR:", xhr.responseText);
                    alert("오류 발생: " + xhr.responseText);
                }
            });
        }

        function renderCostPlan(data) {
            const assetCostRows = Array.isArray(data.assetCostRows) ? data.assetCostRows : [];
            const yearlyBudgetRows = Array.isArray(data.yearlyBudgetRows) ? data.yearlyBudgetRows : [];
            const procurementRows = Array.isArray(data.procurementRows) ? data.procurementRows : [];
            const summary = data.summary || {};

            const pieData = assetCostRows.map(x => ({
                ASSET_TYPE_NAME: x.ASSET_TYPE_NAME,
                TOTAL_COST: Number(x.TOTAL_COST || 0)
            }));

            const budgetData = yearlyBudgetRows.map(x => ({
                FISCAL_YEAR: x.FISCAL_YEAR,
                FISCAL_YEAR_TEXT: String(x.FISCAL_YEAR),
                CRITICAL: Number(x.CRITICAL || 0),
                HIGH: Number(x.HIGH || 0),
                MEDIUM: Number(x.MEDIUM || 0),
                LOW: Number(x.LOW || 0)
            }));

            const baseYear = Number(summary.BASE_YEAR || new Date().getFullYear());
            $("#planPeriod").text(baseYear + "~" + (baseYear + 2) + "년");
            $("#planPartCount").text(Number(summary.TOTAL_PART_COUNT || 0).toLocaleString());
            $("#planOrderQty").text(Number(summary.TOTAL_ORDER_QTY || 0).toLocaleString());
            $("#planOrderCost").text(formatWon(summary.TOTAL_ORDER_COST));
            $("#planExcludedAssets").text(Number(summary.EXCLUDED_ASSET_COUNT || 0).toLocaleString());

            console.log("pieData:", pieData);
            console.log("budgetData:", budgetData);

            const pieChart = $("#assetCostPieChart").dxPieChart("instance");
            if (pieChart) {
                pieChart.option("dataSource", pieData);
            }

            const budgetChart = $("#yearlyBudgetChart").dxChart("instance");
            if (budgetChart) {
                budgetChart.option("dataSource", budgetData);
            }

            const planGrid = $("#procurementPlanGrid").dxDataGrid("instance");
            if (planGrid) {
                planGrid.option("dataSource", procurementRows);
            }
        }

        function formatWon(value) {
            const v = Number(value || 0);
            return v.toLocaleString() + "원";
        }
    </script>
}
