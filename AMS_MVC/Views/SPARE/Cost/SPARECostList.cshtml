@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section LeftMenu {
    @Html.Partial("_SPAREMenu")
}

@section MainContent {
    <h1>예비품 비용계획 목록</h1>

    <div class="con_box">
        <div class="content_warp">
            <div class="btn_area top right">
                <a href="@Url.Action("SPARECostPlan", "SPAREDashboard")" class="btn">RUL 기반 조달계획</a>
                <a href="@Url.Action("SPARECostAdd", "SPARECost")" class="btn add blue">추가</a>
            </div>

            <div id="gridContainer" class="grid_wrap"></div>
        </div>
    </div>

    <script>

        // MVC 기본 JsonResult는 DateTime을 "/Date(ticks)/" 형태로 직렬화한다.
        // 그대로 두면 화면에 원문이 노출되므로 여기서 yy.MM.dd 로 바꾼다.
        function msDate(value) {
            if (!value) return "";
            var m = /\/Date\((-?\d+)/.exec(value);
            var d = m ? new Date(Number(m[1])) : new Date(value);
            if (isNaN(d.getTime())) return "";
            var p = function (n) { return (n < 10 ? "0" : "") + n; };
            return String(d.getFullYear()).slice(2) + "." + p(d.getMonth() + 1) + "." + p(d.getDate());
        }

        $(function () {
            loadCostList();
        });

        function loadCostList() {
            $.ajax({
                type: "POST",
                url: '@Url.Action("GetCostListData", "SPARECost")',
                success: function (response) {
                    if (!response.success) {
                        alert(response.message);
                        return;
                    }

                    $("#gridContainer").dxDataGrid({
                        dataSource: response.data,
                        showBorders: true,
                        hoverStateEnabled: true,
                        searchPanel: { visible: true, width: 240, placeholder: "검색" },
                        columns: [
                            { dataField: "PART_NUMBER", caption: "부품번호", alignment: "center" },
                            { dataField: "PART_NAME", caption: "부품명", alignment: "center" },
                            { dataField: "CRITICALITY_GRADE", caption: "중요도", alignment: "center", width: 100 },
                            { dataField: "FISCAL_YEAR", caption: "회계연도", alignment: "center", width: 100 },
                            { dataField: "BUDGET_AMOUNT", caption: "예산금액", alignment: "right", width: 120, format: "#,##0" },
                            { dataField: "ACTUAL_AMOUNT", caption: "실제금액", alignment: "right", width: 120, format: "#,##0" },
                            { dataField: "UPDATED_AT", caption: "수정일", alignment: "center", width: 110, calculateCellValue: function (row) { return msDate(row.UPDATED_AT); } },
                            {
                                caption: "관리",
                                alignment: "center",
                                width: 100,
                                cellTemplate: function (container, options) {
                                    $("<a>")
                                        .addClass("btn gray")
                                        .text("수정")
                                        .attr("href", '@Url.Action("SPARECostUpdate", "SPARECost")' + '?costId=' + options.data.COST_ID)
                                        .appendTo(container);
                                }
                            }
                        ]
                    });
                }
            });
        }
    </script>
}