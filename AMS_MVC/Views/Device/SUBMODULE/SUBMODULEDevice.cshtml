                <p>점검</p>
                <p class="schedule_value">
                    <span class="confirmed">confirmed</span>
                    <span class="risk">risk</span>
                    <span class="created">To be Created</span>
                </p>
                <p class="month_select">
                    <a href="javascript:void(0);" class="arrow prev">이전달</a>
                    <span id="currentMonth"></span>
                    <a href="javascript:void(0);" class="arrow next">다음달</a>
                </p>
                <a href="javascript:void(0);" class="btn_more">더보기</a>
            </h2>
            <!-- //타이틀 영역 -->
            <!-- 스케줄 테이블 영역 -->
            <div class="schedule_table">
                <table>
                    <thead>
                        <tr>
                            <th colspan="2"></th>
                            @for (int i = 1; i <= 31; i++)
                            {
                                <th>@i</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
