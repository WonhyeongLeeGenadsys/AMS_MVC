        <script>
            $(document).ready(function () {
                // 현재 연도와 월 초기화
                var currentYear = new Date().getFullYear();
                var currentMonth = new Date().getMonth() + 1; // 월은 0부터 시작하므로 +1

                // 상단에 표시할 현재 연도-월 업데이트 함수
                function updateMonthDisplay() {
                    $("#currentMonth").text(currentYear + " - " + String(currentMonth).padStart(2, '0'));
                }

                // 지정한 연도와 월의 점검 스케줄 데이터를 AJAX로 가져오는 함수
                function loadSchedule(year, month) {
                    $.ajax({
                        url: '/TotalInfo/GetScheduleData',
                        type: "GET",
                        data: { year: year, month: month },
                        dataType: "json",
                        success: function (data) {
                            renderSchedule(data, year, month);
                        },
                        error: function () {
                            alert("데이터를 불러오는 중 오류가 발생했습니다.");
                        }
                    });
                }

                // 가져온 데이터를 바탕으로 스케줄 테이블의 행을 생성하는 함수
                function renderSchedule(data, year, month) {
                    var daysInMonth = new Date(year, month, 0).getDate();
                    var tbodyHtml = "";

                    // 먼저 Type별로 그룹화
                    var groupedData = {};
                    data.forEach(function (item) {
                        // 여기서는 SUBMODULE 점검 데이터만 표시한다고 가정 (item.Type === "SUBMODULE")
                        if (!groupedData[item.Type]) {
                            groupedData[item.Type] = [];
                        }
                        groupedData[item.Type].push(item);
                    });

                    // 그룹별로 행 생성
                    for (var type in groupedData) {
                        var items = groupedData[type];
                        items.forEach(function (item) {
                            // 점검 시작일과 종료일의 "일" 숫자를 추출 (예: "2024-07-10" -> 10)
                            var startDay = parseInt(item.Start.split('-')[2]);
                            var endDay = item.End ? parseInt(item.End.split('-')[2]) : startDay;
                            // 상태에 따라 바의 색상 지정
                            var barStyle = "";
                            if (item.Status === "confirmed") {
                                barStyle = "background-color:blue;";

                            } else if (item.Status === "risk") {
                                barStyle = "background-color:purple;";

                            } else if (item.Status === "created") {
                                barStyle = "background-color:gray;";

                            } else {
                                barStyle = "background-color:lightgray;";
                            }
                            var barWidth = ((endDay - startDay + 1) * 31) + "px";

                            tbodyHtml += "<tr>";
                            tbodyHtml += "<th>" + type + "</th>";
                            tbodyHtml += "<td>" + item.Code + "</td>";
                            // 각 날짜 셀 생성
                            for (var i = 1; i <= daysInMonth; i++) {
                                if (i === startDay) {
                                    tbodyHtml += "<td colspan='" + (endDay - startDay + 1) + "' style='position: relative;'><span class='bar' style='" + barStyle + " width: " + barWidth + "; height: 20px; display: block;'></span></td>";
                                    i = endDay; // 종료일 다음 날로 건너뛰기
                                } else {
                                    tbodyHtml += "<td></td>";
                                }
                            }
                            tbodyHtml += "</tr>";
                        });
                    }
                    $(".schedule_table tbody").html(tbodyHtml);
                }

                // 이전달 버튼 클릭 시
                $(".prev").click(function () {
                    currentMonth--;
                    if (currentMonth < 1) {
                        currentMonth = 12;
                        currentYear--;
                    }
                    updateMonthDisplay();
                    loadSchedule(currentYear, currentMonth);
                });

                // 다음달 버튼 클릭 시
                $(".next").click(function () {
                    currentMonth++;
                    if (currentMonth > 12) {
                        currentMonth = 1;
                        currentYear++;
                    }
                    updateMonthDisplay();
                    loadSchedule(currentYear, currentMonth);
                });

                // 초기 로드
                updateMonthDisplay();
                loadSchedule(currentYear, currentMonth);
            });
        </script>
        <!--//점검-->
        <!--유지보수-->
        <div class="con_box flex1">
            <!-- 타이틀 -->
            <h2>
                <p>유지보수</p>
            </h2>
            <!-- 챠트 컨테이너 -->
            <div id="chart03"></div>
            <script>
                $(document).ready(function () {
                    // 서버에서 SUBMODULE 유지보수 데이터를 가져오는 함수
                    function fetchMaintenanceData() {
                        return $.ajax({
                            type: "POST",
                            url: "/SUBMODULEDevice/GetMonthlyMaintenanceData",
                            contentType: "application/json; charset=utf-8",
                            dataType: "json"
                        });
                    }

                    // Key/Value 쌍 배열 데이터를 일반 객체로 변환하는 함수
                    // 일반적인 오브젝트가 아니라 키/값 쌍의 배열 형태로 있을 때 일반적인 JSON 객체 형태로 변환하기 위해 사용!
                    function transformData(rawArray) {
                        return rawArray.map(function (itemArray) {
                            var obj = {};
                            itemArray.forEach(function (pair) {
                                obj[pair.Key] = pair.Value;
                            });
                            return obj;
                        });
                    }

                    // 데이터를 월별로 그룹화하여 SUBMODULE 값만 누적하는 함수
                    function processChartData(rawData) {
                        const groupedData = {};
                        rawData.forEach(item => {
                            const month = item.Month; // EX: "2024-05"
                            if (!groupedData[month]) {
                                groupedData[month] = { Month: month, SUBMODULE: 0 };
                            }
                            if (item.Type === "SUBMODULE") {
                                groupedData[month].SUBMODULE += item.Count;
                            }
                        });
                        // 월별 정렬 (yyyy-MM 문자열 기준)
                        return Object.values(groupedData).sort((a, b) => a.Month.localeCompare(b.Month));
                    }

                    // SUBMODULE 차트를 렌더링하는 함수
                    function renderSUBMODULEChart(data) {
                        $("#chart03").dxChart({
                            dataSource: data,
                            commonSeriesSettings: {
                                argumentField: "Month",  // 각 데이터 객체에 "Month" 속성이 있어야 함
                                type: "bar"
                            },
                            legend: {
                                visible: true,
                                position: "bottom"
                            },
                            tooltip: {
                                enabled: true,
                                customizeTooltip: function (arg) {
                                    return {
                                        text: arg.seriesName + " - " + arg.argumentText + ": " + arg.valueText + "건"
                                    };
                                }
                            },
                            series: [
                                {
                                    name: "SUBMODULE",
                                    valueField: "SUBMODULE",  // 각 데이터 객체에 "SUBMODULE" 속성이 있어야 함
                                    color: "#0051A2"
                                }
                            ]
                        });
                    }

                    // AJAX 호출하여 데이터 로드 및 차트 렌더링
                    fetchMaintenanceData()
                        .done(function (response) {
                            console.log("유지보수 raw 데이터:", response);
                            // 변환: Key/Value 쌍 배열 -> 일반 객체 배열
                            const transformedData = transformData(response);
                            console.log("변환된 데이터:", transformedData);
                            if (!Array.isArray(transformedData) || transformedData.length === 0) {
                                alert("유지보수 데이터가 없습니다.");
                                return;
                            }
                            const chartData = processChartData(transformedData);
                            renderSUBMODULEChart(chartData);
                        })
                        .fail(function (xhr, status, error) {
                            console.error("Ajax Error:", error);
                            alert("유지보수 데이터를 가져오는 중 문제가 발생했습니다.");
                        });
                });
            </script>
        </div>
        <!--//유지보수-->
        <!--고장-->
        <div class="con_box">
            <!-- 타이틀 -->
            <h2>
                <p>고장</p>
                <a href="javacript:void(0);" class="btn_more">더보기</a>
            </h2>
            <!-- //타이틀 -->
            <!-- 그리드 -->
            <div id="gridContainer02" class="grid_wrap" style="height: 400px;"></div>
            <!-- //그리드 -->
            <script type="text/javascript">
                function parseDotNetDate(dotNetString) {
                    var match = /Date\((\d+)\)/.exec(dotNetString);
                    if (match) {
                        var timestamp = parseInt(match[1], 10);
                        return new Date(timestamp);
                    }
                    return null;
                }

                // Key/Value 쌍 배열을 일반 객체로 변환하는 함수
                function transformData(rawArray) {
                    return rawArray.map(function (itemArray) {
                        var obj = {};
                        itemArray.forEach(function (pair) {
                            if (pair.Key === 'Date' && typeof pair.Value === 'string') {
                                obj[pair.Key] = parseDotNetDate(pair.Value);
                            } else {
                                obj[pair.Key] = pair.Value;
                            }
                        });
                        return obj;
                    });
                }

                $(document).ready(function () {
                    $.ajax({
                        type: "POST",
                        url: "/SUBMODULEDevice/GetGojangSUBMODULEList",
                        contentType: "application/json; charset=utf-8",
                        dataType: "json"
                    })
                        .done(function (response) {
                            var transformed = transformData(response);
                            console.log("SUBMODULE 전용 고장 데이터:", transformed);

                            $("#gridContainer02").dxDataGrid({
                                dataSource: transformed,
                                columns: [
                                    { dataField: 'Priority', caption: '우선순위', alignment: 'center' },
                                    { dataField: 'Code', caption: '코드', alignment: 'center' },
                                    { dataField: 'Name', caption: '설비명', alignment: 'center' },
                                    { dataField: 'Serial_No', caption: '시리얼번호', alignment: 'center' },
                                    { dataField: 'Weather', caption: '날씨', alignment: 'center' },
                                    { dataField: 'Temp', caption: '온도(°C)', alignment: 'center' },
                                    { dataField: 'Hum', caption: '습도(%)', alignment: 'center' },
                                    { dataField: 'Reason', caption: '발견동기', alignment: 'center' },
                                    { dataField: 'Status', caption: '상태', alignment: 'center' },
                                    { dataField: 'Part', caption: '부품', alignment: 'center' },
                                    { dataField: 'Period', caption: '기간', alignment: 'center' },
                                    { dataField: 'Finder', caption: '발견자', alignment: 'center' },
                                    {
                                        dataField: 'Date',
                                        caption: '고장일',
                                        alignment: 'center',
                                        dataType: 'date'
                                    }
                                ],
                                showBorders: true,
                                sorting: { mode: 'multiple' },
                                scrolling: { columnRenderingMode: 'virtual' }
                            });
                        })
                        .fail(function (xhr, status, error) {
                            console.error("SUBMODULE 고장 데이터를 가져오는 중 오류:", error);
                        });
                });
            </script>

        </div>
        <!--고장-->
    </div>
