                    <h3 class="left tit">PoF</h3>
                    <ul class="left txt">
                        <li>Very Poor</li>
                        <li>Poor</li>
                        <li>Fair</li>
                        <li>Good</li>
                        <li>Very Good</li>
                    </ul>
                </div>
                <!--//메트릭스좌측-->
                <!--그래프-->
