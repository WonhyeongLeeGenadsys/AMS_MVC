@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section LeftMenu {
    @Html.Partial("_DeviceInfoMenu")
}

@section MainContent {
    <h1>SUBMODULE</h1>
    <!--전체 박스-->
    <div class="box_wrap">
        <!--건전도-->
        <div class="con_box flex3">
            <!--타이틀-->
            <h2>건전도</h2>
            <!--//타이틀-->
            <!--그래프-->
            <div id="pie01" style="height: 280px; width: 100%;"></div>
            <!--//그래프-->
            <!--그래프 타이틀-->
            <script>
                $(document).ready(function () {
                    // 서버에서 HI 집계 데이터를 가져오는 함수
                    function fetchSUBMODULEData() {
                        return $.ajax({
                            type: "POST",
                            url: "/SUBMODULEDevice/GetRiskmatrixData",  // 위에서 추가한 액션 호출
                            data: JSON.stringify({ prefix: "SUBMODULE" }),
                            contentType: "application/json; charset=utf-8",
                            dataType: "json"
                        });
                    }

                    // dxPieChart 생성 함수
                    function initializePieChart(data) {
                        $('#pie01').dxPieChart({
                            type: 'doughnut',
                            palette: ['#5B9F56', '#B4DEB1', '#EBCD1D', '#F18425', '#F05153'],
                            dataSource: data,
                            legend: {
                                visible: true,
                                horizontalAlignment: 'center',
                                verticalAlignment: 'bottom',
                            },
                            onPointClick(arg) {
                                arg.target.select();
                            },
                            series: [{
                                argumentField: 'state',
                                valueField: 'value',
                                label: {
                                    visible: true,
                                    format: 'fixedPoint',
                                    precision: 0,
                                    connector: { visible: true },
                                },
                            }],
                        });
                    }

                    // 데이터를 가져와 차트에 적용
                    fetchSUBMODULEData()
                        .done(function (response) {
                            if (response) {
                                // response는 { "1": count, "2": count, ... } 형태
                                const hiSummary = summarizeHIData(response);
                                initializePieChart(hiSummary);
                            } else {
                                alert("SUBMODULE 데이터를 가져오는 데 실패했습니다.");
                            }
                        })
                        .fail(function (xhr, status, error) {
                            console.error("Ajax Error:", error);
                            alert("서버에서 데이터를 가져오는 중 오류가 발생했습니다.");
                        });

                    // HI 데이터를 요약하여 배열 형태로 변환하는 함수
                    function summarizeHIData(data) {
                        var result = [];
                        Object.keys(data).forEach(function (key) {
                            result.push({
                                state: getStateByHI(key),
                                value: parseInt(data[key], 10)
                            });
                        });
                        return result;
                    }

                    // HI 값에 따라 상태 문자열 반환
                    function getStateByHI(hi) {
                        var value = parseInt(hi, 10);
                        switch (value) {
                            case 1: return 'Very Good';
                            case 2: return 'Good';
                            case 3: return 'Fair';
                            case 4: return 'Poor';
                            case 5: return 'Very Poor';
                            default: return 'Unknown';
                        }
                    }

                });
            </script>
        </div>
        <!--//건전도-->
        <!--risk matrix-->
        <div class="con_box flex3">
            <!--타이틀-->
            <h2>
                Risk Matrix
            </h2>
            <!--//타이틀-->
            <!--메트릭스-->
            <div class="matrix">
                <!--메트릭스좌측-->
