                            endValue: 40,
                            tickInterval: 5,
                            label: {
                                customizeText(arg) {
                                    return `${arg.valueText} °C`;
                                },
                            },
                        },
                        rangeContainer: {
                            ranges: [
                                { startValue: 10, endValue: 20, color: '#7A92CE' },
                                { startValue: 20, endValue: 30, color: '#FEA00D' },
                                { startValue: 30, endValue: 40, color: '#48C29C' },
                            ],
                        },
                        tooltip: { enabled: true },

                        value: 35,
                        subvalues: [20, 38],
                    }).dxCircularGauge('instance');

                });
