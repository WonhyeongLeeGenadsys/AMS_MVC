        <script>
            $(function () {
                    const code = '@Model.VCB_Code';


      $.getJSON('@Url.Action("GetRiskMapPoints","TotalInfo")', { prefix: 'vcb' })
     .done(function (allPoints) {
         // name 프로퍼티가 모델의 코드와 일치하는 포인트만
         const point = allPoints.find(p => p.name === code);
         if (!point) {
             console.warn("해당 장비의 포인트를 찾지 못했습니다:", code);
             return;
         }


         $("#chartRiskVCB").dxChart({
             dataSource: [point],
             commonSeriesSettings: {
                 type: "scatter",
                 argumentField: "x",
                 valueField: "y",
                 point: { size: 10 }
             },
             palette: ['#34A369', '#B82069', '#F57B50', '#2B6D6F', '#38B295', '#DC9FF1', '#EBCC44', '#CFD94D', '#E43387', '#002C68'],
             border: {
                 visible: false // 차트 전체의 외곽선(테두리)을 숨깁니다.
             },

             seriesTemplate: { nameField: "group" },
             argumentAxis: {
                 visualRange: { startValue: 0, endValue: 40000 },
                 valueMarginsEnabled: false, // 여백 제거
                 tickInterval: 8000,
                 grid: {
                     visible: true,
                     opacity: 0.5, /* 선을 더 연하게 */
                     color: '#ffffff', /* 선 색상 지정 */
                     width: 1 /* 선 두께 지정 */
                 },
                 title: { text: "CoF ($)" },
                 label: { customizeText: e => e.value.toLocaleString() }
             },

             valueAxis: {
                 // 0~100% 딱 고정
                 visualRange: { startValue: 0, endValue: 100 },
                 // 눈금을 tick에 맞춰 늘리지 않음
                 endOnTick: false,
                 // 데이터 끝에 여백을 두지 않음
                 valueMarginsEnabled: false, // 여백 제거
                 tickInterval: 20,
                 min: 0, // 첫 번째 셀의 시작 Y 좌표
                 max: 5, // 마지막 셀의 끝 Y 좌표
                 grid: {
                     visible: true,
                     opacity: 0.5, /* 선을 더 연하게 */
                     color: '#ffffff', /* 선 색상 지정 */
                     width: 1 /* 선 두께 지정 */
                 },
                 title: { text: "PoF (%)" },
                 label: { customizeText: e => e.value.toFixed(0) + "%" },
             },


             tooltip: {
                 enabled: true,
                 location: 'edge',
                 customizeTooltip: info => {
                     const d = info.point.data;
                     return {
                         html:
                             `<strong>${d.name}</strong><br/>
                CoF: ${d.x.toLocaleString()}$<br/>
                PoF: ${d.y.toFixed(2)}%`
                     };
                 }

             },
             onPointClick(e) {
                 const d = e.target.originalData;
                 alert(`코드: ${d.name}\nCoF: ${d.x.toLocaleString()}$\nPoF: ${d.y.toFixed(2)}%`);
             },
             legend: {
                 visible: true, position: "bottom",
                 verticalAlignment: 'bottom',
                 horizontalAlignment: 'center',
             },

             size: { width: 400, height: 300 },
             margin: 0,

         });      })
      .fail(function(err) {
        console.error("GetRiskMapPoints 호출 실패:", err);
      });
  });
        </script>
