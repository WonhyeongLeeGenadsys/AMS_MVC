        <!-- 점검일정 -->
        <div class="con_box">
            <h2>점검일정</h2>
            <div id="gridContainerSchedule" class="grid_wrap" style="height:250px;"></div>
        </div>

        <script>
  $(function(){
    var today = new Date();
    var year  = today.getFullYear();
    var month = today.getMonth() + 1;

    $.getJSON('@Url.Action("GetScheduleData","TotalInfo")', { year: year, month: month })
      .done(function(res){
        // 1) VCB만 필터
        let vcbs = res.filter(r => r.Type === 'DS');

        // 2) DueDate 계산 (End + 3개월)
        vcbs.forEach(item => {
          if (item.End) {
            let d = new Date(item.End);
            d.setMonth(d.getMonth() + 3);
            item.DueDate = d.toISOString().slice(0,10);
          }
        });

        // 3) 같은 Serial_No별로 최신 DueDate 항목만 남기기
        let latestBySerial = Object.values(
          vcbs.reduce((acc, item) => {
            let prev = acc[item.Serial_No];
            if (!prev || new Date(item.DueDate) > new Date(prev.DueDate)) {
              acc[item.Serial_No] = item;
            }
            return acc;
          }, {})
        );

        // 4) DueDate 오름차순 정렬 후 Priority 재부여
        latestBySerial
          .sort((a,b) => new Date(a.DueDate) - new Date(b.DueDate))
          .forEach((item, idx) => item.Priority = idx+1);

        // 5) DevExtreme DataGrid 렌더
        $("#gridContainerSchedule").dxDataGrid({
          dataSource: latestBySerial,
          showBorders: true,
          sorting: { mode: 'multiple' },
          scrolling: { columnRenderingMode: 'virtual' },

          onCellPrepared: function(e) {
            if (e.rowType !== 'data') return;

            // 시작일 → 연두색
            if (e.column.dataField === 'Start') {
              e.cellElement.css({ color: 'green', 'font-weight': 'medium' });
            }
            // 종료일 → 검정
            else if (e.column.dataField === 'End') {
              e.cellElement.css({ color: 'black', 'font-weight': 'medium' });
            }
            // 점검일(DueDate) → 빨강
            else if (e.column.dataField === 'DueDate') {
              e.cellElement.css({ color: 'red', 'font-weight': 'bold' });
            }
            // 우선순위는 굵게
            else if (e.column.dataField === 'Priority') {
              e.cellElement.css({ 'font-weight': 'bold' });
            }
          },

          columns: [
            { dataField: "Priority", caption: "우선순위", alignment: "center" },
            {
                  caption: "구분",
                  alignment: "center",
                  calculateCellValue: function () {
                      return "AC";
                  }
            },
            { dataField: "Type", caption: "설비명", alignment: "center" },
            {
              caption: "점검유형", alignment: "center",
              calculateCellValue: row =>
                row.Status === 'confirmed' ? '보통점검'
              : row.Status === 'risk'      ? '정밀점검'
              : row.Status
            },
            { dataField: "Serial_No", caption: "시리얼번호", alignment: "center" },
              { dataField: "Start", caption: "시작일", dataType: "date", alignment: "center", format: 'yy.MM.dd' },
              { dataField: "End", caption: "종료일", dataType: "date", alignment: "center", format: 'yy.MM.dd' },
              { dataField: "DueDate", caption: "정기점검일", dataType: "date", alignment: "center", format: 'yy.MM.dd' }
          ]
        });
      })
      .fail(function(xhr, status, err){
        console.error("GetScheduleData 오류:", err);
      });
  });
        </script>

