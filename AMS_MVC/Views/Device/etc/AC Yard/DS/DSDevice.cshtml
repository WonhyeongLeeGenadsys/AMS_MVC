﻿@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section LeftMenu {
    @Html.Partial("_DeviceInfoMenu")
}

@section MainContent {
    <h1>DS</h1>
    <!--전체 박스-->
    <div class="box_wrap">

        <!--전략-->
        <div class="con_box" id="strategyContainer">
            <h2><p>차년도 교체 대상</p></h2>
        </div>

        <script>
    $(function(){
      loadStrategy(
        '@Url.Action("GetBasicInfoList","DSDevice")',
        '#strategyContainer',
        'DS'
      );
    });
        </script>
        <!--//전략-->
        <!-- 신뢰도 차트 -->
        <div class="con_box flex5">
            <h2>신뢰도</h2>
            <div id="chart_line_trust" style="width:100%; height:350px; border:1px solid #ccc; display:block;"></div>
        </div>

        <script>
$(function(){
  $.ajax({
    url: '@Url.Action("GetAlgorithmData", "EquipmentAlgorithm")',
    type: 'GET',
    data: { equipmentType: "DS" },
    dataType: 'json'
  }).done(function(resp){
    if (!Array.isArray(resp) || resp.length === 0) {
      console.warn("신뢰도 데이터가 없습니다.");
      return;
    }

    var b3 = resp.B3Life !== undefined
              ? parseFloat(resp.B3Life)
          : parseFloat(resp[0].B3Life);
      console.log("!!!!!!!!!!!!B3 값!!!!!!!!!:", b3);

      var usagePeriods = resp[0].UsagePeriod || [];

    var seriesData = resp[0].ReliabilitySeries.map(function(pt){
      return { time: parseFloat(pt.time), value: parseFloat(pt.value) };
    });
    var maxX = resp[0].TimeMax;

      $("#chart_line_trust").dxChart({
      dataSource: seriesData,
      commonSeriesSettings: {
        type: "line",
        point: { visible: false }
      },
      series: [{
        name: "신뢰도",
        argumentField: "time",
        valueField: "value"
      }],
      tooltip: { enabled: true },
      argumentAxis: {
        title: "시간 (년)",
        visualRange: { startValue: 0, endValue: maxX },
        constantLines: [
           {
                value: b3,
                color: "red",
                width: 2.5,
                dashStyle: "dash",
                label: {
                      text: "B3 = " + b3 + "년",
                      visible: true,
                      font: { color: "red" },
                      position: "inside"
                }
                }
            ]
            .concat(usagePeriods.map(function (u) {
                  return {
                        value: u,
                        color: "green",
                        width: 2.5,
                        dashStyle: "solid",
                      label: {
                          text: "사용기간: " + usagePeriods + "년",
                          visible: true,
                          font: { color: "green" },
                          position: "inside"
                      }
                  };
                    }))
      },
      valueAxis: {
        title: "신뢰도 (0 ~ 1)",
        visualRange: { startValue: 0, endValue: 1 }
      },
      legend: { visible: false },
      onContentReady: function(e){
        e.component.render();
      }
    });
  }).fail(function(err){
    console.error("신뢰도 데이터 로드 실패:", err);
  });
});
        </script>


        <!-- B3 수명 차트 -->
        <div class="con_box flex3">
            <h2><p>B3 수명</p></h2>
            <div id="chart_bar" style="height: 280px;"></div>
        </div>

        <script>
    $(document).ready(function () {
        var equipmentType = "DS";

        $.ajax({
            url: '@Url.Action("GetB3HistogramEquipment", "EquipmentAlgorithm")',
            type: 'GET',
            data: { equipmentType: equipmentType },
            dataType: 'json',
            success: function (res) {
                if (res.error) {
                    console.warn("오류:", res.error);
                    return;
                }
                console.log("B3 Histogram 데이터:", res);

                var b3 = res.B3;
                var binSize = res.BinSize;
                var timeMax = res.TimeMax;
                var histogram = res.Histogram;

                $("#chart_bar").dxChart({
                    dataSource: histogram,
                    commonSeriesSettings: {
                        type: 'bar',
                        argumentField: 'binStart',
                        valueField: 'count'
                    },
                    series: [{ name: "장비 수" }],
                    legend: { visible: false },
                    title: "(B3 수명 = " + b3 + ")",
                    tooltip: {
                        enabled: true,
                        customizeTooltip: function(arg) {
                            var start = arg.point.data.binStart;
                            var end = start + binSize;
                            return {
                                text: "구간: " + start + "~" + end + "년, 장비수: " + arg.value
                            };
                        }
                    },
                    argumentAxis: {
                        visualRange: [0, timeMax],
                        tickInterval: binSize,
                        title: "사용 기간 (년)",
                        label: {
                            customizeText: function () {
                                return this.value + "년";
                            }
                        }
                    },
                    valueAxis: {
                        title: "장비 대수"
                    },
                    annotations: [
                        {
                            type: "line",
                            axis: "argumentAxis",
                            value: b3,
                            text: "B3 = " + b3
                        }
                    ]
                });
            },
            error: function (xhr, status, error) {
                console.error("B3 히스토그램 로드 실패:", error);
            }
        });
    });
        </script>

        <!--설비들-->
        <div class="con_box flexSeolbi">
            <!-- 타이틀 -->
            <h2>
                <p>설비들</p>
                <p class="schedule_value">
                    <span class="verygoodDevice">V-Good</span>
                    <span class="goodDevice">Good</span>
                    <span class="fairDevice">Fair</span>
                    <span class="badDevice">Bad</span>
                    <span class="verybadDevice">V-Bad</span>
                </p>
            </h2>
            <!-- //타이틀 -->
            <!-- 리스트 -->
            <ul id="deviceList" class="box_system">
                <!-- 이곳에 AJAX로 동적 생성 -->
            </ul>
            <!-- //리스트 -->
            <script>
                $(document).ready(function () {
                    $.ajax({
                        type: "GET",
                        url: "/DSDevice/GetBasicInfoList",
                        dataType: "json",
                        success: function (data) {
                            var $deviceList = $("#deviceList");
                            $deviceList.empty();

                            data.forEach(function (item) {
                                // HI 값 (1~5)
                                var hi = parseInt(item.HI) || 0; // 혹시 null이면 0 처리

                                // HI에 따른 CSS 클래스 + 텍스트 결정
                                var cssClass = "";
                                var statusText = "";
                                switch (hi) {
                                    case 1:
                                        cssClass = "verygoodDevice";
                                        statusText = "Good";
                                        break;
                                    case 2:
                                        cssClass = "goodDevice";
                                        statusText = "Good";
                                        break;
                                    case 3:
                                        cssClass = "fairDevice";
                                        statusText = "Fair";
                                        break;
                                    case 4:
                                        cssClass = "badDevice";
                                        statusText = "Bad";
                                        break;
                                    case 5:
                                        cssClass = "verybadDevice";
                                        statusText = "Bad";
                                        break;
                                    default:
                                        cssClass = "unknown";
                                        statusText = "Unknown";
                                        break;
                                }

                                // 항상 5개 동그라미. HI 이하인 경우만 on 클래스로 색칠
                                var totalDots = 5;
                                var spansHtml = "";
                                for (var i = 1; i <= totalDots; i++) {
                                    if (i <= hi) {
                                        spansHtml += '<span class="on"></span>';
                                    } else {
                                        spansHtml += '<span></span>';
                                    }
                                }

                                // 사용기간(년) 계산 (가동일 기준)
                                var usageYear = "0년";
                                if (item.Operating_Date) {
                                    var operating = new Date(item.Operating_Date);
                                    var now = new Date();
                                    var diffYear = now.getFullYear() - operating.getFullYear();
                                    usageYear = diffYear + "년";
                                }

                                // li 항목 HTML 생성
                                var liHtml = ''
                                    + '<li>'
                                    + '  <a href="/DSDeviceDetail/DSDeviceDetail?dsCode=' + encodeURIComponent(item.DS_Code) + '" '
                                    + '     style="display:block; text-decoration:none; color:inherit;">'
                                    + '    <dl class="product_info">'
                                    + '      <dt>시리얼번호</dt>'
                                    + '      <dd>' + (item.Serial_No || "") + '</dd>'
                                    + '      <dt>설치일</dt>'
                                    + '      <dd>' + (item.Install_Date || "") + '</dd>'
                                    + '      <dt>가동일</dt>'
                                    + '      <dd>' + (item.Operating_Date || "") + '</dd>'
                                    + '      <dt>사용기간</dt>'
                                    + '      <dd>' + usageYear + '</dd>'
                                    + '    </dl>'
                                    + '    <div class="result ' + cssClass + '">'
                                    + '      ' + spansHtml
                                    + '      <p class="result_txt">' + statusText + '</p>'
                                    + '    </div>'
                                    + '  </a>'
                                    + '</li>';

                                $deviceList.append(liHtml);
                            });
                        },
                        error: function (xhr, status, error) {
                            console.error("Error fetching device list:", error);
                        }
                    });
                });
            </script>

        </div>
