
@model AMS_MVC.Models.COFModel
<!--############### CoF 입력 ###############-->
<div class="basic_wrap">
    <h3>CoF 입력값</h3>
    <div class="box">
        <table>
            <tr>
                <th>정전 시간 (h)</th>
                <td>
                    @Html.TextBoxFor(m => m.Power_Failure_Time, new { type = "number", step = "any", @class = "w100" })
                </td>
                <th>정전 비용 ($/kWh)</th>
                <td>
                    @Html.TextBoxFor(m => m.Power_Failure_Cost, new { type = "number", step = "any", @class = "w100" })
                </td>
            </tr>
            <tr>
                <th>정전 확률 (%)</th>
                <td>
                    @Html.TextBoxFor(m => m.Probability_Of_Power_Failure, new { type = "number", step = "any", @class = "w100" })
                </td>
                <th>용량 (kW)</th>
                <td>
                    @Html.TextBoxFor(m => m.Capacity, new { type = "number", step = "any", @class = "w100" })
                </td>
            </tr>
            <tr>
                <th>역률 (%)</th>
                <td>
                    @Html.TextBoxFor(m => m.Power_Factor, new { type = "number", step = "any", @class = "w100" })
                </td>
                <th>계수</th>
                <td>
                    @Html.TextBoxFor(m => m.Coefficient, new { type = "number", step = "any", @class = "w100" })
                </td>
            </tr>
            <tr>
                <th>평균 이용률 (%)</th>
                <td>
                    @Html.TextBoxFor(m => m.Average_Utilization_Rate, new { type = "number", step = "any", @class = "w100" })
                </td>
                <th>설비 복구 시간 (h)</th>
                <td>
                    @Html.TextBoxFor(m => m.Facility_Recovery_Time, new { type = "number", step = "any", @class = "w100" })
                </td>

            </tr>
            <tr>
                <th>정격 전압 (kV)</th>
                <td>
                    @Html.TextBoxFor(m => m.Rated_Voltage, new { type = "number", step = "any", @class = "w100" })
                </td>
                <th>평균 전력 판매비용 ($/kWh)</th>
                <td>
                    @Html.TextBoxFor(m => m.Average_Electricity_Sales_Cost, new { type = "number", step = "any", @class = "w100" })
                </td>
            </tr>

            <tr>
                <th>선로 길이 (km)</th>
                <td>
                    @Html.TextBoxFor(m => m.Track_Length, new { type = "number", step = "any", @class = "w100" })
                </td>
                <th>교체 확률 (%)</th>
                <td>
                    @Html.TextBoxFor(m => m.Replacement_Probability, new { type = "number", step = "any", @class = "w100" })
                </td>
            </tr>
            <tr>
                <th>설비 단가 ($)</th>
                <td>
                    @Html.TextBoxFor(m => m.Equipment_Unit_Price, new { type = "number", step = "any", @class = "w100" })
                </td>
                <th>도급 비용 ($)</th>
                <td>
                    @Html.TextBoxFor(m => m.Facility_Contracting_Cost, new { type = "number", step = "any", @class = "w100" })
                </td>
            </tr>

            <tr>
                <th>긴급 공사 할증률 (%)</th>
                <td>
                    @Html.TextBoxFor(m => m.Emergency_Construction_Surcharge_Rate, new { type = "number", step = "any", @class = "w100" })
                </td>
                <th>안전사고 확률[일반] (%)</th>
                <td>
                    @Html.TextBoxFor(m => m.General_Accident, new { type = "number", step = "any", @class = "w100" })
                </td>
            </tr>

            <tr>
                <th>안전사고 확률[사망] (%)</th>
                <td>
                    @Html.TextBoxFor(m => m.Dead_Accident, new { type = "number", step = "any", @class = "w100" })
                </td>
                <th>사고 보상비용[일반] ($)</th>
                <td>
                    @Html.TextBoxFor(m => m.General_Cost, new { type = "number", step = "any", @class = "w100" })
                </td>
            </tr>
            <tr>
                <th>사고 보상비용[사망] ($)</th>
                <td>
                    @Html.TextBoxFor(m => m.Dead_Cost, new { type = "number", step = "any", @class = "w100" })
                </td>
                <th>안전 민감 계수</th>
                <td>
                    @Html.TextBoxFor(m => m.Safety_Sensitivity_Cost, new { type = "number", step = "any", @class = "w100" })
                </td>
            </tr>

            <tr>
                <th>절연유 유출면적 (㎥)</th>
                <td>
                    @Html.TextBoxFor(m => m.Insulation_Oil_Area, new { type = "number", step = "any", @class = "w100" })
                </td>
                <th>환경 보상비용 (원/㎥)</th>
                <td>
                    @Html.TextBoxFor(m => m.Cost, new { type = "number", step = "any", @class = "w100" })
                </td>
            </tr>
            <tr>
                <th>환경 오염 확률 (%)</th>
                <td>
                    @Html.TextBoxFor(m => m.Environmental_Pollution, new { type = "number", step = "any", @class = "w100" })
                </td>
                <th>위치 가중치</th>
                <td>
                    @Html.TextBoxFor(m => m.Position_Weight, new { type = "number", step = "any", @class = "w100" })
                </td>
            </tr>
        </table>
    </div>       
</div>