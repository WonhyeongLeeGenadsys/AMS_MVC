@model AMS_MVC.Models.COFModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section LeftMenu {
    @Html.Partial("_SettingMenu")
}

@section MainContent {
    <h1>CoF 정보 등록</h1>

    @using (Html.BeginForm("CofInfo", "Setting", FormMethod.Post, new { id = "cofForm" }))
    {
        @Html.AntiForgeryToken()

        <div class="con_box">
            <div class="content_warp">

                <!-- 장비 선택 -->
                <div class="equipment-wrap">
                    <label for="Code" class="equipment-label">장비 선택</label>
                    @Html.DropDownListFor(
                        m => m.Code,
                        (SelectList)ViewBag.EquipmentTypes,
                        "-- 장비 선택 --",
                        new { id = "Code", @class = "equipment-select" }
                    )
                </div>

                <!-- 적용 버튼 -->
                <div class="btn_area top right">
                    <button type="submit" class="btn blue app">적용</button>
                </div>

                <div class="interface_wrap">

                    <!-- CoF 입력 (Partial) -->
                    @Html.Partial("_CofInputs", Model)

                    <!-- 계산 결과 -->
                    <div class="basic_wrap">
                        <h3>계산 결과</h3>
                        <div class="box">
                            <table>
                                <tr>
                                    <th>고객 정전 비용 ($)</th>
                                    <td>@Html.TextBoxFor(m => m.Customer_Power_Outage_Cost, new { @class = "w100", @readonly = "readonly" })</td>
                                </tr>
                                <tr>
                                    <th>계통 손실 비용 ($)</th>
                                    <td>@Html.TextBoxFor(m => m.System_Loss_Cost, new { @class = "w100", @readonly = "readonly" })</td>
                                </tr>
                                <tr>
                                    <th>설비 복구 비용 ($)</th>
                                    <td>@Html.TextBoxFor(m => m.Facility_Recovery_Cost, new { @class = "w100", @readonly = "readonly" })</td>
                                </tr>
                                <tr>
                                    <th>전력판매 수익 손실 ($)</th>
                                    <td>@Html.TextBoxFor(m => m.Loss_Of_Profit, new { @class = "w100", @readonly = "readonly" })</td>
                                </tr>
                                <tr>
                                    <th>안전사고 보상 ($)</th>
                                    <td>@Html.TextBoxFor(m => m.Safety_Accident_Compensation_1, new { @class = "w100", @readonly = "readonly" })</td>
                                </tr>
                                <tr>
                                    <th>환경사고 보상 ($)</th>
                                    <td>@Html.TextBoxFor(m => m.Safety_Accident_Compensation_2, new { @class = "w100", @readonly = "readonly" })</td>
                                </tr>
                                <tr>
                                    <th>최종 COF 합산값</th>
                                    <td>@Html.TextBoxFor(m => m.Total_Cof, new { @class = "w100", @readonly = "readonly" })</td>
                                </tr>
                            </table>
                        </div>
                    </div>

                </div>  <!-- .interface_wrap -->
            </div>      <!-- .content_warp -->
        </div> <!-- .con_box -->
    }
}

@section Scripts {
    <script>
$(function() {
  // 천단위 쉼표 + 소수점 2자리
  $('input[type="text"]').not('[readonly]').on('input', function() {
    var raw = $(this).val().replace(/[^0-9.]/g, '');
    var fixed = parseFloat(raw || 0).toFixed(2);
    $(this).val(fixed.replace(/\B(?=(\d{3})+(?!\d))/g, ","));
  });

$('#Code').change(function() {
  $.getJSON('@Url.Action("GetCoFData","Setting")', { code: this.value })
   .done(function(data) {
     $.each(data, function(key, val) {
       var $el = $('[name="' + key + '"]');
       if (!$el.length) return;

       // — 안전사고 확률[일반] & [사망] 은 소수점 9자리 고정
       if (key==='General_Accident' || key==='Dead_Accident') {
         var num = parseFloat(val);
         $el.val(isNaN(num) ? '' : num.toFixed(9));
       }
       // — 입력 필드: 소수점 2자리 + 쉼표
       else if ($el.is('input[type="text"]') && !$el.is('[readonly]')) {
         var v2 = parseFloat(val||0).toFixed(2);
         $el.val(v2.replace(/\B(?=(\d{3})+(?!\d))/g, ","));
       }
       // — 계산 결과: 2자리 + 쉼표
       else if ($el.is('[readonly]')) {
         var r2 = parseFloat(val||0).toFixed(2);
         $el.val(r2.replace(/\B(?=(\d{3})+(?!\d))/g, ","));
       }
     });
   });
});

  // — text 필드에서 쉼표 제거 13,000 >> 130000
  $('#cofForm').submit(function() {
    $(this).find('input[type="text"]').each(function() {
      // readonly 필드는 서버로 전달되지 않으니 skip 가능
      if ($(this).is('[readonly]')) return;
      $(this).val($(this).val().replace(/,/g, ''));
    });
  });

  // — 초기 로드 시에도 데이터 바인딩/ 이거 안하면 초기값 설정된 소수점 6자리로 표기되어서 로딩 해줘야함!
  $('#Code').trigger('change');
});
    </script>
}


}
