@model AMS_MVC.Models.COFModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var isExisting = Model != null && Model.Tbl_Idx != 0;
    var btnText = isExisting ? "변경" : "적용";
}

@section LeftMenu { @Html.Partial("_SettingMenu") }

@section MainContent {
    <h1>CoF 정보 등록</h1>

    @if (TempData["SaveInfo"] != null)
    {
        <div class="alert alert-info">@TempData["SaveInfo"]</div>
    }

    @using (Html.BeginForm("CofInfo", "Setting", FormMethod.Get, new { id = "codeForm" }))
    {
        <div class="equipment-wrap" style="margin-bottom:12px">
            <label for="Code" class="equipment-label">장비 선택</label>
            @Html.DropDownListFor(
                m => m.Code,                                  
                (SelectList)ViewBag.EquipmentTypes,
                "-- 장비 선택 --",
                new { @class = "equipment-select", onchange = "this.form.submit()" }
            )
        </div>
    }

    <!-- 저장/변경: POST -->
    @using (Html.BeginForm("CofInfo", "Setting", FormMethod.Post, new { id = "cofForm" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Code) <!-- 현재 코드 유지 -->
        @Html.HiddenFor(m => m.Tbl_Idx) <!-- 있으면 UPDATE, 없으면 INSERT -->

        <div class="con_box">
            <div class="content_warp">
                <div class="btn_area top right">
                    <button type="submit" class="btn blue app">@btnText</button>
                </div>

                <div class="interface_wrap">
                    <!-- 입력 -->
                    @Html.Partial("_CofInputs", Model)

                    <!-- 결과 -->
                    <div class="basic_wrap">
                        <h3>계산 결과</h3>
                        <div class="box">
                            <table>
                                <tr><th>고객 정전 비용 ($)</th><td>@Html.TextBoxFor(m => m.Customer_Power_Outage_Cost, "{0:N2}", new { @class = "w100", @readonly = "readonly" })</td></tr>
                                <tr><th>계통 손실 비용 ($)</th><td>@Html.TextBoxFor(m => m.System_Loss_Cost, "{0:N2}", new { @class = "w100", @readonly = "readonly" })</td></tr>
                                <tr><th>설비 복구 비용 ($)</th><td>@Html.TextBoxFor(m => m.Facility_Recovery_Cost, "{0:N2}", new { @class = "w100", @readonly = "readonly" })</td></tr>
                                <tr><th>전력판매 수익 손실 ($)</th><td>@Html.TextBoxFor(m => m.Loss_Of_Profit, "{0:N2}", new { @class = "w100", @readonly = "readonly" })</td></tr>
                                <tr><th>안전사고 보상 ($)</th><td>@Html.TextBoxFor(m => m.Safety_Accident_Compensation_1, "{0:N2}", new { @class = "w100", @readonly = "readonly" })</td></tr>
                                <tr><th>환경사고 보상 ($)</th><td>@Html.TextBoxFor(m => m.Safety_Accident_Compensation_2, "{0:N2}", new { @class = "w100", @readonly = "readonly" })</td></tr>
                                <tr><th>최종 COF 합산값</th><td>@Html.TextBoxFor(m => m.Total_Cof, "{0:N2}", new { @class = "w100", @readonly = "readonly" })</td></tr>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
}
