                고장
                @*<a href="javacript:void(0);" class="btn_more">더보기</a>*@
            </h2>
            <!--//타이틀-->
            <!--그리드-->
            <div id="gridContainer02" class="grid_wrap" style="height: 400px;"></div>
            <!--//그리드-->
            <script type="text/javascript">
                // .NET Date 형식("/Date(숫자)/")를 JavaScript Date 객체로 변환하는 함수
                function parseDotNetDate(dotNetString) {
                    var match = /Date\((\d+)\)/.exec(dotNetString);
                    if (match) {
                        var timestamp = parseInt(match[1], 10);
                        return new Date(timestamp);
                    }
                    return null;
                }

                // Key/Value 쌍 배열을 일반 객체로 변환하는 함수
                function transformData(rawArray) {
                    return rawArray.map(function (itemArray) {
                        var obj = {};
                        itemArray.forEach(function (pair) {
                            // Date 필드 처리: "Date" 키에 해당하는 값은 파싱하여 Date 객체로 변환
                            if (pair.Key === 'Date' && typeof pair.Value === 'string') {
                                obj[pair.Key] = parseDotNetDate(pair.Value);
                            } else {
                                obj[pair.Key] = pair.Value;
                            }
                        });
                        return obj;
                    });
                }

                // 예: 고장 데이터를 가져와서 dxDataGrid에 적용하는 예제
                $(document).ready(function () {
                    $.ajax({
                        type: "POST",
                        url: "/TotalInfo/GetGojangList",
                        contentType: "application/json; charset=utf-8",
                        dataType: "json"
                    })
                        .done(function (response) {
                            // response는 [ [ {Key, Value}, ... ], [ {Key, Value}, ... ], ... ]
                            var transformed = transformData(response);
                            console.log("변환된 데이터:", transformed);

                            // dxDataGrid에 변환된 데이터를 dataSource로 적용
                            $("#gridContainer02").dxDataGrid({
                                dataSource: transformed,
                                columns: [
                                    { dataField: 'Priority', caption: '우선순위', alignment: 'center' },
                                    { dataField: 'Code', caption: '코드', alignment: 'center' },
                                    { dataField: 'Name', caption: '설비명', alignment: 'center' },
                                    { dataField: 'Serial_No', caption: '시리얼번호', alignment: 'center' },
                                    { dataField: 'Weather', caption: '날씨', alignment: 'center' },
                                    { dataField: 'Temp', caption: '온도(°C)', alignment: 'center' },
                                    { dataField: 'Hum', caption: '습도(%)', alignment: 'center' },
                                    { dataField: 'Reason', caption: '발견동기', alignment: 'center' },
                                    { dataField: 'Status', caption: '상태', alignment: 'center' },
                                    { dataField: 'Part', caption: '부품', alignment: 'center' },
                                    { dataField: 'Period', caption: '기간', alignment: 'center' },
                                    { dataField: 'Finder', caption: '발견자', alignment: 'center' },
                                    {
                                        dataField: 'Date',
                                        caption: '고장일',
                                        alignment: 'center',
                                        dataType: 'date'  // Date 객체로 전달된 경우 날짜 형식으로 렌더링
                                    }
                                ],
                                showBorders: true,
                                sorting: { mode: 'multiple' },
                                scrolling: { columnRenderingMode: 'virtual' }
                            });
                        })
                        .fail(function (xhr, status, error) {
                            console.error("데이터 로드 중 오류:", error);
                        });
                });
            </script>

        </div>
        <!--고장-->
    </div>
