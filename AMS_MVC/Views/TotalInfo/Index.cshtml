        @*우선순위*@
        <script type="text/javascript">
            $(document).ready(function () {
                // 서버에서 우선순위 데이터를 가져오는 함수
                function fetchPriorityInfo() {
                    return $.ajax({
                        type: "POST",
                        url: "/TotalInfo/GetPriorityInfo",
                        contentType: "application/json; charset=utf-8",
                        dataType: "json"
                    });
                }

                // 데이터를 가져와 DataGrid에 적용
                fetchPriorityInfo()
                    .done(function (response) {
                        const priorityData = response;
                        console.log("우선순위 데이터:", priorityData);
                        initializePriorityGrid(priorityData);
                    })
                    .fail(function (xhr, status, error) {
                        console.error("Ajax Error:", error);
                        alert("우선순위 데이터를 가져오는 중 오류가 발생했습니다.");
                    });

                // DataGrid 초기화 함수
                function initializePriorityGrid(data) {
                    $('#gridContainer').dxDataGrid({
                        dataSource: data,
                        columnFixing: { enabled: true },
                        showBorders: true,
                        sorting: { mode: 'multiple' },
                        scrolling: { columnRenderingMode: 'virtual' },
                        height: 200,

                        // **첫 번째 행 테두리 적용**
                        onRowPrepared: function (e) {
                            if (e.rowType === 'data' && e.rowIndex === 0) {
                                e.rowElement.addClass('first-row-highlight');
                            }
                        },

                        onCellPrepared: function (e) {
                            if (e.rowType === 'data' && e.column.dataField === 'HI') {
                                var hi = e.value;
                                var cls = '';
                                switch (hi) {
                                    case 1: cls = 'priorityVerygood'; break;
                                    case 2: cls = 'priorityGood'; break;
                                    case 3: cls = 'priorityFair'; break;
                                    case 4: cls = 'priorityPoor'; break;
                                    case 5: cls = 'priorityVerypoor'; break;
                                }
                                if (cls) {
                                    e.cellElement.addClass(cls);
                                }
                            }
                        },

                        columns: [
                            { dataField: 'Priority', caption: '우선순위', alignment: 'center' },
                            { dataField: 'Sort', caption: '구분', alignment: 'center' },
                            { dataField: 'Name', caption: '설비명', alignment: 'center' },
                            { dataField: 'Serial_No', caption: '시리얼번호', alignment: 'center' },
                            { dataField: 'Install_Date', caption: '설치일', alignment: 'center', dataType: 'date' },
                            { dataField: 'Operating_Date', caption: '운영일', alignment: 'center', dataType: 'date' },
                            { dataField: 'UsagePeriod', caption: '사용기간(년)', alignment: 'center' },
                            { dataField: 'CoF', caption: 'CoF($)', alignment: 'center' },
                            { dataField: 'PoF', caption: 'PoF(%)', alignment: 'center' },
                            {
                                dataField: 'HI',
                                caption: 'HI',
                                alignment: 'center',
                                dataType: 'number'
                            }
                        ],
                        showBorders: true,
                        sorting: {
                            mode: 'multiple',
                        },
                        scrolling: { columnRenderingMode: 'virtual' }
                    });
                }
            });
        </script>
        @*//우선순위*@

        @*고장이력*@
        <script type="text/javascript">
            // .NET Date 형식("/Date(숫자)/")를 JavaScript Date 객체로 변환하는 함수
            function parseDotNetDate(dotNetString) {
                var match = /Date\((\d+)\)/.exec(dotNetString);
                if (match) {
                    var timestamp = parseInt(match[1], 10);
                    return new Date(timestamp);
                }
                return null;
            }

            // Key/Value 쌍 배열을 일반 객체로 변환하는 함수
            function transformData(rawArray) {
                return rawArray.map(function (itemArray) {
                    var obj = {};
                    itemArray.forEach(function (pair) {
                        // Date 필드 처리: "Date" 키에 해당하는 값은 파싱하여 Date 객체로 변환
                        if (pair.Key === 'Date' && typeof pair.Value === 'string') {
                            obj[pair.Key] = parseDotNetDate(pair.Value);
                        } else {
                            obj[pair.Key] = pair.Value;
                        }
                    });
                    return obj;
                });
            }

            $(document).ready(function () {
                $.ajax({
                    type: "POST",
                    url: "/TotalInfo/GetGojangList",
                    contentType: "application/json; charset=utf-8",
                    dataType: "json"
                })
                    .done(function (response) {
                        // response는 [ [ {Key, Value}, ... ], [ {Key, Value}, ... ], ... ]
                        var transformed = transformData(response);
                        console.log("변환된 데이터:", transformed);

                        $("#gridContainer02").dxDataGrid({
                            dataSource: transformed,
                            showBorders: true,
                            sorting: { mode: 'multiple' },
                            scrolling: { columnRenderingMode: 'virtual' },

                            onRowPrepared: function (e) {
                                if (e.rowType === 'data' && e.rowIndex === 0) {
                                    e.rowElement.addClass('first-row-highlight');
                                }
                            },
                            columns: [
                                { dataField: 'Priority', caption: '우선순위', alignment: 'center' },
                                { dataField: 'Code', caption: '코드', alignment: 'center' },
                                { dataField: 'Name', caption: '설비명', alignment: 'center' },
                                { dataField: 'Serial_No', caption: '시리얼번호', alignment: 'center' },
                                { dataField: 'Weather', caption: '날씨', alignment: 'center' },
                                { dataField: 'Temp', caption: '온도(°C)', alignment: 'center' },
                                { dataField: 'Hum', caption: '습도(%)', alignment: 'center' },
                                { dataField: 'Reason', caption: '발견동기', alignment: 'center' },
                                { dataField: 'Status', caption: '상태', alignment: 'center' },
                                { dataField: 'Part', caption: '부품', alignment: 'center' },
                                { dataField: 'Period', caption: '기간', alignment: 'center' },
                                { dataField: 'Finder', caption: '발견자', alignment: 'center' },
                                {
                                    dataField: 'Date',
                                    caption: '고장일',
                                    alignment: 'center',
                                    dataType: 'date'
                                }
                            ],
                            showBorders: true,
                            sorting: { mode: 'multiple' },
                            scrolling: { columnRenderingMode: 'virtual' }
                        });
                    })
                    .fail(function (xhr, status, error) {
                        console.error("데이터 로드 중 오류:", error);
                    });
            });
        </script>

