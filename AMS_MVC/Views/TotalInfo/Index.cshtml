        <script>
$(function(){
  // 1~5 HI 순서대로 들어갈 색
  const hiPalette = [
    '#5B9F56',  // 1등급
    '#B4DEB1',  // 2등급
    '#EBCD1D',  // 3등급
    '#F18425',  // 4등급
    '#F05153'   // 5등급
  ];


  // rawCounts = { "1": "2", "3": "1", … }
  function summarizeHIData(data) {
    return [1,2,3,4,5]
      .filter(hi => (data[hi]||0) > 0)
      .map(hi => ({
        hi:    hi,                  // HI 값
        state: hi + '등급',
        value: parseInt(data[hi], 10),
        color: hiPalette[hi - 1]    // HI-1 인덱스로 색 지정
      }));
  }

    function initializePieChart(selector, rawCounts) {
        const ds = summarizeHIData(rawCounts);

        $(selector).dxPieChart({
            type: 'doughnut',
            dataSource: ds,
            customizePoint: pointInfo => ({ color: pointInfo.data.color }),
            series: [{
                argumentField: 'state',
                valueField: 'value',
                label: {
                    visible: true,                  // 라벨 보이기
                    connector: { visible: true },   // 연결선 보이기
                    customizeText: e => e.valueText + '대'
                }
            }],
            legend: {
                visible: true ,  // 범례는 숨김
                   verticalAlignment: 'bottom',
                horizontalAlignment: 'center',
            },
            size: { width: '100%', height: 300 },
            innerRadius: 0.5
        });
    }

  function setupChart(selector, group) {
    $.ajax({
      type: 'POST',
      url: '@Url.Action("GetRiskmatrixData","TotalInfo")',
      data: JSON.stringify({ prefix: group }),
      contentType: 'application/json; charset=utf-8',
      dataType: 'json'
    })
    .done(counts => initializePieChart(selector, counts))
    .fail(err => console.error(group + ' 차트 로드 실패:', err));
  }

  setupChart('#pieAll', null);    // all five
  //setupChart('#pieAC',  'AC');    // VCB + ITR
  //setupChart('#pieDC',  'DC');    // DCCB + DCCABLE + SUBMODULE
});
        </script>

