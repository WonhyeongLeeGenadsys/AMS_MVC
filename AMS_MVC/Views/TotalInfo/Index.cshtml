    <script>
        window.totalInfoDataHub = (function ($) {
            const urls = {
                risk: '@Url.Action("GetRiskMapPoints", "TotalInfo")',
                history: '@Url.Action("GetHIPofCofHistory", "TotalInfo")',
                dm: '@Url.Action("GetDMDecisionInfo", "TotalInfo")'
            };
            const entries = { risk: {}, history: {}, dm: {} };
            let activePrefix = '';

            function normalizePrefix(prefix) {
                const value = String(prefix || '').toUpperCase();
                return value === 'ALL' ? '' : value;
            }

            function start(kind, prefix, entry) {
                if (!entry || entry.started) return;

                entry.started = true;
                loadUsdKrwRate().always(function () {
                    $.getJSON(urls[kind], { prefix: prefix })
                        .done(data => entry.deferred.resolve(data))
                        .fail(xhr => {
                            entry.deferred.reject(xhr);
                            delete entries[kind][prefix];
                        });
                });
            }

            function request(kind, prefix) {
                const key = normalizePrefix(prefix);
                let entry = entries[kind][key];

                if (!entry) {
                    entry = entries[kind][key] = {
                        deferred: $.Deferred(),
                        started: false
                    };
                }

                if (key === activePrefix) {
                    start(kind, key, entry);
                }

                return entry.deferred.promise();
            }

            function activate(prefix) {
                activePrefix = normalizePrefix(prefix);
                start('risk', activePrefix, entries.risk[activePrefix]);
                start('history', activePrefix, entries.history[activePrefix]);
                start('dm', activePrefix, entries.dm[activePrefix]);
            }

            return {
                activate: activate,
                getRiskPoints: prefix => request('risk', prefix),
                getHistory: prefix => request('history', prefix),
                getDm: prefix => request('dm', prefix)
            };
        })(jQuery);
    </script>

    <script>
        window.dmV31Lazy = (function ($) {
            const loaders = Object.create(null);
            const requested = Object.create(null);
            const loaded = Object.create(null);

            function run(name) {
                requested[name] = true;
                if (loaded[name] || !loaders[name]) return;

                try {
                    loaders[name]();
                    loaded[name] = true;
                } catch (error) {
                    loaded[name] = false;
                    console.error('DM 상세분석 초기화 실패:', name, error);
                }
            }

            function register(name, loader) {
                loaders[name] = loader;
                if (requested[name]) run(name);
            }

            function activatePanel(panelId) {
                if (panelId === 'dmV31Overview') run('decision');
                if (panelId === 'dmV31Condition') {
                    run('decision');
                    run('advanced');
                }
                if (panelId === 'dmV31Economy') {
                    run('decision');
                    run('advanced');
                }
                if (panelId === 'dmV31Spare') run('spare');
                if (panelId === 'dmV31Explain') run('advanced');
            }

            $(function () {
                const dashboard = document.querySelector('.dm-v31-dashboard');
                if (!dashboard) return;

                if (!window.IntersectionObserver) {
                    activatePanel('dmV31Overview');
                    return;
                }

                const observer = new IntersectionObserver(function (entries) {
                    if (!entries.some(entry => entry.isIntersecting)) return;
                    observer.disconnect();
                    activatePanel('dmV31Overview');
                }, { rootMargin: '180px 0px' });

                observer.observe(dashboard);
            });

            return {
                register: register,
                activatePanel: activatePanel
            };
        })(jQuery);
    </script>

