            <script>
                $(document).ready(function () {
                    // 서버에서 데이터를 가져오는 함수
                    function fetchRiskMatrixData() {
                        return $.ajax({
                            type: "POST",
                            url: "/TotalInfo/GetRiskMatrixPofCof",
                            contentType: "application/json; charset=utf-8",
                            dataType: "json"
                        });
                    }
