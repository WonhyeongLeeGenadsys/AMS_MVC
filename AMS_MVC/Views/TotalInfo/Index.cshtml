@{
    Layout = "~/Views/Shared/_Layout.cshtml";

}

@section LeftMenu {
    @Html.Partial("_TotalInfoMenu")
}

@section MainContent {
    <h1>
        종합정보
        <a href="javascript:openPop('/Location/Index','900','600')" class="btn blue map tooltip" data-tooltip="전남 나주시 혁신산단5길 동수동 405-8">위치보기</a>
    </h1>
    <!--전체 박스-->
    <div class="box_wrap">
        <!--건전도-->
        <div class="con_box">
            <!--타이틀-->
            <h2>건전도</h2>
            <!--//타이틀-->
            <ul class="chart">
                <li>
                    <!--그래프-->
                    <div id="pie01" class="chart_box"></div>
                    <!--//그래프-->
                    <!--그래프 타이틀-->
                    <div class="title">AC-VCB</div>
                </li>
                <li>
                    <div id="pie02" class="chart_box"></div>
                    <div class="title">AC-Interface TR</div>
                </li>
                <li>
                    <div id="pie03" class="chart_box"></div>
                    <div class="title">DC-Sub Module</div>
                </li>
                <li>
                    <div id="pie04" class="chart_box"></div>
                    <div class="title">DC-DCCB</div>
                </li>
                <li>
                    <div id="pie05" class="chart_box"></div>
                    <div class="title">DC-DC Cable</div>
                </li>
            </ul>
            <ul class="valuee">
                <li><span class="verygood"></span><strong>1등급</strong></li>
                <li><span class="good"></span><strong>2등급</strong></li>
                <li><span class="fair"></span><strong>3등급</strong></li>
                <li><span class="poor"></span><strong>4등급</strong></li>
                <li><span class="verypoor"></span><strong>5등급</strong></li>
            </ul>
        </div>

        <script>
$(function(){
  // 1~5 HI 순서대로 들어갈 색
  const hiPalette = [
    '#5B9F56',  // 1등급
    '#B4DEB1',  // 2등급
    '#EBCD1D',  // 3등급
    '#F18425',  // 4등급
    '#F05153'   // 5등급
  ];

  // rawCounts = { "1": "2", "3": "1", … }
  function summarizeHIData(data) {
    return [1,2,3,4,5]
      .filter(hi => (data[hi]||0) > 0)
      .map(hi => ({
        hi:    hi,                  // HI 값
        state: hi + '등급',
        value: parseInt(data[hi], 10),
        color: hiPalette[hi - 1]    // HI-1 인덱스로 색 지정
      }));
  }

    function initializePieChart(selector, rawCounts) {
        const ds = summarizeHIData(rawCounts);

        $(selector).dxPieChart({
            type: 'doughnut',
            dataSource: ds,
            customizePoint: pointInfo => ({ color: pointInfo.data.color }),
            series: [{
                argumentField: 'state',
                valueField: 'value',
                label: {
                    visible: true,                  // 라벨 보이기
                    connector: { visible: true },   // 연결선 보이기
                    customizeText: e => e.valueText + '대'
                }
            }],
            legend: {
                visible: false   // 범례는 숨김
            },
            size: { width: 270, height: 270 },
            innerRadius: 0.5
        });
    }

  function setupChart(id, prefix) {
    $.ajax({
      type: 'POST',
      url: '@Url.Action("GetRiskmatrixData","TotalInfo")',
      data: JSON.stringify({ prefix }),
      contentType: 'application/json; charset=utf-8',
      dataType: 'json'
    })
    .done(counts => initializePieChart(id, counts))
    .fail(err => console.error(prefix + ' 차트 로드 실패:', err));
  }

  // 5개 차트 모두 세팅
  setupChart('#pie01','VCB');
  setupChart('#pie02','ITR');
  setupChart('#pie03','SUBMODULE');
  setupChart('#pie04','DCCB');
  setupChart('#pie05','DCCABLE');
});
        </script>

        <!--//건전도-->
        <!-- risk matrix -->
        <div class="con_box riskMatrix" style="height:450px; position:relative;">
            <h2>Risk Matrix</h2>
            <div id="chartContainer" style="width:100%; height:100%;"></div>
        </div>

        <style>
            /* 플롯 배경 투명 처리 */
            #chartContainer .dx-chart-plot-area {
                background-color: transparent !important;
            }
        </style>

        <script>
    $(function(){
      $.getJSON('@Url.Action("GetRiskMapPoints","TotalInfo")')
       .done(function(raw){
         const data = raw.map(p => ({
           x: p.x,    // CoF
           y: p.y,    // PoF
           name: p.name,
           group: p.group
         }));

         $("#chartContainer").dxChart({
           dataSource: data,
           commonSeriesSettings: {
             type: "scatter",
             argumentField: "x",
             valueField: "y",
             point: { size: 12 }
           },
           seriesTemplate: { nameField: "group" },

           argumentAxis: {
             visualRange: { startValue: 0, endValue: 40000 },
             tickInterval: 8000,
             grid: { visible: true },
             valueMarginsEnabled: false,
             endOnTick: false,
             title: { text: "CoF (원)" },
             label: { customizeText: e => e.value.toLocaleString() },
             strips: [
               { startValue:    0, endValue:  8000, color: "#00B0F0" },
               { startValue: 8000, endValue: 16000, color: "#92D050" },
               { startValue:16000, endValue:24000, color: "#FFFF00" },
               { startValue:24000, endValue:32000, color: "#F18425" },
               { startValue:32000, endValue:40000, color: "#F05153" }
             ]
           },

           valueAxis: {
             visualRange: { startValue: 0, endValue: 100 },
             tickInterval: 20,
             grid: { visible: true },
             valueMarginsEnabled: false,
             endOnTick: false,
             title: { text: "PoF (%)" },
             label: { customizeText: e => e.value.toFixed(0) + "%" },
             strips: [
               { startValue:   0, endValue:  20, color: "#00B0F0" },
               { startValue:  20, endValue:  40, color: "#92D050" },
               { startValue:  40, endValue:  60, color: "#FFFF00" },
               { startValue:  60, endValue:  80, color: "#F18425" },
               { startValue:  80, endValue: 100, color: "#F05153" }
             ]
           },

           tooltip: {
             enabled: true,
             customizeTooltip: info => {
               const d = info.point.data;
               return {
                 html:
                   `<strong>${d.name}</strong><br/>
                    CoF: ${d.x.toLocaleString()}원<br/>
                    PoF: ${d.y.toFixed(2)}%`
               };
             }
           },

           onPointClick(e) {
             const d = e.target.originalData;
             alert(`코드: ${d.name}\nCoF: ${d.x.toLocaleString()}원\nPoF: ${d.y.toFixed(2)}%`);
           },

           legend: { visible: true, position: "bottom" },
           size: { width: "100%", height: "100%" },
           margin: 0
         });
       });
    });
        </script>


<!--//risk matrix-->
<!--우선순위-->
<div class="con_box wooseon">
    <!--타이틀-->
    <h2>
        우선순위
        @*<a href="javacript:void(0);" class="btn_more">더보기</a>*@
    </h2>
    <!--//타이틀-->
    <!--그리드-->
    <div id="gridContainer" class="grid_wrap" style="height: 250px;"></div>
    <!--//그리드-->
    <script type="text/javascript">
        $(document).ready(function () {
            // 서버에서 우선순위 데이터를 가져오는 함수
            function fetchPriorityInfo() {
                return $.ajax({
                    type: "POST",
                    url: "/TotalInfo/GetPriorityInfo",
                    contentType: "application/json; charset=utf-8",
                    dataType: "json"
                });
            }

            // 데이터를 가져와 DataGrid에 적용
            fetchPriorityInfo()
                .done(function (response) {
                    const priorityData = response;
                    console.log("우선순위 데이터:", priorityData);
                    initializePriorityGrid(priorityData);
                })
                .fail(function (xhr, status, error) {
                    console.error("Ajax Error:", error);
                    alert("우선순위 데이터를 가져오는 중 오류가 발생했습니다.");
                });

            // DataGrid 초기화 함수
            function initializePriorityGrid(data) {
                $('#gridContainer').dxDataGrid({
                    dataSource: data,
                    columnFixing: { enabled: true },
                    showBorders: true,
                    sorting: { mode: 'multiple' },
                    scrolling: { columnRenderingMode: 'virtual' },

                    // **첫 번째 행 테두리 적용**
                    onRowPrepared: function (e) {
                        if (e.rowType === 'data' && e.rowIndex === 0) {
                            e.rowElement.addClass('first-row-highlight');
                        }
                    },

                    onCellPrepared: function (e) {
                        if (e.rowType === 'data' && e.column.dataField === 'HI') {
                            var hi = e.value;
                            var cls = '';
                            switch (hi) {
                                case 1: cls = 'priorityVerygood'; break;
                                case 2: cls = 'priorityGood'; break;
                                case 3: cls = 'priorityFair'; break;
                                case 4: cls = 'priorityPoor'; break;
                                case 5: cls = 'priorityVerypoor'; break;
                            }
                            if (cls) {
                                e.cellElement.addClass(cls);
                            }
                        }
                    },

                    columns: [
                        { dataField: 'Priority', caption: '우선순위', alignment: 'center' },
                        { dataField: 'Sort', caption: '구분', alignment: 'center' },
                        { dataField: 'Name', caption: '설비명', alignment: 'center' },
                        { dataField: 'Serial_No', caption: '시리얼번호', alignment: 'center' },
                        { dataField: 'Install_Date', caption: '설치일', alignment: 'center', dataType: 'date' },
                        { dataField: 'Operating_Date', caption: '운영일', alignment: 'center', dataType: 'date' },
                        { dataField: 'UsagePeriod', caption: '사용기간(년)', alignment: 'center' },
                        { dataField: 'CoF', caption: 'CoF(원)', alignment: 'center' },
                        { dataField: 'PoF', caption: 'PoF(%)', alignment: 'center' },
                        {
                            dataField: 'HI',
                            caption: 'HI',
                            alignment: 'center',
                            dataType: 'number'
                        }
                    ],
                    showBorders: true,
                    sorting: {
                        mode: 'multiple',
                    },
                    scrolling: { columnRenderingMode: 'virtual' }
                });
            }
        });
    </script>
</div>
<!--//우선순위-->

</div>
<!--//전체 박스-->
<!--//컨텐츠가 들어옵니다-->
}