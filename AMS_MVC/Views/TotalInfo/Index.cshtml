@section Scripts {
    <script>
        $(function () {
            const URLS = {
                PRIORITY: '/TotalInfo/GetPriorityInfo',
                GOJANG: '/TotalInfo/GetGojangList',
                SCHEDULE: '/TotalInfo/GetScheduleData',
                DM: '/TotalInfo/GetDMDecisionInfo',
                RISK: '@Url.Action("GetRiskMapPoints", "TotalInfo")',
                HISTORY: '@Url.Action("GetHIPofCofHistory", "TotalInfo")'
            };

            const SUFFIX = {
                '': '',    // 5대 주요장비
                'AC': 'AC',
                'DC': 'DC'
            };

            //  공통 그리드 렌더 함수
            function renderGrid(selector, data, columns, additionalOptions) {
                const gridOptions = {
                    dataSource: data,
                    showBorders: true,
                    sorting: { mode: 'multiple' },
                    scrolling: { columnRenderingMode: 'virtual' },
                    height: 200,
                    onRowPrepared(e) {
                        if (e.rowType === 'data' && e.rowIndex === 0) {
                            e.rowElement.addClass('first-row-highlight');
                        }
                    },
                    onCellPrepared(e) {
                        if (e.rowType === 'data') {
                            // HI 배경색상 입히기
                            if (e.column.dataField === 'HI') {
                                const cls = {
                                    1: 'priorityVerygood',
                                    2: 'priorityGood',
                                    3: 'priorityFair',
                                    4: 'priorityPoor',
                                    5: 'priorityVerypoor',
                                    0: 'priorityUndefined'
                                }[e.value];
                                if (cls) e.cellElement.addClass(cls);
                            }

                            if (e.rowType === 'data') {
                                // START 날짜
                                if (e.column.dataField === 'Start') {
                                    e.cellElement.css({
                                        color: 'green',
                                        'font-weight': 'medium'
                                    });
                                }
                                // END 날짜
                                if (e.column.dataField === 'End') {
                                    e.cellElement.css({
                                        color: 'black',
                                        'font-weight': 'medium'
                                    });
                                }
                                // DueDate
                                if (e.column.dataField === 'DueDate') {
                                    e.cellElement.css({
                                        color: 'red',
                                        'font-weight': 'bold'
                                    });
                                }
                            }
                        }
                    },
                    columns: columns
                };

                if (additionalOptions) {
                    Object.assign(gridOptions, additionalOptions);
                }

                $(selector).dxDataGrid(gridOptions);
            }

            function preparePriorityData(data, prefix) {
                let filtered = Array.isArray(data) ? data : [];

                if (prefix === 'AC') {
                    filtered = filtered.filter(d => d.Sort === 'AC');
                } else if (prefix === 'DC') {
                    filtered = filtered.filter(d => d.Sort === 'DC');
                }

                return filtered.map((item, idx) => ({
                    ...item,
                    Priority: idx + 1
                }));
            }

            //  각 그리드 로드 함수들
            function loadPriority(prefix) {
                const suf = SUFFIX[prefix];
                $.post(URLS.PRIORITY)
                    .done(data => {
                        const filtered = preparePriorityData(data, prefix);

                        renderGrid(
                            '#gridContainer' + suf,
                            filtered,
                            [
                                { dataField: 'Priority', caption: '우선순위', alignment: 'center' },
                                { dataField: 'Sort', caption: '구분', alignment: 'center' },
                                { dataField: 'Name', caption: '설비명', alignment: 'center' },
                                { dataField: 'Serial_No', caption: '시리얼번호', alignment: 'center' },
                                { dataField: 'Install_Date', caption: '설치일', alignment: 'center', dataType: 'date' },
                                { dataField: 'Operating_Date', caption: '가동일', alignment: 'center', dataType: 'date' },
                                { dataField: 'UsagePeriod', caption: '사용기간(년)', alignment: 'center' },
                                { dataField: 'HI', caption: 'HI', alignment: 'center', dataType: 'number' },
                                {
                                    dataField: 'PoF',
                                    caption: 'PoF(%)',
                                    alignment: 'center',
                                    dataType: 'number',
                                    cellTemplate: function (container, options) {
                                        $("<div>")
                                            .text(Number(options.value || 0).toLocaleString('ko-KR'))
                                            .css("font-weight", "bold")
                                            .appendTo(container);
                                    }
                                },
                                {
                                    dataField: 'CoF',
                                    caption: 'CoF(원)',
                                    alignment: 'center',
                                    dataType: 'number',
                                    cellTemplate: function (container, options) {
                                        $("<div>")
                                            .text(formatKrwFromUsd(options.value))
                                            .css("font-weight", "bold")
                                            .appendTo(container);
                                    }
                                },
                                {
                                    caption: 'Risk(원)',
                                    alignment: 'center',
                                    dataType: 'number',
                                    calculateCellValue: function (rowData) {
                                        var riskUsd = (rowData.CoF || 0) * ((rowData.PoF || 0) / 100);
                                        return Math.round(usdToKrw(riskUsd));
                                    },
                                    format: { type: "fixedPoint", precision: 0 }
                                }
                            ]
                        );
                    });
            }

            function loadHistory(prefix) {
                const suf = SUFFIX[prefix];
                $.post(URLS.GOJANG)
                    .done(raw => {
                        let ds = raw;
                        if (prefix === 'AC') {
                            ds = raw.filter(p => p.Code.startsWith('VCB') || p.Code.startsWith('ITR'));
                        } else if (prefix === 'DC') {
                            ds = raw.filter(p => ['DCCB', 'DCCABLE', 'SUBMODULE']
                                .some(pr => p.Code.startsWith(pr)));
                        }

                        const dataSource = ds.map(arr => {
                            const o = {};
                            arr.forEach(p => {
                                if (p.Key === 'Date') {
                                    const m = /Date\((\d+)\)/.exec(p.Value);
                                    o[p.Key] = m ? new Date(+m[1]) : null;
                                } else o[p.Key] = p.Value;
                            });
                            return o;
                        });
                        renderGrid(
                            '#gridContainer02' + suf,
                            dataSource,
                            [
                                { dataField: 'Priority', caption: '우선순위', alignment: 'center' },
                                { dataField: 'Code', caption: '코드', alignment: 'center' },
                                { dataField: 'Name', caption: '설비명', alignment: 'center' },
                                { dataField: 'Serial_No', caption: '시리얼번호', alignment: 'center' },
                                { dataField: 'Weather', caption: '날씨', alignment: 'center' },
                                { dataField: 'Temp', caption: '온도(°C)', alignment: 'center' },
                                { dataField: 'Hum', caption: '습도(%)', alignment: 'center' },
                                { dataField: 'Reason', caption: '발견동기', alignment: 'center' },
                                { dataField: 'Status', caption: '상태', alignment: 'center' },
                                { dataField: 'Part', caption: '부품', alignment: 'center' },
                                { dataField: 'Period', caption: '기간', alignment: 'center' },
                                { dataField: 'Finder', caption: '발견자', alignment: 'center' },
                                {
                                    dataField: 'Date',
                                    caption: '고장일',
                                    alignment: 'center',
                                    dataType: 'date'
                                }
                            ]
                        );
                    });
            }

            function loadSchedule(prefix) {
                const suf = SUFFIX[prefix];
                $.getJSON(URLS.SCHEDULE)
                    .done(raw => {
                        // 서버에서 장비별 입력 주기로 계산한 향후 3개월 이내 일정을 받는다.
                        let ds = raw;
                        if (prefix === 'AC') {
                            ds = raw.filter(r => r.Category === 'AC');
                        } else if (prefix === 'DC') {
                            ds = raw.filter(r => r.Category === 'DC');
                        }

                        const dataSource = ds
                            .map(r => ({ ...r, DueDate: new Date(r.DueDate) }))
                            .sort((a, b) => a.DueDate - b.DueDate)
                            .map((r, i) => ({ ...r, Priority: i + 1 }));

                        renderGrid(
                            '#gridContainer03' + suf,
                            dataSource,
                            [
                                { dataField: 'Priority', caption: '우선순위', alignment: 'center' },
                                {
                                    caption: '점검유형',
                                    alignment: 'center',
                                    calculateCellValue: function (row) {
                                        return row.InspectionType || row.Status;
                                    }
                                },
                                {
                                    dataField: 'Category',
                                    caption: '구분',
                                    alignment: 'center'
                                },
                                { dataField: 'EquipmentName', caption: '설비명', alignment: 'center' },
                                { dataField: 'Serial_No', caption: '시리얼번호', alignment: 'center' },
                                { dataField: 'Start', caption: '시작일', dataType: 'date', alignment: 'center', format: 'yy.MM.dd' },
                                { dataField: 'End', caption: '종료일', dataType: 'date', alignment: 'center', format: 'yy.MM.dd' },
                                {
                                    dataField: 'DueDate',
                                    caption: '정기점검일',
                                    dataType: 'date',
                                    alignment: 'center',
                                    format: 'yy.MM.dd'
                                }
                            ],
                            {
                                onToolbarPreparing: function (e) {
                                    e.toolbarOptions.items.unshift({
                                        location: 'before',
                                        template: function () {
                                            return $('<span>')
                                                .css({ color: '#666', 'font-weight': 600 })
                                                .text('※ 오늘 기준 향후 3개월 이내의 점검일정만 표시됩니다.');
                                        }
                                    });
                                }
                            }
                        );
                    });
            }

            function loadDM(prefix) {
                const suf = SUFFIX[prefix];
                const krwCell = function (container, options) {
                    const value = Number(options.value);
                    $('<div>')
                        .text(Number.isFinite(value) ? value.toLocaleString('ko-KR') : '-')
                        .appendTo(container);
                };
                const usdAsKrwCell = function (container, options) {
                    const value = Number(options.value);
                    $('<div>')
                        .text(Number.isFinite(value) ? formatKrwFromUsd(value) : '-')
                        .appendTo(container);
                };

                const equipmentDetailRoutes = {
                    VCB: {
                        url: '@Url.Action("VCBDeviceDetail", "VCBDeviceDetail")',
                        param: 'vcbCode',
                        label: 'VCB'
                    },
                    TRANSFORMER: {
                        url: '@Url.Action("ITRDeviceDetail", "ITRDeviceDetail")',
                        param: 'itrCode',
                        label: 'Interface TR'
                    },
                    ITR: {
                        url: '@Url.Action("ITRDeviceDetail", "ITRDeviceDetail")',
                        param: 'itrCode',
                        label: 'Interface TR'
                    },
                    INTERFACETR: {
                        url: '@Url.Action("ITRDeviceDetail", "ITRDeviceDetail")',
                        param: 'itrCode',
                        label: 'Interface TR'
                    },
                    INTERFACE_TR: {
                        url: '@Url.Action("ITRDeviceDetail", "ITRDeviceDetail")',
                        param: 'itrCode',
                        label: 'Interface TR'
                    },
                    MMC_SUBMODULE: {
                        url: '@Url.Action("SUBMODULEDeviceDetail", "SUBMODULEDeviceDetail")',
                        param: 'submoduleCode',
                        label: 'Sub Module'
                    },
                    SUBMODULE: {
                        url: '@Url.Action("SUBMODULEDeviceDetail", "SUBMODULEDeviceDetail")',
                        param: 'submoduleCode',
                        label: 'Sub Module'
                    },
                    DC_BREAKER: {
                        url: '@Url.Action("DCCBDeviceDetail", "DCCBDeviceDetail")',
                        param: 'dccbCode',
                        label: 'DCCB'
                    },
                    DCCB: {
                        url: '@Url.Action("DCCBDeviceDetail", "DCCBDeviceDetail")',
                        param: 'dccbCode',
                        label: 'DCCB'
                    },
                    DC_CABLE: {
                        url: '@Url.Action("DCCABLEDeviceDetail", "DCCABLEDeviceDetail")',
                        param: 'dccableCode',
                        label: 'DC Cable'
                    },
                    DCCABLE: {
                        url: '@Url.Action("DCCABLEDeviceDetail", "DCCABLEDeviceDetail")',
                        param: 'dccableCode',
                        label: 'DC Cable'
                    }
                };

                const getEquipmentDetailRoute = function (row) {
                    const assetType = String(row.AssetType || '')
                        .trim()
                        .replace(/[\s-]+/g, '_')
                        .toUpperCase();
                    const code = String(row.Code || '').trim();
                    const route = equipmentDetailRoutes[assetType];

                    if (!route || !route.url || !code) {
                        return null;
                    }

                    return {
                        label: route.label,
                        href: route.url + '?' + route.param + '=' + encodeURIComponent(code)
                    };
                };

                const renderCofDetail = function (container, row) {
                    const formatKrw = function (value) {
                        const amount = Number(value);
                        return Number.isFinite(amount)
                            ? amount.toLocaleString('ko-KR') + '원'
                            : '-';
                    };
                    const items = [
                        { label: '재무 기여액(정규화)', value: row.CofFinancial },
                        { label: '신뢰도 기여액(정규화)', value: row.CofReliability },
                        { label: '안전 기여액(정규화)', value: row.CofSafety },
                        { label: '환경 기여액(정규화)', value: row.CofEnvironmental },
                        { label: 'DM 참고 CoF 합계', value: row.DmCofKrw, total: true }
                    ];
                    const title = (row.ProductName || row.Code || '장비') + ' DM 참고 CoF 상세(원)';
                    const wrap = $('<div>').addClass('cof-detail-wrap').appendTo(container);
                    const detailRoute = getEquipmentDetailRoute(row);
                    const detailHead = $('<div>').addClass('dm-equipment-detail-head').appendTo(wrap);
                    const detailSummary = $('<div>').addClass('dm-equipment-detail-summary').appendTo(detailHead);
                    $('<strong>')
                        .addClass('dm-equipment-detail-name')
                        .text(row.ProductName || row.Name || row.Code || '장비 개별정보')
                        .appendTo(detailSummary);
                    const detailMeta = $('<div>').addClass('dm-equipment-detail-meta').appendTo(detailSummary);
                    $('<span>')
                        .text('설비유형 ' + (detailRoute ? detailRoute.label : (row.AssetType || '-')))
                        .appendTo(detailMeta);
                    $('<span>').text('설비코드 ' + (row.Code || '-')).appendTo(detailMeta);
                    $('<span>').text('시리얼번호 ' + (row.Serial_No || '-')).appendTo(detailMeta);

                    if (detailRoute) {
                        $('<a>')
                            .addClass('dm-equipment-detail-link')
                            .attr({
                                href: detailRoute.href,
                                title: '설비 개별정보 화면으로 이동'
                            })
                            .text('설비 개별정보 보기 →')
                            .appendTo(detailHead);
                    }

                    $('<div>').addClass('cof-detail-title').text(title).appendTo(wrap);
                    const detailGrid = $('<div>').addClass('cof-detail-grid').appendTo(wrap);

                    items.forEach(function (item) {
                        const card = $('<div>')
                            .addClass('cof-detail-item')
                            .toggleClass('total', item.total === true)
                            .appendTo(detailGrid);
                        $('<span>').addClass('cof-detail-label').text(item.label).appendTo(card);
                        $('<span>').addClass('cof-detail-value').text(formatKrw(item.value)).appendTo(card);
                    });

                    $('<div>')
                        .addClass('cof-detail-note')
                        .text('각 차원을 fleet min-max 정규화한 후 40%·30%·20%·10% 가중치를 적용하며 평균 금액 규모는 보존합니다.')
                        .appendTo(wrap);

                    const rawSection = $('<div>').addClass('dm-detail-section').appendTo(wrap);
                    $('<div>').addClass('cof-detail-title').text('4D CoF 원시 영향도 및 신뢰도 세부').appendTo(rawSection);
                    const rawItems = [
                        { label: '재무 원시 영향도', value: row.RawCofFinancial },
                        { label: '신뢰도 원시 영향도', value: row.RawCofReliability },
                        { label: '안전 원시 영향도', value: row.RawCofSafety },
                        { label: '환경 원시 영향도', value: row.RawCofEnvironmental },
                        { label: 'CENS', value: row.CofCens },
                        { label: 'SAIDI 패널티', value: row.CofSaidiPenalty },
                        { label: 'SAIFI 패널티', value: row.CofSaifiPenalty },
                        { label: '영향 고객 수', value: row.CustomersAffected, count: true },
                        { label: 'SAIDI 기여도', value: row.SaidiContribution, metric: true },
                        { label: 'SAIFI 기여도', value: row.SaifiContribution, metric: true }
                    ];
                    const rawGrid = $('<div>').addClass('cof-detail-grid').appendTo(rawSection);
                    rawItems.forEach(function (item) {
                        const card = $('<div>').addClass('cof-detail-item').appendTo(rawGrid);
                        $('<span>').addClass('cof-detail-label').text(item.label).appendTo(card);
                        const text = item.metric === true
                            ? Number(item.value || 0).toFixed(6)
                            : item.count === true
                                ? Number(item.value || 0).toLocaleString('ko-KR') + '명'
                                : formatKrw(item.value);
                        $('<span>').addClass('cof-detail-value').text(text).appendTo(card);
                    });

                    const economicSection = $('<div>')
                        .addClass('dm-detail-section')
                        .appendTo(wrap);
                    $('<div>')
                        .addClass('cof-detail-title')
                        .text((row.ProductName || row.Code || '장비') + ' NPV·ROI 상세')
                        .appendTo(economicSection);

                    const economicItems = [
                        { label: '위험 경감액', value: row.RiskMitigation },
                        { label: '연간 유지보수 절감액', value: row.AnnualMaintenanceSaving },
                        { label: '연간 효율 개선 편익', value: row.AnnualEfficiencyBenefit },
                        { label: '연간 편익 합계', value: row.AnnualBenefits },
                        { label: '연간 편익 할인 현재가치', value: row.DiscountedAnnualBenefits },
                        { label: '수명 연장 가치', value: row.ExtendedLifetimeValue },
                        { label: '편익 현재가치', value: row.NpvBenefits },
                        { label: '교체비', value: row.ReplacementCost },
                        { label: '설치비', value: row.InstallationCost },
                        { label: '폐기비', value: row.DisposalCost },
                        { label: '초기 총비용', value: row.TotalCosts },
                        { label: 'BCR', value: row.BCR, ratio: true, total: true },
                        { label: 'NPV', value: row.NPV, total: true },
                        { label: 'ROI', value: row.ROI, percent: true, total: true }
                    ];
                    const economicGrid = $('<div>')
                        .addClass('cof-detail-grid')
                        .appendTo(economicSection);

                    economicItems.forEach(function (item) {
                        const card = $('<div>')
                            .addClass('cof-detail-item')
                            .toggleClass('total', item.total === true)
                            .appendTo(economicGrid);
                        $('<span>').addClass('cof-detail-label').text(item.label).appendTo(card);
                        $('<span>')
                            .addClass('cof-detail-value')
                            .text(item.percent === true
                                ? Number(item.value || 0).toLocaleString('ko-KR', {
                                    minimumFractionDigits: 2,
                                    maximumFractionDigits: 2
                                }) + '%'
                                : item.ratio === true
                                    ? Number(item.value || 0).toFixed(3)
                                    : formatKrw(item.value))
                            .appendTo(card);
                    });

                    $('<div>')
                        .addClass('cof-detail-note')
                        .text(
                            'BCR = 편익 현재가치 ÷ 비용 현재가치, NPV = 편익 현재가치 - 비용 현재가치 '
                            + '(평가기간 ' + Number(row.EvaluationPeriodYears || 0) + '년, 할인율 '
                            + Number(row.DiscountRate || 0).toFixed(2) + '%, 물가상승률 '
                            + Number(row.InflationRate || 0).toFixed(2) + '%)')
                        .appendTo(economicSection);
                };

                window.totalInfoDataHub.getDm(prefix)
                    .done(result => {
                        if (!result || result.success === false) {
                            console.error('GetDMDecisionInfo 오류', result && (result.details || result.error));
                            return;
                        }

                        renderGrid(
                            '#gridContainer04' + suf,
                            result.rows || [],
                            [
                                { dataField: 'Priority', caption: '우선순위', alignment: 'center', width: 70 },
                                { dataField: 'Sort', caption: '구분', alignment: 'center', width: 50 },
                                {
                                    dataField: 'ProductName',
                                    caption: '설비명(제품명)',
                                    alignment: 'center',
                                    width: 200,
                                    cellTemplate: function (container, options) {
                                        const row = options.data || {};
                                        const detailRoute = getEquipmentDetailRoute(row);
                                        const name = options.value || row.Name || row.Code || '-';

                                        if (!detailRoute) {
                                            $('<span>').text(name).appendTo(container);
                                            return;
                                        }

                                        $('<a>')
                                            .addClass('dm-equipment-name-link')
                                            .attr({
                                                href: detailRoute.href + '#dmEquipmentAnalysis',
                                                title: name + ' 개별정보 및 DM 산출 상세 보기'
                                            })
                                            .text(name)
                                            .appendTo(container);
                                    }
                                },
                                { dataField: 'Serial_No', caption: '시리얼번호', alignment: 'center' },
                                { dataField: 'HI', caption: 'HI', alignment: 'center', dataType: 'number' },
                                { dataField: 'PoF', caption: 'PoF(%)', alignment: 'center', dataType: 'number', format: { type: 'fixedPoint', precision: 2 } },
                                { dataField: 'ReplacementCost', caption: '교체비(원)', alignment: 'right', dataType: 'number', cellTemplate: krwCell },
                                { dataField: 'CoF', caption: 'CoF(원)', alignment: 'right', dataType: 'number', cellTemplate: usdAsKrwCell },
                                { dataField: 'Risk', caption: 'Risk(원)', alignment: 'right', dataType: 'number', cellTemplate: usdAsKrwCell },
                                { dataField: 'NPV', caption: 'NPV(원)', alignment: 'right', dataType: 'number', cellTemplate: krwCell },
                                { dataField: 'BCR', caption: 'BCR', alignment: 'center', dataType: 'number', format: { type: 'fixedPoint', precision: 3 } },
                                { dataField: 'ROI', caption: 'ROI(%)', alignment: 'center', dataType: 'number', format: { type: 'fixedPoint', precision: 2 } },
                                {
                                    dataField: 'RUL',
                                    caption: 'RUL(년)',
                                    alignment: 'center',
                                    dataType: 'number',
                                    cellTemplate: function (container, options) {
                                        $('<div>')
                                            .text(options.value == null ? '산정불가' : Number(options.value).toFixed(2))
                                            .appendTo(container);
                                    }
                                },
                                {
                                    dataField: 'Decision',
                                    caption: '의사결정',
                                    alignment: 'center',
                                    cellTemplate: function (container, options) {
                                        const colors = {
                                            '즉시 교체': '#d32f2f',
                                            '긴급 유지보수': '#ef6c00',
                                            '예방 유지보수': '#c9a000',
                                            '정기점검': '#1976d2',
                                            '계속 감시': '#2e7d32',
                                            '데이터 확인 필요': '#666666'
                                        };
                                        $('<strong>')
                                            .text(options.value || '')
                                            .css('color', colors[options.value] || '#333333')
                                            .appendTo(container);
                                    }
                                },
                                { dataField: 'Urgency', caption: '긴급도', alignment: 'center' },
                                { dataField: 'RecommendedAction', caption: '권장시기', alignment: 'center' },
                                { dataField: 'TopsisScore', caption: 'TOPSIS 점수', alignment: 'center', dataType: 'number', format: { type: 'fixedPoint', precision: 4 } }
                            ],
                            {
                                height: 360,
                                masterDetail: {
                                    enabled: true,
                                    autoExpandAll: false,
                                    template: function (container, options) {
                                        renderCofDetail(container, options.data || {});
                                    }
                                }
                            }
                        );
                    })
                    .fail(err => console.error('GetDMDecisionInfo 호출 실패', err));
            }

            //  1-depth 탭 클릭 처리: 우선순위만 초기 로드
            $('.tab_onedepth .tab_btn').on('click', function () {
                const prefix = $(this).data('prefix');
                $('.tab_onedepth .tab_btn').removeClass('on');
                $(this).addClass('on');
                $('.box_wrap.totalInfo_content').removeClass('on');
                $('#' + $(this).data('tab')).addClass('on');

                window.totalInfoDataHub.activate(prefix);
                loadPriority(prefix);
                // history, schedule 그리드는 2-depth 클릭 시 lazy-load
            });

            //  2-depth 그리드 탭 클릭 처리
            $('.box_group').on('click', '.tab_twodepth .tab_btn', function () {
                const prefix = $('.tab_onedepth .tab_btn.on').data('prefix');
                const target = $(this).data('tab');
                $(this).addClass('on').siblings().removeClass('on');
                $(this).closest('.box_group').find('.totalInfo_content').removeClass('on');
                $('#' + target).addClass('on');

                if (target.startsWith('gridContainer02')) loadHistory(prefix);
                if (target.startsWith('gridContainer03')) loadSchedule(prefix);
                if (target.startsWith('gridContainer04')) loadDM(prefix);
            });

            // 처음 로딩할 때 5대 주요장비 우선순위만
            loadUsdKrwRate().always(function () {
                loadPriority('');
            });

            // 활성 탭만 30초마다 새로고침하며, 숨겨진 브라우저 탭에서는 요청하지 않습니다.
            const REFRESH_INTERVAL_MS = 30000;
            let refreshInProgress = false;

            function getActivePrefix() {
                return $('.tab_onedepth .tab_btn.on').data('prefix') || '';
            }

            function refreshActiveTotalInfo() {
                if (document.hidden || refreshInProgress) return;

                const prefix = getActivePrefix();
                const suffix = SUFFIX[prefix];
                const chartSuffix = prefix || 'All';
                refreshInProgress = true;

                // Risk 포인트는 한 번만 조회해 건전도와 Risk Matrix가 함께 사용합니다.
                const riskRequest = $.getJSON(URLS.RISK, { prefix: prefix })
                    .done(rawPoints => {
                        const points = Array.isArray(rawPoints) ? rawPoints : [];
                        const buckets = points.reduce((acc, point) => {
                            acc[point.hi] = acc[point.hi] || { hi: point.hi, codes: [] };
                            acc[point.hi].codes.push(point.name);
                            return acc;
                        }, {});
                        const pieData = Object.values(buckets).map(bucket => ({
                            state: bucket.hi + '등급',
                            value: bucket.codes.length,
                            codes: bucket.codes,
                            hi: bucket.hi
                        }));
                        const riskData = points.map(point => ({
                            x: usdToEokKrw(point.x),
                            y: Number(point.y || 0),
                            name: point.name,
                            group: point.group
                        }));
                        const pie = $('#pie' + chartSuffix).data('dxPieChart');
                        const riskMatrix = $('#chartContainer' + chartSuffix).data('dxChart');

                        if (pie) pie.option('dataSource', pieData);
                        if (riskMatrix) {
                            const maxCof = getRiskMatrixMaxEok(riskData);
                            riskMatrix.option('dataSource', riskData);
                            riskMatrix.option('argumentAxis.visualRange', { startValue: 0, endValue: maxCof });
                            riskMatrix.option('argumentAxis.tickInterval', maxCof / 5);
                        }
                    })
                    .fail(error => console.error('Risk 자동 새로고침 실패', error));

                const historyRequest = $.getJSON(URLS.HISTORY, { prefix: prefix })
                    .done(rawHistory => {
                        const history = (Array.isArray(rawHistory) ? rawHistory : []).map(item => {
                            const time = new Date(item.time);
                            time.setHours(0, 0, 0, 0);
                            return { ...item, time: time, cof: usdToEokKrw(item.cof) };
                        });
                        const hiChart = $('#chart_line01' + suffix).data('dxChart');
                        const pofChart = $('#chart_line02' + suffix).data('dxChart');
                        const cofChart = $('#chart_line03' + suffix).data('dxChart');

                        if (hiChart) hiChart.option('dataSource', history);
                        if (pofChart) pofChart.option('dataSource', history);
                        if (cofChart) cofChart.option('dataSource', history);
                    })
                    .fail(error => console.error('이력 자동 새로고침 실패', error));

                const priorityRequest = $.post(URLS.PRIORITY)
                    .done(rows => {
                        const grid = $('#gridContainer' + suffix).data('dxDataGrid');
                        if (grid) {
                            grid.option('dataSource', preparePriorityData(rows, prefix));
                        }
                    })
                    .fail(error => console.error('우선순위 자동 새로고침 실패', error));

                $.when(riskRequest, historyRequest, priorityRequest)
                    .always(() => { refreshInProgress = false; });
            }

            const refreshTimer = window.setInterval(refreshActiveTotalInfo, REFRESH_INTERVAL_MS);

            $(document).on('visibilitychange.totalInfoRefresh', function () {
                if (!document.hidden) {
                    refreshActiveTotalInfo();
                }
            });

        });
    </script>
}
