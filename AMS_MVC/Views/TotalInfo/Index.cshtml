@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section LeftMenu {
    @Html.Partial("_TotalInfoMenu")
}

@section MainContent {
    <h1>
        종합정보
        <a href="javascript:openPop('/Location/Index','900','600')" class="btn blue map tooltip" data-tooltip="전남 나주시 혁신산단5길 동수동 405-8">위치보기</a>
    </h1>
    <!--전체 박스-->
    <div class="box_wrap">
        <!--건전도-->
        <div class="con_box">
            <!--타이틀-->
            <h2>건전도</h2>
            <!--//타이틀-->
            <ul class="chart">
                <li>
                    <!--그래프-->
                    <div id="pie01" class="chart_box"></div>
                    <!--//그래프-->
                    <!--그래프 타이틀-->
                    <div class="title">AC-VCB</div>
                </li>
                <li>
                    <div id="pie02" class="chart_box"></div>
                    <div class="title">AC-Interface TR</div>
                </li>
                <li>
                    <div id="pie03" class="chart_box"></div>
                    <div class="title">AC-Sub Module</div>
                </li>
                <li>
                    <div id="pie04" class="chart_box"></div>
                    <div class="title">AC-DCCB</div>
                </li>
                <li>
                    <div id="pie05" class="chart_box"></div>
                    <div class="title">AC-DC Cable</div>
                </li>
            </ul>
            <ul class="valuee">
                <li><span class="verygood"></span><strong>Very Good</strong></li>
                <li><span class="good"></span><strong>Good</strong></li>
                <li><span class="fair"></span><strong>Fair</strong></li>
                <li><span class="poor"></span><strong>Poor</strong></li>
                <li><span class="verypoor"></span><strong>Very Poor</strong></li>
            </ul>
        </div>

        <script>
            $(document).ready(function () {

                // 공통: HI 데이터를 요약하는 함수
                function summarizeHIData(data) {
                    var result = [];
                    Object.keys(data).forEach(function (key) {
                        result.push({
                            state: getStateByHI(key),
                            value: parseInt(data[key], 10)
                        });
                    });
                    return result;
                }

                // 공통: HI 값에 따른 상태 문자열 반환 함수
                function getStateByHI(hi) {
                    var value = parseInt(hi, 10);
                    switch (value) {
                        case 1: return 'Very Good';
                        case 2: return 'Good';
                        case 3: return 'Fair';
                        case 4: return 'Poor';
                        case 5: return 'Very Poor';
                        default: return 'Unknown';
                    }
                }

                // 공통: dxPieChart를 생성하는 함수
                function initializePieChart(elementId, data) {
                    $(elementId).dxPieChart({
                        type: 'doughnut',
                        palette: ['#5B9F56', '#B4DEB1', '#EBCD1D', '#F18425', '#F05153'],
                        dataSource: data,
                        legend: { visible: false },
                        onPointClick(arg) {
                            arg.target.select();
                        },
                        series: [{
                            argumentField: 'state',
                            valueField: 'value',
                            label: {
                                visible: true,
                                format: 'fixedPoint',
                                precision: 0,
                                connector: { visible: true }
                            }
                        }],
                        size: { width: 270, height: 270 },
                        innerRadius: 0.5
                    });
                }

                // 공통: 특정 prefix에 대해 데이터를 가져와 HI 데이터를 처리하고 차트를 생성하는 함수
                function setupChart(elementId, prefix) {
                    $.ajax({
                        type: "POST",
                        url: "/VCBDevice/GetRiskmatrixData",  // HI 집계 데이터를 반환하는 액션
                        data: JSON.stringify({ prefix: prefix }),
                        contentType: "application/json; charset=utf-8",
                        dataType: "json"
                    })
                        .done(function (response) {
                            if (response) {
                                const hiSummary = summarizeHIData(response);
                                initializePieChart(elementId, hiSummary);
                            } else {
                                alert(prefix + " 데이터를 가져오는 데 실패했습니다.");
                            }
                        })
                        .fail(function (xhr, status, error) {
                            console.error("Ajax Error:", error);
                            alert("서버에서 데이터를 가져오는 중 오류가 발생했습니다.");
                        });
                }

                setupChart('#pie01', 'VCB');       // AC-VCB
                setupChart('#pie02', 'ITR');       // AC-Interface TR
                setupChart('#pie03', 'SUBMODULE'); // AC-Sub Module
                setupChart('#pie04', 'DCCB');      // AC-DCCB
                setupChart('#pie05', 'DCCABLE');   // AC-DC Cable

            });
        </script>


        <!--//건전도-->
        <!--risk matrix-->
        <div class="con_box flex1">
            <!--타이틀-->
            <h2>
                Risk Matrix
                @*<a href="javacript:void(0);" class="btn_more">더보기</a>*@
            </h2>
            <!--//타이틀-->
            <!--메트릭스-->
            <div class="matrix">
                <!--메트릭스좌측-->
                <div class="matrix_left">
                    <h3 class="left tit">PoF</h3>
                    <ul class="left txt">
                        <li>Very Poor</li>
                        <li>Poor</li>
                        <li>Fair</li>
                        <li>Good</li>
                        <li>Very Good</li>
                    </ul>
                </div>
                <!--//메트릭스좌측-->
                <!--그래프-->
                <ul class="value">
                    <!-- Very Poor 행 -->
