        <!-- 점검 -->
        <div class="con_box flex2 schedule">
            <!-- 타이틀 -->
            <h2>
                점검
                <p class="schedule_value">
                    <span class="confirmed">보통점검</span>
                    <span class="risk">정밀점검</span>
                </p>
                <p class="month_select">
                    <a href="javascript:void(0);" class="arrow prev">이전달</a>
                    <span id="currentMonth">2024 - 11</span>
                    <a href="javascript:void(0);" class="arrow next">다음달</a>
                </p>
            </h2>
            <!-- //타이틀 -->
            <!-- 컨텐츠 -->
            <div class="schedule_table">
                <table>
                    <thead>
                        <tr>
                            <th colspan="2"></th>
                            <script>
                                for (let i = 1; i <= 31; i++) {
                                    document.write(`<th>${i}</th>`);
                                }
                            </script>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- 일정이 동적으로 추가될 부분 -->
                    </tbody>
                </table>
            </div>

            <!-- 점검 일정 스크립트 -->
            <script>
                $(document).ready(function () {
                    let currentYear = new Date().getFullYear();
                    let currentMonth = new Date().getMonth() + 1;

                    function updateMonthDisplay() {
                        $("#currentMonth").text(`${currentYear} - ${String(currentMonth).padStart(2, '0')}`);
                    }

                    function loadSchedule(year, month) {
                        $.ajax({
                            url: `/TotalInfo/GetScheduleData?year=${year}&month=${month}`,
                            type: "GET",
                            dataType: "json",
                            success: function (data) {
                                renderSchedule(data, year, month);
                            },
                            error: function () {
                                alert("데이터를 불러오는 중 오류 발생");
                            }
                        });
                    }

                    function renderSchedule(data, year, month) {
                        let daysInMonth = new Date(year, month, 0).getDate();
                        let tbodyHtml = "";

                        let groupedData = {};
                        data.forEach(item => {
                            if (!groupedData[item.Type]) {
                                groupedData[item.Type] = [];
                            }
                            groupedData[item.Type].push(item);
                        });

                        for (let [type, items] of Object.entries(groupedData)) {
                            items.forEach(item => {
                                let startDay = parseInt(item.Start.split('-')[2]);
                                let endDay = parseInt(item.End ? item.End.split('-')[2] : startDay);
                                let barStyle = item.Status === "confirmed" ? "background-color:#0051A2;" : "background-color:#800080;";
                                let barWidth = (endDay - startDay + 1) * 31 + "px";

                                tbodyHtml += `<tr>
                                                                                                    <th>${type}</th>
                                                                                                    <td>${item.Code}</td>`;

                                for (let i = 1; i <= daysInMonth; i++) {
                                    if (i === startDay) {
                                        tbodyHtml += `<td colspan="${endDay - startDay + 1}" style="position: relative;">
                                                                                                            <span class="bar" style="${barStyle} width: ${barWidth}; height: 20px; display: block;"></span>
                                                                                                        </td>`;
                                        i = endDay;
                                    } else {
                                        tbodyHtml += `<td></td>`;
                                    }
                                }
                                tbodyHtml += `</tr>`;
                            });
                        }

                        $(".schedule_table tbody").html(tbodyHtml);
                    }

                    $(".prev").click(function () {
                        currentMonth--;
                        if (currentMonth < 1) {
                            currentMonth = 12;
                            currentYear--;
                        }
                        updateMonthDisplay();
                        loadSchedule(currentYear, currentMonth);
                    });

                    $(".next").click(function () {
                        currentMonth++;
                        if (currentMonth > 12) {
                            currentMonth = 1;
                            currentYear++;
                        }
                        updateMonthDisplay();
                        loadSchedule(currentYear, currentMonth);
                    });

                    updateMonthDisplay();
                    loadSchedule(currentYear, currentMonth);
                });
            </script>
        </div>
        <!-- //점검 -->
        <!--유지보수-->
        <div class="con_box flex1">
            <!--타이틀-->
            <h2>
                유지보수
                @*<a href="javacript:void(0);" class="btn_more">더보기</a>*@
            </h2>
            <!--//타이틀-->
            <!--챠트-->
            <div id="chart"></div>
            <!--//챠트-->
            <script>
                function transformMaintenanceData(rawArray) {
                    return rawArray.map(function (row) {
                        const obj = {};
                        row.forEach(function (pair) {
                            obj[pair.Key] = pair.Value;
                        });
                        return obj;
                    });
                }

                $(document).ready(function () {
                    function fetchMaintenanceData() {
                        return $.ajax({
                            type: "POST",
                            url: "/TotalInfo/GetMonthlyMaintenanceData",
                            contentType: "application/json; charset=utf-8",
                            dataType: "json"
                        });
                    }

                    fetchMaintenanceData()
                        .done(function (response) {
                            console.log("유지보수 rawData:", response);
                            // 응답 변환
                            const normalData = transformMaintenanceData(response);
                            console.log("유지보수 normalData:", normalData);
                            const data = processChartData(normalData);
                            renderMonthlyMaintenanceChart(data);
                        })
                        .fail(function (xhr, status, error) {
                            console.error("Ajax Error:", error);
                            alert("유지보수 데이터를 가져오는 중 문제가 발생했습니다.");
                        });

                    function processChartData(rawData) {
                        const groupedData = {};

                        rawData.forEach(item => {
                            const month = item.Month; // 예: "2024-05"
                            if (!groupedData[month]) {
                                groupedData[month] = {
                                    Month: month,
                                    VCB: 0,
                                    InterfaceTR: 0,
                                    SubModule: 0,
                                    DCCB: 0,
                                    DCCable: 0
                                };
                            }
                            if (item.Type === "VCB") {
                                groupedData[month].VCB += item.Count;
                            } else if (item.Type === "Interface TR") {
                                groupedData[month].InterfaceTR += item.Count;
                            } else if (item.Type === "Sub Module") {
                                groupedData[month].SubModule += item.Count;
                            } else if (item.Type === "DCCB") {
                                groupedData[month].DCCB += item.Count;
                            } else if (item.Type === "DC Cable") {
                                groupedData[month].DCCable += item.Count;
                            }
                        });
                        const result = Object.values(groupedData);
                        // 월 기준 정렬 (옵션)
                        result.sort((a, b) => a.Month.localeCompare(b.Month));
                        return result;
                    }

                    function renderMonthlyMaintenanceChart(data) {
                        $("#chart").dxChart({
                            dataSource: data,
                            commonSeriesSettings: {
                                argumentField: "Month",
                                type: "bar"
                            },
                            legend: {
                                visible: true,
                                position: "bottom"
                            },
                            tooltip: {
                                enabled: true,
                                customizeTooltip: function (arg) {
                                    return {
                                        text: `${arg.seriesName} - ${arg.argumentText}: ${arg.valueText}건`
                                    };
                                }
                            },
                            series: [
                                {
                                    name: "VCB",
                                    valueField: "VCB",
                                    color: "#0051A2"
                                },
                                {
                                    name: "Interface TR",
                                    valueField: "InterfaceTR",
                                    color: "#800080"
                                },
                                {
                                    name: "Sub Module",
                                    valueField: "SubModule",
                                    color: "#A52A2A"
                                },
                                {
                                    name: "DCCB",
                                    valueField: "DCCB",
                                    color: "#808080"
                                },
                                {
                                    name: "DC Cable",
                                    valueField: "DCCable",
                                    color: "#000000"
                                }
                            ]
                        });
                    }
                });
            </script>
        </div>
        <!--//유지보수-->
