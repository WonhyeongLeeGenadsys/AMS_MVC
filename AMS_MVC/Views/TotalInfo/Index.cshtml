                <h2>차년도<br />유지보수 대상</h2>
                <ul>
                    <li id="strategyAll">로딩 중...</li>
                    <li id="strategyAC">로딩 중...</li>
                    <li id="strategyDC">로딩 중...</li>
                </ul>
            </div>

            <script>
            $(function(){
                const urlPoints = '@Url.Action("GetRiskMapPoints","TotalInfo")';
                const urlGroup  = '@Url.Action("GetGroupStrategy","EquipmentAlgorithm")';

            $.getJSON(urlPoints, { prefix: '' })
            .done(function(allPoints){
                const totalCount = allPoints.length;
                const acPoints   = allPoints.filter(p => p.group === 'VCB' || p.group === 'ITR');
                const dcPoints   = allPoints.filter(p => ['DCCB','DCCABLE','SUBMODULE'].includes(p.group));

             // 전체 안내
                $('#strategyAll').html(
                `현재 변전소의 주요장비는 총
                    <strong class="bold">${totalCount}</strong>대 중에서
                    AC <strong class="bold">${acPoints.length}</strong>대,
                    DC <strong class="bold">${dcPoints.length}</strong>대입니다.`
                );

            // AC 전략
                $.getJSON(urlGroup, { equipmentType: 'AC' })
                .done(function(){
                    const worstAC  = Math.max(...acPoints.map(p => p.hi));
                    const prefixAC = acPoints.find(p => p.hi === worstAC).group;
                    const actionAC = worstAC >= 4
                    ? '긴급 유지보수 권장됩니다.'
                    : worstAC === 3
                    ? '유지보수 계획이 권장됩니다.'
                    : '정상 운영 가능합니다.';

                $('#strategyAC').html(
                `AC <strong class="bold">${acPoints.length}</strong>대 중에서 현재 최저 등급은
                ${prefixAC}
                <strong class="grade-${worstAC}">${worstAC}</strong>등급이며 ${actionAC}`
                );

                // DC 전략
                $.getJSON(urlGroup, { equipmentType: 'DC' })
                .done(function(){
                    const worstDC  = Math.max(...dcPoints.map(p => p.hi));
                    const prefixDC = dcPoints.find(p => p.hi === worstDC).group;
                    const actionDC = worstDC >= 4
                    ? '긴급 유지보수 권장됩니다.'
                    : worstDC === 3
                    ? '유지보수 계획이 권장됩니다.'
                    : '정상 운영 가능합니다.';

                $('#strategyDC').html(
                    `DC <strong class="bold">${dcPoints.length}</strong>대 중에서 현재 최저 등급은
                    ${prefixDC}
                    <strong class="grade-${worstDC}">${worstDC}</strong>등급이며 ${actionDC}`
           );
         });
      });
   })
   .fail(err => console.error('GetRiskMapPoints 오류', err));
});
            </script>

