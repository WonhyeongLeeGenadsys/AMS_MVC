@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section LeftMenu {
    @Html.Partial("_TotalInfoMenu")
}

@section MainContent {
    <h1>Health Index(1~5) 전체 이력</h1>

    <div class="con_box">
        <div class="content_warp">
            <div id="hiBigChart" style="width:100%; height:600px;"></div>
        </div>
    </div>
}

@section Scripts {
    <script>
        $(function () {
            const urlHist = '@Url.Action("GetHIPofCofHistory","TotalInfo")';

            $.getJSON(urlHist, { prefix: '' })
                .done(data => {
                    const history = data.map(d => {
                        const t = new Date(d.time);
                        t.setHours(0,0,0,0);
                        return { ...d, time: t };
                    }).sort((a, b) => a.time - b.time);

                    $("#hiBigChart").dxChart({
                        dataSource: history,
                        commonSeriesSettings: {
                            type: "line",
                            argumentField: "time",
                            valueField: "hi",
                            point: { visible: true }
                        },
                        seriesTemplate: { nameField: "code" },
                        argumentAxis: {
                            valueType: "datetime",
                            label: {
                                format: "yy.MM.dd",
                                overlappingBehavior: {
                                    mode: "rotate",
                                    rotationAngle: 45
                                }
                            },
                            title: { text: "날짜" }
                        },
                        valueAxis: {
                            title: "Health Index(HI)",
                            visualRange: { startValue: 0, endValue: 5 },
                            tickInterval: 1,
                            endOnTick: false,
                            max: 5
                        },
                        legend: {
                            visible: true,
                            verticalAlignment: "bottom",
                            horizontalAlignment: "center",
                            orientation: "horizontal",
                            markerShape: "circle"
                        },
                        tooltip: { enabled: true },
                        size: { height: 700 }
                    });
                })
                .fail(err => console.error('HITab 오류', err));
        });
    </script>
}
