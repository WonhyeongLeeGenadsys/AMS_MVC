     @*DC 건전도 파이차트*@
    <script>
        $(function () {
            // 1) 최신 리스크 포인트(코드, HI) 가져오기
            window.totalInfoDataHub.getRiskPoints('DC')
                .done(function (rawPoints) {
                    // 2) HI 별로 묶어서 대수(count)와 장비 리스트(codes) 계산
                    const buckets = rawPoints.reduce((acc, p) => {
                        const hi = p.hi;
                        if (!acc[hi]) {
                            acc[hi] = { hi, codes: [] };
                        }
                        acc[hi].codes.push(p.name);
                        return acc;
                    }, {});

                    // 3) dxPieChart용 배열로 변환
                    const ds = Object.values(buckets)
                        .map(b => ({
                            hi: b.hi,
                            state: b.hi === 0 ? '등급 미정' : b.hi + '등급',
                            value: b.codes.length,
                            codes: b.codes
                        }))
                        .sort((a, b) => a.hi - b.hi);

                    // 4) 차트 초기화
                    $('#pieDC').dxPieChart({
                        type: 'doughnut',
                        dataSource: ds,
                        customizePoint: pt => ({ color: getHiColor(pt.data.hi) }),
                        series: [{
                            argumentField: 'state',
                            valueField: 'value',
                            label: {
                                visible: true,
                                connector: { visible: true },
                                customizeText: e => e.valueText + '대'
                            }
                        }],
                        legend: {
                            visible: true,
                            verticalAlignment: 'bottom',
                            horizontalAlignment: 'center',
                            markerShape: 'circle',
                        },
                        size: { width: '100%', height: 300 },
                        innerRadius: 0.5,
                        tooltip: {
                            enabled: true,
                            customizeTooltip: function (info) {
                                const d = info.point.data;
                                return {
                                    html: `
                  <strong>${d.state}</strong><br/>
                  대수: ${d.value}대<br/>
                  장비: ${d.codes.join(', ')}
                `
                                };
                            }
                        },
                        onPointClick: function (e) {
                            e.target.showTooltip();
                        }
                    });

                    // helper: HI 별 색상 매핑
                    function getHiColor(hi) {
                        switch (hi) {
                            case 1: return '#5B9F56';
                            case 2: return '#B4DEB1';
                            case 3: return '#EBCD1D';
                            case 4: return '#F18425';
                            case 5: return '#F05153';
                            default: return '#888888';
                        }
                    }
                })
                .fail(err => console.error('GetRiskMapPoints 오류', err));
        });
    </script>

    <!-- Risk Matrix DC -->
    <script>
        $(function () {
            window.totalInfoDataHub.getRiskPoints('DC')
                .done(function (raw) {
                    const data = raw.map(p => ({
                        x: usdToEokKrw(p.x), y: p.y, name: p.name, group: p.group
                    }));
                    const maxCof = getRiskMatrixMaxEok(data);

                    $("#chartContainerDC").dxChart({
                        dataSource: data,
                        commonSeriesSettings: {
                            type: "scatter",
                            argumentField: "x",
                            valueField: "y",
                            point: { size: 10 }
                        },
                        palette: ['#34A369', '#B82069', '#F57B50', '#2B6D6F', '#38B295', '#DC9FF1', '#EBCC44', '#CFD94D', '#E43387', '#002C68'],
                        border: {
                            visible: false
                        },
                        seriesTemplate: { nameField: "group" },
                        argumentAxis: {
                            visualRange: { startValue: 0, endValue: maxCof },
                            valueMarginsEnabled: false,
                            tickInterval: maxCof / 5,
                            grid: {
                                visible: true,
                                opacity: 0.5,
                                color: '#ffffff',
                                width: 1
                            },
                            title: { text: "CoF (억원)" },
                            label: { customizeText: e => Number(e.value).toLocaleString('ko-KR', { maximumFractionDigits: 2 }) }
                        },
                        valueAxis: {
                            visualRange: { startValue: 0, endValue: 100 },
                            endOnTick: false,
                            valueMarginsEnabled: false,
                            tickInterval: 20,
                            min: 0,
                            max: 100,
                            grid: {
                                visible: true,
                                opacity: 0.5,
                                color: '#ffffff',
                                width: 1
                            },
                            title: { text: "PoF (%)" },
                            label: { customizeText: e => e.value.toFixed(0) + "%" },
                        },
                        tooltip: {
                            enabled: true,
                            location: 'edge',
                            customizeTooltip: info => {
                                const d = info.point.data;
                                return {
                                    html:
                                        `<strong>${d.name}</strong><br/>
                CoF: ${d.x.toLocaleString('ko-KR', { maximumFractionDigits: 3 })}억원<br/>
                PoF: ${d.y.toFixed(2)}%`
                                };
                            }
                        },
                        onPointClick(e) {
                            const d = e.target.originalData;
                            alert(`코드: ${d.name}\nCoF: ${d.x.toLocaleString('ko-KR', { maximumFractionDigits: 3 })}억원\nPoF: ${d.y.toFixed(2)}%`);
                        },
                        legend: {
                            visible: true, position: "bottom",
                            verticalAlignment: 'bottom',
                            horizontalAlignment: 'center',
                            markerShape: 'circle',
                        },
                        size: { width: 400, height: 300 },
                        margin: 0,
                    });
                });
        });
    </script>

    @* 이력 차트 hi, pof, cof (DC) *@
    <script>
        // DC 용: HI 이력
        function setupHistoryChart(containerId, history) {
            $("#" + containerId).dxChart({
                dataSource: history,
                commonSeriesSettings: {
                    type: "line",
                    argumentField: "time",
                    valueField: "hi",
                    point: { visible: true }
                },
                seriesTemplate: { nameField: "code" },
                argumentAxis: {
                    valueType: "datetime",
                    label: {
                        format: "yy.MM.dd",
                        overlappingBehavior: {
                            mode: "rotate",
                            rotationAngle: 45
                        }
                    },
                    title: { text: "날짜" }
                },
                valueAxis: {
                    title: "HI",
                    visualRange: { startValue: 0, endValue: 5 },
                    tickInterval: 1,
                    endOnTick: false,
                    max: 5
                },
                legend: {
                    visible: true, position: "bottom",
                    markerShape: 'circle',
                },
                tooltip: { enabled: true }
            });
        }

        // DC 용: PoF 이력
        function setupPofChart(containerId, history) {
            $("#" + containerId).dxChart({
                dataSource: history,
                commonSeriesSettings: {
                    type: "line",
                    argumentField: "time",
                    valueField: "pof",
                    point: { visible: true }
                },
                seriesTemplate: { nameField: "code" },
                argumentAxis: {
                    valueType: "datetime",
                    label: {
                        format: "yy.MM.dd",
                        overlappingBehavior: {
                            mode: "rotate",
                            rotationAngle: 45
                        }
                    },
                    title: { text: "날짜" }
                },
                valueAxis: {
                    title: "PoF (%)",
                    visualRange: { startValue: 0, endValue: 100 },
                    tickInterval: 20,
                    endOnTick: false,
                    max: 100
                },
                legend: {
                    visible: true, position: "bottom",
                    markerShape: 'circle',
                },
                tooltip: { enabled: true }
            });
        }

        // DC 용: CoF 이력
        function setupCofChart(containerId, history) {
            const cofHistory = (history || []).map(item => ({ ...item, cof: usdToEokKrw(item.cof) }));
            const maxCof = getRiskMatrixMaxEok(cofHistory.map(item => ({ x: item.cof })));
            $("#" + containerId).dxChart({
                dataSource: cofHistory,
                commonSeriesSettings: {
                    type: "line",
                    argumentField: "time",
                    valueField: "cof",
                    point: { visible: true }
                },
                seriesTemplate: { nameField: "code" },
                argumentAxis: {
                    valueType: "datetime",
                    label: {
                        format: "yy.MM.dd",
                        overlappingBehavior: {
                            mode: "rotate",
                            rotationAngle: 45
                        }
                    },
                    title: { text: "날짜" }
                },
                valueAxis: {
                    title: "CoF (억원)",
                    visualRange: { startValue: 0, endValue: maxCof },
                    tickInterval: maxCof / 5,
                    endOnTick: false,
                    label: { customizeText: e => Number(e.value).toLocaleString('ko-KR', { maximumFractionDigits: 2 }) }
                },
                legend: {
                    visible: true, position: "bottom",
                    markerShape: 'circle',
                },
                tooltip: { enabled: true }
            });
        }
    </script>

    <script>
        $(function () {
            let historyData = null;
            let histLoaded = false, pofLoaded = false, cofLoaded = false;

            // 1) 최초 한번만 data 불러오기
            function loadHistoryData(callback) {
                if (historyData) return callback();

                window.totalInfoDataHub.getHistory('DC')
                    .done(data => {
                        historyData = data
                            .map(d => {
                                const t = new Date(d.time);
                                t.setHours(0, 0, 0, 0);
                                return { ...d, time: t };
                            })
                            .sort((a, b) => a.time - b.time);

                        callback();
                    })
                    .fail(err => console.error('GetHIPofCofHistory 오류', err));
            }

            // 2) 건전도 차트만 초기 렌더링
            loadHistoryData(() => {
                setupHistoryChart('chart_line01DC', historyData);
                histLoaded = true;
            });

            // 3) 2-depth 탭 클릭 처리
            $('.sub_flex .tab_twodepth .tab_btn').on('click', function () {
                const target = $(this).data('tab');
                $(this)
                    .addClass('on')
                    .siblings().removeClass('on');
                // 컨텐츠 show/hide
                $(this).closest('li').find('.totalInfo_content')
                    .removeClass('on');

                $('#' + target).addClass('on');

                // lazy load Pof / Cof
                if (target === 'chart_line02DC' && !pofLoaded) {
                    loadHistoryData(() => {
                        setupPofChart('chart_line02DC', historyData);
                        pofLoaded = true;
                    });
                }
                if (target === 'chart_line03DC' && !cofLoaded) {
                    loadHistoryData(() => {
                        setupCofChart('chart_line03DC', historyData);
                        cofLoaded = true;
                    });
                }
            });
        });
    </script>
