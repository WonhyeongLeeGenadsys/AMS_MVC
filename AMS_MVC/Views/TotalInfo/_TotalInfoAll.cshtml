    <script>
        $(function () {
            let historyData = null;
            let histLoaded = false, pofLoaded = false, cofLoaded = false;

            // 1) 최초 한번만 data 불러오기
            function loadHistoryData(callback) {
                if (historyData) return callback();

                window.totalInfoDataHub.getHistory('')
                    .done(data => {
                        historyData = data
                            .map(d => {
                                const t = new Date(d.time);
                                t.setHours(0, 0, 0, 0);
                                return { ...d, time: t };
                            })
                            .sort((a, b) => a.time - b.time);

                        callback();
                    })
                    .fail(err => console.error('GetHIPofCofHistory 오류', err));
            }

            // 2) 건전도 차트만 초기 렌더링
            loadHistoryData(() => {
                setupHistoryChart('chart_line01', historyData);
                histLoaded = true;
            });

            // 3) 2-depth 탭 클릭 처리
            $('.sub_flex .tab_twodepth .tab_btn').on('click', function () {
                const target = $(this).data('tab');
                $(this)
                    .addClass('on')
                    .siblings().removeClass('on');
                // 컨텐츠 show/hide
                $(this).closest('li').find('.totalInfo_content')
                    .removeClass('on');

                $('#' + target).addClass('on');

                if (target === 'chart_line02' && !pofLoaded) {
                    loadHistoryData(() => {
                        setupPofChart('chart_line02', historyData);
                        pofLoaded = true;
                    });
                }
                if (target === 'chart_line03' && !cofLoaded) {
                    loadHistoryData(() => {
                        setupCofChart('chart_line03', historyData);
                        cofLoaded = true;
                    });
                }
            });
        });
    </script>
