    @*유지보수 스크립트*@
    <script>
        $(function () {
            const urlDM = '@Url.Action("GetDMDecisionInfo","TotalInfo")';
            const decisionStyles = {
                '즉시 교체': { color: '#d32f2f', background: '#ffebee' },
                '긴급 유지보수': { color: '#ef6c00', background: '#fff3e0' },
                '예방 유지보수': { color: '#9a7b00', background: '#fffde7' },
                '정기점검': { color: '#1976d2', background: '#e3f2fd' },
                '계속 감시': { color: '#2e7d32', background: '#e8f5e9' },
                '데이터 확인 필요': { color: '#666666', background: '#f2f2f2' }
            };

            function appendText(target, text) {
                target.append(document.createTextNode(text));
            }

            function appendDecisionBadge(target, decision, count) {
                const style = decisionStyles[decision] || decisionStyles['데이터 확인 필요'];
                target.append(
                    $('<strong>')
                        .text(`${decision} ${count}대`)
                        .css({
                            color: style.color,
                            backgroundColor: style.background,
                            borderRadius: '4px',
                            padding: '2px 6px'
                        })
                );
            }

            function loadStrategy(prefix, selector, label) {
                $.getJSON(urlDM, { prefix: prefix })
                    .done(function (result) {
                        if (!result || result.success === false) {
                            $(selector).text(label + ' 의사결정 데이터를 불러오지 못했습니다.');
                            return;
                        }

                        const s = result.summary;
                        const target = $(selector).empty();
                        appendText(target, `${label} ${s.Total}대: `);
                        const decisions = [
                            { name: '즉시 교체', count: s.ReplaceImmediate },
                            { name: '긴급 유지보수', count: s.UrgentMaintenance },
                            { name: '예방 유지보수', count: s.PreventiveMaintenance },
                            { name: '정기점검', count: s.ScheduledInspection },
                            { name: '계속 감시', count: s.ContinueMonitoring },
                            { name: '데이터 확인 필요', count: s.DataRequired }
                        ].filter(function (item) {
                            return Number(item.count) > 0;
                        });

                        decisions.forEach(function (item, index) {
                            if (index > 0) appendText(target, ', ');
                            appendDecisionBadge(target, item.name, item.count);
                        });

                        if (decisions.length === 0) {
                            appendText(target, '해당 없음');
                        }

                        if (s.TopName || s.TopCode) {
                            const style = decisionStyles[s.TopDecision] || decisionStyles['데이터 확인 필요'];
                            appendText(target, '. 최우선: ');
                            target.append(
                                $('<strong>')
                                    .text(`${s.TopName || s.TopCode} - ${s.TopDecision} (${s.TopAction})`)
                                    .css({
                                        color: style.color,
                                        backgroundColor: style.background,
                                        borderRadius: '4px',
                                        padding: '2px 6px'
                                    })
                            );
                        }
                        appendText(target, '.');
                    })
                    .fail(function () {
                        $(selector).text(label + ' 의사결정 데이터를 불러오지 못했습니다.');
                    });
            }

            loadStrategy('', '#strategyAll', '전체');
            loadStrategy('AC', '#strategyAC, #strategyACPanel', 'AC');
            loadStrategy('DC', '#strategyDC, #strategyDCPanel', 'DC');
        });
    </script>

    @*건전도 파이 스크립트*@
    <script>
        $(function () {
            // 데이터 가져오기 및 차트 설정
            $.getJSON('@Url.Action("GetRiskMapPoints", "TotalInfo")', { prefix: '' })
                .done(function (rawPoints) {
                    // 2) HI 별로 묶어서 대수(count)와 장비 리스트(codes) 계산
                    const buckets = rawPoints.reduce((acc, p) => {
                        const hi = p.hi;            // RiskmatrixController에서 내려주는 hi 필드
                        if (!acc[hi]) {
                            acc[hi] = { hi, codes: [] };
                        }
                        acc[hi].codes.push(p.name); // name은 "VCB001" 같은 코드
                        return acc;
                    }, {});

                    // 3) dxPieChart용 배열로 변환
                    const ds = Object.values(buckets)
                        .map(b => ({
                            hi: b.hi,
                            state: b.hi === 0 ? '등급 미정' : b.hi + '등급',
                            value: b.codes.length,
                            codes: b.codes
                        }))
                        .sort((a, b) => a.hi - b.hi);  // 등급 오름차순으로 정렬

                    // 4) 차트 초기화
                    $('#pieAll').dxPieChart({
                        type: 'doughnut',
                        dataSource: ds,
                        customizePoint: pt => ({ color: getHiColor(pt.data.hi) }),
                        series: [{
                            argumentField: 'state',
                            valueField: 'value',
                            label: {
                                visible: true,
                                connector: { visible: true },
                                customizeText: e => e.valueText + '대'
                            }
                        }],
                        legend: {
                            visible: true,
                            verticalAlignment: 'bottom',
                            horizontalAlignment: 'center',
                            markerShape: 'circle',
                        },
                        size: { width: '100%', height: 300 },
                        innerRadius: 0.5,
                        tooltip: {
                            enabled: true,
                            customizeTooltip: function (info) {
                                const d = info.point.data;
                                const serialNumbersText = d.codes.length > 0 ? d.codes.join(', ') : '없음';
                                return {
                                    html: `
                <strong>${d.state}</strong><br/>
                대수: ${d.value}대<br/>
                장비: ${serialNumbersText}`
                                };
                            }
                        },
                        onPointClick: function (e) {
                            e.target.showTooltip();
                        }
                    });

                    // HI 별 색상 매핑
                    function getHiColor(hi) {
                        switch (hi) {
                            case 1: return '#5B9F56';
                            case 2: return '#B4DEB1';
                            case 3: return '#EBCD1D';
                            case 4: return '#F18425';
                            case 5: return '#F05153';
                            default: return '#888888';
                        }
                    }
                })
                .fail(function (err) {
                    console.error('GetRiskMapPoints 오류', err);
                });
        });
    </script>

    <!-- Risk Matrix (전체) -->
    <script>
        $(function () {
            $.getJSON('@Url.Action("GetRiskMapPoints","TotalInfo")', { prefix: 'all' })
                .done(function (raw) {
                    const data = raw.map(p => ({
                        x: p.x, y: p.y, name: p.name, group: p.group
                    }));

                    $("#chartContainerAll").dxChart({
                        dataSource: data,
                        commonSeriesSettings: {
                            type: "scatter",
                            argumentField: "x",
                            valueField: "y",
                            point: { size: 10 }
                        },
                        palette: ['#34A369', '#B82069', '#F57B50', '#2B6D6F', '#38B295', '#DC9FF1', '#EBCC44', '#CFD94D', '#E43387', '#002C68'],
                        border: {
                            visible: false // 차트 전체의 외곽선(테두리)을 숨깁니다.
                        },
                        seriesTemplate: { nameField: "group" },
                        argumentAxis: {
                            visualRange: { startValue: 0, endValue: 40000 },
                            valueMarginsEnabled: false, // 여백 제거
                            tickInterval: 8000,
                            grid: {
                                visible: true,
                                opacity: 0.5,
                                color: '#ffffff',
                                width: 1
                            },
                            title: { text: "CoF ($)" },
                            label: { customizeText: e => e.value.toLocaleString() }
                        },
                        valueAxis: {
                            // 0~100% 딱 고정
                            visualRange: { startValue: 0, endValue: 100 },
                            endOnTick: false,
                            valueMarginsEnabled: false, // 여백 제거
                            tickInterval: 20,
                            min: 0,
                            max: 5,
                            grid: {
                                visible: true,
                                opacity: 0.5,
                                color: '#ffffff',
                                width: 1
                            },
                            title: { text: "PoF (%)" },
                            label: { customizeText: e => e.value.toFixed(0) + "%" },
                        },
                        tooltip: {
                            enabled: true,
                            location: 'edge',
                            customizeTooltip: info => {
                                const d = info.point.data;
                                return {
                                    html:
                                        `<strong>${d.name}</strong><br/>
                CoF: ${d.x.toLocaleString()}$<br/>
                PoF: ${d.y.toFixed(2)}%`
                                };
                            }
                        },
                        onPointClick(e) {
                            const d = e.target.originalData;
                            alert(`코드: ${d.name}\nCoF: ${d.x.toLocaleString()}$\nPoF: ${d.y.toFixed(2)}%`);
                        },
                        legend: {
                            visible: true, position: "bottom",
                            verticalAlignment: 'bottom',
                            horizontalAlignment: 'center',
                            markerShape: 'circle',
                        },
                        size: { width: 400, height: 300 },
                        margin: 0,
                    });
                });
        });
    </script>

    @* 이력 차트 hi, pof, cof *@
    <script>
        // 전체(all) 용: HI 이력
        function setupHistoryChart(containerId, history) {
            $("#" + containerId).dxChart({
                dataSource: history,
                commonSeriesSettings: {
                    type: "line",
                    argumentField: "time",
                    valueField: "hi",
                    point: { visible: true }
                },
                seriesTemplate: { nameField: "code" },
                argumentAxis: {
                    valueType: "datetime",
                    label: {
                        format: "yy.MM.dd",
                        overlappingBehavior: {
                            mode: "rotate",
                            rotationAngle: 45
                        }
                    },
                    title: { text: "날짜" }
                },
                valueAxis: {
                    title: "HI",
                    visualRange: { startValue: 0, endValue: 5 },
                    tickInterval: 1,
                    endOnTick: false,
                    max: 5
                },
                legend: {
                    visible: true,
                    verticalAlignment: "bottom",
                    horizontalAlignment: "center",
                    orientation: "horizontal",
                    markerShape: 'circle',
                },
                tooltip: { enabled: true }
            });
        }

        // 전체(all) 용: PoF 이력
        function setupPofChart(containerId, history) {
            $("#" + containerId).dxChart({
                dataSource: history,
                commonSeriesSettings: {
                    type: "line",
                    argumentField: "time",
                    valueField: "pof",
                    point: { visible: true }
                },
                seriesTemplate: { nameField: "code" },
                argumentAxis: {
                    valueType: "datetime",
                    label: {
                        format: "yy.MM.dd",
                        overlappingBehavior: {
                            mode: "rotate",
                            rotationAngle: 45
                        }
                    },
                    title: { text: "날짜" }
                },
                valueAxis: {
                    title: "PoF (%)",
                    visualRange: { startValue: 0, endValue: 100 },
                    tickInterval: 20,
                    endOnTick: false,
                    max: 100
                },
                legend: {
                    visible: true,
                    verticalAlignment: "bottom",
                    horizontalAlignment: "center",
                    orientation: "horizontal",
                    markerShape: 'circle',
                },
                tooltip: { enabled: true }
            });
        }

        // 전체(all) 용: CoF 이력
        function setupCofChart(containerId, history) {
            $("#" + containerId).dxChart({
                dataSource: history,
                commonSeriesSettings: {
                    type: "line",
                    argumentField: "time",
                    valueField: "cof",
                    point: { visible: true }
                },
                seriesTemplate: { nameField: "code" },
                argumentAxis: {
                    valueType: "datetime",
                    label: {
                        format: "yy.MM.dd",
                        overlappingBehavior: {
                            mode: "rotate",
                            rotationAngle: 45
                        }
                    },
                    title: { text: "날짜" }
                },
                valueAxis: {
                    title: "CoF",
                    visualRange: { startValue: 8000, endValue: 40000 },
                    tickInterval: 8000,
                    endOnTick: false,
                    label: { customizeText: e => e.valueText + "$" }
                },
                legend: {
                    visible: true,
                    verticalAlignment: "bottom",
                    horizontalAlignment: "center",
                    orientation: "horizontal",
                    markerShape: 'circle',
                },
                tooltip: { enabled: true }
            });
        }
    </script>

    <script>
        $(function () {
            const urlHist = '@Url.Action("GetHIPofCofHistory","TotalInfo")';
            let historyData = null;
            let histLoaded = false, pofLoaded = false, cofLoaded = false;

            // 1) 최초 한번만 data 불러오기
            function loadHistoryData(callback) {
                if (historyData) return callback();

                $.getJSON(urlHist, { prefix: '' })
                    .done(data => {
                        historyData = data
                            .map(d => {
                                const t = new Date(d.time);
                                t.setHours(0, 0, 0, 0);
                                return { ...d, time: t };
                            })
                            .sort((a, b) => a.time - b.time);

                        callback();
                    })
                    .fail(err => console.error('GetHIPofCofHistory 오류', err));
            }

            // 2) 건전도 차트만 초기 렌더링
            loadHistoryData(() => {
                setupHistoryChart('chart_line01', historyData);
                histLoaded = true;
            });

            // 3) 2-depth 탭 클릭 처리
            $('.sub_flex .tab_twodepth .tab_btn').on('click', function () {
                const target = $(this).data('tab');
                $(this)
                    .addClass('on')
                    .siblings().removeClass('on');
                // 컨텐츠 show/hide
                $(this).closest('li').find('.totalInfo_content')
                    .removeClass('on');

                $('#' + target).addClass('on');

                if (target === 'chart_line02' && !pofLoaded) {
                    loadHistoryData(() => {
                        setupPofChart('chart_line02', historyData);
                        pofLoaded = true;
                    });
                }
                if (target === 'chart_line03' && !cofLoaded) {
                    loadHistoryData(() => {
                        setupCofChart('chart_line03', historyData);
                        cofLoaded = true;
                    });
                }
            });
        });
    </script>
</div>
