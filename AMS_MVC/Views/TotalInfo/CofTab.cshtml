@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section LeftMenu {
    @Html.Partial("_TotalInfoMenu")
}

@section MainContent {
    <h1>CoF($) 전체 이력</h1>

    <div class="con_box">
        <div class="content_warp">
            <div id="cofBigChart" style="width:100%; height:600px;"></div>
        </div>
    </div>
}

@section Scripts {
    <script>
        $(function () {
            const urlHist = '@Url.Action("GetHIPofCofHistory","TotalInfo")';

            $.getJSON(urlHist, { prefix: '' })
                .done(data => {
                    const history = data.map(d => {
                        const t = new Date(d.time);
                        t.setHours(0,0,0,0);
                        return { ...d, time: t };
                    }).sort((a, b) => a.time - b.time);

                    $("#cofBigChart").dxChart({
                        dataSource: history,
                        commonSeriesSettings: {
                            type: "line",
                            argumentField: "time",
                            valueField: "cof",
                            point: { visible: true }
                        },
                        seriesTemplate: { nameField: "code" },
                        argumentAxis: {
                            valueType: "datetime",
                            label: {
                                format: "yy.MM.dd",
                                overlappingBehavior: { mode: "rotate", rotationAngle: 45 }
                            },
                            title: { text: "날짜" }
                        },
                        valueAxis: {
                            title: "CoF ($)",
                            visualRange: { startValue: 8000, endValue: 40000 },
                            tickInterval: 8000,
                            endOnTick: false,
                            label: { customizeText: e => e.value.toLocaleString() + "$" }
                        },
                        legend: {
                            visible: true,
                            verticalAlignment: "bottom",
                            horizontalAlignment: "center",
                            orientation: "horizontal",
                            markerShape: "circle"
                        },
                        tooltip: {
                            enabled: true,
                            customizeTooltip: info => {
                                const d = info.point.data;
                                return { html:
                                  `<strong>${d.code}</strong><br/>
                                   날짜: ${DevExpress.localization.formatDate(d.time, "yy.MM.dd")}<br/>
                                   CoF: ${Number(d.cof||0).toLocaleString()}$`
                                };
                            }
                        },
                        size: { height: 600 }
                    });
                })
                .fail(err => console.error('CofTab 오류', err));
        });
    </script>
}
