@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section LeftMenu {
    @Html.Partial("_GojangMenu")
}

@section MainContent {
    <h1>DCCB 고장이력</h1>

    <div class="con_box">
        <div class="content_warp">
            <div class="btn_area top right">
                <a href="@Url.Action("DCCBGojangAdd", "DCCBGojang")" class="btn add blue">추가</a>
            </div>
            <div id="gridContainer" class="grid_wrap"></div>
        </div>

        <script>
            $(document).ready(function () {
                loadDCCBGojangData();
            });

            function loadDCCBGojangData() {

                $.ajax({
                    type: "POST",
                    url: '@Url.Action("GetTotalDCCBGojangListData", "DCCBGojang")',
                    contentType: "application/json; charset=utf-8",
                    success: function (response) {
                        if (response.success == false) {
                            console.error("DCCBGojang 데이터 로드 실패: " + response.message);
                            return;
                        }

                        // 작성일(Tbl_GetDate) 기준 내림차순 정렬
                        let data = response.sort((a, b) => new Date(b.Tbl_GetDate) - new Date(a.Tbl_GetDate));

                        // 순번 매기기
                        data = data.map((item, index) => {
                            item.RowNumber = data.length - index;
                            return item;
                        });

                        $("#gridContainer").dxDataGrid({
                            dataSource: data,
                            columnFixing: { enabled: true },
                            columns: [
                                { dataField: "RowNumber", caption: "순번", width: 80 },
                                { dataField: "Name", caption: "제품이름", alignment: "center" },
                                { dataField: "Serial_No", caption: "시리얼번호", alignment: "center" },
                                { dataField: 'Fail_Gojang_Name', caption: '고장명', alignment: 'center', width: 'auto' },
                                { dataField: 'Fail_Weather', caption: '날씨', alignment: 'center', width: 'auto' },
                                { dataField: 'Fail_Temp', caption: '기온(°C)', alignment: 'center', width: 'auto' },
                                { dataField: 'Fail_Hum', caption: '습도(%)', alignment: 'center', width: 'auto' },
                                { dataField: 'Fail_Cause', caption: '원인', alignment: 'center', width: 'auto' },
                                { dataField: 'Fail_Reason', caption: '발견동기', alignment: 'center', width: 'auto' },
                                { dataField: 'Fail_Status', caption: '상태', alignment: 'center', width: 'auto' },
                                { dataField: 'Fail_Part', caption: '부품', alignment: 'center', width: 'auto' },
                                { dataField: 'Fail_Period', caption: '기간', alignment: 'center', width: 'auto' },
                                { dataField: 'Fail_Finder', caption: '발견자', alignment: 'center', width: 'auto' },
                                { dataField: 'Fail_Repairer', caption: '보수자', alignment: 'center', width: 'auto' },
                                { dataField: 'Fail_Supervisor', caption: '관리자', alignment: 'center', width: 'auto' },
                                { dataField: 'Fail_Registrar', caption: '등록자', alignment: 'center', width: 'auto' },
                                { dataField: 'Fail_Repair_Date', caption: '고장일', alignment: 'center', width: 'auto' },
                                { dataField: 'Fail_Writer', caption: '작성자', alignment: 'center', width: 'auto' }

                            ],
                            showBorders: false,
                            searchPanel: { visible: true, width: 240, placeholder: "검색" },
                            filterRow: { visible: true, applyFilter: 'auto' },
                            headerFilter: { visible: true },
                            loadPanel: { enabled: true },
                            scrolling: { columnRenderingMode: 'virtual' },
                            onRowClick: function (e) {
                                const tblIdx = e.data.Tbl_Idx;
                                const dccbCode = e.data.DCCB_Code;

                                var baseUrl = window.location.origin;
                                var detailUrl = '@Url.Action("DCCBGojangDetail", "DCCBGojang")';

                                window.location.href = baseUrl + detailUrl + "?dccbCode=" + encodeURIComponent(dccbCode) + "&tblIdx=" + encodeURIComponent(tblIdx);
                            }
                        });
                    },
                        error: function (xhr, status, error) {
                            console.error("데이터 로드 중 오류", error);
                        }
                });
            }
        </script>
    </div>
}
