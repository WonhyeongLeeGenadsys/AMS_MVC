@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var vcbCode = Request.QueryString["vcbCode"] ?? "";
    var tblIdx = Request.QueryString["tblIdx"] ?? "";
}

@section LeftMenu {
    @Html.Partial("_GojangMenu")
}

@section MainContent {
    <h1>VCB 고장 상세정보</h1>
    <div class="con_box">
        <div class="content_warp">
            <div class="btn_area top right">
                <p>
                    <!-- 삭제 버튼: 클릭 시 deleteGojang() 함수 호출 -->
                    <a href="javascript:void(0);" class="btn red del" onclick="deleteGojang('@vcbCode', '@tblIdx');">삭제</a>
                    <a href="@Url.Action("VCBGojangUpdate", "VCBGojang", new { vcbCode = vcbCode, tblIdx = tblIdx })" class="btn blue edit">수정</a>
                 </p>
            </div>

            <div class="table_app" id="vcbGojang">
                <table>
                    <colgroup>
                        <col style="width:100px;" />
                        <col style="width:calc(33.3% - 100px);" />
                        <col style="width:100px;" />
                        <col style="width:calc(33.3% - 100px);" />
                        <col style="width:100px;" />
                        <col style="width:calc(33.3% - 100px);" />
                    </colgroup>
                    <tr>
                        <th>고장명</th>
                        <td colspan="5">
                            @Model.Fail_Gojang_Name
                        </td>
                    </tr>
                    <tr>
                        <th>날씨</th>
                        <td>@Model.Fail_Weather</td>
                        <th>기온</th>
                        <td>@Model.Fail_Temp</td>
                        <th>습도</th>
                        <td>@Model.Fail_Hum</td>
                    </tr>
                    <tr>
                        <th>원인</th>
                        <td colspan="5">@Model.Fail_Cause</td>
                    </tr>
                    <tr>
                        <th>발견동기</th>
                        <td>@Model.Fail_Reason</td>
                        <th>상태</th>
                        <td>@Model.Fail_Status</td>
                        <th>부품</th>
                        <td>@Model.Fail_Part</td>
                    </tr>
                    <tr>
                        <th>기간</th>
                        <td>@Model.Fail_Period</td>
                        <th>발견자</th>
                        <td>@Model.Fail_Finder</td>
                        <th>보수자</th>
                        <td>@Model.Fail_Repairer</td>
                    </tr>
                    <tr>
                        <th>감독자</th>
                        <td>@Model.Fail_Supervisor</td>
                        <th>보수일</th>
                        <td>@Model.Fail_Repair_Date</td>
                        <th></th>
                        <td></td>
                    </tr>
                </table>
            </div>
        </div>
    </div>

    <script type="text/javascript">
        function deleteGojang(vcbCode, tblIdx) {
            if (confirm("정말 삭제하시겠습니까?")) {
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("VCBGojangDelete", "VCBGojang")',
                    data: JSON.stringify({ vcbCode: vcbCode, tblIdx: tblIdx }),
                    contentType: "application/json; charset=utf-8",
                    success: function (response) {
                        if (response.success) {
                            alert("VCB 고장 정보가 삭제되었습니다.");
                            window.location.href = '@Url.Action("VCBGojangTotalList", "VCBGojang")';
                        } else {
                            alert("VCB 고장 정보 삭제 실패: " + response.message);
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error("삭제 중 오류:", xhr.responseText || status, error);
                        alert("삭제 중 오류가 발생했습니다: " + xhr.responseText);
                    }
                });
            }
        }
    </script>
}
