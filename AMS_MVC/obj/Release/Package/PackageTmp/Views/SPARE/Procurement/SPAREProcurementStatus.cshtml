@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section LeftMenu {
    @Html.Partial("_SPAREMenu")
}

@section MainContent {
    <h1>예비품 발주관리</h1>

    <div class="con_box">
        <div class="content_warp spare-proc-dashboard">

            <div class="proc-chart-box">
                <div class="proc-chart-header">
                    <h2>부품별 발주 비용 Top 20</h2>
                </div>

                <div id="procurementTopChart" class="proc-chart-area"></div>
            </div>

        </div>
    </div>

    <style>
        .spare-proc-dashboard {
            padding-top: 10px;
        }

        .proc-chart-box {
            background: #fff;
            border-radius: 10px;
            padding: 12px 16px 16px 16px;
            box-shadow: 2px 2px 4px rgba(0,0,0,0.08);
        }

        .proc-chart-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
        }

            .proc-chart-header h2 {
                margin: 0;
                font-size: 16px;
                font-weight: 800;
            }

        .proc-chart-area {
            height: 340px;
        }
    </style>

    <script>
        $(document).ready(function () {
            initProcurementChart();
            loadProcurementStatus();
        });

        function initProcurementChart() {
            $("#procurementTopChart").dxChart({
                dataSource: [],
                rotated: true,
                commonSeriesSettings: {
                    argumentField: "PART_NAME",
                    type: "bar",
                    ignoreEmptyPoints: true
                },
                series: [
                    {
                        valueField: "TOTAL_PROC_COST_MANWON",
                        name: "발주 비용",
                        label: {
                            visible: true,
                            position: "outside",
                            backgroundColor: "none",
                            customizeText: function (arg) {
                                return formatManwon(arg.value);
                            }
                        }
                    }
                ],
                legend: {
                    visible: false
                },
                argumentAxis: {
                    label: {
                        overlappingBehavior: "stagger",
                        font: {
                            size: 12
                        }
                    }
                },
                valueAxis: {
                    title: "발주 비용 (원)",
                    label: {
                        customizeText: function (arg) {
                            return formatAxisManwon(arg.value);
                        }
                    }
                },
                tooltip: {
                    enabled: true,
                    customizeTooltip: function (arg) {
                        return {
                            text: arg.argumentText + "<br/>" + formatManwon(arg.value)
                        };
                    }
                }
            });
        }

        function loadProcurementStatus() {
            $.ajax({
                type: "POST",
                url: '@Url.Action("GetSPAREProcurementStatusData", "SpareDashboard")',
                data: {
                    assetTypeId: null,
                    status: null
                },
                success: function (response) {
                    console.log("procurement response:", response);

                    if (!response || !response.success) {
                        alert("발주관리 데이터를 불러오지 못했습니다.");
                        return;
                    }

                    renderProcurementStatus(response);
                },
                error: function (xhr) {
                    console.log("AJAX ERROR:", xhr.responseText);
                    alert("오류 발생: " + xhr.responseText);
                }
            });
        }

        function renderProcurementStatus(data) {
            const topCostRows = Array.isArray(data.topCostRows) ? data.topCostRows : [];

            const chartData = topCostRows.map(x => ({
                PART_NAME: x.PART_NAME,
                TOTAL_PROC_COST: Number(x.TOTAL_PROC_COST || 0),
                TOTAL_PROC_COST_MANWON: Number(x.TOTAL_PROC_COST || 0) / 10000
            }));

            const chart = $("#procurementTopChart").dxChart("instance");
            if (chart) {
                chart.option("dataSource", chartData);
            }
        }

        function formatManwon(value) {
            const v = Number(value || 0);
            return v.toLocaleString() + "만원";
        }

        function formatAxisManwon(value) {
            const v = Number(value || 0);
            if (v >= 10000) {
                return (v / 10000) + "만원";
            }
            if (v >= 1000) {
                return (v / 1000) + "k";
            }
            return v.toLocaleString();
        }
    </script>
}