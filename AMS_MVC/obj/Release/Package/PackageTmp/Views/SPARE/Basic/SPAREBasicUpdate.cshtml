@model Web.Common.SPAREPartInfo

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var assetTypeIds = ViewBag.AssetTypeIds as List<int> ?? new List<int>();
}

@section LeftMenu {
    @Html.Partial("_SPAREMenu")
}

@section MainContent {
    <h1>예비품 기본정보 수정</h1>

    <div class="con_box">
        <div class="content_warp">
            <div class="btn_area top right">
                <p>
                    <a href="javascript:void(0)" class="btn blue app" onclick="updateSpareBasicInfo()">저장</a>
                </p>
            </div>

            <form id="spareForm" method="post">
                <input type="hidden" name="SPARE_ID" value="@Model.SPARE_ID" />

                <div class="table_app">
                    <table>
                        <tr>
                            <th>부품번호</th>
                            <td><input type="text" name="PART_NUMBER" value="@Model.PART_NUMBER" required></td>
                            <th>부품명</th>
                            <td><input type="text" name="PART_NAME" value="@Model.PART_NAME" required></td>
                        </tr>
                        <tr>
                            <th>중요도 등급</th>
                            <td>
                                <select name="CRITICALITY_GRADE">
                                    <option value="CRITICAL" @(Model.CRITICALITY_GRADE == "CRITICAL" ? "selected" : "")>CRITICAL - 핵심 부품</option>
                                    <option value="HIGH" @(Model.CRITICALITY_GRADE == "HIGH" ? "selected" : "")>HIGH - 주요 부품</option>
                                    <option value="MEDIUM" @(Model.CRITICALITY_GRADE == "MEDIUM" ? "selected" : "")>MEDIUM - 일반 부품</option>
                                    <option value="LOW" @(Model.CRITICALITY_GRADE == "LOW" ? "selected" : "")>LOW - 소모품</option>
                                </select>
                            </td>
                            <th>단가</th>
                            <td><input type="number" name="UNIT_PRICE" value="@Model.UNIT_PRICE" min="0" step="1" required><span>원</span></td>
                        </tr>
                        <tr>
                            <th>납기일</th>
                            <td><input type="number" name="LEAD_TIME_DAYS" value="@Model.LEAD_TIME_DAYS" min="0" step="1" required><span>일</span></td>
                            <th>사용 여부</th>
                            <td>
                                <label class="ty_rdo">
                                    <input type="radio" name="IS_ACTIVE" value="true" @((Model.IS_ACTIVE ?? false) ? "checked" : "")><span>사용</span>
                                </label>
                                <label class="ty_rdo">
                                    <input type="radio" name="IS_ACTIVE" value="false" @(!(Model.IS_ACTIVE ?? false) ? "checked" : "")><span>미사용</span>
                                </label>
                            </td>
                        </tr>
                        <tr>
                            <th>연결 설비유형</th>
                            <td colspan="3">
                                <label class="ty_chk"><input type="checkbox" name="asset_type_ids" value="1" @(assetTypeIds.Contains(1) ? "checked" : "")><span>VCB</span></label>
                                <label class="ty_chk"><input type="checkbox" name="asset_type_ids" value="2" @(assetTypeIds.Contains(2) ? "checked" : "")><span>DCCB</span></label>
                                <label class="ty_chk"><input type="checkbox" name="asset_type_ids" value="3" @(assetTypeIds.Contains(3) ? "checked" : "")><span>SUBMODULE</span></label>
                                <label class="ty_chk"><input type="checkbox" name="asset_type_ids" value="4" @(assetTypeIds.Contains(4) ? "checked" : "")><span>DCCABLE</span></label>
                                <label class="ty_chk"><input type="checkbox" name="asset_type_ids" value="5" @(assetTypeIds.Contains(5) ? "checked" : "")><span>INTERFACETR</span></label>
                            </td>
                        </tr>
                    </table>
                </div>
            </form>
        </div>
    </div>

    <script>
        function updateSpareBasicInfo() {
            var form = document.getElementById("spareForm");

            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            if ($(form).find('input[name="asset_type_ids"]:checked').length === 0) {
                alert("연결 설비유형을 한 개 이상 선택하세요.");
                return;
            }

            var formData = new FormData(form);

            $.ajax({
                url: '@Url.Action("UpdateSPAREBasicInfo", "SPAREBasic")',
                type: "POST",
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {
                    if (response.success) {
                        alert("예비품 기본정보가 수정되었습니다.");
                        window.location.href = '@Url.Action("SPAREBasicDetail", "SPAREBasic")' + '?spareId=@Model.SPARE_ID';
                    } else {
                        alert("수정 실패: " + response.message);
                    }
                },
                error: function (xhr) {
                    alert("오류 발생: " + xhr.responseText);
                }
            });
        }
    </script>
}
