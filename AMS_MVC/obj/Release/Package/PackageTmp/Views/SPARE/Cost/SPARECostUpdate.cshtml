@model Web.Common.CostManagementInfo
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section LeftMenu {
    @Html.Partial("_SPAREMenu")
}

@section MainContent {
    <h1>예비품 비용계획 수정</h1>

    <div class="con_box">
        <div class="content_warp">
            <div class="btn_area top right">
                <a href="javascript:void(0)" class="btn blue app" onclick="updateCost()">저장</a>
            </div>

            <form id="costForm">
                <input type="hidden" name="COST_ID" value="@Model.COST_ID" />
                <input type="hidden" name="SPARE_ID" value="@Model.SPARE_ID" />

                <div class="table_app">
                    <table>
                        <tr>
                            <th>회계연도</th>
                            <td><input type="text" name="FISCAL_YEAR" value="@Model.FISCAL_YEAR" data-type="number" /></td>
                            <th>예산금액</th>
                            <td><input type="text" name="BUDGET_AMOUNT" value="@Model.BUDGET_AMOUNT" data-type="number" /></td>
                        </tr>
                        <tr>
                            <th>실제금액</th>
                            <td><input type="text" name="ACTUAL_AMOUNT" value="@Model.ACTUAL_AMOUNT" data-type="number" /></td>
                            <th></th>
                            <td></td>
                        </tr>
                    </table>
                </div>
            </form>
        </div>
    </div>

    <script>
        function updateCost() {
            var formData = new FormData(document.getElementById("costForm"));

            $.ajax({
                url: '@Url.Action("UpdateCost", "SPARECost")',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {
                    if (response.success) {
                        alert("비용계획 수정 성공");
                        location.href = '@Url.Action("SPARECostList", "SPARECost")';
                    } else {
                        alert(response.message);
                    }
                }
            });
        }
    </script>
}