@model Web.Common.CostManagementInfo
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var sparePart = ViewBag.SparePart as Web.Common.SPAREPartInfo;
}

@section LeftMenu {
    @Html.Partial("_SPAREMenu")
}

@section MainContent {
    <h1>예비품 비용계획 추가</h1>

    <div class="con_box">
        <div class="content_warp">
            <div class="btn_area top right">
                <a href="javascript:void(0)" class="btn blue app" onclick="saveCost()">저장</a>
            </div>

            <form id="costForm">
                <input type="hidden" name="SPARE_ID" value="@Model.SPARE_ID" />

                <div class="table_app">
                    <table>
                        <tr>
                            <th>부품번호</th>
                            <td>@(sparePart?.PART_NUMBER ?? "")</td>
                            <th>부품명</th>
                            <td>@(sparePart?.PART_NAME ?? "")</td>
                        </tr>
                        <tr>
                            <th>회계연도</th>
                            <td><input type="text" name="FISCAL_YEAR" data-type="number" /></td>
                            <th>예산금액</th>
                            <td><input type="text" name="BUDGET_AMOUNT" data-type="number" /></td>
                        </tr>
                        <tr>
                            <th>실제금액</th>
                            <td colspan="3"><input type="text" name="ACTUAL_AMOUNT" data-type="number" /></td>
                        </tr>
                    </table>
                </div>
            </form>
        </div>
    </div>

    <script>
        function saveCost() {
            var formData = new FormData(document.getElementById("costForm"));

            $.ajax({
                url: '@Url.Action("SaveCost", "SPARECost")',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {
                    if (response.success) {
                        alert("비용계획 등록 성공");
                        location.href = '@Url.Action("SPARECostList", "SPARECost")';
                    } else {
                        alert(response.message);
                    }
                }
            });
        }
    </script>
}
