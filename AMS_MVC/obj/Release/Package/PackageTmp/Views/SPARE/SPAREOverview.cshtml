@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section LeftMenu {
    @Html.Partial("_SPAREMenu")
}

@section MainContent {
    <h1>예비품 종합현황</h1>

    <div class="con_box">
        <div class="content_warp spare-dashboard">

            <div class="spare-kpi-row">
                <div class="spare-kpi-card blue">
                    <div class="kpi-title">총 부품 수</div>
                    <div class="kpi-value" id="kpiTotalCount">0</div>
                    <div class="kpi-desc">등록 예비품</div>
                </div>

                <div class="spare-kpi-card orange">
                    <div class="kpi-title">발주 예산</div>
                    <div class="kpi-value" id="kpiBudget">0</div>
                    <div class="kpi-desc">연간 발주 계획</div>
                </div>

                <div class="spare-kpi-card red">
                    <div class="kpi-title">필수(CRITICAL) 부품</div>
                    <div class="kpi-value" id="kpiCriticalCount">0</div>
                    <div class="kpi-desc danger">재고 부족 품목 포함</div>
                </div>

                <div class="spare-kpi-card green">
                    <div class="kpi-title">재고 가치</div>
                    <div class="kpi-value" id="kpiInventoryValue">0</div>
                    <div class="kpi-desc">현재 총 재고 자산</div>
                </div>

                <div class="spare-kpi-card sky">
                    <div class="kpi-title">평균 납기</div>
                    <div class="kpi-value" id="kpiLeadTime">0</div>
                    <div class="kpi-desc">CRITICAL 기준 포함</div>
                </div>
            </div>

            <div class="spare-chart-row">
                <div class="spare-chart-box">
                    <div class="chart-header">
                        <h2>중요도별 부품 분포</h2>
                    </div>

                    <div class="chart-donut-wrap">
                        <div id="chartCriticality" class="chart-area"></div>
                    </div>
                </div>

                <div class="spare-chart-box">
                    <div class="chart-header">
                        <h2>설비 유형별 예비품 비용</h2>
                    </div>
                    <div id="chartAssetCost" class="chart-area"></div>
                </div>
            </div>

            <div class="spare-chart-row">
                <div class="spare-chart-box">
                    <div class="chart-header">
                        <h2>재고 부족 위험 (안전재고 미달)</h2>
                    </div>
                    <div id="chartShortage" class="chart-area"></div>
                </div>

                <div class="spare-chart-box">
                    <div class="chart-header">
                        <h2>납기 vs 부품수량</h2>
                    </div>
                    <div id="chartLeadScatter" class="chart-area"></div>
                </div>
            </div>

            <div class="spare-demand-box">
                <div class="demand-header">
                    <div>
                        <h2>DM 기반 예비품 수요예측</h2>
                        <p>필요수량 × 의사결정별 교체비율 × PoF × 납기 안전계수</p>
                    </div>
                    <div class="demand-summary">
                        <span>예측 품목 <strong id="forecastPartCount">0</strong></span>
                        <span>부족 품목 <strong id="forecastShortageCount">0</strong></span>
                        <span>권장수량 <strong id="forecastRecommendedQty">0</strong></span>
                        <span>예상비용 <strong id="forecastExpectedCost">0</strong></span>
                    </div>
                </div>
                <div id="gridDemandForecast"></div>
            </div>

        </div>
    </div>

    <style>
        .spare-dashboard {
            padding-top: 10px;
        }

        .spare-kpi-row {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 14px;
            margin-bottom: 18px;
        }

        .spare-kpi-card {
            background: #fff;
            border-radius: 10px;
            padding: 14px 16px 12px 16px;
            box-shadow: 2px 2px 4px rgba(0,0,0,0.08);
            border-top: 4px solid #ccc;
            min-height: 92px;
        }

            .spare-kpi-card.blue {
                border-top-color: #3E6BC0;
            }

            .spare-kpi-card.orange {
                border-top-color: #F39C12;
            }

            .spare-kpi-card.red {
                border-top-color: #E74C3C;
            }

            .spare-kpi-card.green {
                border-top-color: #27AE60;
            }

            .spare-kpi-card.sky {
                border-top-color: #5DADE2;
            }

        .kpi-title {
            font-size: 13px;
            color: #666;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .kpi-value {
            font-size: 32px;
            line-height: 1;
            font-weight: 900;
            color: #222;
            margin-bottom: 8px;
        }

        .kpi-desc {
            font-size: 11px;
            color: #999;
            font-weight: 700;
        }

            .kpi-desc.danger {
                color: #E74C3C;
            }

        .spare-chart-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
            margin-bottom: 14px;
        }

        .spare-chart-box {
            background: #fff;
            border-radius: 10px;
            padding: 10px 14px 14px 14px;
            box-shadow: 2px 2px 4px rgba(0,0,0,0.08);
        }

        .chart-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 6px;
        }

            .chart-header h2 {
                font-size: 15px;
                font-weight: 800;
                margin: 0;
            }

            .chart-header span {
                font-size: 11px;
                color: #3E6BC0;
                font-weight: 700;
            }

        .chart-area {
            height: 270px;
        }

        .chart-donut-wrap {
            position: relative;
            height: 270px;
        }

        .donut-center-label {
            position: absolute;
            left: 50%;
            top: 46%;
            transform: translate(-50%, -50%);
            font-size: 24px;
            font-weight: 800;
            color: #333;
            pointer-events: none;
        }

        .spare-demand-box {
            background: #fff;
            border-radius: 10px;
            padding: 16px 18px 18px 18px;
            box-shadow: 2px 2px 4px rgba(0,0,0,0.08);
        }

        .demand-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 14px;
        }

            .demand-header h2 {
                font-size: 17px;
                font-weight: 800;
                margin: 0 0 5px 0;
            }

            .demand-header p {
                color: #777;
                font-size: 12px;
                margin: 0;
            }

        .demand-summary {
            display: flex;
            flex-wrap: wrap;
            justify-content: flex-end;
            gap: 7px;
        }

            .demand-summary span {
                background: #eef4ff;
                border: 1px solid #d5e2f8;
                border-radius: 14px;
                color: #365a94;
                font-size: 12px;
                padding: 6px 10px;
            }

            .demand-summary strong {
                color: #0f4b9b;
                margin-left: 4px;
            }

        .forecast-shortage {
            color: #e53935;
            font-weight: 800;
        }
    </style>

    <script>
        $(document).ready(function () {
            initCharts();
            initDemandForecastGrid();
            loadSpareOverview();
            loadDemandForecast();
        });

        function initCharts() {
            $("#chartCriticality").dxPieChart({
                type: "doughnut",
                palette: ["#E74C3C", "#F39C12", "#F1C40F", "#27AE60"],
                dataSource: [],
                legend: {
                    visible: true,
                    orientation: "horizontal",
                    horizontalAlignment: "center",
                    verticalAlignment: "bottom"
                },
                series: [{
                    argumentField: "CRITICALITY_GRADE",
                    valueField: "CNT",
                    label: {
                        visible: true,
                        connector: { visible: true },
                        customizeText: function (arg) {
                            return arg.argumentText + " " + arg.percentText;
                        }
                    }
                }],
                tooltip: { enabled: true }
            });

            $("#chartAssetCost").dxChart({
                rotated: true,
                dataSource: [],
                commonSeriesSettings: {
                    argumentField: "ASSET_TYPE_NAME",
                    type: "bar"
                },
                series: [
                    { valueField: "TOTAL_COST", name: "예비품 비용" }
                ],
                legend: { visible: false },
                argumentAxis: {
                    label: { overlappingBehavior: "stagger" }
                },
                valueAxis: {
                    title: "예비품 비용"
                },
                tooltip: {
                    enabled: true,
                    customizeTooltip: function (arg) {
                        return { text: arg.argumentText + " : " + formatMoney(arg.value) };
                    }
                }
            });

            $("#chartShortage").dxChart({
                dataSource: [],
                commonSeriesSettings: {
                    argumentField: "PART_NAME",
                    type: "bar"
                },
                series: [
                    { valueField: "SHORTAGE_QTY", name: "부족 수량" }
                ],
                legend: { visible: false },
                argumentAxis: {
                    label: { overlappingBehavior: "rotate" }
                },
                valueAxis: {
                    title: "부족 수량"
                },
                tooltip: { enabled: true }
            });

            $("#chartLeadScatter").dxChart({
                dataSource: [],
                series: [{
                    type: "scatter",
                    argumentField: "LEAD_TIME_DAYS",
                    valueField: "CURRENT_QTY",
                    point: { size: 10 }
                }],
                argumentAxis: {
                    title: "납기일(days)"
                },
                valueAxis: {
                    title: "부품수량"
                },
                tooltip: {
                    enabled: true,
                    customizeTooltip: function (arg) {
                        const d = arg.point && arg.point.data ? arg.point.data : {};
                        return {
                            text: (d.PART_NAME || "") +
                                "<br/>납기: " + (d.LEAD_TIME_DAYS || 0) + "일" +
                                "<br/>재고: " + (d.CURRENT_QTY || 0)
                        };
                    }
                }
            });
        }

        function initDemandForecastGrid() {
            $("#gridDemandForecast").dxDataGrid({
                dataSource: [],
                keyExpr: "SPARE_ID",
                showBorders: true,
                rowAlternationEnabled: true,
                columnAutoWidth: true,
                noDataText: "수요예측 대상 예비품이 없습니다.",
                paging: { pageSize: 10 },
                pager: {
                    visible: true,
                    showPageSizeSelector: true,
                    allowedPageSizes: [10, 20, 50],
                    showInfo: true
                },
                columns: [
                    { dataField: "PART_NUMBER", caption: "부품번호", alignment: "center" },
                    { dataField: "PART_NAME", caption: "부품명" },
                    { dataField: "ASSET_TYPE_NAME", caption: "연결 설비", alignment: "center" },
                    { dataField: "CRITICALITY_GRADE", caption: "중요도", alignment: "center" },
                    { dataField: "AFFECTED_ASSET_COUNT", caption: "대상 장비", alignment: "center", format: "#,##0" },
                    { dataField: "TOP_DECISION", caption: "최고 의사결정", alignment: "center" },
                    { dataField: "CURRENT_QTY", caption: "현재재고", alignment: "center", format: "#,##0" },
                    {
                        dataField: "EXPECTED_DEMAND",
                        caption: "예상수요",
                        alignment: "right",
                        format: { type: "fixedPoint", precision: 4 }
                    },
                    { dataField: "RECOMMENDED_QTY", caption: "권장수량", alignment: "center", format: "#,##0" },
                    {
                        dataField: "SHORTAGE_QTY",
                        caption: "부족수량",
                        alignment: "center",
                        format: "#,##0",
                        cellTemplate: function (container, options) {
                            const value = Number(options.value || 0);
                            $("<span>")
                                .toggleClass("forecast-shortage", value > 0)
                                .text(value.toLocaleString())
                                .appendTo(container);
                        }
                    },
                    {
                        dataField: "EXPECTED_COST",
                        caption: "예상비용(원)",
                        alignment: "right",
                        cellTemplate: function (container, options) {
                            $("<span>").text(formatMoney(options.value)).appendTo(container);
                        }
                    }
                ]
            });
        }

        function loadSpareOverview() {
    $.ajax({
        type: "POST",
        url: '@Url.Action("GetSPAREOverviewData", "SpareDashboard")',
        data: {
            assetTypeId: null,
            criticality: null
        },
        success: function (response) {
            console.log("SPARE overview response:", response);

            if (!response || !response.success) {
                alert("종합현황 데이터를 불러오지 못했습니다.\n" + (response && response.message ? response.message : ""));
                return;
            }

            renderOverview(response);
        },
        error: function (xhr) {
            console.log("AJAX ERROR:", xhr.responseText);
            alert("오류 발생: " + xhr.responseText);
        }
    });
}

        function loadDemandForecast() {
            $.ajax({
                type: "POST",
                url: '@Url.Action("GetSPAREDemandForecastData", "SpareDashboard")',
                data: {
                    assetTypeId: null,
                    criticality: null
                },
                success: function (response) {
                    if (!response || !response.success) {
                        console.error("예비품 수요예측 오류", response);
                        return;
                    }

                    const summary = response.summary || {};
                    const rows = Array.isArray(response.rows) ? response.rows : [];
                    $("#forecastPartCount").text(Number(summary.FORECAST_PART_COUNT || 0).toLocaleString());
                    $("#forecastShortageCount").text(Number(summary.SHORTAGE_PART_COUNT || 0).toLocaleString());
                    $("#forecastRecommendedQty").text(Number(summary.TOTAL_RECOMMENDED_QTY || 0).toLocaleString());
                    $("#forecastExpectedCost").text(formatUk(Number(summary.TOTAL_EXPECTED_COST || 0)));

                    const grid = $("#gridDemandForecast").dxDataGrid("instance");
                    if (grid) grid.option("dataSource", rows);
                },
                error: function (xhr) {
                    console.error("예비품 수요예측 호출 실패", xhr.responseText);
                }
            });
        }

        function renderOverview(data) {
            console.log("overview response:", data);

            const kpi = data.kpi || {};
            const criticalityData = Array.isArray(data.criticalityData) ? data.criticalityData : [];
            const assetCostData = Array.isArray(data.assetCostData) ? data.assetCostData : [];
            const shortageData = Array.isArray(data.shortageData) ? data.shortageData : [];
            const scatterData = Array.isArray(data.scatterData) ? data.scatterData : [];

            const totalCount = Number(kpi.TOTAL_COUNT || 0);
            const totalBudget = Number(kpi.TOTAL_BUDGET || 0);
            const inventoryValue = Number(kpi.INVENTORY_VALUE || 0);
            const avgLeadTime = Number(kpi.AVG_LEAD_TIME || 0);
            const criticalCount = Number(kpi.CRITICAL_COUNT || 0);
            const criticalShortageCount = Number(kpi.CRITICAL_SHORTAGE_COUNT || 0);

            $("#kpiTotalCount").text(totalCount.toLocaleString());
            $("#kpiBudget").text(formatUk(totalBudget));
            $("#kpiCriticalCount").text(criticalCount.toLocaleString());
            $(".spare-kpi-card.red .kpi-desc").text("△ " + criticalShortageCount + "개 재주문 품목 도달");
            $("#kpiInventoryValue").text(formatUk(inventoryValue));
            $("#kpiLeadTime").text(Math.round(avgLeadTime) + "일");

            const pie = $("#chartCriticality").dxPieChart("instance");
            if (pie) pie.option("dataSource", criticalityData);

            const assetChart = $("#chartAssetCost").dxChart("instance");
            if (assetChart) assetChart.option("dataSource", assetCostData);

            const shortageChart = $("#chartShortage").dxChart("instance");
            if (shortageChart) shortageChart.option("dataSource", shortageData);

            const scatterChart = $("#chartLeadScatter").dxChart("instance");
            if (scatterChart) scatterChart.option("dataSource", scatterData);
        }

        function buildAssetCostData(rows) {
            const map = {};
            rows.forEach(x => {
                const key = x.ASSET_TYPE_NAME || "UNKNOWN";
                const value = Number(x.UNIT_PRICE || 0) * Number(x.CURRENT_QTY || 0);
                if (!map[key]) map[key] = 0;
                map[key] += value;
            });

            return Object.keys(map)
                .map(k => ({
                    ASSET_TYPE_NAME: k,
                    TOTAL_COST: map[k]
                }))
                .sort((a, b) => b.TOTAL_COST - a.TOTAL_COST);
        }

        function buildShortageData(rows) {
            return rows
                .map(x => ({
                    PART_NAME: x.PART_NAME,
                    SHORTAGE_QTY: Math.max(Number(x.SAFETY_STOCK || 0) - Number(x.CURRENT_QTY || 0), 0)
                }))
                .filter(x => x.SHORTAGE_QTY > 0)
                .sort((a, b) => b.SHORTAGE_QTY - a.SHORTAGE_QTY)
                .slice(0, 10);
        }

        function buildScatterData(rows) {
            return rows
                .filter(x => x.LEAD_TIME_DAYS != null)
                .map(x => ({
                    PART_NAME: x.PART_NAME,
                    LEAD_TIME_DAYS: Number(x.LEAD_TIME_DAYS || 0),
                    CURRENT_QTY: Number(x.CURRENT_QTY || 0)
                }));
        }

        function formatUk(value) {
            if (!value) return "0";
            if (value >= 100000000) {
                return (value / 100000000).toFixed(1) + "억";
            }
            return Number(value).toLocaleString();
        }

        function formatMoney(value) {
            if (!value) return "0";
            return Number(value).toLocaleString();
        }
    </script>
}
