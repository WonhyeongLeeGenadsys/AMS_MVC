@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var itrCode = Request.QueryString["ITR_Code"] ?? "";
}

@section LeftMenu {
    @Html.Partial("_CheckMenu")
}

@section MainContent {
    <h1>Interface TR 정밀점검: @ViewBag.Name, @ViewBag.SerialNo </h1>

    <div class="con_box">
        <div class="content_warp">
            <div class="btn_area top right">
                <a href="@Url.Action("ITRChkAdd", "ITRChk", new { ITR_Code = itrCode, type = 2 })" class="btn add blue">추가</a>
            </div>
            <div id="gridContainer" class="grid_wrap"></div>
        </div>

        <script>
                var itrCode = '@itrCode';

            $(document).ready(function () {
                loadITRChk2Data();
            });

            function loadITRChk2Data() {
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("GetITRChkListData", "ITRChk")',
                    data: { itrCode: itrCode, type: 2 },
                    dataType: "json",
                    success: function (response) {

                        let data = response
                            .sort((a, b) => new Date(b.Tbl_GetDate) - new Date(a.Tbl_GetDate))
                            .map((item, index, arr) => {
                                item.RowNumber = arr.length - index;
                                return item;
                            });

                        $("#gridContainer").dxDataGrid({
                            dataSource: data,
                            columnFixing: { enabled: true },
                            columns: [
                                { dataField: "RowNumber", caption: "순번", width: 80 },
                                { dataField: 'CHK2_Gongsa_Name', caption: '공사명', alignment: 'center', width: 'auto' },
                                { dataField: 'CHK2_Weather', caption: '날씨', alignment: 'center', width: 'auto' },
                                { dataField: 'CHK2_Temp', caption: '기온(°C)', alignment: 'center', width: 'auto' },
                                { dataField: 'CHK2_Hum', caption: '습도(%)', alignment: 'center', width: 'auto' },
                                { dataField: 'CHK2_Company', caption: '업체명', alignment: 'center', width: 'auto' },
                                { dataField: 'CHK2_Worker', caption: '점검자', alignment: 'center', width: 'auto' },
                                { dataField: 'CHK2_Manager', caption: '감독자', alignment: 'center', width: 'auto' },
                                { dataField: 'CHK2_Urgent_No', caption: '급전번호', alignment: 'center', width: 'auto' },
                                { dataField: 'CHK2_Type', caption: '형식', alignment: 'center', width: 'auto' },
                                { dataField: 'CHK2_Start_Date', caption: '점검시작일', alignment: 'center', width: 120},
                                { dataField: 'CHK2_End_Date', caption: '점검 종료일', alignment: 'center', width: 120}
                            ],
                            showBorders: false,
                            searchPanel: { visible: true, width: 240, placeholder: "검색" },
                            filterRow: { visible: true, applyFilter: 'auto' },
                            headerFilter: { visible: true },
                            loadPanel: { enabled: true },
                            scrolling: { columnRenderingMode: 'virtual' },
                            onRowClick: function (e) {
                                // 각 행의 Tbl_Idx와 ITR_Code 값을 사용하여 ITRChk2Detail 페이지로 이동
                                const tblIdx = e.data.Tbl_Idx;
                                const itrCode = e.data.ITR_Code;
                                const detailUrl = '@Url.Action("ITRChk2Detail", "ITRChk")';
                                window.location.href = detailUrl + '?itrCode=' + encodeURIComponent(itrCode) + '&tblIdx='  + encodeURIComponent(tblIdx);
                            }
                        });
                    },
                        error: function (xhr, status, error) {
                            console.error("데이터 로드 중 오류", error);
                        }
                });
            }
        </script>
    </div>
}
