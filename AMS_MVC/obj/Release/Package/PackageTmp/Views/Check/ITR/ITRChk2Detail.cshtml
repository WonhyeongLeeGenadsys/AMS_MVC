@model Web.Common.ITRChk2

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var itrCode = Request.QueryString["itrCode"] ?? "";
    var tblIdx = Request.QueryString["tblIdx"] ?? "";
}

@section LeftMenu {
    @Html.Partial("_CheckMenu")
}

@section MainContent {
    <h1>ITR 정밀점검 상세 정보</h1>

    <div class="con_box">
        <div class="content_warp">
            <div class="btn_area top right">
                <p>
                    <a href="javascript:void(0);" class="btn red del" onclick="deleteChk('@itrCode', '@tblIdx');">삭제</a>
                    <a href="@Url.Action("ITRChk2Update", "ITRChk", new { itrCode = itrCode, tblIdx = tblIdx })" class="btn blue edit">수정</a>
                </p>
            </div>

            <div class="table_app" id="itrChk">
                <table>
                    <colgroup>
                        <col style="width:100px;">
                        <col style="width:calc(33.3% - 100px);">
                        <col style="width:100px;">
                        <col style="width:calc(33.3% - 100px);">
                        <col style="width:100px;">
                        <col style="width:calc(33.3% - 100px);">
                    </colgroup>
                    <tr>
                        <th>공사명</th>
                        <td>@Model.CHK2_Gongsa_Name</td>
                        <th>제품명</th>
                        <td>@ViewBag.Name</td>
                        <th>시리얼번호</th>
                        <td>@ViewBag.SerialNo</td>
                    </tr>
                    <tr>
                        <th>날씨</th>
                        <td>@Model.CHK2_Weather</td>
                        <th>기온</th>
                        <td>@Model.CHK2_Temp °C</td>
                        <th>습도</th>
                        <td>@Model.CHK2_Hum %</td>
                    </tr>
                    <tr>
                        <th>업체명</th>
                        <td>@Model.CHK2_Company</td>
                        <th>점검자</th>
                        <td>@Model.CHK2_Worker</td>
                        <th>감독자</th>
                        <td>@Model.CHK2_Manager</td>
                    </tr>
                    <tr>
                        <th>급전번호</th>
                        <td>@Model.CHK2_Urgent_No</td>
                        <th>형식</th>
                        <td>@Model.CHK2_Type</td>
                        <th></th>
                        <td></td>
                    </tr>
                    <tr>
                        <th>점검 시작일</th>
                        <td>@Model.CHK2_Start_Date</td>
                        <th>점검 종료일</th>
                        <td>@Model.CHK2_End_Date</td>
                        <th></th>
                        <td></td>
                    </tr>
                </table>
            </div>

            <div class="table_list_app">
                <table>
                    <colgroup>
                        <col style="width:15%">
                        <col style="width:15%">
                        <col style="width:12%">
                        <col style="width:8%">
                        <col>
                        <col style="width:6%">
                    </colgroup>
                    <thead>
                        <tr>
                            <th>구분</th>
                            <th>Parameters</th>
                            <th>한전기준</th>
                            <th>단위</th>
                            <th>판정기준 및 score</th>
                            <th>가중치</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td rowspan="2">Oil Quality</td>
                            <td>H2</td>
                            <td></td>
                            <td></td>
                            <td>@(Model.CHK2_Computerized_Price)</td>
                            <td rowspan="2"></td>
                        </tr>
                        <tr>
                            <td>수분함량</td>
                            <td></td>
                            <td></td>
                            <td>@(Model.CHK2_Water_Content)</td>
                        </tr>

                        <tr>
                            <td rowspan="4">Measure</td>
                            <td>전압비</td>
                            <td></td>
                            <td></td>
                            <td>@(Model.CHK2_Voltage_Ratio) </td>
                            <td rowspan="4"></td>
                        </tr>
                        <tr>
                            <td>여자전류</td>
                            <td></td>
                            <td></td>
                            <td>@(Model.CHK2_Excitation_Current)</td>
                        </tr>
                        <tr>
                            <td>단락전류</td>
                            <td></td>
                            <td></td>
                            <td>@(Model.CHK2_Short_Current)</td>
                        </tr>
                        <tr>
                            <td>PD측정</td>
                            <td></td>
                            <td></td>
                            <td>@(Model.CHK2_PD)</td>
                        </tr>
                    </tbody>
                </table>
            </div>

        </div>
    </div>
}
@section Scripts {
<script type="text/javascript">
        function deleteChk(itrCode, tblIdx) {
            if (!confirm("Interface TR 정밀점검 정보를 삭제하시겠습니까?")) return;
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("DeleteITRChk2", "ITRChk")',
                    data: JSON.stringify({ itrCode: itrCode, tblIdx: tblIdx }),
                    contentType: "application/json; charset=utf-8",
                    success: function (response) {
                        if (response.success) {
                            alert("ITR 기본 정보가 삭제되었습니다.");
                            window.location.href = '@Url.Action("ITRChkTotalList", "ITRChk",new { type = 2 } )';
                        } else {
                            alert("ITR 기본 정보 삭제 실패: " + response.message);
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error("삭제 중 오류:", xhr.responseText || status, error);
                        alert("삭제 중 오류가 발생했습니다: " + xhr.responseText);
                    }
                });
            }
</script>
    }

