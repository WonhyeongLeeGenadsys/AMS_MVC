@model AMS_MVC.Models.SUBMODULEChk

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var submoduleCode = Request.QueryString["submoduleCode"] ?? "";
    var tblIdx = Request.QueryString["tblIdx"] ?? "";
}

@section LeftMenu {
    @Html.Partial("_CheckMenu")
}

@section MainContent {
    <h1>SUBMODULE 보통점검 상세 정보</h1>

    <div class="con_box">
        <div class="content_warp">
            <div class="btn_area top right">
                <p>
                    <a href="javascript:void(0);" class="btn red del"
                       onclick="deleteChk('@submoduleCode', '@tblIdx');">삭제</a>
                    
                    <a href="@Url.Action("SUBMODULEChkUpdate", "SUBMODULEChk", new { submoduleCode = submoduleCode, tblIdx = tblIdx })" class="btn blue edit">수정</a>
                </p>
            </div>

            <div class="table_app" id="submoduleChk">
                <table>
                    <colgroup>
                        <col style="width:100px;">
                        <col style="width:calc(33.3% - 100px);">
                        <col style="width:100px;">
                        <col style="width:calc(33.3% - 100px);">
                        <col style="width:100px;">
                        <col style="width:calc(33.3% - 100px);">
                    </colgroup>
                    <tr>
                        <th>공사명</th>
                        <td>@Model.CHK_Gongsa_Name</td>
                        <th>제품명</th>
                        <td>@ViewBag.Name</td>
                        <th>시리얼번호</th>
                        <td>@ViewBag.SerialNo</td>
                    </tr>
                    <tr>
                        <th>날씨</th>
                        <td>@Model.CHK_Weather</td>
                        <th>기온</th>
                        <td>@Model.CHK_Temp °C</td>
                        <th>습도</th>
                        <td>@Model.CHK_Hum %</td>
                    </tr>
                    <tr>
                        <th>업체명</th>
                        <td>@Model.CHK_Company</td>
                        <th>점검자</th>
                        <td>@Model.CHK_Worker</td>
                        <th>감독자</th>
                        <td>@Model.CHK_Manager</td>
                    </tr>
                    <tr>
                        <th>급전번호</th>
                        <td>@Model.CHK_Urgent_No</td>
                        <th>형식</th>
                        <td>@Model.CHK_Type</td>
                        <th></th>
                        <td></td>
                    </tr>
                    <tr>
                        <th>점검 시작일</th>
                        <td>@Model.CHK_Start_Date</td>
                        <th>점검 종료일</th>
                        <td>@Model.CHK_End_Date</td>
                        <th></th>
                        <td></td>
                    </tr>
                </table>
            </div>

            <div class="table_list_app">
                <table>
                    <colgroup>
                        <col style="width:15%">
                        <col style="width:15%">
                        <col style="width:12%">
                        <col style="width:8%">
                        <col>
                        <col style="width:6%">
                    </colgroup>
                    <thead>
                        <tr>
                            <th>구분</th>
                            <th>Parameters</th>
                            <th>한전기준</th>
                            <th>단위</th>
                            <th>판정기준 및 score</th>
                            <th>가중치</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td rowspan="6">IGBT</td>
                            <td>C-E 전압</td>
                            <td></td>
                            <td>1PU = 제조사 권장값</td>
                            <td>@(Model.CHK_CE_Voltage)</td>
                            <td rowspan="6"></td>
                        </tr>
                        <tr>
                            <td>G 전압</td>
                            <td></td>
                            <td></td>
                            <td>@(Model.CHK_G_Voltage)</td>
                        </tr>
                        <tr>
                            <td>On 전압</td>
                            <td></td>
                            <td></td>
                            <td>@(Model.CHK_On_Resistance)</td>
                        </tr>
                        <tr>
                            <td>열 저항</td>
                            <td></td>
                            <td>1PU = 제조사 권장값</td>
                            <td>@(Model.CHK_Thermal_Resistance)</td>
                        </tr>
                        <tr>
                            <td>C 전류</td>
                            <td></td>
                            <td>1PU = 정격 스위칭 시간</td>
                            <td>@(Model.CHK_C_Current)</td>
                        </tr>
                        <tr>
                            <td>On/Off 전류</td>
                            <td></td>
                            <td>1PU = 정격 스위칭 시간</td>
                            <td>@(Model.CHK_OnOff_Time)</td>
                        </tr>

                        <tr>
                            <td rowspan="4">커패시터</td>
                            <td>절연저항</td>
                            <td></td>
                            <td></td>
                            <td>@(Model.CHK_Insulation_Resistance) </td>
                            <td rowspan="4"></td>
                        </tr>
                        <tr>
                            <td>ESR</td>
                            <td></td>
                            <td></td>
                            <td>@(Model.CHK_ESR)</td>
                        </tr>
                        <tr>
                            <td>커패시턴스</td>
                            <td></td>
                            <td>1PU = 제조사 권장값</td>
                            <td>@(Model.CHK_Capacitance)</td>
                        </tr>
                        <tr>
                            <td>온도</td>
                            <td></td>
                            <td></td>
                            <td>@(Model.CHK_Temperature)</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
<script type="text/javascript">
  function deleteChk(submoduleCode, tblIdx) {
    if (!confirm("정말 삭제하시겠습니까?")) return;

    $.ajax({
      type: "POST",
      url: '@Url.Action("DeleteSUBMODULEChk", "SUBMODULEChk")',
      data: { submoduleCode: submoduleCode, tblIdx: tblIdx }, 
      success: function (response) {
        if (response.success) {
            alert("SUBMODULE 보통점검 정보가 삭제되었습니다.");
          window.location.href = '@Url.Action("SUBMODULEChkTotalList", "SUBMODULEChk")';
        } else {
          alert("SUBMODULE 보통점검 정보 삭제 실패: " + (response.message || ""));
        }
      },
      error: function (xhr, status, error) {
        console.error("삭제 중 오류:", xhr.responseText || status, error);
        alert("삭제 중 오류가 발생했습니다: " + (xhr.responseText || error));
      }
    });
  }
</script>


