@model Web.Common.VCBChk
@using Web.Common

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var vcbCode = Request.QueryString["vcbCode"] ?? "";
    var tblIdx = Request.QueryString["tblIdx"] ?? "";
}

@section LeftMenu {
    @Html.Partial("_CheckMenu")
}

@section MainContent {
    <h1>VCB 보통점검 상세 정보</h1>

    <div class="con_box">
        <div class="content_warp">
            <div class="btn_area top right">
                <p>
                    <a href="javascript:void(0);" class="btn red del" onclick="deleteChk('@vcbCode', '@tblIdx');">삭제</a>

                    <a href="@Url.Action("VCBChkUpdate", "VCBChk", new { vcbCode = vcbCode, tblIdx = tblIdx })" class="btn blue edit">수정</a>
                </p>
            </div>

            <div class="table_app" id="vcbChk">
                <table>
                    <colgroup>
                        <col style="width:100px;">
                        <col style="width:calc(33.3% - 100px);">
                        <col style="width:100px;">
                        <col style="width:calc(33.3% - 100px);">
                        <col style="width:100px;">
                        <col style="width:calc(33.3% - 100px);">
                    </colgroup>
                    <tr>
                        <th>공사명</th>
                        <td>@Model.CHK_Gongsa_Name</td>
                        <th>제품명</th>
                        <td>@ViewBag.Name</td>
                        <th>시리얼번호</th>
                        <td>@ViewBag.SerialNo</td>
                    </tr>
                    <tr>
                        <th>날씨</th>
                        <td>@Model.CHK_Weather</td>
                        <th>기온</th>
                        <td>@Model.CHK_Temp °C</td>
                        <th>습도</th>
                        <td>@Model.CHK_Hum %</td>
                    </tr>
                    <tr>
                        <th>업체명</th>
                        <td>@Model.CHK_Company</td>
                        <th>점검자</th>
                        <td>@Model.CHK_Worker</td>
                        <th>감독자</th>
                        <td>@Model.CHK_Manager</td>
                    </tr>
                    <tr>
                        <th>급전번호</th>
                        <td>@Model.CHK_Urgent_No</td>
                        <th>형식</th>
                        <td>@Model.CHK_Type</td>
                        <th></th>
                        <td></td>
                    </tr>
                    <tr>
                        <th>점검 시작일</th>
                        <td>@Model.CHK_Start_Date</td>
                        <th>점검 종료일</th>
                        <td>@Model.CHK_End_Date</td>
                        <th></th>
                        <td></td>
                    </tr>
                </table>
            </div>
            <div class="table_list_app">
                <table>
                    <colgroup>
                        <col style="width:15%">
                        <col style="width:15%">
                        <col style="width:12%">
                        <col style="width:8%">
                        <col>
                    </colgroup>
                    <thead>
                        <tr>
                            <th>구분</th>
                            <th>Parameters</th>
                            <th>한전기준</th>
                            <th>단위</th>
                            <th>판정기준</th>
                            <th>등급</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td rowspan="6">차단부</td>
                            <td>접점 소모량</td>
                            <td></td>
                            <td>mm</td>
                            <td>
                                @(Model.ContactWearPercentText)
                            </td>
                            @Html.HiCell((int)Model.CHK_ContactWearPercent)

                        </tr>
                        <tr>
                            <td>진공(누설전류)</td>
                            <td></td>
                            <td>mA</td>
                            <td>@(Model.VacuumLeakCurrentText)</td>
                            @Html.HiCell((int)Model.CHK_VacuumLeakCurrent)

                        </tr>
                        <tr>
                            <td>접촉저항</td>
                            <td></td>
                            <td>초기값 대비</td>
                            <td>@(Model.ContactResistanceText)</td>
                            @Html.HiCell((int)Model.CHK_ContactResistance)

                        </tr>
                        <tr>
                            <td>절연저항</td>
                            <td></td>
                            <td>MΩ</td>
                            <td>@(Model.InsulationResistanceText)</td>
                            @Html.HiCell((int)Model.CHK_InsulationResistance)

                        </tr>
                        <tr>
                            <td>핫스팟</td>
                            <td></td>
                            <td></td>
                            <td>@(Model.HotSpotText)</td>
                            @Html.HiCell((int)Model.CHK_HotSpot)

                        </tr>
                        <tr>
                            <td>
                                PD 패턴 및 성장
                            </td>
                            <td></td>
                            <td></td>
                            <td>@(Model.PdPatternValueText)</td>
                            @Html.HiCell((int)Model.CHK_PdPatternValue)

                        </tr>
                        <tr>
                            <td rowspan="1">구동모터</td>
                            <td>구동모터 전류</td>
                            <td></td>
                            <td>초기값 대비</td>
                            <td>@(Model.MotorCurrentText)</td>
                            @Html.HiCell((int)Model.CHK_MotorCurrent)

                        </tr>

                        <tr>
                            <td rowspan="1">누적단락전류</td>
                            <td>누적 단락전류량</td>
                            <td>
                            </td>
                            <td>설계 한계치</td>
                            <td>@(Model.AccumShortCircuitCurrentText)</td>
                            @Html.HiCell((int)Model.CHK_AccumShortCircuitCurrent)

                        </tr>
                        <tr>
                            <td rowspan="5">기타</td>
                            <td>단락전류</td>
                            <td>
                            </td>
                            <td>
                                설계 한계치
                            </td>
                            <td>@(Model.ShortCircuitCountText)</td>
                            @Html.HiCell((int)Model.CHK_ShortCircuitCount)

                        </tr>
                        <tr>
                            <td>
                                동작 횟수
                            </td>
                            <td></td>
                            <td>설계 한계치</td>
                            <td>@(Model.OperationCountText)</td>
                            @Html.HiCell((int)Model.CHK_OperationCount)

                        </tr>
                        <tr>
                            <td>
                                개폐 시간
                            </td>
                            <td></td>
                            <td>초기값 대비</td>
                            <td>@(Model.OpenCloseTimeText)</td>
                            @Html.HiCell((int)Model.CHK_OpenCloseTime)

                        </tr>
                        <tr>
                            <td>
                                외관 점검
                            </td>
                            <td></td>
                            <td></td>
                            <td>@(Model.VisualCheckText)</td>
                            @Html.HiCell((int)Model.CHK_VisualCheck)

                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script type="text/javascript">
  function deleteChk(vcbCode, tblIdx) {
    if (!confirm("VCB 보통점검 정보를 삭제하시겠습니까?")) return;

    $.ajax({
      type: "POST",
      url: '@Url.Action("DeleteVCBChk", "VCBChk")',
      data: { vcbCode: vcbCode, tblIdx: tblIdx },
      success: function (response) {
        if (response.success) {
          alert("VCB 보통점검 정보가 삭제되었습니다.");
          window.location.href = '@Url.Action("VCBChkTotalList", "VCBChk")';
        } else {
          alert("VCB 보통점검 정보 삭제 실패: " + (response.message || ""));
        }
      },
      error: function (xhr, status, error) {
        console.error("삭제 중 오류:", xhr.responseText || status, error);
        alert("삭제 중 오류가 발생했습니다: " + (xhr.responseText || error));
      }
    });
  }
    </script>
}



