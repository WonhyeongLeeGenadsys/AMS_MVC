@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var dccableCode = Request.QueryString["DCCABLE_Code"] ?? "";
}

@section LeftMenu {
    @Html.Partial("_CheckMenu")
}

@section MainContent {
    <h1>
        DCCABLE 보통점검 추가: @ViewBag.SerialNo
    </h1>
    <div class="con_box">
        <div class="content_warp">
            <div class="btn_area top right">
                <p>
                    <a href="#" class="btn blue app" onclick="createDCCABLEChk()">적용</a>
                </p>
            </div>
            <form id="dccableChkForm" method="post" enctype="multipart/form-data">
                @* URL에 DCCABLE_Code가 전달된 경우 hidden 필드로 사용, 그렇지 않으면 드롭다운 출력 *@
                @if (!string.IsNullOrEmpty(dccableCode))
                {
                    <input type="hidden" name="DCCABLE_Code" value="@dccableCode" />
                }
                else
                {
                    <div style="margin-bottom: 15px;">
                        @Html.DropDownList("DCCABLE_Code", (SelectList)ViewBag.DCCABLEs, "DCCABLE를 선택하세요.", new { @class = "form-control", @id = "DCCABLE_Code" })
                    </div>
                }
                <div class="table_app" id="dccableChk">
                    <table>
                        <colgroup>
                            <col style="width:100px;">
                            <col style="width:calc(33.3% - 100px);">
                            <col style="width:100px;">
                            <col style="width:calc(33.3% - 100px);">
                            <col style="width:100px;">
                            <col style="width:calc(33.3% - 100px);">
                        </colgroup>
                        <tr>
                            <th>공사명</th>
                            <td colspan="5">
                                <input type="text" id="chk_gongsa_name" name="chk_gongsa_name">
                            </td>
                        </tr>
                        <tr>
                            <th>날씨</th>
                            <td>
                                <input type="text" id="chk_weather" name="chk_weather">
                            </td>
                            <th>기온</th>
                            <td>
                                <input type="text" id="chk_temp" name="chk_temp"> <span>°C</span>
                            </td>
                            <th>습도</th>
                            <td>
                                <input type="text" id="chk_hum" name="chk_hum"> <span>%</span>
                            </td>
                        </tr>
                        <tr>
                            <th>업체명</th>
                            <td>
                                @Html.DropDownList("chk_company", new SelectList(ViewBag.Companies, "Com_Name", "Com_Name"), "제작사를 선택하세요.")
                            </td>
                            <th>점검자</th>
                            <td>
                                <input type="text" id="chk_worker" name="chk_worker">
                            </td>
                            <th>감독자</th>
                            <td>
                                <input type="text" id="chk_manager" name="chk_manager">
                            </td>
                        </tr>
                        <tr>
                            <th>급전번호</th>
                            <td>
                                <input type="text" id="chk_urgent_no" name="chk_urgent_no">
                            </td>
                            <th>형식</th>
                            <td>
                                <input type="text" id="chk_type" name="chk_type">
                            </td>
                            <th></th>
                            <td></td>
                        </tr>
                        <tr>
                            <th>점검 시작일</th>
                            <td>
                                <input type="date" id="chk_start_date" name="chk_start_date">
                            </td>
                            <th>점검 종료일</th>
                            <td>
                                <input type="date" id="chk_end_date" name="chk_end_date">
                            </td>
                            <th></th>
                            <td></td>
                        </tr>
                    </table>
                </div>
                <!--//입력테이블-->
                <!--알고리즘 반영 파라미터-->
                <div class="table_list_app">
                    <table>
                        <colgroup>
                            <col style="width:5%">
                            <col style="width:8%">
                            <col style="width:4%">
                            <col style="width:15%">
                            <col style="width:2%">
                            <col>
                        </colgroup>
                        <thead>
                            <tr>
                                <th rowspan="2">하위설비</th>
                                <th rowspan="2">입력 파라미터</th>
                                <th rowspan="2">단위</th>
                                <th colspan="5">판단기준</th>
                                <th rowspan="2">비고</th>
                            </tr>
                            <tr>
                                <th>Very Good</th>
                                <th>Good</th>
                                <th>Fair</th>
                                <th>Poor</th>
                                <th>Very Poor</th>
                            </tr>
                        </thead>

                        <tbody>
                            <tr>
                                <td rowspan="3">
                                    절연부/도체
                                </td>
                                <td>부분방전(PD)</td>
                                <td>pC</td>
                                <td>
                                    <label class="ty_rdo" for="CHK_Partial_Discharge_1">
                                        <input type="radio" id="CHK_Partial_Discharge_1" name="CHK_Partial_Discharge" value="1" checked>
                                        <span>미검출</span>
                                    </label>
                                </td>
                                <td>-</td>
                                <td>
                                    <label class="ty_rdo" for="CHK_Partial_Discharge_3">
                                        <input type="radio" id="CHK_Partial_Discharge_3" name="CHK_Partial_Discharge" value="3">
                                        <span>0~5</span>
                                    </label>
                                </td>
                                <td>
                                    <label class="ty_rdo" for="CHK_Partial_Discharge_4">
                                        <input type="radio" id="CHK_Partial_Discharge_4" name="CHK_Partial_Discharge" value="4">
                                        <span>5~10</span>
                                    </label>
                                </td>
                                <td>
                                    <label class="ty_rdo" for="CHK_Partial_Discharge_5">
                                        <input type="radio" id="CHK_Partial_Discharge_5" name="CHK_Partial_Discharge" value="5">
                                        <span>10 초과</span>
                                    </label>
                                </td>
                                <td></td>
                            </tr>
                            <tr>
                                <td>
                                    내전압
                                </td>
                                <td>P.U</td>
                                <td>
                                    <label class="ty_rdo" for="CHK_Rated_Voltage_1">
                                        <input type="radio" id="CHK_Rated_Voltage_1" name="CHK_Rated_Voltage" value="1" checked>
                                        <span>±3% 이내</span>
                                    </label>
                                </td>
                                <td>-</td>
                                <td>
                                    <label class="ty_rdo" for="CHK_Rated_Voltage_3">
                                        <input type="radio" id="CHK_Rated_Voltage_3" name="CHK_Rated_Voltage" value="3">
                                        <span>±5% 이내</span>
                                    </label>
                                </td>
                                <td>-</td>
                                <td>
                                    <label class="ty_rdo" for="CHK_Rated_Voltage_5">
                                        <input type="radio" id="CHK_Rated_Voltage_5" name="CHK_Rated_Voltage" value="5">
                                        <span>±10% 초과</span>
                                    </label>
                                </td>
                                <td>1 P.U = 설계 내전압</td>
                            </tr>
                            <tr>
                                <td>
                                    Ten Delta
                                </td>
                                <td>-</td>
                                <td>
                                    <label class="ty_rdo" for="CHK_Tan_Delta_1">
                                        <input type="radio" id="CHK_Tan_Delta_1" name="CHK_Tan_Delta" value="1" checked>
                                        <span>0.001 이하</span>
                                    </label>
                                </td>
                                <td>
                                    <label class="ty_rdo" for="CHK_Tan_Delta_2">
                                        <input type="radio" id="CHK_Tan_Delta_2" name="CHK_Tan_Delta" value="2">
                                        <span>0.001~0.004</span>
                                    </label>
                                </td>
                                <td>
                                    <label class="ty_rdo" for="CHK_Tan_Delta_3">
                                        <input type="radio" id="CHK_Tan_Delta_3" name="CHK_Tan_Delta" value="3">
                                        <span>0.004~0.008</span>
                                    </label>
                                </td>
                                <td>
                                    <label class="ty_rdo" for="CHK_Tan_Delta_4">
                                        <input type="radio" id="CHK_Tan_Delta_4" name="CHK_Tan_Delta" value="4">
                                        <span>0.008~0.01</span>
                                    </label>
                                </td>
                                <td>
                                    <label class="ty_rdo" for="CHK_Tan_Delta_5">
                                        <input type="radio" id="CHK_Tan_Delta_5" name="CHK_Tan_Delta" value="5">
                                        <span>0.01 초과</span>
                                    </label>
                                </td>
                                <td></td>
                            </tr>
                            <tr>
                                <td rowspan="1">
                                    스크린
                                </td>
                                <td>절연 저항</td>
                                <td>mΩ</td>
                                <td>
                                    <label class="ty_rdo" for="CHK_Resistance_1">
                                        <input type="radio" id="CHK_Resistance_1" name="CHK_Resistance" value="1" checked>
                                        <span>500 이상</span>
                                    </label>
                                </td>
                                <td>-</td>
                                <td>-</td>
                                <td>-</td>
                                <td>
                                    <label class="ty_rdo" for="CHK_Resistance_5">
                                        <input type="radio" id="CHK_Resistance_5" name="CHK_Resistance" value="5">
                                        <span>500 미만</span>
                                    </label>
                                </td>
                                <td></td>
                            </tr>

                            <tr>
                                <td rowspan="1">
                                    재킷
                                </td>
                                <td>시간영역 반사(TDR)</td>
                                <td>P.U</td>
                                <td>
                                    <label class="ty_rdo" for="CHK_TDR_1">
                                        <input type="radio" id="CHK_TDR_1" name="CHK_TDR" value="1" checked>
                                        <span>5% 이내</span>
                                    </label>
                                </td>
                                <td>-</td>
                                <td>
                                    <label class="ty_rdo" for="CHK_TDR_3">
                                        <input type="radio" id="CHK_TDR_3" name="CHK_TDR" value="3">
                                        <span>5~10%</span>
                                    </label>
                                </td>
                                <td>
                                    <label class="ty_rdo" for="CHK_TDR_4">
                                        <input type="radio" id="CHK_TDR_4" name="CHK_TDR" value="4">
                                        <span>10~15%</span>
                                    </label>
                                </td>
                                <td>
                                    <label class="ty_rdo" for="CHK_TDR_5">
                                        <input type="radio" id="CHK_TDR_5" name="CHK_TDR" value="5">
                                        <span>15% 초과</span>
                                    </label>
                                </td>
                                <td>1 P.U = 기준 신호량</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </form>
        </div>
    </div>

    <script>
    // DCCABLE 점검 정보 수집 함수
        function createDCCABLEChk() {
            submitDCCABLEChkForm();
        }

        function submitDCCABLEChkForm() {
            var form = document.getElementById("dccableChkForm");
            var formData = new FormData(form);

            // 1) DCCABLE_Code가 hidden인 경우(이미 URL에 있었음) => 바로 진행
            // 2) DCCABLE_Code가 드롭다운인 경우 => 선택 체크
            var dccableCodeDropdown = document.getElementById("DCCABLE_Code");
            if (dccableCodeDropdown) {
                // 사용자가 "DCCABLE를 선택하세요."(기본값) 또는 빈 값("")을 선택한 경우 확인
                if (!dccableCodeDropdown.value) {
                    alert("DCCABLE를 선택하세요.");
                    return;
                }
            }

            // FormData 내용을 콘솔에 출력
            for (var pair of formData.entries()) {
                console.log(pair[0] + ": " + pair[1]);
            }

            $.ajax({
            url: '@Url.Action("DCCABLEChkAdd", "DCCABLEChk")',
            type: "POST",
            data: formData,
            processData: false,
            contentType: false,
            success: function (response) {
                console.log("서버 응답:", response);
                if (response.IsSuccess) {
                    alert("DCCABLE 보통점검 정보가 저장되었습니다.");
                    window.location.href = '@Url.Action("DCCABLEChkTotalList", "DCCABLEChk")';
                } else {
                    alert("DCCABLE 보통점검 정보를 추가하지 못했습니다.: " + response.message);
                }
            },
            error: function (xhr, status, error) {
                console.error("오류 발생:", xhr.responseText || status, error);
                alert("DCCABLE 보통점검 정보 등록 중 오류가 발생했습니다." + xhr.responseText);
            }
        });
    }
    </script>
}