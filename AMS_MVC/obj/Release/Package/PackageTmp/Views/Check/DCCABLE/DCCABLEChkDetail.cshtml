@model Web.Common.DCCABLEChk
@using Web.Common

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var dccableCode = Request.QueryString["dccableCode"] ?? "";
    var tblIdx = Request.QueryString["tblIdx"] ?? "";
}

@section LeftMenu {
    @Html.Partial("_CheckMenu")
}

@section MainContent {
    <h1>DCCABLE 보통점검 상세 정보</h1>

    <div class="con_box">
        <div class="content_warp">
            <div class="btn_area top right">
                <p>
                    <a href="javascript:void(0);" class="btn red del"
                       onclick="deleteChk('@dccableCode', '@tblIdx');">삭제</a>

                    <a href="@Url.Action("DCCABLEChkUpdate", "DCCABLEChk", new { dccableCode = dccableCode, tblIdx = tblIdx })" class="btn blue edit">수정</a>
                </p>
            </div>

            <div class="table_app" id="dccableChk">
                <table>
                    <colgroup>
                        <col style="width:100px;">
                        <col style="width:calc(33.3% - 100px);">
                        <col style="width:100px;">
                        <col style="width:calc(33.3% - 100px);">
                        <col style="width:100px;">
                        <col style="width:calc(33.3% - 100px);">
                    </colgroup>
                    <tr>
                        <th>공사명</th>
                        <td>@Model.CHK_Gongsa_Name</td>
                        <th>제품명</th>
                        <td>@ViewBag.Name</td>
                        <th>시리얼번호</th>
                        <td>@ViewBag.SerialNo</td>
                    </tr>
                    <tr>
                        <th>날씨</th>
                        <td>@Model.CHK_Weather</td>
                        <th>기온</th>
                        <td>@Model.CHK_Temp °C</td>
                        <th>습도</th>
                        <td>@Model.CHK_Hum %</td>
                    </tr>
                    <tr>
                        <th>업체명</th>
                        <td>@Model.CHK_Company</td>
                        <th>점검자</th>
                        <td>@Model.CHK_Worker</td>
                        <th>감독자</th>
                        <td>@Model.CHK_Manager</td>
                    </tr>
                    <tr>
                        <th>급전번호</th>
                        <td>@Model.CHK_Urgent_No</td>
                        <th>형식</th>
                        <td>@Model.CHK_Type</td>
                        <th></th>
                        <td></td>
                    </tr>
                    <tr>
                        <th>점검 시작일</th>
                        <td>@Model.CHK_Start_Date</td>
                        <th>점검 종료일</th>
                        <td>@Model.CHK_End_Date</td>
                        <th></th>
                        <td></td>
                    </tr>
                </table>
            </div>

            <div class="table_list_app">
                <table>
                    <colgroup>
                        <col style="width:15%">
                        <col style="width:15%">
                        <col style="width:12%">
                        <col style="width:8%">
                        <col>
                        <col style="width:6%">
                    </colgroup>
                    <thead>
                        <tr>
                            <th>구분</th>
                            <th>Parameters</th>
                            <th>한전기준</th>
                            <th>단위</th>
                            <th>판정기준</th>
                            <th>등급</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td rowspan="3">절연부/도체</td>
                            <td>부분방전</td>
                            <td></td>
                            <td></td>
                            <td>@(Model.PartialDischargeText)</td>
                            @Html.HiCell((int)Model.CHK_Partial_Discharge)

                        </tr>
                        <tr>
                            <td>공칭전압</td>
                            <td></td>
                            <td></td>
                            <td>@(Model.RatedVoltageText)</td>
                            @Html.HiCell((int)Model.CHK_Rated_Voltage)

                        </tr>
                        <tr>
                            <td>Ten Delta</td>
                            <td></td>
                            <td></td>
                            <td>@(Model.TanDeltaText)</td>
                            @Html.HiCell((int)Model.CHK_Tan_Delta)

                        </tr>

                        <tr>
                            <td rowspan="1">스크린</td>
                            <td>저항</td>
                            <td></td>
                            <td></td>
                            <td>@(Model.ResistanceText) </td>
                            @Html.HiCell((int)Model.CHK_Resistance)

                        </tr>

                        <tr>
                            <td rowspan="1">재킷</td>
                            <td>TDR</td>
                            <td></td>
                            <td></td>
                            <td>@(Model.TDRText) </td>
                            @Html.HiCell((int)Model.CHK_TDR)

                        </tr>
                    </tbody>
                </table>
            </div>

        </div>
    </div>
}
@section Scripts {
    <script type="text/javascript">
  function deleteChk(dccableCode, tblIdx) {
      if (!confirm("DC Cable 보통점검 정보를 삭제하시겠습니까?")) return;

    $.ajax({
      type: "POST",
      url: '@Url.Action("DeleteDCCABLEChk", "DCCABLEChk")',
      data: { dccableCode: dccableCode, tblIdx: tblIdx }, // 폼 인코딩 방식
      success: function (response) {
        if (response.success) {
          alert("DCCABLE 보통점검 정보가 삭제되었습니다.");
          window.location.href = '@Url.Action("DCCABLEChkTotalList", "DCCABLEChk")';
        } else {
          alert("DCCABLE 보통점검 정보 삭제 실패: " + (response.message || ""));
        }
      },
      error: function (xhr, status, error) {
        console.error("삭제 중 오류:", xhr.responseText || status, error);
        alert("삭제 중 오류가 발생했습니다: " + (xhr.responseText || error));
      }
    });
  }
    </script>
}

