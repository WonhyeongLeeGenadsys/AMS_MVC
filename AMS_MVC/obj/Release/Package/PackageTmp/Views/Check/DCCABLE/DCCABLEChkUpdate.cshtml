@model Web.Common.DCCABLEChk

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var dccableCode = Request.QueryString["dccableCode"] ?? "";
}

@section LeftMenu {
    @Html.Partial("_CheckMenu")
}

@section MainContent {
    <h1>
        DCCABLE 보통점검 수정 
    </h1>
    <div class="con_box">
        <div class="content_warp">
            <div class="btn_area top right">
                <p>
                    <a href="#" class="btn blue app" onclick="updateDCCABLEChk()">적용</a>
                </p>
            </div>

            <form id="dccableChkUpdateForm" method="post" enctype="multipart/form-data">
                <input type="hidden" name="Tbl_Idx" value="@Model.Tbl_Idx" />
                <input type="hidden" name="DCCABLE_Code" value="@Model.DCCABLE_Code" />

                <div class="table_app" id="dccableChk">
                    <table>
                        <colgroup>
                            <col style="width:100px;">
                            <col style="width:calc(33.3% - 100px);">
                            <col style="width:100px;">
                            <col style="width:calc(33.3% - 100px);">
                            <col style="width:100px;">
                            <col style="width:calc(33.3% - 100px);">
                        </colgroup>
                        <tr>
                            <th>공사명</th>
                            <td colspan="5">
                                <input type="text" id="chk_gongsa_name" name="chk_gongsa_name" value="@Model.CHK_Gongsa_Name">
                            </td>
                        </tr>
                        <tr>
                            <th>날씨</th>
                            <td>
                                <input type="text" id="chk_weather" name="chk_weather" value="@Model.CHK_Weather">
                            </td>
                            <th>기온</th>
                            <td>
                                <input type="text" id="chk_temp" name="chk_temp" value="@Model.CHK_Temp"> <span>°C</span>
                            </td>
                            <th>습도</th>
                            <td>
                                <input type="text" id="chk_hum" name="chk_hum" value="@Model.CHK_Hum"> <span>%</span>
                            </td>
                        </tr>
                        <tr>
                            <th>업체명</th>
                            <td>
                                @Html.DropDownList("chk_company", new SelectList(ViewBag.Companies, "Com_Name", "Com_Name", Model.CHK_Company), "제작사를 선택하세요.")
                            </td>
                            <th>점검자</th>
                            <td>
                                <input type="text" id="chk_worker" name="chk_worker" value="@Model.CHK_Worker">
                            </td>
                            <th>감독자</th>
                            <td>
                                <input type="text" id="chk_manager" name="chk_manager" value="@Model.CHK_Manager">
                            </td>
                        </tr>
                        <tr>
                            <th>급전번호</th>
                            <td>
                                <input type="text" id="chk_urgent_no" name="chk_urgent_no" value="@Model.CHK_Urgent_No">
                            </td>
                            <th>형식</th>
                            <td>
                                <input type="text" id="chk_type" name="chk_type" value="@Model.CHK_Type">
                            </td>
                            <th></th>
                            <td></td>
                        </tr>
                        <tr>
                            <th>점검 시작일</th>
                            <td>
                                <input type="date" id="chk_start_date" name="chk_start_date" value="@(Model.CHK_Start_Date.HasValue ? Model.CHK_Start_Date.Value.ToString("yyyy-MM-dd") : "")">
                            </td>
                            <th>점검 종료일</th>
                            <td>
                                <input type="date" id="chk_end_date" name="chk_end_date" value="@(Model.CHK_End_Date.HasValue ? Model.CHK_End_Date.Value.ToString("yyyy-MM-dd") : "")">
                            </td>
                            <th></th>
                            <td></td>
                        </tr>
                    </table>
                </div>
                <!--//입력테이블-->
                <!--알고리즘 반영 파라미터-->
                <div class="table_list_app">
                    <table>
                        <colgroup>
                            <col style="width:10%">
                            <col style="width:8%">
                            <col style="width:8%">
                            <col style="width:8%">
                            <col>
                        </colgroup>
                        <thead>
                            <tr>
                                <th>구분</th>
                                <th>Parameters</th>
                                <th>한전기준</th>
                                <th>단위</th>
                                <th>판정기준 및 score</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td rowspan="3">
                                    절연부/도체
                                </td>
                                <td>부분방전</td>
                                <td></td>
                                <td></td>
                                <td>
                                    <label class="ty_rdo" for="CHK_Partial_Discharge_1">
                                        <input type="radio" id="CHK_Partial_Discharge_1" name="CHK_Partial_Discharge" value="1" @(Model.CHK_Partial_Discharge == 1 ? "checked" : "")>
                                        <span>10pC이하</span>
                                    </label>
                                    <label class="ty_rdo" for="CHK_Partial_Discharge_2">
                                        <input type="radio" id="CHK_Partial_Discharge_2" name="CHK_Partial_Discharge" value="2" @(Model.CHK_Partial_Discharge == 2 ? "checked" : "")>
                                        <span>10pC~25pC</span>
                                    </label>
                                    <label class="ty_rdo" for="CHK_Partial_Discharge_3">
                                        <input type="radio" id="CHK_Partial_Discharge_3" name="CHK_Partial_Discharge" value="3" @(Model.CHK_Partial_Discharge == 3 ? "checked" : "")>
                                        <span>25pC~50pC</span>
                                    </label>
                                    <label class="ty_rdo" for="CHK_Partial_Discharge_4">
                                        <input type="radio" id="CHK_Partial_Discharge_4" name="CHK_Partial_Discharge" value="4" @(Model.CHK_Partial_Discharge == 4 ? "checked" : "")>
                                        <span>50pC~100pC</span>
                                    </label>
                                    <label class="ty_rdo" for="CHK_Partial_Discharge_5">
                                        <input type="radio" id="CHK_Partial_Discharge_5" name="CHK_Partial_Discharge" value="5" @(Model.CHK_Partial_Discharge == 5 ? "checked" : "")>
                                        <span>100pC초과</span>
                                    </label>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    공칭전압
                                </td>
                                <td></td>
                                <td>1PU = 공칭 전압</td>
                                <td>
                                    <label class="ty_rdo" for="CHK_Rated_Voltage_1">
                                        <input type="radio" id="CHK_Rated_Voltage_1" name="CHK_Rated_Voltage" value="1" @(Model.CHK_Rated_Voltage == 1 ? "checked" : "")>
                                        <span>PU±2.5%이내</span>
                                    </label>
                                    <label class="ty_rdo" for="CHK_Rated_Voltage_2">
                                        <input type="radio" id="CHK_Rated_Voltage_2" name="CHK_Rated_Voltage" value="2" @(Model.CHK_Rated_Voltage == 2 ? "checked" : "")>
                                        <span>PU±5%이내</span>
                                    </label>
                                    <label class="ty_rdo" for="CHK_Rated_Voltage_3">
                                        <input type="radio" id="CHK_Rated_Voltage_3" name="CHK_Rated_Voltage" value="3" @(Model.CHK_Rated_Voltage == 3 ? "checked" : "")>
                                        <span>PU±7.5%이내</span>
                                    </label>
                                    <label class="ty_rdo" for="CHK_Rated_Voltage_4">
                                        <input type="radio" id="CHK_Rated_Voltage_4" name="CHK_Rated_Voltage" value="4" @(Model.CHK_Rated_Voltage == 4 ? "checked" : "")>
                                        <span>PU±10%이내</span>
                                    </label>
                                    <label class="ty_rdo" for="CHK_Rated_Voltage_5">
                                        <input type="radio" id="CHK_Rated_Voltage_5" name="CHK_Rated_Voltage" value="5" @(Model.CHK_Rated_Voltage == 5 ? "checked" : "")>
                                        <span>PU±10%초과</span>
                                    </label>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    Ten Delta
                                </td>
                                <td></td>
                                <td></td>
                                <td>
                                    <label class="ty_rdo" for="CHK_Tan_Delta_1">
                                        <input type="radio" id="CHK_Tan_Delta_1" name="CHK_Tan_Delta" value="1" @(Model.CHK_Tan_Delta == 1 ? "checked" : "")>
                                        <span>0.001이하</span>
                                    </label>
                                    <label class="ty_rdo" for="CHK_Tan_Delta_2">
                                        <input type="radio" id="CHK_Tan_Delta_2" name="CHK_Tan_Delta" value="2" @(Model.CHK_Tan_Delta == 2 ? "checked" : "")>
                                        <span>0.001~0.004</span>
                                    </label>
                                    <label class="ty_rdo" for="CHK_Tan_Delta_3">
                                        <input type="radio" id="CHK_Tan_Delta_3" name="CHK_Tan_Delta" value="3" @(Model.CHK_Tan_Delta == 3 ? "checked" : "")>
                                        <span>0.004~0.008</span>
                                    </label>
                                    <label class="ty_rdo" for="CHK_Tan_Delta_4">
                                        <input type="radio" id="CHK_Tan_Delta_4" name="CHK_Tan_Delta" value="4" @(Model.CHK_Tan_Delta == 4 ? "checked" : "")>
                                        <span>0.008~0.01</span>
                                    </label>
                                    <label class="ty_rdo" for="CHK_Tan_Delta_5">
                                        <input type="radio" id="CHK_Tan_Delta_5" name="CHK_Tan_Delta" value="5" @(Model.CHK_Tan_Delta == 5 ? "checked" : "")>
                                        <span>0.01초과</span>
                                    </label>
                                </td>
                            </tr>
                            <tr>
                                <td rowspan="1">
                                    스크린
                                </td>
                                <td>저항</td>
                                <td></td>
                                <td></td>
                                <td>
                                    <label class="ty_rdo" for="CHK_Resistance_1">
                                        <input type="radio" id="CHK_Resistance_1" name="CHK_Resistance" value="1" @(Model.CHK_Resistance == 1 ? "checked" : "")>
                                        <span>10GΩ이상</span>
                                    </label>
                                    <label class="ty_rdo" for="CHK_Resistance_2">
                                        <input type="radio" id="CHK_Resistance_2" name="CHK_Resistance" value="2" @(Model.CHK_Resistance == 2 ? "checked" : "")>
                                        <span>5GΩ~10GΩ</span>
                                    </label>
                                    <label class="ty_rdo" for="CHK_Resistance_3">
                                        <input type="radio" id="CHK_Resistance_3" name="CHK_Resistance" value="3" @(Model.CHK_Resistance == 3 ? "checked" : "")>
                                        <span>1GΩ~5GΩ</span>
                                    </label>
                                    <label class="ty_rdo" for="CHK_Resistance_4">
                                        <input type="radio" id="CHK_Resistance_4" name="CHK_Resistance" value="4" @(Model.CHK_Resistance == 4 ? "checked" : "")>
                                        <span>500MΩ~1000MΩ</span>
                                    </label>
                                    <label class="ty_rdo" for="CHK_Resistance_5">
                                        <input type="radio" id="CHK_Resistance_5" name="CHK_Resistance" value="5" @(Model.CHK_Resistance == 5 ? "checked" : "")>
                                        <span>500MΩ이하</span>
                                    </label>
                                </td>
                            </tr>

                            <tr>
                                <td rowspan="1">
                                    재킷
                                </td>
                                <td>TDR</td>
                                <td></td>
                                <td></td>
                                <td>
                                    <label class="ty_rdo" for="CHK_TDR_1">
                                        <input type="radio" id="CHK_TDR_1" name="CHK_TDR" value="1" @(Model.CHK_TDR == 1 ? "checked" : "")>
                                        <span>PU 5%이내</span>
                                    </label>
                                    <label class="ty_rdo" for="CHK_TDR_2">
                                        <input type="radio" id="CHK_TDR_2" name="CHK_TDR" value="2" @(Model.CHK_TDR == 2 ? "checked" : "")>
                                        <span>PU 5~7.5%</span>
                                    </label>
                                    <label class="ty_rdo" for="CHK_TDR_3">
                                        <input type="radio" id="CHK_TDR_3" name="CHK_TDR" value="3" @(Model.CHK_TDR == 3 ? "checked" : "")>
                                        <span>PU 7.5~10%</span>
                                    </label>
                                    <label class="ty_rdo" for="CHK_TDR_4">
                                        <input type="radio" id="CHK_TDR_4" name="CHK_TDR" value="4" @(Model.CHK_TDR == 4 ? "checked" : "")>
                                        <span>PU 10~15%</span>
                                    </label>
                                    <label class="ty_rdo" for="CHK_TDR_5">
                                        <input type="radio" id="CHK_TDR_5" name="CHK_TDR" value="5" @(Model.CHK_TDR == 5 ? "checked" : "")>
                                        <span>PU 15%초과</span>
                                    </label>
                                </td>
                            </tr>

                        </tbody>
                    </table>
                </div>
            </form>
        </div>
    </div>

    <script>
        function updateDCCABLEChk() {
            var form = document.getElementById("dccableChkUpdateForm");
            var formData = new FormData(form);

            // FormData 내용을 콘솔에 출력
            for (var pair of formData.entries()) {
                console.log(pair[0] + ": " + pair[1]);
            }

            $.ajax({
                url: '@Url.Action("DCCABLEChkUpdate", "DCCABLEChk")',
                type: "POST",
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {
                    console.log("서버 응답:", response);
                    if (response.IsSuccess) {
                        alert("DCCABLE 보통점검 정보가 수정되었습니다.");
                        window.location.href = '@Url.Action("DCCABLEChkTotalList", "DCCABLEChk")';
                    } else {
                        alert("DCCABLE 보통점검 정보를 수정하지 못했습니다.: " + response.message);
                    }
                },
                error: function (xhr, status, error) {
                    console.error("오류 발생:", xhr.responseText || status, error);
                    alert("DCCABLE 보통점검 정보 수정중 오류가 발생했습니다." + xhr.responseText);
                }
            });
        }
    </script>
}
