@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var dsCode = Request.QueryString["DS_Code"] ?? "";
}

@section LeftMenu {
    @Html.Partial("_CheckMenu")
}

@section MainContent {
    <h1>
        DS 보통점검 추가: @ViewBag.SerialNo
    </h1>
    <div class="con_box">
        <div class="content_warp">
            <div class="btn_area top right">
                <p>
                    <a href="#" class="btn blue app" onclick="createDSChk()">적용</a>
                </p>
            </div>
            <form id="dsChkForm" method="post" enctype="multipart/form-data">
                @* URL에 DS_Code가 전달된 경우 hidden 필드로 사용, 그렇지 않으면 드롭다운 출력 *@
                @if (!string.IsNullOrEmpty(dsCode))
                {
                    <input type="hidden" name="DS_Code" value="@dsCode" />
                }
                else
                {
                    <div style="margin-bottom: 15px;">
                        @Html.DropDownList("DS_Code", (SelectList)ViewBag.DSs, "DS를 선택하세요.", new { @class = "form-control", @id = "DS_Code" })
                    </div>
                }
                <div class="table_app" id="dsChk">
                    <table>
                        <colgroup>
                            <col style="width:100px;">
                            <col style="width:calc(33.3% - 100px);">
                            <col style="width:100px;">
                            <col style="width:calc(33.3% - 100px);">
                            <col style="width:100px;">
                            <col style="width:calc(33.3% - 100px);">
                        </colgroup>
                        <tr>
                            <th>공사명</th>
                            <td colspan="5">
                                <input type="text" id="chk_gongsa_name" name="chk_gongsa_name">
                            </td>
                        </tr>
                        <tr>
                            <th>날씨</th>
                            <td>
                                <input type="text" id="chk_weather" name="chk_weather">
                            </td>
                            <th>기온</th>
                            <td>
                                <input type="text" id="chk_temp" name="chk_temp"> <span>°C</span>
                            </td>
                            <th>습도</th>
                            <td>
                                <input type="text" id="chk_hum" name="chk_hum"> <span>%</span>
                            </td>
                        </tr>
                        <tr>
                            <th>업체명</th>
                            <td>
                                @Html.DropDownList("chk_company", new SelectList(ViewBag.Companies, "Com_Name", "Com_Name"), "제작사를 선택하세요.")
                            </td>
                            <th>점검자</th>
                            <td>
                                <input type="text" id="chk_worker" name="chk_worker">
                            </td>
                            <th>감독자</th>
                            <td>
                                <input type="text" id="chk_manager" name="chk_manager">
                            </td>
                        </tr>
                        <tr>
                            <th>급전번호</th>
                            <td>
                                <input type="text" id="chk_urgent_no" name="chk_urgent_no">
                            </td>
                            <th>형식</th>
                            <td>
                                <input type="text" id="chk_type" name="chk_type">
                            </td>
                            <th></th>
                            <td></td>
                        </tr>
                        <tr>
                            <th>점검 시작일</th>
                            <td>
                                <input type="date" id="chk_start_date" name="chk_start_date">
                            </td>
                            <th>점검 종료일</th>
                            <td>
                                <input type="date" id="chk_end_date" name="chk_end_date">
                            </td>
                            <th></th>
                            <td></td>
                        </tr>
                    </table>
                </div>
                <!--//입력테이블-->
                <!--알고리즘 반영 파라미터-->
                <div class="table_list_app">
                    <table>
                        <colgroup>
                            <col style="width:10%">
                            <col style="width:10%">
                            <col style="width:8%">
                            <col style="width:6%">
                            <col>
                        </colgroup>
                        <thead>
                            <tr>
                                <th>구분</th>
                                <th>Parameters</th>
                                <th>한전기준</th>
                                <th>단위</th>
                                <th>판정기준 및 score</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td rowspan="1">
                                    동작 확인
                                </td>
                                <td>개폐 동작 상태 확인</td>
                                <td>정상 개폐 동작 확인</td>
                                <td>-</td>
                                <td>
                                    <label class="ty_rdo" for="chk_1_1_1">
                                        <input type="radio" id="chk_1_1_1" name="CHK_1_1" value ="1" checked>
                                        <span>정상(1)</span>
                                    </label>
                                    <label class="ty_rdo" for="chk_1_1_2">
                                        <input type="radio" id="chk_1_1_2" name="CHK_1_1" value ="5" >
                                        <span>이상(5)</span>
                                    </label>
                                </td>
                            </tr>

                            <tr>
                                <td rowspan="1">
                                    내부 점검
                                </td>
                                <td>조작기구함 내 청소 및 볼트 조임</td>
                                <td>이물질 제거 및 체결 상태 양호</td>
                                <td>-</td>
                                <td>
                                    <label class="ty_rdo" for="chk_2_1_1">
                                        <input type="radio" id="chk_2_1_1" name="CHK_2_1" value ="5"  checked>
                                        <span>정상(1)</span>
                                    </label>
                                    <label class="ty_rdo" for="chk_2_1_2">
                                        <input type="radio" id="chk_2_1_2" name="CHK_2_1" value ="5" >
                                        <span>이상(5)</span>
                                    </label>
                                </td>
                            </tr>

                            <tr>
                                <td rowspan="1">
                                    접속부 점검
                                </td>
                                <td>접속부 마모 상태 점검 및 청소</td>
                                <td>접속 단자 마모 및 손상 없음</td>
                                <td>-</td>
                                <td>
                                    <label class="ty_rdo" for="chk_3_1_1">
                                        <input type="radio" id="chk_3_1_1" name="CHK_3_1" value ="1"  checked>
                                        <span>정상(1)</span>
                                    </label>
                                    <label class="ty_rdo" for="chk_3_1_2">
                                        <input type="radio" id="chk_3_1_2" name="CHK_3_1" value ="5" >
                                        <span>이상(5)</span>
                                    </label>
                                </td>
                            </tr>

                            <tr>
                                <td rowspan="1">
                                    절연물 점검
                                </td>
                                <td>애자 균열, 오손 여부 점검 및 청소</td>
                                <td>균열 및 오염 없을 것, 청소 완료</td>
                                <td>-</td>
                                <td>
                                    <label class="ty_rdo" for="chk_4_1_1">
                                        <input type="radio" id="chk_4_1_1" name="CHK_4_1" value ="1"  checked>
                                        <span>정상(1)</span>
                                    </label>
                                    <label class="ty_rdo" for="chk_4_1_2">
                                        <input type="radio" id="chk_4_1_2" name="CHK_4_1" value ="5" >
                                        <span>이상(5)</span>
                                    </label>
                                </td>
                            </tr>

                            <tr>
                                <td rowspan="1">
                                    기계 결합부
                                </td>
                                <td>각 연결부 볼트 조임</td>
                                <td>볼트 풀림 없이 견고히 체결</td>
                                <td>-</td>
                                <td>
                                    <label class="ty_rdo" for="chk_5_1_1">
                                        <input type="radio" id="chk_5_1_1" name="CHK_5_1" value ="1"  checked>
                                        <span>정상(1)</span>
                                    </label>
                                    <label class="ty_rdo" for="chk_5_1_2">
                                        <input type="radio" id="chk_5_1_2" name="CHK_5_1" value ="5" >
                                        <span>이상(5)</span>
                                    </label>
                                </td>
                            </tr>

                            <tr>
                                <td rowspan="1">
                                    시험
                                </td>
                                <td>각종 시험 (절연시험, 동작시험 등)</td>
                                <td>시험 결과 기준치 만족</td>
                                <td>-</td>
                                <td>
                                    <label class="ty_rdo" for="chk_6_1_1">
                                        <input type="radio" id="chk_6_1_1" name="CHK_6_1" value ="1"  checked>
                                        <span>정상(1)</span>
                                    </label>
                                    <label class="ty_rdo" for="chk_6_1_2">
                                        <input type="radio" id="chk_6_1_2" name="CHK_6_1" value ="5" >
                                        <span>이상(5)</span>
                                    </label>
                                </td>
                            </tr>

                            <tr>
                                <td rowspan="1">
                                    윤활 상태
                                </td>
                                <td>기어부의 그리스 제거 및 재도포</td>
                                <td>정상 윤활 상태 유지</td>
                                <td>-</td>
                                <td>
                                    <label class="ty_rdo" for="chk_7_1_1">
                                        <input type="radio" id="chk_7_1_1" name="CHK_7_1" value ="1"  checked>
                                        <span>정상(1)</span>
                                    </label>
                                    <label class="ty_rdo" for="chk_7_1_2">
                                        <input type="radio" id="chk_7_1_2" name="CHK_7_1" value ="5" >
                                        <span>이상(5)</span>
                                    </label>
                                </td>
                            </tr>
                    </table>
                </div>

            </form>
        </div>
    </div>

    <script>
    // DS 점검 정보 수집 함수
        function createDSChk() {
            submitDSChkForm();
        }

        function submitDSChkForm() {
            var form = document.getElementById("dsChkForm");
            var formData = new FormData(form);

            var dsCodeDropdown = document.getElementById("DS_Code");
            if (dsCodeDropdown) {
                if (!dsCodeDropdown.value) {
                    alert("DS를 선택하세요.");
                    return;
                }
            }

            // FormData 내용을 콘솔에 출력
            for (var pair of formData.entries()) {
                console.log(pair[0] + ": " + pair[1]);
            }

            $.ajax({
            url: '@Url.Action("DSChkAdd", "DSChk")',
            type: "POST",
            data: formData,
            processData: false,
            contentType: false,
            success: function (response) {
                console.log("서버 응답:", response);
                if (response.IsSuccess) {
                    alert("DS 보통점검 정보가 저장되었습니다.");
                    window.location.href = '@Url.Action("DSChkTotalList", "DSChk")';
                } else {
                    alert("DS 보통점검 정보를 추가하지 못했습니다.: " + response.message);
                }
            },
            error: function (xhr, status, error) {
                console.error("오류 발생:", xhr.responseText || status, error);
                alert("DS 보통점검 정보 등록 중 오류가 발생했습니다." + xhr.responseText);
            }
        });
    }
    </script>
}