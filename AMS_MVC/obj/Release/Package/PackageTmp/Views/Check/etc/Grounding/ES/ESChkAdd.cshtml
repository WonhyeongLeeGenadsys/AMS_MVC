    <script>
    // ES 점검 정보 수집 함수
        function createESChk() {
            submitESChkForm();
        }

        function submitESChkForm() {
            var form = document.getElementById("esChkForm");
            var formData = new FormData(form);

            var esCodeDropdown = document.getElementById("ES_Code");
            if (esCodeDropdown) {
                if (!esCodeDropdown.value) {
                    alert("ES를 선택하세요.");
                    return;
                }
            }

            // FormData 내용을 콘솔에 출력
            for (var pair of formData.entries()) {
                console.log(pair[0] + ": " + pair[1]);
            }

            $.ajax({
            url: '@Url.Action("ESChkAdd", "ESChk")',
            type: "POST",
            data: formData,
            processData: false,
            contentType: false,
            success: function (response) {
                console.log("서버 응답:", response);
                if (response.IsSuccess) {
                    alert("ES 보통점검 정보가 저장되었습니다.");
                    window.location.href = '@Url.Action("ESChkTotalList", "ESChk")';
                } else {
                    alert("ES 보통점검 정보를 추가하지 못했습니다.: " + response.message);
                }
            },
            error: function (xhr, status, error) {
                console.error("오류 발생:", xhr.responseText || status, error);
                alert("ES 보통점검 정보 등록 중 오류가 발생했습니다." + xhr.responseText);
            }
        });
    }
    </script>
