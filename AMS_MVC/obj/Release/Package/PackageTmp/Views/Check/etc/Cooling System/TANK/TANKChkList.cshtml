@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var tankCode = Request.QueryString["TANK_Code"] ?? "";
}

@section LeftMenu {
    @Html.Partial("_CheckMenu")
}

@section MainContent {
    <h1>TANK 보통점검이력</h1>

    <div class="con_box">
        <div class="content_warp">
            <h2>제품명: @ViewBag.Name, 시리얼번호: @ViewBag.SerialNo</h2>

            <div class="btn_area top right">
                <a href="@Url.Action("TANKChkAdd", "TANKChk", new { TANK_Code = tankCode })" class="btn add blue">추가</a>
            </div>
            <div id="gridContainer" class="grid_wrap"></div>
        </div>

        <script>
            $(document).ready(function () {
                loadTANKChkData();
            });

            function loadTANKChkData() {
                var tankCode = "@tankCode";

                $.ajax({
                    type: "POST",
                    url: '@Url.Action("GetTANKChkListData", "TANKChk")',
                    data: JSON.stringify({ tankCode: tankCode }),
                    contentType: "application/json; charset=utf-8",
                    success: function (response) {
                        if (response.success == false) {
                            console.error("TANKChk 데이터 로드 실패: " + response.message);
                            return;
                        }

                        // 등록 순번(Tbl_Idx) 기준 내림차순 정렬
                        let data = response.sort((a, b) => Number(b.Tbl_Idx) - Number(a.Tbl_Idx));

                        // 순번 매기기
                        data = data.map((item, index) => {
                            item.RowNumber = data.length - index;
                            return item;
                        });

                        $("#gridContainer").dxDataGrid({
                            dataSource: data,
                            hoverStateEnabled: true,
                            onRowPrepared: function (e) {
                                if (e.rowType === "data") {
                                    e.rowElement.css("cursor", "pointer");
                                }
                            },
                            columnFixing: { enabled: true },
                            columns: [
                                { dataField: "RowNumber", caption: "순번", width: 80 },
                                { dataField: 'CHK_Gongsa_Name', caption: '공사명', alignment: 'center', width: 'auto' },
                                { dataField: 'CHK_Weather', caption: '날씨', alignment: 'center', width: 'auto' },
                                { dataField: 'CHK_Temp', caption: '기온(°C)', alignment: 'center', width: 'auto' },
                                { dataField: 'CHK_Hum', caption: '습도(%)', alignment: 'center', width: 'auto' },
                                { dataField: 'CHK_Company', caption: '업체명', alignment: 'center', width: 'auto' },
                                { dataField: 'CHK_Worker', caption: '점검자', alignment: 'center', width: 'auto' },
                                { dataField: 'CHK_Manager', caption: '감독자', alignment: 'center', width: 'auto' },
                                { dataField: 'CHK_Urgent_No', caption: '급전번호', alignment: 'center', width: 'auto' },
                                { dataField: 'CHK_Type', caption: '형식', alignment: 'center', width: 'auto' },
                                { dataField: 'CHK_Start_Date', caption: '점검시작일', alignment: 'center', width: 120},
                                { dataField: 'CHK_End_Date', caption: '점검 종료일', alignment: 'center', width: 120}
                            ],
                            showBorders: false,
                            searchPanel: { visible: true, width: 240, placeholder: "검색" },
                            filterRow: { visible: true, applyFilter: 'auto' },
                            headerFilter: { visible: true },
                            loadPanel: { enabled: true },
                            scrolling: { columnRenderingMode: 'virtual' },
                            onRowClick: function (e) {
                                // 각 행의 Tbl_Idx와 TANK_Code 값을 사용하여 TANKChkDetail 페이지로 이동
                                const tblIdx = e.data.Tbl_Idx;
                                const tankCode = e.data.TANK_Code;
                                console.log(tblIdx);
                                console.log(tankCode);
                                var baseUrl = window.location.origin;
                                var detailUrl = '@Url.Action("TANKChkDetail", "TANKChk")';

                                window.location.href = baseUrl + detailUrl + "?tankCode=" + encodeURIComponent(tankCode) + "&tblIdx=" + encodeURIComponent(tblIdx);
                            }
                        });
                    },
                        error: function (xhr, status, error) {
                            console.error("데이터 로드 중 오류", error);
                        }
                });
            }
        </script>
    </div>
}
