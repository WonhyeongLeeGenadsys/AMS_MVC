@model Web.Common.CTChk

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var ctCode = Request.QueryString["ctCode"] ?? "";
    var tblIdx = Request.QueryString["tblIdx"] ?? "";
}

@section LeftMenu {
    @Html.Partial("_CheckMenu")
}

@section MainContent {
    <h1>CT 보통점검 상세 정보</h1>

    <div class="con_box">
        <div class="content_warp">
            <div class="btn_area top right">
                <p>
                    <a href="javascript:void(0);" class="btn red del" onclick="deleteChk('@ctCode', '@tblIdx');">삭제</a>
                    <a href="@Url.Action("CTChkUpdate", "CTChk", new { ctCode = ctCode, tblIdx = tblIdx })" class="btn blue edit">수정</a>
                </p>
            </div>

            <div class="table_app" id="ctChk">
                <table>
                    <colgroup>
                        <col style="width:100px;">
                        <col style="width:calc(33.3% - 100px);">
                        <col style="width:100px;">
                        <col style="width:calc(33.3% - 100px);">
                        <col style="width:100px;">
                        <col style="width:calc(33.3% - 100px);">
                    </colgroup>
                    <tr>
                        <th>공사명</th>
                        <td colspan="5">@Model.CHK_Gongsa_Name</td>
                    </tr>
                    <tr>
                        <th>날씨</th>
                        <td>@Model.CHK_Weather</td>
                        <th>기온</th>
                        <td>@Model.CHK_Temp °C</td>
                        <th>습도</th>
                        <td>@Model.CHK_Hum %</td>
                    </tr>
                    <tr>
                        <th>업체명</th>
                        <td>@Model.CHK_Company</td>
                        <th>점검자</th>
                        <td>@Model.CHK_Worker</td>
                        <th>감독자</th>
                        <td>@Model.CHK_Manager</td>
                    </tr>
                    <tr>
                        <th>급전번호</th>
                        <td>@Model.CHK_Urgent_No</td>
                        <th>형식</th>
                        <td>@Model.CHK_Type</td>
                        <th></th>
                        <td></td>
                    </tr>
                    <tr>
                        <th>점검 시작일</th>
                        <td>@Model.CHK_Start_Date</td>
                        <th>점검 종료일</th>
                        <td>@Model.CHK_End_Date</td>
                        <th></th>
                        <td></td>
                    </tr>
                </table>
            </div>
            <div class="table_list_app">
                <table>
                    <colgroup>
                        <col style="width:15%">
                        <col style="width:15%">
                        <col style="width:12%">
                        <col style="width:8%">
                        <col>
                        <col style="width:6%">
                    </colgroup>
                    <thead>
                        <tr>
                            <th>구분</th>
                            <th>Parameters</th>
                            <th>한전기준</th>
                            <th>단위</th>
                            <th>판정기준 및 score</th>
                            <th>가중치</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td rowspan="1">외관 점검</td>
                            <td>애관부 균열 및 오손 여부 점검/청소</td>
                            <td>균열·오손 없고 청결 유지</td>
                            <td>-</td>
                            <td>@(Model.CHK_1_1)</td>
                            <td rowspan="1"></td>
                        </tr>

                        @*접속 점검*@
                        <tr>
                            <td rowspan="2">
                                접속 점검
                            </td>
                            <td>1차 단자부 볼트 조임</td>
                            <td>풀림 없이 견고히 체결</td>
                            <td>-</td>
                            <td>@(Model.CHK_2_1)</td>
                            <td rowspan="2"></td>
                        </tr>
                        <tr>
                            <td>2차 단자함 내부 점검 및 볼트 조임</td>
                            <td>이상 없음 및 조임 상태 양호</td>
                            <td>-</td>
                            <td>@(Model.CHK_2_2)</td>
                        </tr>

                        @*기능 시험*@
                        <tr>
                            <td rowspan="1">기능 시험</td>
                            <td>절연저항 / 절연열화 측정 / 포화시험</td>
                            <td>기기 기준치 만족</td>
                            <td>-</td>
                            <td>@(Model.CHK_3_1)</td>
                            <td rowspan="1"></td>
                        </tr>

                        @*부속 점검*@
                        <tr>
                            <td rowspan="2">
                                부속 점검
                            </td>
                            <td>콘덴서형 전압변성기 보호캡 점검</td>
                            <td>보호캡 손상 및 탈락 없음</td>
                            <td>-</td>
                            <td>@(Model.CHK_4_1)</td>
                            <td rowspan="2"></td>
                        </tr>
                        <tr>
                            <td>호흡기 상태 점검</td>
                            <td>실리카겔 변색 없고 건조 상태</td>
                            <td>-</td>
                            <td>@(Model.CHK_4_2)</td>
                        </tr>

                        <tr>
                            <td rowspan="1">케이블 점검</td>
                            <td>케이블 고정부 청소 및 이완 여부 점검</td>
                            <td>이완·오염 없고 고정 상태 양호</td>
                            <td>-</td>
                            <td>@(Model.CHK_5_1)</td>
                            <td rowspan="1"></td>
                        </tr>

                        <tr>
                            <td rowspan="1">접지 점검</td>
                            <td>접지선 접속부 조임 상태 점검</td>
                            <td>볼트 풀림 없이 견고히 체결</td>
                            <td>-</td>
                            <td>@(Model.CHK_6_1)</td>
                            <td rowspan="1"></td>
                        </tr>

                        <tr>
                            <td rowspan="1">유류 점검</td>
                            <td>Oil Level 점검</td>
                            <td>적정 유위 유지</td>
                            <td>-</td>
                            <td>@(Model.CHK_7_1)</td>
                            <td rowspan="1"></td>
                        </tr>

                    </tbody>
                </table>
            </div>

        </div>
    </div>
}
@section Scripts {
    <script type="text/javascript">
        function deleteGojang(ctCode, tblIdx) {
            if (!confirm("CT 보통점검 정보를 삭제하시겠습니까?")) return;
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("CTChkDelete", "CTChk")',
                    data: JSON.stringify({ ctCode: ctCode, tblIdx: tblIdx }),
                    contentType: "application/json; charset=utf-8",
                    success: function (response) {
                        if (response.success) {
                            alert("CT 기본 정보가 삭제되었습니다.");
                            window.location.href = '@Url.Action("CTChkTotalList", "CTChk")';
                        } else {
                            alert("CT 기본 정보 삭제 실패: " + response.message);
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error("삭제 중 오류:", xhr.responseText || status, error);
                        alert("삭제 중 오류가 발생했습니다: " + xhr.responseText);
                    }
                });
            }
    </script>
}
