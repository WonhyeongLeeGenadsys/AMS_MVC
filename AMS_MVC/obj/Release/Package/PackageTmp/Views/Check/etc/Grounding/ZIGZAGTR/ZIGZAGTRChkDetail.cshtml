@model Web.Common.ZIGZAGTRChk

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var zigzagtrCode = Request.QueryString["zigzagtrCode"] ?? "";
    var tblIdx = Request.QueryString["tblIdx"] ?? "";
}

@section LeftMenu {
    @Html.Partial("_CheckMenu")
}

@section MainContent {
    <h1>ZIGZAGTR 보통점검 상세 정보</h1>

    <div class="con_box">
        <div class="content_warp">
            <div class="btn_area top right">
                <p>
                    <a href="javascript:void(0);" class="btn red del" onclick="deleteChk('@zigzagtrCode', '@tblIdx');">삭제</a>
                    <a href="@Url.Action("ZIGZAGTRChkUpdate", "ZIGZAGTRChk", new { zigzagtrCode = zigzagtrCode, tblIdx = tblIdx })" class="btn blue edit">수정</a>
                </p>
            </div>

            <div class="table_app" id="zigzagtrChk">
                <table>
                    <colgroup>
                        <col style="width:100px;">
                        <col style="width:calc(33.3% - 100px);">
                        <col style="width:100px;">
                        <col style="width:calc(33.3% - 100px);">
                        <col style="width:100px;">
                        <col style="width:calc(33.3% - 100px);">
                    </colgroup>
                    <tr>
                        <th>공사명</th>
                        <td colspan="5">@Model.CHK_Gongsa_Name</td>
                    </tr>
                    <tr>
                        <th>날씨</th>
                        <td>@Model.CHK_Weather</td>
                        <th>기온</th>
                        <td>@Model.CHK_Temp °C</td>
                        <th>습도</th>
                        <td>@Model.CHK_Hum %</td>
                    </tr>
                    <tr>
                        <th>업체명</th>
                        <td>@Model.CHK_Company</td>
                        <th>점검자</th>
                        <td>@Model.CHK_Worker</td>
                        <th>감독자</th>
                        <td>@Model.CHK_Manager</td>
                    </tr>
                    <tr>
                        <th>급전번호</th>
                        <td>@Model.CHK_Urgent_No</td>
                        <th>형식</th>
                        <td>@Model.CHK_Type</td>
                        <th></th>
                        <td></td>
                    </tr>
                    <tr>
                        <th>점검 시작일</th>
                        <td>@Model.CHK_Start_Date</td>
                        <th>점검 종료일</th>
                        <td>@Model.CHK_End_Date</td>
                        <th></th>
                        <td></td>
                    </tr>
                </table>
            </div>
            <div class="table_list_app">
                <table>
                    <colgroup>
                        <col style="width:15%">
                        <col style="width:15%">
                        <col style="width:12%">
                        <col style="width:8%">
                        <col>
                    </colgroup>
                    <thead>
                        <tr>
                            <th>구분</th>
                            <th>Parameters</th>
                            <th>한전기준</th>
                            <th>단위</th>
                            <th>판정기준 및 score</th>
                            <th>가중치</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td rowspan="1">외관 점검</td>
                            <td>변압기 본체, 냉각 장치, 단자함 파손/부식/변형/누유 확인</td>
                            <td>이상 없음 (파손, 부식, 누유 등 무)</td>
                            <td>-</td>
                            <td>@(Model.CHK_1_1_Text)</td>
                        </tr>
                        <tr>
                            <td rowspan="1">절연 점검</td>
                            <td>절연 저항 및 부분 방전 측정</td>
                            <td>절연 기준 이상 및 부분방전 없음</td>
                            <td>MΩ/pC</td>
                            <td>@(Model.CHK_2_1_Text)</td>
                        </tr>
                        <tr>
                            <td rowspan="1">접지 점검</td>
                            <td>접지 저항 측정 및 접지선 연결 상태 확인</td>
                            <td>10Ω 이하, 접속 양호</td>
                            <td>Ω</td>
                            <td>@(Model.CHK_3_1_Text)</td>
                        </tr>
                        <tr>
                            <td rowspan="1">온도 점검</td>
                            <td>본체, 권선, 오일 온도 측정 및 과열 여부 확인</td>
                            <td>설계 온도 이하 유지</td>
                            <td>℃</td>
                            <td>@(Model.CHK_4_1_Text)</td>
                        </tr>
                        <tr>
                            <td rowspan="1">소음 점검</td>
                            <td>이상 소음 유무 확인</td>
                            <td>이상 소음 없을 것</td>
                            <td>-</td>
                            <td>@(Model.CHK_5_1_Text)</td>
                        </tr>
                        <tr>
                            <td rowspan="1">오일 점검</td>
                            <td>절연유 레벨, 색상, 절연 내력 확인 (유입식)</td>
                            <td>레벨 정상, 색상 변화 없음, 내력 기준 이상</td>
                            <td>-</td>
                            <td>@(Model.CHK_6_1_Text)</td>
                        </tr>
                        <tr>
                            <td rowspan="1">권선 점검</td>
                            <td>1차 및 2차 권선 저항 측정</td>
                            <td>권선 저항 기준 일치</td>
                            <td>-</td>
                            <td>@(Model.CHK_7_1_Text)</td>
                        </tr>
                        <tr>
                            <td rowspan="1">임피던스 측정</td>
                            <td>임피던스 전압, 단락 전류 측정</td>
                            <td>정격 임피던스 및 전류 기준 부합</td>
                            <td>% / A</td>
                            <td>@(Model.CHK_8_1_Text)</td>
                        </tr>
                        <tr>
                            <td rowspan="1">온도 상승 측정</td>
                            <td>운전 중 권선 온도 상승률 측정</td>
                            <td>과도한 온도 상승 없음</td>
                            <td>℃</td>
                            <td>@(Model.CHK_9_1_Text)</td>
                        </tr>
                        <tr>
                            <td rowspan="1">기타 점검</td>
                            <td>보호장치, 냉각장치, 부싱 상태 점검</td>
                            <td>정상 작동 및 외관 이상 없음</td>
                            <td>-</td>
                            <td>@(Model.CHK_10_1_Text)</td>
                        </tr>

                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
@section Scripts {
    <script type="text/javascript">
        function deleteGojang(zigzagtrCode, tblIdx) {
            if (!confirm("Zig-Zag TR 보통점검 정보를 삭제하시겠습니까?")) return;
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("ZIGZAGTRChkDelete", "ZIGZAGTRChk")',
                    data: JSON.stringify({ zigzagtrCode: zigzagtrCode, tblIdx: tblIdx }),
                    contentType: "application/json; charset=utf-8",
                    success: function (response) {
                        if (response.success) {
                            alert("ZIGZAGTR 기본 정보가 삭제되었습니다.");
                            window.location.href = '@Url.Action("ZIGZAGTRChkTotalList", "ZIGZAGTRChk")';
                        } else {
                            alert("ZIGZAGTR 기본 정보 삭제 실패: " + response.message);
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error("삭제 중 오류:", xhr.responseText || status, error);
                        alert("삭제 중 오류가 발생했습니다: " + xhr.responseText);
                    }
                });
            }
    </script>
    }

