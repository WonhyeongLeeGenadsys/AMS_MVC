                </div>
                <!--알고리즘 반영 파라미터-->
                <div class="table_list_app">
                    <table>
                        <colgroup>
                            <col style="width:10%">
                            <col style="width:10%">
                            <col style="width:8%">
                            <col style="width:6%">
                            <col>
                        </colgroup>
