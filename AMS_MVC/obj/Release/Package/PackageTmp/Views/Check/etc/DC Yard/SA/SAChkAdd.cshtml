@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var saCode = Request.QueryString["SA_Code"] ?? "";
}

@section LeftMenu {
    @Html.Partial("_CheckMenu")
}

@section MainContent {
    <h1>
        SA 보통점검 추가: @ViewBag.SerialNo
    </h1>
    <div class="con_box">
        <div class="content_warp">
            <div class="btn_area top right">
                <p>
                    <a href="#" class="btn blue app" onclick="createSAChk()">적용</a>
                </p>
            </div>
            <form id="saChkForm" method="post" enctype="multipart/form-data">
                @* URL에 SA_Code가 전달된 경우 hidden 필드로 사용, 그렇지 않으면 드롭다운 출력 *@
                @if (!string.IsNullOrEmpty(saCode))
                {
                    <input type="hidden" name="SA_Code" value="@saCode" />
                }
                else
                {
                    <div style="margin-bottom: 15px;">
                        @Html.DropDownList("SA_Code", (SelectList)ViewBag.SAs, "SA를 선택하세요.", new { @class = "form-control", @id = "SA_Code" })
                    </div>
                }
