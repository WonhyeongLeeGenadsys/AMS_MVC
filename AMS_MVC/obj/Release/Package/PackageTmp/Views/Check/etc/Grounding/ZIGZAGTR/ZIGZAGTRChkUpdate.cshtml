@model Web.Common.ZIGZAGTRChk

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section LeftMenu {
    @Html.Partial("_CheckMenu")
}

@section MainContent {
    <h1>
        ZIGZAGTR 보통점검 수정 
    </h1>
    <div class="con_box">
        <div class="content_warp">
            <div class="btn_area top right">
                <p>
                    <a href="#" class="btn blue app" onclick="updateZIGZAGTRChk()">적용</a>
                </p>
            </div>

            <form id="zigzagtrChkUpdateForm" method="post" enctype="multipart/form-data">
                <input type="hidden" name="Tbl_Idx" value="@Model.Tbl_Idx" />
                <input type="hidden" name="ZIGZAGTR_Code" value="@Model.ZIGZAGTR_Code" />

                <div class="table_app" id="zigzagtrChk">
                    <table>
                        <colgroup>
                            <col style="width:100px;">
                            <col style="width:calc(33.3% - 100px);">
                            <col style="width:100px;">
                            <col style="width:calc(33.3% - 100px);">
                            <col style="width:100px;">
                            <col style="width:calc(33.3% - 100px);">
                        </colgroup>
                        <tr>
                            <th>공사명</th>
                            <td colspan="5">
                                <input type="text" id="chk_gongsa_name" name="chk_gongsa_name" value="@Model.CHK_Gongsa_Name">
                            </td>
                        </tr>
                        <tr>
                            <th>날씨</th>
                            <td>
                                <input type="text" id="chk_weather" name="chk_weather" value="@Model.CHK_Weather">
                            </td>
                            <th>기온</th>
                            <td>
                                <input type="text" id="chk_temp" name="chk_temp" value="@Model.CHK_Temp"> <span>°C</span>
                            </td>
                            <th>습도</th>
                            <td>
                                <input type="text" id="chk_hum" name="chk_hum" value="@Model.CHK_Hum"> <span>%</span>
                            </td>
                        </tr>
                        <tr>
                            <th>업체명</th>
                            <td>
                                @Html.DropDownList("chk_company", new SelectList(ViewBag.Companies, "Com_Name", "Com_Name", Model.CHK_Company), "제작사를 선택하세요.")
                            </td>
                            <th>점검자</th>
                            <td>
                                <input type="text" id="chk_worker" name="chk_worker" value="@Model.CHK_Worker">
                            </td>
                            <th>감독자</th>
                            <td>
                                <input type="text" id="chk_manager" name="chk_manager" value="@Model.CHK_Manager">
                            </td>
                        </tr>
                        <tr>
                            <th>급전번호</th>
                            <td>
                                <input type="text" id="chk_urgent_no" name="chk_urgent_no" value="@Model.CHK_Urgent_No">
                            </td>
                            <th>형식</th>
                            <td>
                                <input type="text" id="chk_type" name="chk_type" value="@Model.CHK_Type">
                            </td>
                            <th></th>
                            <td></td>
                        </tr>
                        <tr>
                            <th>점검 시작일</th>
                            <td>
                                <input type="date" id="chk_start_date" name="chk_start_date" value="@(Model.CHK_Start_Date.HasValue ? Model.CHK_Start_Date.Value.ToString("yyyy-MM-dd") : "")">
                            </td>
                            <th>점검 종료일</th>
                            <td>
                                <input type="date" id="chk_end_date" name="chk_end_date" value="@(Model.CHK_End_Date.HasValue ? Model.CHK_End_Date.Value.ToString("yyyy-MM-dd") : "")">
                            </td>
                            <th></th>
                            <td></td>
                        </tr>
                    </table>
                </div>
                <!--알고리즘 반영 파라미터-->
                <div class="table_list_app">
                    <table>
                        <colgroup>
                            <col style="width:10%">
                            <col style="width:10%">
                            <col style="width:8%">
                            <col style="width:6%">
                            <col>
                        </colgroup>
                        <thead>
                            <tr>
                                <th>구분</th>
                                <th>Parameters</th>
                                <th>한전기준</th>
                                <th>단위</th>
                                <th>판정기준 및 score</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td rowspan="1">
                                    외관 점검
                                </td>
                                <td>변압기 본체, 냉각 장치, 단자함 파손/부식/변형/누유 확인</td>
                                <td>이상 없음 (파손, 부식, 누유 등 무)</td>
                                <td>-</td>
                                <td>
                                    <label class="ty_rdo" for="chk_1_1_1">
                                        <input type="radio" id="chk_1_1_1" name="CHK_1_1" value="1" @(Model.CHK_1_1 == 1 ? "checked" : "")>
                                        <span>정상(1)</span>
                                    </label>
                                    <label class="ty_rdo" for="chk_1_1_2">
                                        <input type="radio" id="chk_1_1_2" name="CHK_1_1" value="5" @(Model.CHK_1_1 == 5 ? "checked" : "")>
                                        <span>이상(5)</span>
                                    </label>
                                </td>
                            </tr>

                            <tr>
                                <td rowspan="1">
                                    절연 점검
                                </td>
                                <td>절연 저항 및 부분 방전 측정</td>
                                <td>절연 기준 이상 및 부분방전 없음</td>
                                <td>MΩ/pC</td>
                                <td>
                                    <label class="ty_rdo" for="chk_2_1_1">
                                        <input type="radio" id="chk_2_1_1" name="CHK_2_1" value="1" @(Model.CHK_2_1 == 1 ? "checked" : "")>
                                        <span>정상(1)</span>
                                    </label>
                                    <label class="ty_rdo" for="chk_2_1_2">
                                        <input type="radio" id="chk_2_1_2" name="CHK_2_1" value="5" @(Model.CHK_2_1 == 5 ? "checked" : "")>
                                        <span>이상(5)</span>
                                    </label>
                                </td>
                            </tr>

                            <tr>
                                <td rowspan="1">
                                    접지 점검
                                </td>
                                <td>접지 저항 측정 및 접지선 연결 상태 확인</td>
                                <td>10Ω 이하, 접속 양호</td>
                                <td>Ω</td>
                                <td>
                                    <label class="ty_rdo" for="chk_3_1_1">
                                        <input type="radio" id="chk_3_1_1" name="CHK_3_1" value="1" @(Model.CHK_3_1 == 1 ? "checked" : "")>
                                        <span>정상(1)</span>
                                    </label>
                                    <label class="ty_rdo" for="chk_3_1_2">
                                        <input type="radio" id="chk_3_1_2" name="CHK_3_1" value="5" @(Model.CHK_3_1 == 5 ? "checked" : "")>
                                        <span>이상(5)</span>
                                    </label>
                                </td>
                            </tr>

                            <tr>
                                <td rowspan="1">온도 점검</td>
                                <td>본체, 권선, 오일 온도 측정 및 과열 여부 확인</td>
                                <td>설계 온도 이하 유지</td>
                                <td>℃</td>
                                <td>
                                    <label class="ty_rdo" for="chk_4_1_1">
                                        <input type="radio" id="chk_4_1_1" name="CHK_4_1" value="1" @(Model.CHK_4_1 == 1 ? "checked" : "")>
                                        <span>정상(1)</span>
                                    </label>
                                    <label class="ty_rdo" for="chk_4_1_2">
                                        <input type="radio" id="chk_4_1_2" name="CHK_4_1" value="5" @(Model.CHK_4_1 == 5 ? "checked" : "")>
                                        <span>이상(5)</span>
                                    </label>
                                </td>
                            </tr>

                            <tr>
                                <td rowspan="1">소음 점검</td>
                                <td>이상 소음 유무 확인</td>
                                <td>이상 소음 없을 것</td>
                                <td>-</td>
                                <td>
                                    <label class="ty_rdo" for="chk_5_1_1">
                                        <input type="radio" id="chk_5_1_1" name="CHK_5_1" value="1" @(Model.CHK_5_1 == 1 ? "checked" : "")>
                                        <span>정상(1)</span>
                                    </label>
                                    <label class="ty_rdo" for="chk_5_1_2">
                                        <input type="radio" id="chk_5_1_2" name="CHK_5_1" value="5" @(Model.CHK_5_1 == 5 ? "checked" : "")>
                                        <span>이상(5)</span>
                                    </label>
                                </td>
                            </tr>

                            <tr>
                                <td rowspan="1">오일 점검</td>
                                <td>절연유 레벨, 색상, 절연 내력 확인 (유입식)</td>
                                <td>레벨 정상, 색상 변화 없음, 내력 기준 이상</td>
                                <td>-</td>
                                <td>
                                    <label class="ty_rdo" for="chk_6_1_1">
                                        <input type="radio" id="chk_6_1_1" name="CHK_6_1" value="1" @(Model.CHK_6_1 == 1 ? "checked" : "")>
                                        <span>정상(1)</span>
                                    </label>
                                    <label class="ty_rdo" for="chk_6_1_2">
                                        <input type="radio" id="chk_6_1_2" name="CHK_6_1" value="5" @(Model.CHK_6_1 == 5 ? "checked" : "")>
                                        <span>이상(5)</span>
                                    </label>
                                </td>
                            </tr>

                            <tr>
                                <td rowspan="1">권선 점검</td>
                                <td>1차 및 2차 권선 저항 측정</td>
                                <td>권선 저항 기준 일치</td>
                                <td>Ω</td>
                                <td>
                                    <label class="ty_rdo" for="chk_7_1_1">
                                        <input type="radio" id="chk_7_1_1" name="CHK_7_1" value="1" @(Model.CHK_7_1 == 1 ? "checked" : "")>
                                        <span>정상(1)</span>
                                    </label>
                                    <label class="ty_rdo" for="chk_7_1_2">
                                        <input type="radio" id="chk_7_1_2" name="CHK_7_1" value="5" @(Model.CHK_7_1 == 5 ? "checked" : "")>
                                        <span>이상(5)</span>
                                    </label>
                                </td>
                            </tr>

                            <tr>
                                <td rowspan="1">임피던스 측정</td>
                                <td>임피던스 전압, 단락 전류 측정</td>
                                <td>정격 임피던스 및 전류 기준 부합</td>
                                <td>% / A</td>
                                <td>
                                    <label class="ty_rdo" for="chk_8_1_1">
                                        <input type="radio" id="chk_8_1_1" name="CHK_8_1" value="1" @(Model.CHK_8_1 == 1 ? "checked" : "")>
                                        <span>정상(1)</span>
                                    </label>
                                    <label class="ty_rdo" for="chk_8_1_2">
                                        <input type="radio" id="chk_8_1_2" name="CHK_8_1" value="5" @(Model.CHK_8_1 == 5 ? "checked" : "")>
                                        <span>이상(5)</span>
                                    </label>
                                </td>
                            </tr>

                            <tr>
                                <td rowspan="1">온도 상승 측정</td>
                                <td>운전 중 권선 온도 상승률 측정</td>
                                <td>과도한 온도 상승 없음</td>
                                <td>℃</td>
                                <td>
                                    <label class="ty_rdo" for="chk_9_1_1">
                                        <input type="radio" id="chk_9_1_1" name="CHK_9_1" value="1" @(Model.CHK_9_1 == 1 ? "checked" : "")>
                                        <span>정상(1)</span>
                                    </label>
                                    <label class="ty_rdo" for="chk_9_1_2">
                                        <input type="radio" id="chk_9_1_2" name="CHK_9_1" value="5" @(Model.CHK_9_1 == 5 ? "checked" : "")>
                                        <span>이상(5)</span>
                                    </label>
                                </td>
                            </tr>

                            <tr>
                                <td rowspan="1">기타 점검</td>
                                <td>보호장치, 냉각장치, 부싱 상태 점검</td>
                                <td>정상 작동 및 외관 이상 없음</td>
                                <td>-</td>
                                <td>
                                    <label class="ty_rdo" for="chk_10_1_1">
                                        <input type="radio" id="chk_10_1_1" name="CHK_10_1" value="1" @(Model.CHK_10_1 == 1 ? "checked" : "")>
                                        <span>정상(1)</span>
                                    </label>
                                    <label class="ty_rdo" for="chk_10_1_2">
                                        <input type="radio" id="chk_10_1_2" name="CHK_10_1" value="5" @(Model.CHK_10_1 == 5 ? "checked" : "")>
                                        <span>이상(5)</span>
                                    </label>
                                </td>
                            </tr>
                    </table>
                </div>
            </form>
        </div>
    </div>

    <script>
        function updateZIGZAGTRChk() {
            var form = document.getElementById("zigzagtrChkUpdateForm");
            var formData = new FormData(form);

            // FormData 내용을 콘솔에 출력
            for (var pair of formData.entries()) {
                console.log(pair[0] + ": " + pair[1]);
            }

            $.ajax({
                url: '@Url.Action("ZIGZAGTRChkUpdate", "ZIGZAGTRChk")',
                type: "POST",
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {
                    console.log("서버 응답:", response);
                    if (response.IsSuccess) {
                        alert("ZIGZAGTR 보통점검 정보가 수정되었습니다.");
                        window.location.href = '@Url.Action("ZIGZAGTRChkTotalList", "ZIGZAGTRChk")';
                    } else {
                        alert("ZIGZAGTR 보통점검 정보를 수정하지 못했습니다.: " + response.message);
                    }
                },
                error: function (xhr, status, error) {
                    console.error("오류 발생:", xhr.responseText || status, error);
                    alert("ZIGZAGTR 보통점검 정보 수정중 오류가 발생했습니다." + xhr.responseText);
                }
            });
        }
    </script>
}
