@model Web.Common.TANKChk

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section LeftMenu {
    @Html.Partial("_CheckMenu")
}

@section MainContent {
    <h1>
        TANK 보통점검 수정 
    </h1>
    <div class="con_box">
        <div class="content_warp">
            <div class="btn_area top right">
                <p>
                    <a href="#" class="btn blue app" onclick="updateTANKChk()">적용</a>
                </p>
            </div>

            <form id="tankChkUpdateForm" method="post" enctype="multipart/form-data">
                <input type="hidden" name="Tbl_Idx" value="@Model.Tbl_Idx" />
                <input type="hidden" name="TANK_Code" value="@Model.TANK_Code" />

                <div class="table_app" id="tankChk">
                    <table>
                        <colgroup>
                            <col style="width:100px;">
                            <col style="width:calc(33.3% - 100px);">
                            <col style="width:100px;">
                            <col style="width:calc(33.3% - 100px);">
                            <col style="width:100px;">
                            <col style="width:calc(33.3% - 100px);">
                        </colgroup>
                        <tr>
                            <th>공사명</th>
                            <td colspan="5">
                                <input type="text" id="chk_gongsa_name" name="chk_gongsa_name" value="@Model.CHK_Gongsa_Name">
                            </td>
                        </tr>
                        <tr>
                            <th>날씨</th>
                            <td>
                                <input type="text" id="chk_weather" name="chk_weather" value="@Model.CHK_Weather">
                            </td>
                            <th>기온</th>
                            <td>
                                <input type="text" id="chk_temp" name="chk_temp" value="@Model.CHK_Temp"> <span>°C</span>
                            </td>
                            <th>습도</th>
                            <td>
                                <input type="text" id="chk_hum" name="chk_hum" value="@Model.CHK_Hum"> <span>%</span>
                            </td>
                        </tr>
                        <tr>
                            <th>업체명</th>
                            <td>
                                @Html.DropDownList("chk_company", new SelectList(ViewBag.Companies, "Com_Name", "Com_Name", Model.CHK_Company), "제작사를 선택하세요.")
                            </td>
                            <th>점검자</th>
                            <td>
                                <input type="text" id="chk_worker" name="chk_worker" value="@Model.CHK_Worker">
                            </td>
                            <th>감독자</th>
                            <td>
                                <input type="text" id="chk_manager" name="chk_manager" value="@Model.CHK_Manager">
                            </td>
                        </tr>
                        <tr>
                            <th>급전번호</th>
                            <td>
                                <input type="text" id="chk_urgent_no" name="chk_urgent_no" value="@Model.CHK_Urgent_No">
                            </td>
                            <th>형식</th>
                            <td>
                                <input type="text" id="chk_type" name="chk_type" value="@Model.CHK_Type">
                            </td>
                            <th></th>
                            <td></td>
                        </tr>
                        <tr>
                            <th>점검 시작일</th>
                            <td>
                                <input type="date" id="chk_start_date" name="chk_start_date" value="@(Model.CHK_Start_Date.HasValue ? Model.CHK_Start_Date.Value.ToString("yyyy-MM-dd") : "")">
                            </td>
                            <th>점검 종료일</th>
                            <td>
                                <input type="date" id="chk_end_date" name="chk_end_date" value="@(Model.CHK_End_Date.HasValue ? Model.CHK_End_Date.Value.ToString("yyyy-MM-dd") : "")">
                            </td>
                            <th></th>
                            <td></td>
                        </tr>
                    </table>
                </div>
                <!--알고리즘 반영 파라미터-->
                <div class="table_list_app">
                    <table>
                        <colgroup>
                            <col style="width:10%">
                            <col style="width:10%">
                            <col style="width:8%">
                            <col style="width:6%">
                            <col>
                            <col style="width:3%">
                        </colgroup>
                        <thead>
                            <tr>
                                <th>구분</th>
                                <th>Parameters</th>
                                <th>한전기준</th>
                                <th>단위</th>
                                <th>판정기준 및 score</th>
                                <th>가중치</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td rowspan="2">
                                    외관 점검
                                </td>
                                <td>탱크 표면 및 연결 부위 누유, 부식, 손상 여부 확인</td>
                                <td>이상 없음 (누유/부식/손상 무)</td>
                                <td>-</td>
                                <td>
                                    <label class="ty_rdo" for="chk_1_1_1">
                                        <input type="radio" id="chk_1_1_1" name="chk_1_1" checked>
                                        <span>정상(1)</span>
                                    </label>
                                    <label class="ty_rdo" for="chk_1_1_2">
                                        <input type="radio" id="chk_1_1_2" name="chk_1_1">
                                        <span>이상(5)</span>
                                    </label>
                                </td>
                                <td rowspan="2">-</td>
                            </tr>
                            <tr>
                                <td>밸브 및 계측기 상태 점검</td>
                                <td>밸브 작동 및 계측 상태 양호</td>
                                <td>-</td>
                                <td>
                                    <label class="ty_rdo" for="chk_1_2_1">
                                        <input type="radio" id="chk_1_2_1" name="chk_1_2" checked>
                                        <span>정상(1)</span>
                                    </label>
                                    <label class="ty_rdo" for="chk_1_2_2">
                                        <input type="radio" id="chk_1_2_2" name="chk_1_2">
                                        <span>이상(5)</span>
                                    </label>
                                </td>
                            </tr>

                            <tr>
                                <td rowspan="2">
                                    기능 점검
                                </td>
                                <td>압력, 온도 정상 범위 작동 여부 확인</td>
                                <td>압력/온도 설계 범위 내 유지</td>
                                <td>kg/cm², ℃</td>
                                <td>
                                    <label class="ty_rdo" for="chk_2_1_1">
                                        <input type="radio" id="chk_2_1_1" name="chk_2_1" checked>
                                        <span>정상(1)</span>
                                    </label>
                                    <label class="ty_rdo" for="chk_2_1_2">
                                        <input type="radio" id="chk_2_1_2" name="chk_2_1">
                                        <span>이상(5)</span>
                                    </label>
                                </td>
                                <td rowspan="2">-</td>
                            </tr>
                            <tr>
                                <td>유량 정상 작동 여부 확인</td>
                                <td>정상 유량 유지</td>
                                <td>m³/h</td>
                                <td>
                                    <label class="ty_rdo" for="chk_2_2_1">
                                        <input type="radio" id="chk_2_2_1" name="chk_2_2" checked>
                                        <span>정상(1)</span>
                                    </label>
                                    <label class="ty_rdo" for="chk_2_2_2">
                                        <input type="radio" id="chk_2_2_2" name="chk_2_2">
                                        <span>이상(5)</span>
                                    </label>
                                </td>
                            </tr>

                            <tr>
                                <td rowspan="1">
                                    안전 장치 점검
                                </td>
                                <td>안전밸브, 방폭 장치 작동 상태 확인</td>
                                <td>정상 작동 확인 (점검 및 시험 포함)</td>
                                <td>-</td>
                                <td>
                                    <label class="ty_rdo" for="chk_3_1_1">
                                        <input type="radio" id="chk_3_1_1" name="chk_3_1" checked>
                                        <span>정상(1)</span>
                                    </label>
                                    <label class="ty_rdo" for="chk_3_1_2">
                                        <input type="radio" id="chk_3_1_2" name="chk_3_1">
                                        <span>이상(5)</span>
                                    </label>
                                </td>
                                <td rowspan="1">-</td>
                            </tr>

                            <tr>
                                <td rowspan="1">
                                    주변 환경 점검
                                </td>
                                <td>위험 물질 및 화재 위험 요인 여부 확인</td>
                                <td>위험 요소 없음 (청결 유지)</td>
                                <td>-</td>
                                <td>
                                    <label class="ty_rdo" for="chk_4_1_1">
                                        <input type="radio" id="chk_4_1_1" name="chk_4_1" checked>
                                        <span>정상(1)</span>
                                    </label>
                                    <label class="ty_rdo" for="chk_4_1_2">
                                        <input type="radio" id="chk_4_1_2" name="chk_4_1">
                                        <span>이상(5)</span>
                                    </label>
                                </td>
                                <td rowspan="1">-</td>
                            </tr>

                    </table>
                </div>
            </form>
        </div>
    </div>

    <script>
        function updateTANKChk() {
            var form = document.getElementById("tankChkUpdateForm");
            var formData = new FormData(form);

            // FormData 내용을 콘솔에 출력
            for (var pair of formData.entries()) {
                console.log(pair[0] + ": " + pair[1]);
            }

            $.ajax({
                url: '@Url.Action("TANKChkUpdate", "TANKChk")',
                type: "POST",
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {
                    console.log("서버 응답:", response);
                    if (response.IsSuccess) {
                        alert("TANK 보통점검 정보가 수정되었습니다.");
                        window.location.href = '@Url.Action("TANKChkTotalList", "TANKChk")';
                    } else {
                        alert("TANK 보통점검 정보를 수정하지 못했습니다.: " + response.message);
                    }
                },
                error: function (xhr, status, error) {
                    console.error("오류 발생:", xhr.responseText || status, error);
                    alert("TANK 보통점검 정보 수정중 오류가 발생했습니다." + xhr.responseText);
                }
            });
        }
    </script>
}
