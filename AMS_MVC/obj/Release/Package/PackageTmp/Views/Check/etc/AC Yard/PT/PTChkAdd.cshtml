@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var ptCode = Request.QueryString["PT_Code"] ?? "";
}

@section LeftMenu {
    @Html.Partial("_CheckMenu")
}

@section MainContent {
    <h1>
        PT 보통점검 추가: @ViewBag.SerialNo
    </h1>
    <div class="con_box">
        <div class="content_warp">
            <div class="btn_area top right">
                <p>
                    <a href="#" class="btn blue app" onclick="createPTChk()">적용</a>
                </p>
            </div>
            <form id="ptChkForm" method="post" enctype="multipart/form-data">
                @* URL에 PT_Code가 전달된 경우 hidden 필드로 사용, 그렇지 않으면 드롭다운 출력 *@
                @if (!string.IsNullOrEmpty(ptCode))
                {
                    <input type="hidden" name="PT_Code" value="@ptCode" />
                }
                else
                {
                    <div style="margin-bottom: 15px;">
                        @Html.DropDownList("PT_Code", (SelectList)ViewBag.PTs, "PT를 선택하세요.", new { @class = "form-control", @id = "PT_Code" })
                    </div>
                }
                <div class="table_app" id="ptChk">
                    <table>
                        <colgroup>
                            <col style="width:100px;">
                            <col style="width:calc(33.3% - 100px);">
                            <col style="width:100px;">
                            <col style="width:calc(33.3% - 100px);">
                            <col style="width:100px;">
                            <col style="width:calc(33.3% - 100px);">
                        </colgroup>
                        <tr>
                            <th>공사명</th>
                            <td colspan="5">
                                <input type="text" id="chk_gongsa_name" name="chk_gongsa_name">
                            </td>
                        </tr>
                        <tr>
                            <th>날씨</th>
                            <td>
                                <input type="text" id="chk_weather" name="chk_weather">
                            </td>
                            <th>기온</th>
                            <td>
                                <input type="text" id="chk_temp" name="chk_temp"> <span>°C</span>
                            </td>
                            <th>습도</th>
                            <td>
                                <input type="text" id="chk_hum" name="chk_hum"> <span>%</span>
                            </td>
                        </tr>
                        <tr>
                            <th>업체명</th>
                            <td>
                                @Html.DropDownList("chk_company", new SelectList(ViewBag.Companies, "Com_Name", "Com_Name"), "제작사를 선택하세요.")
                            </td>
                            <th>점검자</th>
                            <td>
                                <input type="text" id="chk_worker" name="chk_worker">
                            </td>
                            <th>감독자</th>
                            <td>
                                <input type="text" id="chk_manager" name="chk_manager">
                            </td>
                        </tr>
                        <tr>
                            <th>급전번호</th>
                            <td>
                                <input type="text" id="chk_urgent_no" name="chk_urgent_no">
                            </td>
                            <th>형식</th>
                            <td>
                                <input type="text" id="chk_type" name="chk_type">
                            </td>
                            <th></th>
                            <td></td>
                        </tr>
                        <tr>
                            <th>점검 시작일</th>
                            <td>
                                <input type="date" id="chk_start_date" name="chk_start_date">
                            </td>
                            <th>점검 종료일</th>
                            <td>
                                <input type="date" id="chk_end_date" name="chk_end_date">
                            </td>
                            <th></th>
                            <td></td>
                        </tr>
                    </table>
                </div>
                <!--//입력테이블-->
                <!--알고리즘 반영 파라미터-->
                <div class="table_list_app">
                    <table>
                        <colgroup>
                            <col style="width:10%">
                            <col style="width:10%">
                            <col style="width:8%">
                            <col style="width:6%">
                            <col>
                        </colgroup>
                        <thead>
                            <tr>
                                <th>구분</th>
                                <th>Parameters</th>
                                <th>한전기준</th>
                                <th>단위</th>
                                <th>판정기준 및 score</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td rowspan="1">
                                    외관 점검
                                </td>
                                <td>애관부 균열 및 오손 여부 점검/청소</td>
                                <td>균열·오손 없고 청결 유지</td>
                                <td>-</td>
                                <td>
                                    <label class="ty_rdo" for="chk_1_1_1">
                                        <input type="radio" id="chk_1_1_1" name="CHK_1_1" value="1" checked>
                                        <span>정상(1)</span>
                                    </label>
                                    <label class="ty_rdo" for="chk_1_1_2">
                                        <input type="radio" id="chk_1_1_2" name="CHK_1_1" value="5">
                                        <span>이상(5)</span>
                                    </label>
                                </td>
                            </tr>

                            <tr>
                                <td rowspan="2">
                                    접속 점검
                                </td>
                                <td>1차 단자부 볼트 조임</td>
                                <td>풀림 없이 견고히 체결</td>
                                <td>-</td>
                                <td>
                                    <label class="ty_rdo" for="chk_2_1_1">
                                        <input type="radio" id="chk_2_1_1" name="CHK_2_1"  value="1" checked>
                                        <span>정상(1)</span>
                                    </label>
                                    <label class="ty_rdo" for="chk_2_1_2">
                                        <input type="radio" id="chk_2_1_2" name="CHK_2_1" value="5">
                                        <span>이상(5)</span>
                                    </label>
                                </td>
                            </tr>
                            <tr>
                                <td>2차 단자함 내부 점검 및 볼트 조임</td>
                                <td>이상 없음 및 조임 상태 양호</td>
                                <td>-</td>
                                <td>
                                    <label class="ty_rdo" for="chk_2_2_1">
                                        <input type="radio" id="chk_2_2_1" name="CHK_2_2" value="1" checked>
                                        <span>정상(1)</span>
                                    </label>
                                    <label class="ty_rdo" for="chk_2_2_2">
                                        <input type="radio" id="chk_2_2_2" name="CHK_2_2" value="5">
                                        <span>이상(5)</span>
                                    </label>
                                </td>
                            </tr>

                            <tr>
                                <td rowspan="1">기능 시험</td>
                                <td>절연저항 / 절연열화 측정 / 포화시험</td>
                                <td>기기 기준치 만족</td>
                                <td>-</td>
                                <td>
                                    <label class="ty_rdo" for="chk_3_1_1">
                                        <input type="radio" id="chk_3_1_1" name="CHK_3_1" value="1" checked>
                                        <span>정상(1)</span>
                                    </label>
                                    <label class="ty_rdo" for="chk_3_1_2">
                                        <input type="radio" id="chk_3_1_2" name="CHK_3_1" value="5">
                                        <span>이상(5)</span>
                                    </label>
                                </td>
                            </tr>

                            <tr>
                                <td rowspan="2">부속 점검</td>
                                <td>콘덴서형 전압변성기 보호캡 점검</td>
                                <td>보호캡 손상 및 탈락 없음</td>
                                <td>-</td>
                                <td>
                                    <label class="ty_rdo" for="chk_4_1_1">
                                        <input type="radio" id="chk_4_1_1" name="CHK_4_1" value="1" checked>
                                        <span>정상(1)</span>
                                    </label>
                                    <label class="ty_rdo" for="chk_4_1_2">
                                        <input type="radio" id="chk_4_1_2" name="CHK_4_1" value="5">
                                        <span>이상(5)</span>
                                    </label>
                                </td>
                            </tr>
                            <tr>
                                <td>호흡기 상태 점검</td>
                                <td>실리카겔 변색 없고 건조 상태</td>
                                <td>-</td>
                                <td>
                                    <label class="ty_rdo" for="chk_4_2_1">
                                        <input type="radio" id="chk_4_2_1" name="CHK_4_2" value="1"checked>
                                        <span>정상(1)</span>
                                    </label>
                                    <label class="ty_rdo" for="chk_4_2_2">
                                        <input type="radio" id="chk_4_2_2" name="CHK_4_2" value="5">
                                        <span>이상(5)</span>
                                    </label>
                                </td>
                            </tr>

                            <tr>
                                <td rowspan="1">케이블 점검</td>
                                <td>케이블 고정부 청소 및 이완 여부 점검</td>
                                <td>이완·오염 없고 고정 상태 양호</td>
                                <td>-</td>
                                <td>
                                    <label class="ty_rdo" for="chk_5_1_1">
                                        <input type="radio" id="chk_5_1_1" name="CHK_5_1" value="1"checked>
                                        <span>정상(1)</span>
                                    </label>
                                    <label class="ty_rdo" for="chk_5_1_2">
                                        <input type="radio" id="chk_5_1_2" name="CHK_5_1" value="5">
                                        <span>이상(5)</span>
                                    </label>
                                </td>
                            </tr>

                            <tr>
                                <td rowspan="1">접지 점검</td>
                                <td>접지선 접속부 조임 상태 점검</td>
                                <td>볼트 풀림 없이 견고히 체결</td>
                                <td>-</td>
                                <td>
                                    <label class="ty_rdo" for="chk_6_1_1">
                                        <input type="radio" id="chk_6_1_1" name="CHK_6_1" value="1" checked>
                                        <span>정상(1)</span>
                                    </label>
                                    <label class="ty_rdo" for="chk_6_1_2">
                                        <input type="radio" id="chk_6_1_2" name="CHK_6_1" value="5">
                                        <span>이상(5)</span>
                                    </label>
                                </td>
                            </tr>

                            <tr>
                                <td rowspan="1">유류 점검</td>
                                <td>Oil Level 점검</td>
                                <td>적정 유위 유지</td>
                                <td>-</td>
                                <td>
                                    <label class="ty_rdo" for="chk_7_1_1">
                                        <input type="radio" id="chk_7_1_1" name="CHK_7_1" value="1" checked>
                                        <span>정상(1)</span>
                                    </label>
                                    <label class="ty_rdo" for="chk_7_1_2">
                                        <input type="radio" id="chk_7_1_2" name="CHK_7_1" value="5" >
                                        <span>이상(5)</span>
                                    </label>
                                </td>
                            </tr>
                    </table>
                </div>
            </form>
        </div>
    </div>

    <script>
    // PT 점검 정보 수집 함수
        function createPTChk() {
            submitPTChkForm();
        }

        function submitPTChkForm() {
            var form = document.getElementById("ptChkForm");
            var formData = new FormData(form);

            var ptCodeDropdown = document.getElementById("PT_Code");
            if (ptCodeDropdown) {
                if (!ptCodeDropdown.value) {
                    alert("PT를 선택하세요.");
                    return;
                }
            }

            // FormData 내용을 콘솔에 출력
            for (var pair of formData.entries()) {
                console.log(pair[0] + ": " + pair[1]);
            }

            $.ajax({
            url: '@Url.Action("PTChkAdd", "PTChk")',
            type: "POST",
            data: formData,
            processData: false,
            contentType: false,
            success: function (response) {
                console.log("서버 응답:", response);
                if (response.IsSuccess) {
                    alert("PT 보통점검 정보가 저장되었습니다.");
                    window.location.href = '@Url.Action("PTChkTotalList", "PTChk")';
                } else {
                    alert("PT 보통점검 정보를 추가하지 못했습니다.: " + response.message);
                }
            },
            error: function (xhr, status, error) {
                console.error("오류 발생:", xhr.responseText || status, error);
                alert("PT 보통점검 정보 등록 중 오류가 발생했습니다." + xhr.responseText);
            }
        });
    }
    </script>
}