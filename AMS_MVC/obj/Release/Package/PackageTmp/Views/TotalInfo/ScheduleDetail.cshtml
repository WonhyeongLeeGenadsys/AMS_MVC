@model IEnumerable<dynamic>
@{
    Layout = null;    // 팝업 전용이므로 레이아웃 비활성화
    var list = Model.ToList();

    // ID 부여 및 JSON 변환
    Func<dynamic, string, object> GetVal = (obj, propName) =>
    {
        var pi = obj.GetType().GetProperty(propName);
        return pi != null ? pi.GetValue(obj) : null;
    };

    var rows = new List<dynamic>();
    int id = 1;
    foreach (var d in list)
    {
        rows.Add(new
        {
            ID = id++,
            construc = GetVal(d, "CHK_Gongsa_Name") ?? GetVal(d, "CHK1_Gongsa_Name") ?? GetVal(d, "CHK2_Gongsa_Name") ?? "",
            weather = GetVal(d, "CHK_Weather") ?? GetVal(d, "CHK1_Weather") ?? GetVal(d, "CHK2_Weather") ?? "",
            temper = GetVal(d, "CHK_Temp") ?? GetVal(d, "CHK1_Temp") ?? GetVal(d, "CHK2_Temp") ?? "",
            humidity = GetVal(d, "CHK_Hum") ?? GetVal(d, "CHK1_Hum") ?? GetVal(d, "CHK2_Hum") ?? "",
            company = GetVal(d, "CHK_Company") ?? GetVal(d, "CHK1_Company") ?? GetVal(d, "CHK2_Company") ?? "",
            check = GetVal(d, "CHK_Worker") ?? GetVal(d, "CHK1_Worker") ?? GetVal(d, "CHK2_Worker") ?? "",
            supervisor = GetVal(d, "CHK_Manager") ?? GetVal(d, "CHK1_Manager") ?? GetVal(d, "CHK2_Manager") ?? "",
            start_date = ((DateTime?)(
                            GetVal(d, "CHK_Start_Date") ??
                            GetVal(d, "CHK1_Start_Date") ??
                            GetVal(d, "CHK2_Start_Date")
                          ))?.ToString("yyyy-MM-dd") ?? "",
            end_date = ((DateTime?)(
                            GetVal(d, "CHK_End_Date") ??
                            GetVal(d, "CHK1_End_Date") ??
                            GetVal(d, "CHK2_End_Date")
                          ))?.ToString("yyyy-MM-dd") ?? ""
        });
    }
    var jsonData = Json.Encode(rows);
}

<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Script-Type" content="text/javascript" />
    <meta http-equiv="Content-Style-Type" content="text/css" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0, user-scalable=yes" />
    <meta name="format-detection" content="telephone=no">
    <meta name="keywords" content="Electric">
    <meta name="description" content="Electric">
    <meta name="apple-mobile-web-app-title" content="Electric" />
    <meta name="robots" content="index,nofollow" />
    <title>::Electric::</title>
    <!-- js -->
    <script type="text/javascript" src="~/js/jquery-3.6.0.min.js"></script>
    <script type="text/javascript" src="~/js/electric.js"></script>
    <!-- plugin -->
    <script type="text/javascript" src="~/plugin/dx.all.js"></script>
    <link href="~/plugin/dx.light.css" rel="stylesheet" type="text/css" />
    <!-- css -->
    <link href="~/font/font.css" rel="stylesheet" type="text/css" />
    <link href="~/css/electric.css" rel="stylesheet" type="text/css" />

    <style>
        /* 탭 텍스트 컬러 지정 */
        ul.tab li:nth-child(1) a {
            color: #0051A2;
        }
        /* 보통점검 : 파란색 */
        ul.tab li:nth-child(2) a {
            color: #800080;
        }
        /* 정밀점검 : 보라색 */
    </style>
</head>
<body class="popup">
    <article class="popup_wrap">
        <!-- 타이틀 -->
        <h1>@ViewBag.Type - @ViewBag.Code</h1>
        <!-- //타이틀 -->
        <!-- 탭 -->
        <ul class="tab">
            <li><a href="javascript:void(0)" class="on">보통점검</a></li>
            <li><a href="javascript:void(0)">정밀점검</a></li>
        </ul>
        <!-- //탭 -->
        <!-- 그리드 -->
        <div id="gridContainer" class="grid_wrap" style="height:450px;"></div>
        <!-- //그리드 -->
    </article>

    <script type="text/javascript">
    // 서버에서 주입된 데이터
    var customers = @Html.Raw(jsonData);

    $(function() {
        $('#gridContainer').dxDataGrid({
            dataSource: customers,
            columnFixing: { enabled: true },
            showBorders: false,
            keyExpr: 'ID',
            columns: [
                { dataField: 'construc',   caption: '공사명',      alignment: 'center', width: 100 },
                { dataField: 'weather',    caption: '날씨',        alignment: 'center', width: 80  },
                { dataField: 'temper',     caption: '기온(°C)',    alignment: 'center', width: 80  },
                { dataField: 'humidity',   caption: '습도(%)',     alignment: 'center', width: 80  },
                { dataField: 'company',    caption: '업체명',      alignment: 'center',   width: 120},
                { dataField: 'check',      caption: '점검자',      alignment: 'center', width: 100 },
                { dataField: 'supervisor', caption: '감독자',      alignment: 'center', width: 100 },
                { dataField: 'start_date', caption: '점검시작일',  alignment: 'center', width: 120, dataType: 'date' },
                { dataField: 'end_date',   caption: '점검 종료일', alignment: 'center', width: 120, dataType: 'date' }
            ],
            scrolling: { columnRenderingMode: 'virtual' },
            paging:    { enabled: false }
        });
    });
    </script>
</body>
</html>
