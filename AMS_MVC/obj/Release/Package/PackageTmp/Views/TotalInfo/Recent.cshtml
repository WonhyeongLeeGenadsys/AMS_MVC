@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section LeftMenu { @Html.Partial("_TotalInfoMenu") }

@section MainContent {
    <h1>최근 활동</h1>

    <div class="box_wrap totalInfo_content on">
        <div class="con_box totalInfo">

            <ul class="sub_flex main4">
                <li>
                    <h2>건전도 (Before)</h2>
                    <div id="pieBefore" class="chart_box"></div>
                </li>

                <li>
                    <h2>Risk Matrix (Before)</h2>
                    <div class="matrix_group">
                        <div id="matrixBefore" class="chart_box matrix" data-prefix="all"></div>
                        <ul class="chartContainer_bg">
                            <li class="yellow"></li>
                            <li class="yellow"></li>
                            <li class="orange"></li>
                            <li class="orange"></li>
                            <li class="orange"></li>
                            <li class="green"></li>
                            <li class="yellow"></li>
                            <li class="yellow"></li>
                            <li class="orange"></li>
                            <li class="orange"></li>
                            <li class="green"></li>
                            <li class="green"></li>
                            <li class="yellow"></li>
                            <li class="yellow"></li>
                            <li class="orange"></li>
                            <li class="blue"></li>
                            <li class="green"></li>
                            <li class="green"></li>
                            <li class="yellow"></li>
                            <li class="yellow"></li>
                            <li class="blue"></li>
                            <li class="blue"></li>
                            <li class="green"></li>
                            <li class="green"></li>
                            <li class="yellow"></li>
                        </ul>
                    </div>
                </li>

                <li>
                    <h2>건전도 (After)</h2>
                    <div id="pieAfter" class="chart_box"></div>
                </li>

                <li>
                    <h2>Risk Matrix (After)</h2>
                    <div class="matrix_group">
                        <div id="matrixAfter" class="chart_box matrix" data-prefix="all"></div>
                        <ul class="chartContainer_bg">
                            <li class="yellow"></li>
                            <li class="yellow"></li>
                            <li class="orange"></li>
                            <li class="orange"></li>
                            <li class="orange"></li>
                            <li class="green"></li>
                            <li class="yellow"></li>
                            <li class="yellow"></li>
                            <li class="orange"></li>
                            <li class="orange"></li>
                            <li class="green"></li>
                            <li class="green"></li>
                            <li class="yellow"></li>
                            <li class="yellow"></li>
                            <li class="orange"></li>
                            <li class="blue"></li>
                            <li class="green"></li>
                            <li class="green"></li>
                            <li class="yellow"></li>
                            <li class="yellow"></li>
                            <li class="blue"></li>
                            <li class="blue"></li>
                            <li class="green"></li>
                            <li class="green"></li>
                            <li class="yellow"></li>
                        </ul>
                    </div>
                </li>
            </ul>

            <div class="box_group" style="margin-top:50px;">
                <h2>변경 내역</h2>
                <div id="changeGrid" class="grid_wrap" style="margin-top:20px;"></div>
            </div>

        </div>
    </div>
}

@section Scripts {
    <script>
$(function(){
    // MS JSON 날짜 문자열을 Date로 바꾸는 헬퍼
    function parseMsDate(msDateStr) {
        if (!msDateStr) return null;
        const ticks = parseInt(msDateStr.replace(/\D/g, ''), 10);
        return isNaN(ticks) ? null : new Date(ticks);
    }

    $.getJSON('@Url.Action("GetRecentActivity","TotalInfo")')
     .done(function(data){
        // 1) Before/After Pie 용 카운트 집계
        const beforeCnt = {}, afterCnt = {};
        data.forEach(d => {
            beforeCnt[d.Before.Hi] = (beforeCnt[d.Before.Hi]||0) + 1;
            afterCnt [d.After.Hi ] = (afterCnt [d.After.Hi ]||0) + 1;
        });
        function makeDs(cntObj){
            return Object.entries(cntObj)
                         .map(([hi,c])=>({ hi:+hi, state:hi+'등급', value:c }))
                         .sort((a,b)=>a.hi-b.hi);
        }
        const dsBefore = makeDs(beforeCnt),
              dsAfter  = makeDs(afterCnt);

        // HI별 색상 함수
        function getHiColor(hi){
            switch(hi){
                case 1: return '#5B9F56'; // 초록
                case 2: return '#B4DEB1'; // 연두
                case 3: return '#EBCD1D'; // 노랑
                case 4: return '#F18425'; // 주황
                case 5: return '#F05153'; // 빨강 
                default: return '#888'; // 회색
            }
        }

         // 도넛 차트: index와 동일 사이즈
         ['Before', 'After'].forEach(stage => {
             $('#pie' + stage).dxPieChart({
                 type: 'doughnut',
                 dataSource: stage === 'Before' ? dsBefore : dsAfter,
                 customizePoint: pt => ({ color: getHiColor(pt.data.hi) }),
                 series: [{
                     argumentField: 'state',
                     valueField: 'value',
                     label: { visible: true, connector: { visible: true }, customizeText: e => e.valueText + '대' }
                 }],
                 legend: { visible: true, verticalAlignment: 'bottom', horizontalAlignment: 'center', markerShape: 'circle' },
                 size: { width: '100%', height: 300 },   // ★ index와 동일
                 innerRadius: 0.5
             });
         });

         // Risk Matrix: index와 동일 사이즈(400x300)
         [['Before', 'matrixBefore'], ['After', 'matrixAfter']].forEach(([stage, id]) => {
             const pts = data.map(d => ({
                 x: stage === 'Before' ? +d.Before.Cof : +d.After.Cof,
                 y: stage === 'Before' ? +d.Before.Pof : +d.After.Pof,
                 name: d.Code
             }));

             $('#' + id).dxChart({
                 dataSource: pts,
                 commonSeriesSettings: { type: 'scatter', argumentField: 'x', valueField: 'y', point: { size: 10 } },
                 palette: ['#34A369', '#B82069', '#F57B50', '#2B6D6F', '#38B295', '#DC9FF1', '#EBCC44', '#CFD94D', '#E43387', '#002C68'],
                 border: { visible: false },
                 seriesTemplate: { nameField: 'name' },
                 argumentAxis: {
                     visualRange: { startValue: 0, endValue: 40000 },
                     valueMarginsEnabled: false,
                     tickInterval: 8000,
                     grid: { visible: true, opacity: 0.5, color: '#ffffff', width: 1 },
                     title: { text: 'CoF ($)' },
                     label: { customizeText: e => e.value.toLocaleString() }
                 },
                 valueAxis: {
                     visualRange: { startValue: 0, endValue: 100 },
                     endOnTick: false,
                     valueMarginsEnabled: false,
                     tickInterval: 20,
                     grid: { visible: true, opacity: 0.5, color: '#ffffff', width: 1 },
                     title: { text: 'PoF (%)' },
                     label: { customizeText: e => e.value.toFixed(0) + '%' }
                 },
                 tooltip: {
                     enabled: true, location: 'edge',
                     customizeTooltip: i => {
                         const d = i.point.data;
                         return { html: `<strong>${d.name}</strong><br/>CoF: ${d.x.toLocaleString()}$<br/>PoF: ${d.y.toFixed(2)}%` };
                     }
                 },
                 legend: { visible: true, position: 'bottom', verticalAlignment: 'bottom', horizontalAlignment: 'center', markerShape: 'circle' },
                 size: { width: 400, height: 340 },   
                 margin: 0
             });
         });


        // 4) 변경 내역 DevExpress Grid — 날짜 파싱 및 최신 AfterTime 기준 정렬
         const gridDs = data
             .map(d => ({
                 Code: d.Code,
                 Before_HI: d.Before.Hi,
                 After_HI: d.After.Hi,
                 Before_CoF: d.Before.Cof,
                 After_CoF: d.After.Cof,
                 Before_PoF: d.Before.Pof / 100,
                 After_PoF: d.After.Pof / 100,
                 BeforeTime: parseMsDate(d.BeforeTime),
                 AfterTime: parseMsDate(d.AfterTime)
             }))
             .filter(r =>
                 r.Before_HI !== r.After_HI ||
                 r.Before_CoF !== r.After_CoF ||
                 r.Before_PoF !== r.After_PoF
             );

         $('#changeGrid').dxDataGrid({
             dataSource: gridDs,
             showBorders: true,
             columnAutoWidth: true,
             sorting: { mode: 'multiple' },
             columns: [
                 { dataField: 'Code', caption: '코드', alignment: 'center' },
                 {
                     dataField: 'BeforeTime',
                     caption: 'Before 시점',
                     alignment: 'center',
                     dataType: 'datetime',
                     format: 'yyyy-MM-dd HH:mm'
                 },
                 {
                     dataField: 'AfterTime',
                     caption: 'After 시점',
                     alignment: 'center',
                     dataType: 'datetime',
                     format: 'yyyy-MM-dd HH:mm',
                     sortOrder: 'desc'
                 },
                 { dataField: 'Before_HI', caption: 'Before HI', alignment: 'center', dataType: 'number' },
                 { dataField: 'After_HI', caption: 'After HI', alignment: 'center', dataType: 'number' },
                 { dataField: 'Before_CoF', caption: 'Before CoF($)', alignment: 'center', format: { type: 'fixedPoint', precision: 2 } },
                 { dataField: 'After_CoF', caption: 'After CoF($)', alignment: 'center', format: { type: 'fixedPoint', precision: 2 } },
                 { dataField: 'Before_PoF', caption: 'Before PoF(%)', alignment: 'center', format: { type: 'percent', precision: 2 } },
                 { dataField: 'After_PoF', caption: 'After PoF(%)', alignment: 'center', format: { type: 'percent', precision: 2 } }
             ],
             paging: { pageSize: 10 },
             pager: {
                 showPageSizeSelector: true,
                 allowedPageSizes: [5, 10, 20],
                 showInfo: true
             },
             onCellPrepared: function (e) {
                 if (e.rowType === 'data' && (e.column.dataField === 'Before_HI' || e.column.dataField === 'After_HI')) {
                     const cls = {
                         1: 'priorityVerygood',
                         2: 'priorityGood',
                         3: 'priorityFair',
                         4: 'priorityPoor',
                         5: 'priorityVerypoor'
                     }[e.value] || 'priorityUndefined';
                     e.cellElement.addClass(cls);
                 }
                 if (e.rowType === 'data' && e.column.dataField === 'Before_HI') {
                     e.cellElement.css({
                         'border-right': '1px solid #CBD2E0',
                         'border-left': '1px solid #CBD2E0',
                         'padding-left': '8px',
                         'padding-right': '8px'
                     });
                 }
                 if (e.rowType === 'data' && e.column.dataField === 'After_HI') {
                     e.cellElement.css({
                         'border-left': '1px solid #CBD2E0',
                         'padding-left': '8px'
                     });
                 }
                 if (e.rowType === 'data' && e.column.dataField === 'Before_PoF') {
                     e.cellElement.css({
                         'border-left': '1px solid #CBD2E0',
                         'padding-left': '8px'
                     });
                 }
                 if (e.rowType === 'data' && e.column.dataField === 'After_CoF') {
                     e.cellElement.css({
                         'border-right': '1px solid #CBD2E0',
                         'padding-right': '8px'
                     });
                 }
                 if (e.rowType === 'data' && e.column.dataField === 'Before_CoF') {
                     e.cellElement.css({
                         'border-left': '1px solid #CBD2E0',
                         'padding-left': '8px'
                     });
                 }
             }
         });
     })
     .fail(err=> console.error('GetRecentActivity 오류', err));
});
    </script>
}

