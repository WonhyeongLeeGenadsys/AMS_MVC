                    argumentField: "time",
                    valueField: "hi",
                    point: { visible: true }
                },
                seriesTemplate: { nameField: "code" },
                argumentAxis: {
                    valueType: "datetime",
                    label: {
                        format: "yy.MM.dd",
                        overlappingBehavior: {
                            mode: "rotate",
                            rotationAngle: 45
                        }
