                    visible: true,
                    verticalAlignment: "bottom",
                    horizontalAlignment: "center",
                    orientation: "horizontal",
                    markerShape: 'circle',
                },
                tooltip: { enabled: true }
            });
        }

        // 전체(all) 용: PoF 이력
        function setupPofChart(containerId, history) {
            $("#" + containerId).dxChart({
                dataSource: history,
                commonSeriesSettings: {
                    type: "line",
                    argumentField: "time",
                    valueField: "pof",
                    point: { visible: true }
                },
                seriesTemplate: { nameField: "code" },
                argumentAxis: {
                    valueType: "datetime",
                    label: {
                        format: "yy.MM.dd",
                        overlappingBehavior: {
                            mode: "rotate",
                            rotationAngle: 45
                        }
                    },
                    title: { text: "날짜" }
                },
                valueAxis: {
                    title: "PoF (%)",
                    visualRange: { startValue: 0, endValue: 100 },
                    tickInterval: 20,
                    endOnTick: false,
                    max: 100
                },
                legend: {
                    visible: true,
                    verticalAlignment: "bottom",
                    horizontalAlignment: "center",
                    orientation: "horizontal",
                    markerShape: 'circle',
                },
                tooltip: { enabled: true }
            });
        }

        // 전체(all) 용: CoF 이력
        function setupCofChart(containerId, history) {
            const cofHistory = (history || []).map(item => ({ ...item, cof: usdToEokKrw(item.cof) }));
            const maxCof = getRiskMatrixMaxEok(cofHistory.map(item => ({ x: item.cof })));
            $("#" + containerId).dxChart({
                dataSource: cofHistory,
                commonSeriesSettings: {
                    type: "line",
                    argumentField: "time",
                    valueField: "cof",
                    point: { visible: true }
                },
                seriesTemplate: { nameField: "code" },
                argumentAxis: {
                    valueType: "datetime",
                    label: {
                        format: "yy.MM.dd",
                        overlappingBehavior: {
                            mode: "rotate",
                            rotationAngle: 45
                        }
                    },
                    title: { text: "날짜" }
                },
                valueAxis: {
                    title: "CoF (억원)",
                    visualRange: { startValue: 0, endValue: maxCof },
                    tickInterval: maxCof / 5,
                    endOnTick: false,
                    label: { customizeText: e => Number(e.value).toLocaleString('ko-KR', { maximumFractionDigits: 2 }) }
                },
                legend: {
                    visible: true,
                    verticalAlignment: "bottom",
                    horizontalAlignment: "center",
                    orientation: "horizontal",
                    markerShape: 'circle',
                },
                tooltip: { enabled: true }
            });
        }
    </script>

    <script>
        $(function () {
            let historyData = null;
            let histLoaded = false, pofLoaded = false, cofLoaded = false;

            // 1) 최초 한번만 data 불러오기
            function loadHistoryData(callback) {
                if (historyData) return callback();

                window.totalInfoDataHub.getHistory('')
                    .done(data => {
                        historyData = data
                            .map(d => {
                                const t = new Date(d.time);
                                t.setHours(0, 0, 0, 0);
                                return { ...d, time: t };
                            })
                            .sort((a, b) => a.time - b.time);

                        callback();
                    })
                    .fail(err => console.error('GetHIPofCofHistory 오류', err));
            }

            // 2) 건전도 차트만 초기 렌더링
            loadHistoryData(() => {
                setupHistoryChart('chart_line01', historyData);
                histLoaded = true;
            });

            // 3) 2-depth 탭 클릭 처리
            $('.sub_flex .tab_twodepth .tab_btn').on('click', function () {
                const target = $(this).data('tab');
                $(this)
                    .addClass('on')
                    .siblings().removeClass('on');
                // 컨텐츠 show/hide
                $(this).closest('li').find('.totalInfo_content')
                    .removeClass('on');

                $('#' + target).addClass('on');

                if (target === 'chart_line02' && !pofLoaded) {
                    loadHistoryData(() => {
                        setupPofChart('chart_line02', historyData);
                        pofLoaded = true;
                    });
                }
                if (target === 'chart_line03' && !cofLoaded) {
                    loadHistoryData(() => {
                        setupCofChart('chart_line03', historyData);
                        cofLoaded = true;
                    });
                }
            });
        });
    </script>
</div>

