@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section LeftMenu {
    @Html.Partial("_TotalInfoMenu")
}

@section MainContent {
    <h1>
        종합정보
        @*<a href="javascript:openPop('/Location/Index','900','600')"
            class="btn blue map tooltip"
            data-tooltip="전남 나주시 혁신산단5길 동수동 405-8">위치보기</a>*@
    </h1>

    <ul class="tab_onedepth">
        <li class="tab_btn on" data-tab="con_box01" data-prefix="">5종 주요장비</li>
        <li class="tab_btn" data-tab="con_box02" data-prefix="AC">AC</li>
        <li class="tab_btn" data-tab="con_box03" data-prefix="DC">DC</li>
    </ul>

    @Html.Partial("_TotalInfoAll")
    @Html.Partial("_TotalInfoAC")
    @Html.Partial("_TotalInfoDC")
}

@section Scripts {
    <script>
        $(function () {
            const URLS = {
                PRIORITY: '/TotalInfo/GetPriorityInfo',
                GOJANG: '/TotalInfo/GetGojangList',
                SCHEDULE: '/TotalInfo/GetScheduleData',
                DM: '/TotalInfo/GetDMDecisionInfo'
            };

            const SUFFIX = {
                '': '',    // 5대 주요장비
                'AC': 'AC',
                'DC': 'DC'
            };

            const tabLoaded = { '': true, AC: false, DC: false };
            const historyLoaded = { '': false, AC: false, DC: false };
            const scheduleLoaded = { '': false, AC: false, DC: false };

            //  공통 그리드 렌더 함수
            function renderGrid(selector, data, columns) {
                $(selector).dxDataGrid({
                    dataSource: data,
                    showBorders: true,
                    sorting: { mode: 'multiple' },
                    scrolling: { columnRenderingMode: 'virtual' },
                    height: 200,
                    onRowPrepared(e) {
                        if (e.rowType === 'data' && e.rowIndex === 0) {
                            e.rowElement.addClass('first-row-highlight');
                        }
                    },
                    onCellPrepared(e) {
                        if (e.rowType === 'data') {
                            // HI 배경색상 입히기
                            if (e.column.dataField === 'HI') {
                                const cls = {
                                    1: 'priorityVerygood',
                                    2: 'priorityGood',
                                    3: 'priorityFair',
                                    4: 'priorityPoor',
                                    5: 'priorityVerypoor',
                                    0: 'priorityUndefined'
                                }[e.value];
                                if (cls) e.cellElement.addClass(cls);
                            }

                            if (e.rowType === 'data') {
                                // START 날짜
                                if (e.column.dataField === 'Start') {
                                    e.cellElement.css({
                                        color: 'green',
                                        'font-weight': 'medium'
                                    });
                                }
                                // END 날짜
                                if (e.column.dataField === 'End') {
                                    e.cellElement.css({
                                        color: 'black',
                                        'font-weight': 'medium'
                                    });
                                }
                                // DueDate
                                if (e.column.dataField === 'DueDate') {
                                    e.cellElement.css({
                                        color: 'red',
                                        'font-weight': 'bold'
                                    });
                                }
                            }
                        }
                    },
                    columns: columns
                });
            }

            //  각 그리드 로드 함수들
            function loadPriority(prefix) {
                const suf = SUFFIX[prefix];
                $.post(URLS.PRIORITY)
                    .done(data => {
                        // 1) AC탭, DC탭 필터링
                        let filtered = data;
                        if (prefix === 'AC') {
                            filtered = data.filter(d => d.Sort === 'AC');
                        } else if (prefix === 'DC') {
                            filtered = data.filter(d => d.Sort === 'DC');
                        }

                        // 2) 필터된 배열에 새로운 우선순위 부여하기
                        filtered = filtered.map((item, idx) => ({
                            ...item,
                            Priority: idx + 1
                        }));

                        renderGrid(
                            '#gridContainer' + suf,
                            filtered,
                            [
                                { dataField: 'Priority', caption: '우선순위', alignment: 'center' },
                                { dataField: 'Sort', caption: '구분', alignment: 'center' },
                                { dataField: 'Name', caption: '설비명', alignment: 'center' },
                                { dataField: 'Serial_No', caption: '시리얼번호', alignment: 'center' },
                                { dataField: 'Install_Date', caption: '설치일', alignment: 'center', dataType: 'date' },
                                { dataField: 'Operating_Date', caption: '운영일', alignment: 'center', dataType: 'date' },
                                { dataField: 'UsagePeriod', caption: '사용기간(년)', alignment: 'center' },
                                { dataField: 'HI', caption: 'HI', alignment: 'center', dataType: 'number' },
                                {
                                    dataField: 'PoF',
                                    caption: 'PoF(%)',
                                    alignment: 'center',
                                    dataType: 'number',
                                    cellTemplate: function (container, options) {
                                        $("<div>")
                                            .text(options.value)
                                            .css("font-weight", "bold")
                                            .appendTo(container);
                                    }
                                },
                                {
                                    dataField: 'CoF',
                                    caption: 'CoF($)',
                                    alignment: 'center',
                                    dataType: 'number',
                                    cellTemplate: function (container, options) {
                                        $("<div>")
                                            .text(options.value)
                                            .css("font-weight", "bold")
                                            .appendTo(container);
                                    }
                                },
                                {
                                    caption: 'PoF*CoF ($)',
                                    alignment: 'center',
                                    dataType: 'number',
                                    calculateCellValue: function (rowData) {
                                        var result = (rowData.CoF || 0) * ((rowData.PoF || 0) / 100);
                                        return result;
                                    },
                                    format: { type: "fixedPoint", precision: 2 }
                                }
                            ]
                        );
                    });
            }

            function loadHistory(prefix) {
                const suf = SUFFIX[prefix];
                $.post(URLS.GOJANG)
                    .done(raw => {
                        let ds = raw;
                        if (prefix === 'AC') {
                            ds = raw.filter(p => p.Code.startsWith('VCB') || p.Code.startsWith('ITR'));
                        } else if (prefix === 'DC') {
                            ds = raw.filter(p => ['DCCB', 'DCCABLE', 'SUBMODULE']
                                .some(pr => p.Code.startsWith(pr)));
                        }

                        const dataSource = ds.map(arr => {
                            const o = {};
                            arr.forEach(p => {
                                if (p.Key === 'Date') {
                                    const m = /Date\((\d+)\)/.exec(p.Value);
                                    o[p.Key] = m ? new Date(+m[1]) : null;
                                } else o[p.Key] = p.Value;
                            });
                            return o;
                        });
                        renderGrid(
                            '#gridContainer02' + suf,
                            dataSource,
                            [
                                { dataField: 'Priority', caption: '우선순위', alignment: 'center' },
                                { dataField: 'Code', caption: '코드', alignment: 'center' },
                                { dataField: 'Name', caption: '설비명', alignment: 'center' },
                                { dataField: 'Serial_No', caption: '시리얼번호', alignment: 'center' },
                                { dataField: 'Weather', caption: '날씨', alignment: 'center' },
                                { dataField: 'Temp', caption: '온도(°C)', alignment: 'center' },
                                { dataField: 'Hum', caption: '습도(%)', alignment: 'center' },
                                { dataField: 'Reason', caption: '발견동기', alignment: 'center' },
                                { dataField: 'Status', caption: '상태', alignment: 'center' },
                                { dataField: 'Part', caption: '부품', alignment: 'center' },
                                { dataField: 'Period', caption: '기간', alignment: 'center' },
                                { dataField: 'Finder', caption: '발견자', alignment: 'center' },
                                {
                                    dataField: 'Date',
                                    caption: '고장일',
                                    alignment: 'center',
                                    dataType: 'date'
                                }
                            ]
                        );
                    });
            }

            function loadSchedule(prefix) {
                const suf = SUFFIX[prefix];
                const today = new Date();
                $.getJSON(URLS.SCHEDULE, { year: today.getFullYear(), month: today.getMonth() + 1 })
                    .done(raw => {
                        // 1) prefix 필터
                        let ds = raw;
                        if (prefix === 'AC') {
                            ds = raw.filter(r => r.Code.startsWith('VCB') || r.Code.startsWith('ITR'));
                        } else if (prefix === 'DC') {
                            ds = raw.filter(r => ['DCCB', 'DCCABLE', 'SUBMODULE'].some(pr => r.Code.startsWith(pr)));
                        }

                        // 2) 각 코드별로 가장 마지막(가장 큰 DueDate) 행만 남기기
                        //    DueDate 계산도 미리 해 둘 것
                        const withDue = ds.map(r => {
                            const start = new Date(r.Start);
                            const due = new Date(start);
                            due.setFullYear(due.getFullYear() + 3);
                            return { ...r, DueDate: due };
                        });
                        const latestByCode = Object.values(
                            withDue.reduce((acc, item) => {
                                const prev = acc[item.Code];
                                if (!prev || item.DueDate > prev.DueDate) {
                                    acc[item.Code] = item;
                                }
                                return acc;
                            }, {})
                        );

                        // 3) 정렬 & Priority 재부여
                        const dataSource = latestByCode
                            .sort((a, b) => a.DueDate - b.DueDate)
                            .map((r, i) => ({ ...r, Priority: i + 1 }));

                        renderGrid(
                            '#gridContainer03' + suf,
                            dataSource,
                            [
                                { dataField: 'Priority', caption: '우선순위', alignment: 'center' },
                                {
                                    caption: '점검유형',
                                    alignment: 'center',
                                    calculateCellValue: function (row) {
                                        return row.Status === 'confirmed'
                                            ? '보통점검'
                                            : row.Status === 'risk'
                                                ? '정밀점검'
                                                : row.Status;
                                    }
                                },
                                {
                                    caption: '구분',
                                    alignment: 'center',
                                    calculateCellValue: function (row) {
                                        const code = (row.Code || '').toUpperCase();
                                        if (code.startsWith('VCB') || code.startsWith('ITR')) {
                                            return 'AC';
                                        }
                                        if (code.startsWith('DCCB')
                                            || code.startsWith('DCCABLE')
                                            || code.startsWith('SUBMODULE')) {
                                            return 'DC';
                                        }
                                        return '';
                                    }
                                },
                                { dataField: 'Type', caption: '설비명', alignment: 'center' },
                                { dataField: 'Serial_No', caption: '시리얼번호', alignment: 'center' },
                                { dataField: 'Start', caption: '시작일', dataType: 'date', alignment: 'center', format: 'yy.MM.dd' },
                                { dataField: 'End', caption: '종료일', dataType: 'date', alignment: 'center', format: 'yy.MM.dd' },
                                {
                                    dataField: 'DueDate',
                                    caption: '정기점검일',
                                    dataType: 'date',
                                    alignment: 'center',
                                    format: 'yy.MM.dd'
                                }
                            ]
                        );
                    });
            }

            function loadDM(prefix) {
                const suf = SUFFIX[prefix];
                const krwCell = function (container, options) {
                    const value = Number(options.value);
                    $('<div>')
                        .text(Number.isFinite(value) ? value.toLocaleString('ko-KR') : '-')
                        .appendTo(container);
                };

                $.getJSON(URLS.DM, { prefix: prefix })
                    .done(result => {
                        if (!result || result.success === false) {
                            console.error('GetDMDecisionInfo 오류', result && (result.details || result.error));
                            return;
                        }

                        renderGrid(
                            '#gridContainer04' + suf,
                            result.rows || [],
                            [
                                { dataField: 'Priority', caption: '우선순위', alignment: 'center', width: 70 },
                                { dataField: 'Sort', caption: '구분', alignment: 'center', width: 50 },
                                { dataField: 'ProductName', caption: '설비명(제품명)', alignment: 'center', width: 200 },
                                { dataField: 'Serial_No', caption: '시리얼번호', alignment: 'center' },
                                { dataField: 'HI', caption: 'HI', alignment: 'center', dataType: 'number' },
                                { dataField: 'PoF', caption: 'PoF(%)', alignment: 'center', dataType: 'number', format: { type: 'fixedPoint', precision: 2 } },
                                { dataField: 'ReplacementCost', caption: '교체비(원)', alignment: 'right', dataType: 'number', cellTemplate: krwCell },
                                { dataField: 'CoF', caption: 'CoF(원)', alignment: 'right', dataType: 'number', cellTemplate: krwCell },
                                { dataField: 'Risk', caption: 'Risk(원)', alignment: 'right', dataType: 'number', cellTemplate: krwCell },
                                { dataField: 'NPV', caption: 'NPV(원)', alignment: 'right', dataType: 'number', cellTemplate: krwCell },
                                { dataField: 'ROI', caption: 'ROI(%)', alignment: 'center', dataType: 'number', format: { type: 'fixedPoint', precision: 2 } },
                                {
                                    dataField: 'RUL',
                                    caption: 'RUL(년)',
                                    alignment: 'center',
                                    dataType: 'number',
                                    cellTemplate: function (container, options) {
                                        $('<div>')
                                            .text(options.value == null ? '산정불가' : Number(options.value).toFixed(2))
                                            .appendTo(container);
                                    }
                                },
                                {
                                    dataField: 'Decision',
                                    caption: '의사결정',
                                    alignment: 'center',
                                    cellTemplate: function (container, options) {
                                        const colors = {
                                            '즉시 교체': '#d32f2f',
                                            '긴급 유지보수': '#ef6c00',
                                            '예방 유지보수': '#c9a000',
                                            '정기점검': '#1976d2',
                                            '계속 감시': '#2e7d32',
                                            '데이터 확인 필요': '#666666'
                                        };
                                        $('<strong>')
                                            .text(options.value || '')
                                            .css('color', colors[options.value] || '#333333')
                                            .appendTo(container);
                                    }
                                },
                                { dataField: 'Urgency', caption: '긴급도', alignment: 'center' },
                                { dataField: 'RecommendedAction', caption: '권장시기', alignment: 'center' },
                                { dataField: 'DMScore', caption: '우선순위 점수', alignment: 'center', dataType: 'number', format: { type: 'fixedPoint', precision: 4 } }
                            ]
                        );
                    })
                    .fail(err => console.error('GetDMDecisionInfo 호출 실패', err));
            }

            //  1-depth 탭 클릭 처리: 우선순위만 초기 로드
            $('.tab_onedepth .tab_btn').on('click', function () {
                const prefix = $(this).data('prefix');
                $('.tab_onedepth .tab_btn').removeClass('on');
                $(this).addClass('on');
                $('.box_wrap.totalInfo_content').removeClass('on');
                $('#' + $(this).data('tab')).addClass('on');

                loadPriority(prefix);
                // history, schedule 그리드는 2-depth 클릭 시 lazy-load
            });

            //  2-depth 그리드 탭 클릭 처리
            $('.box_group').on('click', '.tab_twodepth .tab_btn', function () {
                const prefix = $('.tab_onedepth .tab_btn.on').data('prefix');
                const target = $(this).data('tab');
                $(this).addClass('on').siblings().removeClass('on');
                $(this).closest('.box_group').find('.totalInfo_content').removeClass('on');
                $('#' + target).addClass('on');

                if (target.startsWith('gridContainer02')) loadHistory(prefix);
                if (target.startsWith('gridContainer03')) loadSchedule(prefix);
                if (target.startsWith('gridContainer04')) loadDM(prefix);
            });

            //  처음 로딩할 때 5대 주요장비 우선순위만
            loadPriority('');

            // 주기적 새로고침
            setInterval(() => {
                // 1) pie 데이터 재조회
                $.getJSON('@Url.Action("GetRiskMapPoints","TotalInfo")', { prefix: '' })
                    .done(rawPoints => {
                        var buckets = rawPoints.reduce((a, p) => {
                            a[p.hi] = a[p.hi] || { hi: p.hi, codes: [] };
                            a[p.hi].codes.push(p.name);
                            return a;
                        }, {});
                        var ds = Object.values(buckets).map(b => ({
                            state: b.hi + '등급',
                            value: b.codes.length,
                            codes: b.codes,
                            hi: b.hi
                        }));
                        var pie = $('#pieAll').data('dxPieChart');
                        if (pie) pie.option('dataSource', ds);
                    });

                // 2) risk matrix 재조회
                $.getJSON('@Url.Action("GetRiskMapPoints","TotalInfo")', { prefix: '' })
                    .done(raw => {
                        var data = raw.map(p => ({ x: p.x, y: p.y, name: p.name, group: p.group }));
                        var rm = $('#chartContainerAll').data('dxChart');
                        if (rm) rm.option('dataSource', data);
                    });

                // 3) 이력 차트 재조회 (생성된 차트만 업데이트)
                $.getJSON('@Url.Action("GetHIPofCofHistory","TotalInfo")', { prefix: '' })
                    .done(hist => {
                        hist = hist.map(d => {
                            const t = new Date(d.time);
                            t.setHours(0, 0, 0, 0);
                            return { ...d, time: t };
                        });

                        const hiChart = $('#chart_line01').data('dxChart');
                        const pofChart = $('#chart_line02').data('dxChart');
                        const cofChart = $('#chart_line03').data('dxChart');

                        if (hiChart) hiChart.option('dataSource', hist);
                        if (pofChart) pofChart.option('dataSource', hist);
                        if (cofChart) cofChart.option('dataSource', hist);
                    });

                // 4) 우선순위 그리드 재조회
                $.post('@Url.Action("GetPriorityInfo","TotalInfo")')
                    .done(dataGrid => {
                        var grid = $('#gridContainer').data('dxDataGrid');
                        if (grid) grid.option('dataSource', dataGrid);
                    });

            }, 10000);
        });
    </script>
}
