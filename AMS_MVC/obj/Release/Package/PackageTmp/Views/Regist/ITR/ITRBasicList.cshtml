@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section LeftMenu {
    @Html.Partial("_RegistMenu")
}

@section MainContent {
    <h1>
    InterfaceTR 기본정보 목록
    </h1>
    <div class="con_box">
        <!--테이블리스트-->
        <div class="content_warp">
            <div class="btn_area top right">
                <a href="@Url.Action("ITRBasicAdd", "ITRBasic")" class="btn add blue">추가</a>
            </div>
            <div id="gridContainer" class="grid_wrap"></div>
        </div>

        <script>
        $(document).ready(function () {
            loadITRData();
        });

         function loadITRData() {
            $.ajax({
                type: "POST",
                url: '@Url.Action("GetITRListData", "ITRBasic")',
                contentType: "application/json; charset=utf-8",
                success: function (response) {
                    if (response.success === false) {
                        console.error("ITR 데이터 로드 실패: " + response.message);
                        return;
                    }

                    let data = response.data.sort((a, b) => new Date(b.Tbl_GetDate) - new Date(a.Tbl_GetDate));

                    // 순번 매기기
                    data = data.map((item, index) => {
                        item.RowNumber = data.length - index;
                        return item;
                    });

                    $("#gridContainer").dxDataGrid({
                        dataSource: data,
                        columnFixing: {
                            enabled: true,
                        },
                        columns: [
                            {
                                dataField: "RowNumber",
                                caption: "순번",
                                width: 80
                            },
                            { dataField: 'Name', caption: '제품이름', alignment: 'center', width: 'auto' },
                            { dataField: 'Serial_No', caption: '시리얼번호', alignment: 'center', width: 'auto' },
                            { dataField: 'Install_Date', caption: '설치일', alignment: 'center', width: 100},
                            { dataField: 'Operating_Date', caption: '가동일', alignment: 'center', width: 100},
                            //{ dataField: 'Price', caption: '구입비용(원)', alignment: 'center', width: 100 },
                            { dataField: 'Install_Place', caption: '설치장소', alignment: 'center', width: 'auto' },
                            //{ dataField: 'use', caption: '사용(년)', alignment: 'center', width: 100 },
                            //{ dataField: 'Rated_V', caption: '정격전압(kV)', alignment: 'center', width: 120 },
                            //{ dataField: 'Rated_A', caption: '정격전류(A)', alignment: 'center', width: 100 },
                            //{ dataField: 'Make_Company', caption: '제작사', alignment: 'center', width: 100 },
                            //{ dataField: 'Make_No', caption: '제작번호', alignment: 'center', width: 120 },
                            { dataField: 'Is_Diagnostics', caption: '진단사용', alignment: 'center', width: 'auto' },
                            { dataField: 'Is_Health', caption: '건전도 사용', alignment: 'center', width: 'auto' },
                            { dataField: 'Tbl_GetDate', caption: '작성일자', alignment: 'center', width: 'auto'},
                            {
                                dataField: 'manage',
                                caption: '관리',
                                alignment: 'center',
                                width: 250,
                                cellTemplate: function (container, options) {
                                    var chk1Url = '@Url.Action("ITRChk1List", "ITRChk1")';
                                    var chk2Url = '@Url.Action("ITRChk2List", "ITRChk2")';
                                    var gojangUrl = '@Url.Action("ITRGojangList", "ITRGojang")';
                                    var mrUrl = '@Url.Action("ITRMaintenanceList", "ITRMaintenance")';

                                    container.append(
        `<a href="${chk1Url}?ITR_Code=${encodeURIComponent(options.data.ITR_Code)}" class="btn table blue">보통점검</a>
         <a href="${chk2Url}?ITR_Code=${encodeURIComponent(options.data.ITR_Code)}" class="btn table red">정밀점검</a>
    <a href="${gojangUrl}?ITR_Code=${encodeURIComponent(options.data.ITR_Code)}" class="btn table gray">고장이력</a>
         <a href="${mrUrl}?ITR_Code=${encodeURIComponent(options.data.ITR_Code)}" class="btn table gray">유지보수</a>`
    );
}
                                }
                            ],
                            showBorders: true,
                            searchPanel: { visible: true, width: 240, placeholder: "검색" },
                            filterRow: { visible: true, applyFilter: "auto" },
                            headerFilter: { visible: true },
                            loadPanel: { enabled: true },
                            scrolling: { columnRenderingMode: "virtual" },
                            onRowClick: function (e) {
                                const tblIdx = e.data.Tbl_Idx;
                                var detailUrl = '@Url.Action("ITRBasicDetail", "ITRBasic")';
                                window.location.href = detailUrl + "?tblIdx=" + encodeURIComponent(tblIdx);
                            }
                        });
                    },
                error: function (xhr, status, error) {
                    console.error("데이터 로드 중 오류", error)
                }
            });
        }
        </script>
    </div>
}

