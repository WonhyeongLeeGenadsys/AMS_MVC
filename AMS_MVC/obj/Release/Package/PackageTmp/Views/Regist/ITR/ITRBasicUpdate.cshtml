@model AMS_MVC.Models.ITRBasicInfo
@using Web.Common.Utlity

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section LeftMenu {
    @Html.Partial("_RegistMenu")
}

@section MainContent {
    <h1>InterfaceTR 기본정보 수정</h1>
    <div class="con_box">
        <div class="content_warp">
            <div class="btn_area top right">
                <p>
                    <a href="javascript:void(0)" class="btn blue app" onclick="updateITRBasicInfo()">적용</a>
                </p>
            </div>
            <form id="itrForm" method="post" enctype="multipart/form-data">
                <div class="table_app" id="itrBasicInfo">
                    <table>
                        <tr>
                            <th>제품 이름</th>
                            <td>
                                <input type="text" id="name" name="Name" value="@Model.Name" required>
                            </td>
                            <th>시리얼 번호</th>
                            <td>
                                <!-- 시리얼번호는 보통 변경하지 않으므로 readonly 처리 -->
                                <input type="text" id="serial_no" name="Serial_No" value="@Model.Serial_No" required readonly>
                            </td>
                        </tr>
                        <tr>
                            <th>설치일</th>
                            <td>
                                <input type="date" id="install_date" name="Install_Date" value="@(Model.Install_Date.HasValue ? Model.Install_Date.Value.ToString("yyyy-MM-dd") : "")" required>
                            </td>
                            <th>가동일</th>
                            <td>
                                <input type="date" id="operating_date" name="Operating_Date" value="@(Model.Operating_Date.HasValue ? Model.Operating_Date.Value.ToString("yyyy-MM-dd") : "")" required>
                            </td>
                        </tr>
                        <tr>
                            <th>구입비용</th>
                            <td>
                                <input type="text" id="price" name="Price" value="@(Model.Price.ToString("N0"))">
                                <span>원</span>
                            </td>
                            <th>설치장소</th>
                            <td>
                                <input type="text" id="install_place" name="Install_Place" value="@Model.Install_Place">
                            </td>
                            <th>정격전압</th>
                            <td>
                                <input type="text" id="rated_v" name="Rated_V" value="@Model.Rated_V">
                                <span>kV</span>
                            </td>
                        </tr>
                        <tr>
                            <th>정격전류</th>
                            <td>
                                <input type="text" id="rated_a" name="Rated_A" value="@Model.Rated_A">
                                <span>A</span>
                            </td>
                            <th>제작사</th>
                            <td>
                                <!-- 제작사 Dropdown: ViewBag.Companies에 담긴 목록을 사용 -->
                                @Html.DropDownList("Make_Company", new SelectList(ViewBag.Companies, "Com_Name", "Com_Name", Model.Make_Company), "제작사를 선택하세요.")
                            </td>
                            <th>제작번호</th>
                            <td>
                                <input type="text" id="make_no" name="Make_No" value="@Model.Make_No">
                            </td>
                        </tr>
                        <tr>
                            <th>제품사진</th>
                            <td colspan="5">
                                <p class="file_upload">
                                    <!-- 파일 선택 input (숨김) 및 선택된 파일명 표시 -->
                                    <input type="file" name="photo" id="fileUpload" style="display: none" onchange="fileChange(event)" />
                                    <textarea id="fileNm" class="file_wrap" readonly="readonly">@Model.Photo</textarea>
                                    <label for="fileUpload" class="btn table blue">파일선택</label>
                                    @if (!string.IsNullOrEmpty(Model.Photo))
                                    {
                                        <br />
                                        <img src="@Model.Photo" width="200" height="200" alt="제품사진" />
                                    }
                                </p>
                            </td>
                        </tr>
                        <tr>
                            <th>예방진단 사용</th>
                            <td>
                                <input type="radio" name="Is_Diagnostics" value="true" @(Model.Is_Diagnostics ? "checked" : "")> 예
                                <input type="radio" name="Is_Diagnostics" value="false" @(!Model.Is_Diagnostics ? "checked" : "")> 아니오
                            </td>
                            <th>건전도 사용</th>
                            <td>
                                <input type="radio" name="Is_Health" value="true" @(Model.Is_Health ? "checked" : "")> 예
                                <input type="radio" name="Is_Health" value="false" @(!Model.Is_Health ? "checked" : "")> 아니오
                            </td>
                        </tr>
                        <tr>
                            <!-- 수정 시 필요한 숨김 필드: Tbl_Idx와 ITR_Code -->
                            <td colspan="6">
                                <input type="hidden" name="Tbl_Idx" value="@Model.Tbl_Idx" />
                                <input type="hidden" name="ITR_Code" value="@Model.ITR_Code" />
                            </td>
                        </tr>
                    </table>
                </div>
            </form>
        </div>
    </div>
    <script>
        // 수정 요청 AJAX 함수
        function updateITRBasicInfo() {
            var form = document.getElementById("itrForm");
            var formData = new FormData(form);

            $.ajax({
                url: '@Url.Action("ITRBasicUpdate", "ITRBasic")',
                type: "POST",
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {
                    if (response.success) {
                        alert("InterfaceTR 기본정보가 수정되었습니다: " + response.message);
                        // 수정 후 상세 페이지로 이동
                        window.location.href = '@Url.Action("ITRBasicDetail", "ITRBasic", new { tblIdx = Model.Tbl_Idx })';
                    } else {
                        alert("수정 실패: " + response.message);
                    }
                },
                error: function (xhr) {
                    console.error("오류 발생:", xhr.responseText);
                    alert("수정 중 오류가 발생했습니다.");
                }
            });
        }
    </script>
}
