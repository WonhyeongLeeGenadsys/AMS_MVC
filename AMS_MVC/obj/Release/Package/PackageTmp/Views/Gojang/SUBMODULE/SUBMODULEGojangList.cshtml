@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var submoduleCode = Request.QueryString["SUBMODULE_Code"] ?? "";
}

@section LeftMenu {
    @Html.Partial("_GojangMenu")
}

@section MainContent {
    <h1>SUBMODULE 고장이력: @ViewBag.Name, @ViewBag.SerialNo</h1>

    <div class="con_box">
        <div class="content_warp">
            <div class="btn_area top right">
                <a href="@Url.Action("SUBMODULEGojangAdd", "SUBMODULEGojang", new { SUBMODULE_Code = submoduleCode })" class="btn add blue">추가</a>
            </div>
            <div id="gridContainer" class="grid_wrap"></div>
        </div>

        <script>
            $(document).ready(function () {
                loadSUBMODULEGojangData();
            });

            function loadSUBMODULEGojangData() {
                var submoduleCode = "@submoduleCode";

                $.ajax({
                    type: "POST",
                    url: '@Url.Action("GetSUBMODULEFHBySUBMODULECode", "SUBMODULEGojang")',
                    data: JSON.stringify({ submoduleCode: submoduleCode }),
                    contentType: "application/json; charset=utf-8",
                    success: function (response) {
                        if (response.success == false) {
                            console.error("SUBMODULEGojang 데이터 로드 실패: " + response.message);
                            return;
                        }

                        // 작성일(Tbl_GetDate) 기준 내림차순 정렬
                        let data = response.data.sort((a, b) => new Date(b.Tbl_GetDate) - new Date(a.Tbl_GetDate));

                        // 순번 매기기
                        data = data.map((item, index) => {
                            item.RowNumber = data.length - index;
                            return item;
                        });

                        $("#gridContainer").dxDataGrid({
                            dataSource: data,
                            columnFixing: { enabled: true },
                            columns: [
                                { dataField: "RowNumber", caption: "순번", width: 80 },
                                { dataField: 'Fail_Gojang_Name', caption: '고장명', alignment: 'center', width: 'auto' },
                                { dataField: 'Fail_Weather', caption: '날씨', alignment: 'center', width: 'auto' },
                                { dataField: 'Fail_Temp', caption: '기온(°C)', alignment: 'center', width: 'auto' },
                                { dataField: 'Fail_Hum', caption: '습도(%)', alignment: 'center', width: 'auto' },
                                { dataField: 'Fail_Cause', caption: '원인', alignment: 'center', width: 'auto' },
                                { dataField: 'Fail_Reason', caption: '발견동기', alignment: 'center', width: 'auto' },
                                { dataField: 'Fail_Status', caption: '상태', alignment: 'center', width: 'auto' },
                                { dataField: 'Fail_Part', caption: '부품', alignment: 'center', width: 'auto' },
                                { dataField: 'Fail_Period', caption: '발견자', alignment: 'center', width: 'auto' },
                                { dataField: 'Fail_Finder', caption: '점검시작일', alignment: 'center', width: 'auto' },
                                { dataField: 'Fail_Repairer', caption: '점검시작일', alignment: 'center', width: 'auto' },
                                { dataField: 'Fail_Supervisor', caption: '점검시작일', alignment: 'center', width: 'auto' },
                                { dataField: 'Fail_Registrar', caption: '점검시작일', alignment: 'center', width: 'auto' },
                                { dataField: 'Fail_Date', caption: '고장일', alignment: 'center', width: 'auto' },
                                { dataField: 'Fail_Writer', caption: '점검시작일', alignment: 'center', width: 'auto' }

                            ],
                            showBorders: false,
                            searchPanel: { visible: true, width: 240, placeholder: "검색" },
                            filterRow: { visible: true, applyFilter: 'auto' },
                            headerFilter: { visible: true },
                            loadPanel: { enabled: true },
                            scrolling: { columnRenderingMode: 'virtual' },
                            onRowClick: function (e) {
                                // 각 행의 Tbl_Idx와 SUBMODULE_Code 값을 사용하여 SUBMODULEChkDetail 페이지로 이동
                                const tblIdx = e.data.Tbl_Idx;
                                const submoduleCode = e.data.SUBMODULE_Code;
                                window.location.href = `/Gojang/SUBMODULEGojang/SUBMODULEGojangDetail?SUBMODULE_Code=${encodeURIComponent(submoduleCode)}&Tbl_Idx=${encodeURIComponent(tblIdx)}`;
                            }
                        });
                    },
                        error: function (xhr, status, error) {
                            console.error("데이터 로드 중 오류", error);
                        }
                });
            }
        </script>
    </div>
}
