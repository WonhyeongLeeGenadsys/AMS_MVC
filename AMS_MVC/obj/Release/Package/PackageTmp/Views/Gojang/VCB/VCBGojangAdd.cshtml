@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section LeftMenu {
    @Html.Partial("_GojangMenu")
}

@section MainContent {
    <!--타이틀-->
    <h1>고장이력</h1>
    <!--//타이틀-->
    <!--컨텐츠-->
    <div class="con_box">
        <!--컨텐츠 inn-->
        <div class="content_warp">
            <!--버튼-->
            <div class="btn_area top right">
                <p>
                    <a href="#" class="btn red del">삭제</a>
                    <a href="#" class="btn blue app">적용</a>
                </p>
            </div>
            <!--//버튼-->
            <!--입력테이블-->
            <div class="table_app">
                <table>
                    <colgroup>
                        <col style="width:100px;" />
                        <col style="width:calc(33.3% - 100px);" />
                        <col style="width:100px;" />
                        <col style="width:calc(33.3% - 100px);" />
                        <col style="width:100px;" />
                        <col style="width:calc(33.3% - 100px);" />
                    </colgroup>
                    <tr>
                        <th>고장명</th>
                        <td colspan="5">
                            <input type="text" class="w100" />
                        </td>
                    </tr>
                    <tr>
                        <th>날씨</th>
                        <td>
                            <input type="text" />
                        </td>
                        <th>기온</th>
                        <td>
                            <input type="text" /> <span>°C</span>
                        </td>
                        <th>습도</th>
                        <td>
                            <input type="text" /> <span>%</span>
                        </td>
                    </tr>
                    <tr>
                        <th>원인</th>
                        <td colspan="5">
                            <textarea></textarea>
                        </td>
                    </tr>
                    <tr>
                        <th>발견동기</th>
                        <td>
                            <input type="text" />
                        </td>
                        <th>상태</th>
                        <td>
                            <input type="text" />
                        </td>
                        <th>부품</th>
                        <td>
                            <input type="text" />
                        </td>
                    </tr>
                    <tr>
                        <th>기간</th>
                        <td>
                            <input type="text" /><span>일</span>
                        </td>
                        <th>발견자</th>
                        <td>
                            <input type="text" />
                        </td>
                        <th>보수자</th>
                        <td>
                            <input type="text" />
                        </td>
                    </tr>
                    <tr>
                        <th>감독자</th>
                        <td>
                            <input type="text" />
                        </td>
                        <th>보수일</th>
                        <td>
                            <input type="date" />
                        </td>
                        <th></th>
                        <td></td>
                    </tr>
                </table>
            </div>
            <!--//입력테이블-->
        </div>
    </div>
    <!--//컨텐츠가 들어옵니다-->
}
