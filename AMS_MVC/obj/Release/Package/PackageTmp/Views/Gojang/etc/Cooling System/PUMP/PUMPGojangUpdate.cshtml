@model AMS_MVC.Models.PUMPFailureHistory

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section LeftMenu {
    @Html.Partial("_GojangMenu")
}

@section MainContent {
    <h1>PUMP 고장 정보 수정</h1>

    <div class="con_box">
        <div class="content_warp">
            <div class="btn_area top right">
                <p>
                    <a href="#" class="btn blue app" onclick="updatePUMPGojang()">적용</a>
                </p>
            </div>

            <!-- 수정 폼 -->
            <form id="pumpGojangUpdateForm" method="post" enctype="multipart/form-data">
                <!-- 반드시 식별 가능한 PK/UK(예: Tbl_Idx, PUMP_Code)를 전송해야 함 -->
                <input type="hidden" name="Tbl_Idx" value="@Model.Tbl_Idx" />
                <input type="hidden" name="PUMP_Code" value="@Model.PUMP_Code" />

                <div class="table_app">
                    <table>
                        <colgroup>
                            <col style="width:100px;" />
                            <col style="width:calc(33.3% - 100px);" />
                            <col style="width:100px;" />
                            <col style="width:calc(33.3% - 100px);" />
                            <col style="width:100px;" />
                            <col style="width:calc(33.3% - 100px);" />
                        </colgroup>
                        <tr>
                            <th>고장명</th>
                            <td colspan="5">
                                <input type="text" name="Fail_Gojang_Name" value="@Model.Fail_Gojang_Name" />
                            </td>
                        </tr>
                        <tr>
                            <th>날씨</th>
                            <td>
                                <input type="text" name="Fail_Weather" value="@Model.Fail_Weather" />
                            </td>
                            <th>기온</th>
                            <td>
                                <input type="text" name="Fail_Temp" value="@Model.Fail_Temp" />
                                <span>°C</span>
                            </td>
                            <th>습도</th>
                            <td>
                                <input type="text" name="Fail_Hum" value="@Model.Fail_Hum" />
                                <span>%</span>
                            </td>
                        </tr>
                        <tr>
                            <th>원인</th>
                            <td colspan="5">
                                <input type="text" name="Fail_Cause" value="@Model.Fail_Cause" />
                            </td>
                        </tr>
                        <tr>
                            <th>발견동기</th>
                            <td>
                                <input type="text" name="Fail_Reason" value="@Model.Fail_Reason" />
                            </td>
                            <th>상태</th>
                            <td>
                                <input type="text" name="Fail_Status" value="@Model.Fail_Status" />
                            </td>
                            <th>부품</th>
                            <td>
                                <input type="text" name="Fail_Part" value="@Model.Fail_Part" />
                            </td>
                        </tr>
                        <tr>
                            <th>기간</th>
                            <td>
                                <input type="text" name="Fail_Period" value="@Model.Fail_Period" />
                            </td>
                            <th>발견자</th>
                            <td>
                                <input type="text" name="Fail_Finder" value="@Model.Fail_Finder" />
                            </td>
                            <th>보수자</th>
                            <td>
                                <input type="text" name="Fail_Repairer" value="@Model.Fail_Repairer" />
                            </td>
                        </tr>
                        <tr>
                            <th>감독자</th>
                            <td>
                                <input type="text" name="Fail_Supervisor" value="@Model.Fail_Supervisor" />
                            </td>
                            <th>보수일</th>
                            <td>
                                <!-- 날짜 필드는 yyyy-MM-dd 포맷으로 변환 -->
                                <input type="date" name="Fail_Repair_Date" value="@(Model.Fail_Repair_Date.HasValue ? Model.Fail_Repair_Date.Value.ToString("yyyy-MM-dd") : "")" />
                            </td>
                            <th></th>
                            <td></td>
                        </tr>
                    </table>
                </div>
            </form>
        </div>
    </div>

    <script type="text/javascript">
        function updatePUMPGojang() {
            var form = document.getElementById("pumpGojangUpdateForm");
            var formData = new FormData(form);

            console.log(formData);
            $.ajax({
                url: '@Url.Action("PUMPGojangUpdate", "PUMPGojang")',
                type: "POST",
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {
                    if (response.IsSuccess) {
                        alert("PUMP 고장 정보가 수정되었습니다.");
                        // 수정 후 목록 페이지로 이동
                        window.location.href = '@Url.Action("PUMPGojangTotalList", "PUMPGojang")';
                    } else {
                        alert("PUMP 고장 정보를 수정하지 못했습니다.: " + response.message);
                    }
                },
                error: function (xhr, status, error) {
                    console.error("오류 발생:", xhr.responseText || status, error);
                    alert("PUMP 고장 정보 수정 중 오류가 발생했습니다." + xhr.responseText);
                }
            });
        }
    </script>
}
