@model Web.Common.COFModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section LeftMenu {
    @Html.Partial("_SettingMenu")
}

@section MainContent {
    <h1>CoF 정보 등록</h1>

    <!-- ① 장비 선택: GET 폼 (드롭다운 변경 시 자동 전송) -->
    <form method="get" action="@Url.Action("CofInfo","Setting")" class="equipment-wrap" style="margin-bottom:16px;">
        <label for="code" class="equipment-label">장비 선택</label>
        @Html.DropDownList(
            "code",
            (SelectList)ViewBag.EquipmentTypes,
            "-- 장비 선택 --",
            new { id = "code", @class = "equipment-select", onchange = "this.form.submit();" }
        )
        <noscript><button type="submit" class="btn blue">불러오기</button></noscript>
    </form>

    <!-- ② 저장: POST 폼 -->
    @using (Html.BeginForm("CofInfo", "Setting", FormMethod.Post, new { id = "cofForm" }))
    {
        @Html.AntiForgeryToken()

        @Html.HiddenFor(m => m.Tbl_Idx)
        @Html.HiddenFor(m => m.Code)
        @Html.ValidationSummary(false, "", new { @class = "validation-summary-errors" })

        <div class="con_box">
            <div class="content_warp">
                <div class="btn_area top right">
                    <button type="submit" class="btn blue app">적용</button>
                </div>

                <div class="interface_wrap">
                    @Html.Partial("_CofInputs", Model)

                    <div class="basic_wrap">
                        <h3>계산 결과</h3>
                        <div class="box">
                            <table>
                                <tr><th>고객 정전 비용 ($) : </th><td>@Html.DisplayFor(m => m.Customer_Power_Outage_Cost, "{0:0.00}")</td></tr>
                                <tr><th>계통 손실 비용 ($) : </th><td>@Html.DisplayFor(m => m.System_Loss_Cost, "{0:0.00}")</td></tr>
                                <tr><th>설비 복구 비용 ($) : </th><td>@Html.DisplayFor(m => m.Facility_Recovery_Cost, "{0:0.00}")</td></tr>
                                <tr><th>전력판매 수익 손실 ($) : </th><td>@Html.DisplayFor(m => m.Loss_Of_Profit, "{0:0.00}")</td></tr>
                                <tr><th>안전사고 보상 ($) : </th><td>@Html.DisplayFor(m => m.Safety_Accident_Compensation_1, "{0:0.00}")</td></tr>
                                <tr><th>환경사고 보상 ($) : </th><td>@Html.DisplayFor(m => m.Safety_Accident_Compensation_2, "{0:0.00}")</td></tr>
                                <tr><th>--최종 COF 합산값-- : </th><td>@Html.DisplayFor(m => m.Total_Cof, "{0:0.00}")</td></tr>
                            </table>
                        </div>
                    </div>
                </div> <!-- .interface_wrap -->
            </div> <!-- .content_warp -->
        </div> <!-- .con_box -->
    }
}
