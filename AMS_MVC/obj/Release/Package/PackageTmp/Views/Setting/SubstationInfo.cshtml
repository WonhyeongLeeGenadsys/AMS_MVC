@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section LeftMenu {
    @Html.Partial("_SettingMenu")
}

@section MainContent {
    <!--타이틀-->
    <h1>변전소 정보</h1>
    <!--//타이틀-->
    <!--컨텐츠-->
    <div class="con_box">
        <!--컨텐츠 inn-->
        <div class="content_warp">
            <!--버튼-->
            @*<div class="btn_area top right">
                    <p>
                        <a href="#" class="btn red del">삭제</a>
                        <a href="#" class="btn blue app">적용</a>
                    </p>
                </div>*@
            <!--//버튼-->

            <div class="interface_wrap">
                <!--변전소-->
                <div class="basic_wrap">
                    <h3>변전소 정보</h3>
                    <div class="box">
                        <table>
                            <colgroup>
                                <col style="width:150px;" />
                                <col />
                            </colgroup>
                            <tr>
                                <th>변전소 이름</th>
                                <td><input type="text" class="w100" /></td>
                            </tr>
                            <tr>
                                <th>연간 공급 전력량</th>
                                <td><input type="text" class="w100" /></td>
                            </tr>
                        </table>
                    </div>
                </div>
                <!--//변전소-->
                <!--CoF-->
                <div class="basic_wrap">
                    <h3>CoF 정보</h3>
                    <div class="box">
                        <table>
                            <tr>
                                <th>정전비용</th>
                                <td><input type="text" class="w100" /></td>
                                <th>부하값</th>
                                <td><input type="text" class="w100" /></td>
                            </tr>
                            <tr>
                                <th>전압값</th>
                                <td><input type="text" class="w100" /></td>
                                <th>환경비용</th>
                                <td><input type="text" class="w100" /></td>
                            </tr>
                            <tr>
                                <th>신뢰도비용</th>
                                <td><input type="text" class="w100" /></td>
                                <th>투자비용</th>
                                <td><input type="text" class="w100" /></td>
                            </tr>
                            <tr>
                                <th>안전비용</th>
                                <td><input type="text" class="w100" /></td>
                            </tr>
                        </table>
                    </div>
                </div>
                <!--//CoF-->
            </div>
            <div class="interface_wrap mrT20">
                <!--수명 통계-->
                <div class="basic_wrap">
                    <h3>수명 통계</h3>
                    <div class="interface_wrap">
                        <!-- AC 통계 -->
                        <div class="small_wrap">
                            <div class="box">
                                <h4 class="tit_h4">AC</h4>
                                <div class="table_list_app small">
                                    <table>
                                        <colgroup>
                                            <col style="width:33.3%" />
                                            <col style="width:33.3%" />
                                            <col style="width:33.3%" />
                                        </colgroup>
                                        <thead>
                                            <tr>
                                                <th>설비명</th>
                                                <th>형상모수(ShapeParam)</th>
                                                <th>척도모수(ScaleParam)</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td>VCB</td>
                                                <td>
                                                    <input type="text" value="@(ViewBag.VCB?.ShapeParam?.ToString() ?? "")" />

                                                </td>
                                                <td>
                                                    <input type="text" value="@(ViewBag.VCB?.ScaleParam?.ToString() ?? "")" />

                                                </td>
                                            </tr>
                                            <tr>
                                                <td>Interface TR</td>
                                                <td>
                                                    <input type="text" value="@(ViewBag.ITR?.ShapeParam?.ToString() ?? "")" />
                                                </td>                                                
                                                <td>
                                                    <input type="text" value="@(ViewBag.ITR?.ScaleParam?.ToString() ?? "")" />
                                                </td>                                                
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- DC 통계 -->
                        <div class="small_wrap">
                            <div class="box">
                                <h4 class="tit_h4">DC</h4>
                                <div class="table_list_app small">
                                    <table>
                                        <colgroup>
                                            <col style="width:33.3%" />
                                            <col style="width:33.3%" />
                                            <col style="width:33.3%" />
                                        </colgroup>
                                        <thead>
                                            <tr>
                                                <th>설비명</th>
                                                <th>형상모수(ShapeParam)</th>
                                                <th>척도모수(ScaleParam)</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td>Sub Module</td>
                                                <td>
                                                    <input type="text" value="@(ViewBag.SUBMODULE?.ShapeParam?.ToString() ?? "")" />
                                                </td>
                                                <td>
                                                    <input type="text" value="@(ViewBag.SUBMODULE?.ScaleParam?.ToString() ?? "")" />

                                                </td>
                                            </tr>
                                            <tr>
                                                <td>DCCB</td>
                                                <td>
                                                    <input type="text" value="@(ViewBag.DCCB?.ShapeParam?.ToString() ?? "")" />

                                                </td>
                                                <td>
                                                    <input type="text" value="@(ViewBag.DCCB?.ScaleParam?.ToString() ?? "")" />

                                                </td>
                                            </tr>
                                            <tr>
                                                <td>DC Cable</td>
                                                <td>
                                                    <input type="text" value="@(ViewBag.DCCABLE?.ShapeParam?.ToString() ?? "-")" />
                                                </td>
                                                <td>
                                                    <input type="text" value="@(ViewBag.DCCABLE?.ScaleParam?.ToString() ?? "-")" />
                                                </td>

                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <!-- Cooling System 통계 -->
                        <div class="small_wrap">
                            <div class="box">
                                <h4 class="tit_h4">Cooling System</h4>
                                <div class="table_list_app small">
                                    <table>
                                        <colgroup>
                                            <col style="width:33.3%" />
                                            <col style="width:33.3%" />
                                            <col style="width:33.3%" />
                                        </colgroup>
                                        <thead>
                                            <tr>
                                                <th>설비명</th>
                                                <th>형상모수(ShapeParam)</th>
                                                <th>척도모수(ScaleParam)</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td>Tank</td>
                                                <td><input type="text" /></td>
                                                <td><input type="text" /></td>
                                            </tr>
                                            <tr>
                                                <td>Filer</td>
                                                <td><input type="text" /></td>
                                                <td><input type="text" /></td>
                                            </tr>
                                            <tr>
                                                <td>Heat Exchanger</td>
                                                <td><input type="text" /></td>
                                                <td><input type="text" /></td>
                                            </tr>
                                            <tr>
                                                <td>Bypass Valve</td>
                                                <td><input type="text" /></td>
                                                <td><input type="text" /></td>
                                            </tr>
                                            <tr>
                                                <td>Pump</td>
                                                <td><input type="text" /></td>
                                                <td><input type="text" /></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <!-- Grounding 통계 -->
                        <div class="small_wrap">
                            <div class="box">
                                <h4 class="tit_h4">Grounding</h4>
                                <div class="table_list_app small">
                                    <table>
                                        <colgroup>
                                            <col style="width:33.3%" />
                                            <col style="width:33.3%" />
                                            <col style="width:33.3%" />
                                        </colgroup>
                                        <thead>
                                            <tr>
                                                <th>설비명</th>
                                                <th>형상모수(ShapeParam)</th>
                                                <th>척도모수(ScaleParam)</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td>Zig-Zag TR</td>
                                                <td><input type="text" /></td>
                                                <td><input type="text" /></td>
                                            </tr>
                                            <tr>
                                                <td>ES</td>
                                                <td><input type="text" /></td>
                                                <td><input type="text" /></td>
                                            </tr>
                                            <tr>
                                                <td>NGR</td>
                                                <td><input type="text" /></td>
                                                <td><input type="text" /></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!--//수명 통계-->
            </div>
        </div>
    </div>
    <!--//컨텐츠가 들어옵니다-->
}
