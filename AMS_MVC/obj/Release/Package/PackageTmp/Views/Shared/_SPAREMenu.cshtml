
@{
    var activeAction = Convert.ToString(ViewContext.RouteData.Values["action"]);
    var activeController = Convert.ToString(ViewContext.RouteData.Values["controller"]);
    Func<string, bool> isController = name =>
        string.Equals(activeController, name, StringComparison.OrdinalIgnoreCase);
    Func<string, bool> isDashboardAction = name =>
        isController("SPAREDashboard") &&
        string.Equals(activeAction, name, StringComparison.OrdinalIgnoreCase);
}

<h1>예비품</h1>
<ul>
    <li><a href="@Url.Action("SPAREOverview", "SPAREDashboard")" class="@(isDashboardAction("SPAREOverview") ? "on" : "")">종합현황</a></li>

    <li><a href="@Url.Action("SPAREBasicList", "SPAREBasic")" class="@(isController("SPAREBasic") ? "on" : "")">기본정보</a></li>

    <li><a href="@Url.Action("SPAREInventoryStatus", "SPAREDashboard")" class="@(isController("SPAREInventory") || isDashboardAction("SPAREInventoryStatus") ? "on" : "")">재고현황</a></li>
    <li><a href="@Url.Action("SPAREProcurementStatus", "SPAREDashboard")" class="@(isController("SPAREProcurement") || isDashboardAction("SPAREProcurementStatus") ? "on" : "")">발주관리</a></li>
    <li><a href="@Url.Action("SPARECostPlan", "SPAREDashboard")" class="@(isController("SPARECost") || isDashboardAction("SPARECostPlan") ? "on" : "")">비용계획</a></li>
    <li><a href="@Url.Action("SPAREPolicy", "SPAREDashboard")" class="@(isDashboardAction("SPAREPolicy") ? "on" : "")">재고정책</a></li>
</ul>


