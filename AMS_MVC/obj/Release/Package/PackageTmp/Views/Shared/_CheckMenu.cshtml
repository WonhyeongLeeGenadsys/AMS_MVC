<script>
    $(document).ready(function () {
        // active 상위 메뉴에 서브메뉴가 지정되지 않았으면 첫 번째 항목을 active로 처리
        $('.check-menu li.has-sub.active').each(function () {
            if ($(this).find('.two_depth li.active').length === 0) {
                $(this).find('.two_depth li:first-child').addClass('active');
            }
        });
    });
</script>
