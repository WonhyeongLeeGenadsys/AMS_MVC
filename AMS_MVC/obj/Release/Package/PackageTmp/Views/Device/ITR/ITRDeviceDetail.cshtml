@model AMS_MVC.Models.ITRBasicInfo
@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    // 1) 보통점검 데이터
    var chk1List = ViewBag.ITRChk1List as List<AMS_MVC.Models.ITRChk1>;
    var lastChk11 = chk1List != null && chk1List.Any()
                   ? chk1List.OrderByDescending(c => c.CHK1_Tbl_GetDate).First()
                   : null;

    // 2) 정밀점검 데이터
    var chk2List = ViewBag.ITRChk2List as List<AMS_MVC.Models.ITRChk2>;
    var lastChk12 = chk2List != null && chk2List.Any()
                   ? chk2List.OrderByDescending(c => c.CHK2_Tbl_GetDate).First()
                   : null;

    // RiskMatrix HI 파싱
    int riskHI = 0;
    if (ViewBag.HIDict != null)
    {
        int.TryParse(ViewBag.HIDict.HI, out riskHI);
    }
}
@section LeftMenu {
    @Html.Partial("_DeviceInfoMenu")
}

@section MainContent {
    <h1>ITR - @(Model?.ITR_Code ?? "N/A")</h1>
    <!-- 전체 박스 -->
    <div class="box_wrap">
        <div class="con_box flex3">
            <div class="product">
                <p class="img">
                    <img src='@Url.Content(Model?.Photo ?? "~/img/default_product.png")' alt="제품 이미지" />
                </p>
                <dl class="product_info">
                    <dt>시리얼번호</dt>
                    <dd>@(Model?.Serial_No ?? "N/A")</dd>

                    <dt>설치일</dt>
                    <dd>
                        @(Model?.Install_Date != null
                            ? ((DateTime)Model.Install_Date).ToString("yyyy-MM-dd")
                            : "N/A")
                    </dd>

                    <dt>가동일</dt>
                    <dd>
                        @(Model?.Operating_Date != null
                            ? ((DateTime)Model.Operating_Date).ToString("yyyy-MM-dd")
                            : "N/A")
                    </dd>

                    <dt>사용기간</dt>
                    <dd>
                        @if (Model?.Operating_Date != null)
                        {
                            int years = DateTime.Now.Year - ((DateTime)Model.Operating_Date).Year;
                            @($"{years}년")
                        }
                        else
                        {
                            @("0년")
                        }
                    </dd>

                    <dt>구입비용</dt>
                    <dd>
                        @(Model != null ? String.Format("{0:N0}원", Model.Price) : "N/A")
                    </dd>

                    <dt>설치장소</dt>
                    <dd>@(Model?.Install_Place ?? "N/A")</dd>

                    <dt>정격전압</dt>
                    <dd>@(Model != null ? Model.Rated_V.ToString() : "N/A")</dd>

                    <dt>정격전류</dt>
                    <dd>@(Model != null ? Model.Rated_A.ToString() : "N/A")</dd>

                    <dt>제작사</dt>
                    <dd>@(Model?.Make_Company ?? "N/A")</dd>

                    <dt>제작번호</dt>
                    <dd>@(Model?.Make_No ?? "N/A")</dd>

                    <dt>예방진단사용</dt>
                    <dd>@(Model != null && Model.Is_Diagnostics ? "예" : "아니오")</dd>

                    <dt>건전도 사용</dt>
                    <dd>@(Model != null && Model.Is_Health ? "예" : "아니오")</dd>
                </dl>
            </div>
        </div>
        <!-- 건전도 차트 -->
        <div class="con_box flex3">
            <!--타이틀-->
            <h2>
                <p>건전도</p>
            </h2>
            <!--//타이틀-->
            <!--차트-->
            <div id="gauge" style="height:250px;"></div>
            <!--//차트-->
            <script type="text/javascript">
        $(function () {
            const gauge = $('#gauge').dxCircularGauge({
                scale: {
                    startValue: 1,
                    endValue: 5,
                    tickInterval: 1,
                    label: {
                        customizeText: function (arg) {
                            return "HI: " + arg.valueText;
                        }
                    }
                },
                rangeContainer: {
                    ranges: [
                        { startValue: 0.5, endValue: 1.5, color: '#5B9F56' },  // HI = 1: Very Good
                        { startValue: 1.5, endValue: 2.5, color: '#B4DEB1' },  // HI = 2: Good
                        { startValue: 2.5, endValue: 3.5, color: '#EBCD1D' },  // HI = 3: Fair
                        { startValue: 3.5, endValue: 4.5, color: '#F18425' },  // HI = 4: Bad
                        { startValue: 4.5, endValue: 5.5, color: '#F05153' }   // HI = 5: Very Bad
                    ]
                },
                tooltip: { enabled: true },
                // 서버에서 파싱한 riskHI 값을 사용
                value: @riskHI,
            }).dxCircularGauge("instance");
        });
            </script>
        </div>
        <!-- //건전도 차트 -->
        <!--risk matrix-->
        <div class="con_box flex3 riskMatrix">
            <h2>Risk Matrix</h2>
            <div class="matrix_group">
                <ul class="chartContainer_bg">
                    <!-- 1행 -->
                    <li class="yellow"></li>
                    <li class="yellow"></li>
                    <li class="orange"></li>
                    <li class="orange"></li>
                    <li class="orange"></li>
                    <!-- 2행 -->
                    <li class="green"></li>
                    <li class="yellow"></li>
                    <li class="yellow"></li>
                    <li class="orange"></li>
                    <li class="orange"></li>
                    <!-- 3행 -->
                    <li class="green"></li>
                    <li class="green"></li>
                    <li class="yellow"></li>
                    <li class="yellow"></li>
                    <li class="orange"></li>
                    <!-- 4행 -->
                    <li class="blue"></li>
                    <li class="green"></li>
                    <li class="green"></li>
                    <li class="yellow"></li>
                    <li class="yellow"></li>
                    <!-- 5행 -->
                    <li class="blue"></li>
                    <li class="blue"></li>
                    <li class="green"></li>
                    <li class="green"></li>
                    <li class="yellow"></li>
                </ul>
                <div id="chartRiskITR" class="chart_box matrix"></div>
            </div>

        </div>

        <script>
            $(function () {
                    const code = '@Model.ITR_Code';


      $.getJSON('@Url.Action("GetRiskMapPoints","TotalInfo")', { prefix: 'itr' })
     .done(function (allPoints) {
         // name 프로퍼티가 모델의 코드와 일치하는 포인트만
         const point = allPoints.find(p => p.name === code);
         if (!point) {
             console.warn("해당 장비의 포인트를 찾지 못했습니다:", code);
             return;
         }


         $("#chartRiskITR").dxChart({
             dataSource: [point],
             commonSeriesSettings: {
                 type: "scatter",
                 argumentField: "x",
                 valueField: "y",
                 point: { size: 10 }
             },
             palette: ['#34A369', '#B82069', '#F57B50', '#2B6D6F', '#38B295', '#DC9FF1', '#EBCC44', '#CFD94D', '#E43387', '#002C68'],
             border: {
                 visible: false // 차트 전체의 외곽선(테두리)을 숨깁니다.
             },

             seriesTemplate: { nameField: "group" },
             argumentAxis: {
                 visualRange: { startValue: 0, endValue: 40000 },
                 valueMarginsEnabled: false, // 여백 제거
                 tickInterval: 8000,
                 grid: {
                     visible: true,
                     opacity: 0.5, /* 선을 더 연하게 */
                     color: '#ffffff', /* 선 색상 지정 */
                     width: 1 /* 선 두께 지정 */
                 },
                 title: { text: "CoF ($)" },
                 label: { customizeText: e => e.value.toLocaleString() }
             },

             valueAxis: {
                 // 0~100% 딱 고정
                 visualRange: { startValue: 0, endValue: 100 },
                 // 눈금을 tick에 맞춰 늘리지 않음
                 endOnTick: false,
                 // 데이터 끝에 여백을 두지 않음
                 valueMarginsEnabled: false, // 여백 제거
                 tickInterval: 20,
                 min: 0, // 첫 번째 셀의 시작 Y 좌표
                 max: 5, // 마지막 셀의 끝 Y 좌표
                 grid: {
                     visible: true,
                     opacity: 0.5, /* 선을 더 연하게 */
                     color: '#ffffff', /* 선 색상 지정 */
                     width: 1 /* 선 두께 지정 */
                 },
                 title: { text: "PoF (%)" },
                 label: { customizeText: e => e.value.toFixed(0) + "%" },
             },


             tooltip: {
                 enabled: true,
                 location: 'edge',
                 customizeTooltip: info => {
                     const d = info.point.data;
                     return {
                         html:
                             `<strong>${d.name}</strong><br/>
                CoF: ${d.x.toLocaleString()}$<br/>
                PoF: ${d.y.toFixed(2)}%`
                     };
                 }

             },
             onPointClick(e) {
                 const d = e.target.originalData;
                 alert(`코드: ${d.name}\nCoF: ${d.x.toLocaleString()}$\nPoF: ${d.y.toFixed(2)}%`);
             },
             legend: {
                 visible: true, position: "bottom",
                 verticalAlignment: 'bottom',
                 horizontalAlignment: 'center',
             },

             size: { width: 400, height: 300 },
             margin: 0,

         });      })
      .fail(function(err) {
        console.error("GetRiskMapPoints 호출 실패:", err);
      });
  });
        </script>
        <!--//risk matrix-->
        <!-- 그룹 전략 박스 -->
        <div class="con_box" id="groupStrategy">
            <h2>차년도 유지보수 대상 (그룹)</h2>
            <div id="groupStrategyMessage">로딩 중…</div>
        </div>

        <script>
$(function(){
  var prefix = '@ViewData["Prefix"]';

  $.getJSON('@Url.Action("GetGroupStrategy","EquipmentAlgorithm")', { equipmentType: 'VCB' })
   .done(res => $('#groupStrategyMessage').html(res.StrategyMessage))
   .fail(() => $('#groupStrategyMessage').html('<span class="error">불러오기 실패</span>'));
});
        </script>
        <!--//전략-->
        <!-- 보통점검 영역 -->
        <div class="con_box">
            <h2><p>보통점검</p></h2>
            @if (lastChk11 != null)
            {
                <ul class="sub_flex">
                    <!-- 1. 접점 소모량  -->
                    <li>
                        <h4 class="tit_h4">DGA</h4>
                        <div class="table_list_app small">
                            <table>
                                <colgroup>
                                    <col style="width:50%">
                                    <col style="width:50%">
                                </colgroup>
                                <thead>
                                    <tr>
                                        <th>파라미터</th>
                                        <th>판정</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>H2</td>
                                        <td>@lastChk11.CHK1_H2</td>
                                    </tr>
                                    <tr>
                                        <td>C2H2</td>
                                        <td>@lastChk11.CHK1_C2H2</td>
                                    </tr>
                                    <tr>
                                        <td>C2H4</td>
                                        <td>@lastChk11.CHK1_C2H4</td>
                                    </tr>
                                    <tr>
                                        <td>CH4</td>
                                        <td>@lastChk11.CHK1_CH4</td>
                                    </tr>
                                    <tr>
                                        <td>C2H6</td>
                                        <td>@lastChk11.CHK1_C2H6</td>
                                    </tr>
                                    <tr>
                                        <td>CO</td>
                                        <td>@lastChk11.CHK1_CO</td>
                                    </tr>
                                    <tr>
                                        <td>CO2</td>
                                        <td>@lastChk11.CHK1_CO2</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </li>
                    <li>
                        <h4 class="tit_h4">Oil Quality</h4>
                        <div class="table_list_app small">
                            <table>
                                <colgroup>
                                    <col style="width:50%">
                                    <col style="width:50%">
                                </colgroup>
                                <thead>
                                    <tr>
                                        <th>파라미터</th>
                                        <th>판정</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>유전체 강도</td>
                                        <td>@lastChk11.CHK1_Dielectric_Strength</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </li>
                    <li>
                        <h4 class="tit_h4">Age</h4>
                        <div class="table_list_app small">
                            <table>
                                <colgroup>
                                    <col style="width:50%">
                                    <col style="width:50%">
                                </colgroup>
                                <thead>
                                    <tr>
                                        <th>파라미터</th>
                                        <th>판정</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>나이</td>
                                        <td>@lastChk11.CHK1_Age</td>
                                    </tr>
                                    <tr>
                                        <td>잔여수명</td>
                                        <td>@lastChk11.CHK1_Remain_Life</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </li>
                    <li>
                        <h4 class="tit_h4">Measure</h4>
                        <div class="table_list_app small">
                            <table>
                                <colgroup>
                                    <col style="width:50%">
                                    <col style="width:50%">
                                </colgroup>
                                <thead>
                                    <tr>
                                        <th>파라미터</th>
                                        <th>판정</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>Doble</td>
                                        <td>@lastChk11.CHK1_Doble</td>
                                    </tr>
                                    <tr>
                                        <td>SFRA</td>
                                        <td>@lastChk11.CHK1_SFRA</td>
                                    </tr>
                                    <tr>
                                        <td>HV_E</td>
                                        <td>@lastChk11.CHK1_HV_E</td>
                                    </tr>
                                    <tr>
                                        <td>LV_E</td>
                                        <td>@lastChk11.CHK1_LV_E</td>
                                    </tr>
                                    <tr>
                                        <td>TV_E</td>
                                        <td>@lastChk11.CHK1_TV_E</td>
                                    </tr>
                                    <tr>
                                        <td>HV_LV</td>
                                        <td>@lastChk11.CHK1_HV_LV</td>
                                    </tr>
                                    <tr>
                                        <td>HV_TV</td>
                                        <td>@lastChk11.CHK1_HV_TV</td>
                                    </tr>
                                    <tr>
                                        <td>LV_TV</td>
                                        <td>@lastChk11.CHK1_LV_TV</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </li>
                </ul>
            }
            else
            {
                <p>보통점검 데이터가 없습니다.</p>
            }
        </div>
        <!-- //보통점검 영역 -->
        <!-- 정밀점검 영역 -->
        <div class="con_box">
            <h2><p>정밀점검</p></h2>
            @if (lastChk11 != null)
            {
                <ul class="sub_flex">
                    <li>
                        <h4 class="tit_h4">Oil Quality</h4>
                        <div class="table_list_app small">
                            <table>
                                <colgroup>
                                    <col style="width:50%">
                                    <col style="width:50%">
                                </colgroup>
                                <thead>
                                    <tr>
                                        <th>파라미터</th>
                                        <th>판정</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>산가</td>
                                        <td>@lastChk12.CHK2_Computerized_Price</td>
                                    </tr>
                                    <tr>
                                        <td>수분함량</td>
                                        <td>@lastChk12.CHK2_Water_Content</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </li>
                    <li>
                        <h4 class="tit_h4">Measure</h4>
                        <div class="table_list_app small">
                            <table>
                                <colgroup>
                                    <col style="width:50%">
                                    <col style="width:50%">
                                </colgroup>
                                <thead>
                                    <tr>
                                        <th>파라미터</th>
                                        <th>판정</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>전압비</td>
                                        <td>@lastChk12.CHK2_Voltage_Ratio</td>
                                    </tr>
                                    <tr>
                                        <td>여자전류</td>
                                        <td>@lastChk12.CHK2_Excitation_Current</td>
                                    </tr>
                                    <tr>
                                        <td>단락전류</td>
                                        <td>@lastChk12.CHK2_Short_Current</td>
                                    </tr>
                                    <tr>
                                        <td>PD측정</td>
                                        <td>@lastChk12.CHK2_PD</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </li>
                </ul>
            }
            else
            {
                <p>정밀점검 데이터가 없습니다.</p>
            }
        </div>
        <!-- //정밀점검 영역 -->
    </div>
}