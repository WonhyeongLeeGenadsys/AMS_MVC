@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    ViewData["Prefix"] = "DCCB";
    ViewData["Controller"] = "DCCBDevice";
    ViewData["PieId"] = "pie04";
    ViewData["DetailParam"] = "dccbCode";
}

@section LeftMenu {
    @Html.Partial("_DeviceInfoMenu")
}

@section MainContent {
    <h1>DCCB</h1>
    <!--전체 박스-->
    <div class="box_wrap">

        <!-- 전략 -->
        <div class="con_box" id="strategyContainerMain">
            <!-- 타이틀 -->
            <h2><p>차년도 유지보수 대상</p></h2>
            <!-- //타이틀 -->
        </div>

        <script>
  var prefix = '@ViewData["Prefix"]';

  $.getJSON(
      '@Url.Action("GetGroupStrategy","EquipmentAlgorithm")',
      { equipmentType: prefix }
  )
  .done(function(res){
    console.log("B3=", res.B3Life, "HI=", res.HIList);
    $('#strategyContainerMain')
      .append('<p>' + (res.error ? '<span class="error">'+res.error+'</span>' : res.StrategyMessage) + '</p>');
  })
  .fail(function(xhr, status, err){
    console.error("GET /EquipmentAlgorithm/GetGroupStrategy 실패:", status, err);
    $('#strategyContainerMain')
      .append('<p class="error">전략 로드를 실패했습니다.</p>');
  });
        </script>
        <!--//전략-->
        <!--건전도-->
        @Html.Partial("DeviceInfo/_HealthPie")
        <!--//건전도-->
        <!--risk matrix-->
        <div class="con_box flex3 riskMatrix">
            <h2>Risk Matrix</h2>
            <div class="matrix_group">
                <div id="chartRiskDCCB" class="chart_box matrix"></div>
                <ul class="chartContainer_bg">
                    <!-- 1행 -->
                    <li class="yellow"></li>
                    <li class="yellow"></li>
                    <li class="orange"></li>
                    <li class="orange"></li>
                    <li class="orange"></li>
                    <!-- 2행 -->
                    <li class="green"></li>
                    <li class="yellow"></li>
                    <li class="yellow"></li>
                    <li class="orange"></li>
                    <li class="orange"></li>
                    <!-- 3행 -->
                    <li class="green"></li>
                    <li class="green"></li>
                    <li class="yellow"></li>
                    <li class="yellow"></li>
                    <li class="orange"></li>
                    <!-- 4행 -->
                    <li class="blue"></li>
                    <li class="green"></li>
                    <li class="green"></li>
                    <li class="yellow"></li>
                    <li class="yellow"></li>
                    <!-- 5행 -->
                    <li class="blue"></li>
                    <li class="blue"></li>
                    <li class="green"></li>
                    <li class="green"></li>
                    <li class="yellow"></li>
                </ul>
            </div>


        </div>

        <script>
            $(function(){
      loadUsdKrwRate().always(function () {
      $.getJSON('@Url.Action("GetRiskMapPoints","TotalInfo")', { prefix: 'DCCB' })
     .done(function(raw){
       const data = raw.map(p => ({
         x: usdToEokKrw(p.x), y: p.y, name: p.name, group: p.group
       }));
       const maxCof = getRiskMatrixMaxEok(data);


         $("#chartRiskDCCB").dxChart({
         dataSource: data,
         commonSeriesSettings: {
           type: "scatter",
           argumentField: "x",
           valueField: "y",
           point: { size: 10 }
           },
           palette: ['#34A369', '#B82069', '#F57B50', '#2B6D6F', '#38B295', '#DC9FF1', '#EBCC44', '#CFD94D', '#E43387','#002C68'],
           border: {
               visible: false // 차트 전체의 외곽선(테두리)을 숨깁니다.
           },

           seriesTemplate: { nameField: "group" },
           argumentAxis: {
               visualRange: { startValue: 0, endValue: maxCof },
               valueMarginsEnabled: false, // 여백 제거
               tickInterval: maxCof / 5,
               grid: {
                   visible: true,
                   opacity: 0.5, /* 선을 더 연하게 */
                   color: '#ffffff', /* 선 색상 지정 */
                   width: 1 /* 선 두께 지정 */
               },
               title: { text: "CoF (억원)" },
               label: { customizeText: e => Number(e.value).toLocaleString('ko-KR', { maximumFractionDigits: 2 }) }
           },

           valueAxis: {
               // 0~100% 딱 고정
               visualRange: { startValue: 0, endValue: 100 },
               // 눈금을 tick에 맞춰 늘리지 않음
               endOnTick: false,
               // 데이터 끝에 여백을 두지 않음
               valueMarginsEnabled: false, // 여백 제거
               tickInterval: 20,
               min: 0, // 첫 번째 셀의 시작 Y 좌표
               max: 5, // 마지막 셀의 끝 Y 좌표
               grid: {
                   visible: true,
                   opacity: 0.5, /* 선을 더 연하게 */
                   color: '#ffffff', /* 선 색상 지정 */
                   width: 1 /* 선 두께 지정 */
               },
               title: { text: "PoF (%)" },
               label: { customizeText: e => e.value.toFixed(0) + "%" },
           },


         tooltip: {
             enabled: true,
             location: 'edge',
             customizeTooltip: info => {
             const d = info.point.data;
             return { html:
               `<strong>${d.name}</strong><br/>
                 CoF: ${d.x.toLocaleString('ko-KR', { maximumFractionDigits: 3 })}억원<br/>
                PoF: ${d.y.toFixed(2)}%` };
             }

         },
         onPointClick(e) {
           const d = e.target.originalData;
             alert(`코드: ${d.name}\nCoF: ${d.x.toLocaleString('ko-KR', { maximumFractionDigits: 3 })}억원\nPoF: ${d.y.toFixed(2)}%`);
         },
           legend: {
               visible: true, position: "bottom",
               verticalAlignment: 'bottom',
               horizontalAlignment: 'center',
               markerShape: 'circle',

           },

           size: { width:400, height: 300 },
           margin: 0,

       });
     });
      });
  });
        </script>
        <!--//risk matrix-->
        <!-- B3 수명 차트 -->
        <div class="con_box flex3">
            <h2><p>B3 수명</p></h2>
            <div id="chart_bar" style="height: 280px;"></div>
        </div>

        <script>
    $(document).ready(function () {
        var equipmentType = "DCCB";

        $.ajax({
            url: '@Url.Action("GetB3HistogramEquipment", "EquipmentAlgorithm")',
            type: 'GET',
            data: { equipmentType: equipmentType },
            dataType: 'json',
            success: function (res) {
                if (res.error) {
                    console.warn("오류:", res.error);
                    return;
                }
                console.log("B3 Histogram 데이터:", res);

                var b3 = res.B3;
                var binSize = res.BinSize;
                var timeMax = res.TimeMax;
                var histogram = res.Histogram;

                $("#chart_bar").dxChart({
                    dataSource: histogram,
                    commonSeriesSettings: {
                        type: 'bar',
                        argumentField: 'binStart',
                        valueField: 'count'
                    },
                    series: [{ name: "장비 수" }],
                    legend: { visible: false },
                    title: "(B3 수명 = " + b3 + ")",
                    tooltip: {
                        enabled: true,
                        customizeTooltip: function(arg) {
                            var start = arg.point.data.binStart;
                            var end = start + binSize;
                            return {
                                text: "구간: " + start + "~" + end + "년, 장비수: " + arg.value
                            };
                        }
                    },
                    argumentAxis: {
                        visualRange: [0, timeMax],
                        tickInterval: binSize,
                        title: "사용 기간 (년)",
                        label: {
                            customizeText: function () {
                                return this.value + "년";
                            }
                        }
                    },
                    valueAxis: {
                        title: "장비 대수"
                    },
                    annotations: [
                        {
                            type: "line",
                            axis: "argumentAxis",
                            value: b3,
                            text: "B3 = " + b3
                        }
                    ]
                });
            },
            error: function (xhr, status, error) {
                console.error("B3 히스토그램 로드 실패:", error);
            }
        });
    });
        </script>

        <!--설비들-->
        <div class="con_box flex4 system">
            <!-- 타이틀 -->
            <h2>
                <p>설비들</p>
                <p class="schedule_value">
                    <span class="verygoodDevice">V-Good</span>
                    <span class="goodDevice">Good</span>
                    <span class="fairDevice">Fair</span>
                    <span class="badDevice">Bad</span>
                    <span class="verybadDevice">V-Bad</span>
                </p>
            </h2>
            <!-- //타이틀 -->
            <!-- 리스트 -->
            <ul id="deviceList" class="box_system">
                <!-- 이곳에 AJAX로 동적 생성 -->
            </ul>
            <!-- //리스트 -->
            <script>
                $(document).ready(function () {
                    $.ajax({
                        type: "GET",
                        url: "/DCCBDevice/GetBasicInfoList",
                        dataType: "json",
                        success: function (data) {
                            var $deviceList = $("#deviceList");
                            $deviceList.empty();

                            data.forEach(function (item) {
                                // HI 값 (1~5)
                                var hi = parseInt(item.HI) || 0; // 혹시 null이면 0 처리

                                // HI에 따른 CSS 클래스 + 텍스트 결정
                                var cssClass = "";
                                var statusText = "";
                                switch (hi) {
                                    case 1:
                                        cssClass = "verygoodDevice";
                                        statusText = "Good";
                                        break;
                                    case 2:
                                        cssClass = "goodDevice";
                                        statusText = "Good";
                                        break;
                                    case 3:
                                        cssClass = "fairDevice";
                                        statusText = "Fair";
                                        break;
                                    case 4:
                                        cssClass = "badDevice";
                                        statusText = "Bad";
                                        break;
                                    case 5:
                                        cssClass = "verybadDevice";
                                        statusText = "Bad";
                                        break;
                                    default:
                                        cssClass = "unknown";
                                        statusText = "Unknown";
                                        break;
                                }

                                // 항상 5개 동그라미. HI 이하인 경우만 on 클래스로 색칠
                                var totalDots = 5;
                                var spansHtml = "";
                                for (var i = 1; i <= totalDots; i++) {
                                    if (i <= hi) {
                                        spansHtml += '<span class="on"></span>';
                                    } else {
                                        spansHtml += '<span></span>';
                                    }
                                }

                                // 사용기간(년) 계산 (가동일 기준)
                                var usageYear = "0년";
                                if (item.Operating_Date) {
                                    var operating = new Date(item.Operating_Date);
                                    var now = new Date();
                                    var diffYear = now.getFullYear() - operating.getFullYear();
                                    usageYear = diffYear + "년";
                                }

                                // li 항목 HTML 생성
                                var liHtml = ''
                                    + '<li>'
                                    + '  <a href="/DCCBDeviceDetail/DCCBDeviceDetail?dccbCode=' + encodeURIComponent(item.DCCB_Code) + '" '
                                    + '     style="display:block; text-decoration:none; color:inherit;">'
                                    + '    <dl class="product_info">'
                                    + '      <dt>시리얼번호</dt>'
                                    + '      <dd>' + (item.Serial_No || "") + '</dd>'
                                    + '      <dt>설치일</dt>'
                                    + '      <dd>' + (item.Install_Date || "") + '</dd>'
                                    + '      <dt>가동일</dt>'
                                    + '      <dd>' + (item.Operating_Date || "") + '</dd>'
                                    + '      <dt>사용기간</dt>'
                                    + '      <dd>' + usageYear + '</dd>'
                                    + '    </dl>'
                                    + '    <div class="result ' + cssClass + '">'
                                    + '      ' + spansHtml
                                    + '      <p class="result_txt">' + statusText + '</p>'
                                    + '    </div>'
                                    + '  </a>'
                                    + '</li>';

                                $deviceList.append(liHtml);
                            });
                        },
                        error: function (xhr, status, error) {
                            console.error("Error fetching device list:", error);
                        }
                    });
                });
            </script>

        </div>
        <!--//설비들-->
        <!--우선순위-->
        <div class="con_box flex4">
            <!--타이틀-->
            <h2>우선순위</h2>
            <!--그리드-->
            <div id="gridContainer" class="grid_wrap" style="height: 250px;"></div>
            <!--//그리드-->
            <script type="text/javascript">
                $(document).ready(function () {
                    // 우선순위 데이터를 서버에서 가져오는 함수
                    function fetchPriorityInfo() {
                        return $.ajax({
                            type: "POST",
                            url: "/DCCBDevice/GetPriorityDCCB",
                            contentType: "application/json; charset=utf-8",
                            dataType: "json"
                        });
                    }

                    fetchPriorityInfo()
                        .done(function (response) {
                            console.log("우선순위 데이터:", response);
                            // 이미 컨트롤러에서 날짜형식 등으로 변환되어 반환되므로 바로 사용
                            initializePriorityGrid(response);
                        })
                        .fail(function (xhr, status, error) {
                            console.error("Ajax Error:", error);
                            alert("우선순위 데이터를 가져오는 중 오류가 발생했습니다.");
                        });

                    // dxDataGrid 초기화 함수
                    function initializePriorityGrid(data) {
                        $('#gridContainer').dxDataGrid({
                            dataSource: data,
                            columnFixing: { enabled: true },
                            showBorders: true,
                            sorting: { mode: 'multiple' },
                            scrolling: { columnRenderingMode: 'virtual' },

                            // 첫 번째 행 강조
                            onRowPrepared: function (e) {
                                if (e.rowType === 'data' && e.rowIndex === 0) {
                                    e.rowElement.addClass('first-row-highlight');
                                }
                            },

                            // HI 셀에 클래스 부여
                            columns: [
                                { dataField: "Priority", caption: "우선순위", alignment: "center" },
                                { dataField: "Sort", caption: "구분", alignment: "center" },
                                { dataField: "Name", caption: "설비명", alignment: "center" },
                                { dataField: "Serial_No", caption: "시리얼번호", alignment: "center" },
                                { dataField: "Install_Date", caption: "설치일", alignment: "center", dataType: "date" },
                                { dataField: "Operating_Date", caption: "가동일", alignment: "center", dataType: "date" },
                                { dataField: "UsagePeriod", caption: "사용기간(년)", alignment: "center" },
                                { dataField: "CoF", caption: "CoF(원)", alignment: "center", cellTemplate: (container, options) => container.text(formatKrwFromUsd(options.value)) },
                                { dataField: "PoF", caption: "PoF(%)", alignment: "center" },
                                {
                                    dataField: "HI",
                                    caption: "HI",
                                    alignment: "center",
                                    dataType: "number",
                                    cellTemplate: function (container, info) {
                                        var clsMap = {
                                            1: 'priorityVerygood',
                                            2: 'priorityGood',
                                            3: 'priorityFair',
                                            4: 'priorityPoor',
                                            5: 'priorityVerypoor',
                                            0: 'priorityUndefined'
                                        };
                                        container.addClass(clsMap[info.value] || '');
                                        container.text(info.value);
                                    }
                                }
                            ]
                        });
                    }
                });
            </script>
        </div>
