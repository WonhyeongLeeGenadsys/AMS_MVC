        <div class="con_box flex1">
            <!--타이틀-->
            <h2>
                <p>유지보수</p>
            </h2>
            <!--//타이틀-->
            <!--챠트-->
            <div id="chart03"></div>
            <!--//챠트-->
            <script>
                $(document).ready(function () {
                    // 유지보수 데이터를 서버에서 가져오는 함수
                    function fetchMaintenanceData() {
                        return $.ajax({
                            type: "POST",
                            url: "/VCBDevice/GetMonthlyMaintenanceData",
                            contentType: "application/json; charset=utf-8",
                            dataType: "json"
                        });
                    }

                    // 데이터 가져오기 및 차트 렌더링
                    fetchMaintenanceData()
                        .done(function (response) {
                            console.log("유지보수 데이터:", response);

                            if (!Array.isArray(response) || response.length === 0) {
                                //alert("유지보수 데이터가 없습니다.");
                                return;
                            }
                            const chartData = processMaintenanceData(rawData);
                            renderVCBChart(chartData);
                        })
                        .fail(function (xhr, status, error) {
                            console.error("Ajax Error:", error);
                            alert("유지보수 데이터를 가져오는 중 문제가 발생했습니다.");
                        });

                    // 데이터를 월별로 그룹화하는 함수
                    function processMaintenanceData(rawData) {
                        const groupedData = {};

                        rawData.forEach(item => {
                            const month = item.Month;
                            if (!groupedData[month]) {
                                groupedData[month] = { Month: month, VCB: 0 };
                            }
                            if (item.Type === "VCB") {
                                groupedData[month].VCB += item.Count;
                            }
                        });
                        // 데이터를 배열로 변환하고 월별로 정렬
                        return Object.values(groupedData).sort((a, b) => a.Month.localeCompare(b.Month));
                    }

                    // VCB 차트를 렌더링하는 함수
                    function renderVCBChart(data) {
                        $("#chart03").dxChart({
                            dataSource: data,
                            commonSeriesSettings: {
                                argumentField: "Month",
                                type: "bar"
                            },
                            legend: {
                                visible: true,
                                position: "bottom"
                            },
                            tooltip: {
                                enabled: true,
                                customizeTooltip: function (arg) {
                                    return {
                                        text: `${arg.seriesName} - ${arg.argumentText}월: ${arg.valueText}건`
                                    };
                                }
                            },
                            series: [
                                {
                                    name: "VCB",
                                    valueField: "VCB",
                                    color: "#0051A2" // 파란색
                                },
                            ]
                        });
                    }
                });
            </script>
        </div>
