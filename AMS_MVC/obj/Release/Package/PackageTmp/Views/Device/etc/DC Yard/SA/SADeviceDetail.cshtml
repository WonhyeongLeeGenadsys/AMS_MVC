@model Web.Common.SABasicInfo

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    // 모든 점검 데이터를 ViewBag으로 전달받았다고 가정하고, 최신 데이터만 선택
    var allChkData = ViewBag.SAChkList as List<Web.Common.SAChk>;
    var lastChk = allChkData != null && allChkData.Any()
                  ? allChkData.OrderByDescending(chk => chk.CHK_Tbl_GetDate).FirstOrDefault()
                  : null;

    // Riskmatrix의 HI 값을 파싱
    int riskHI = 0;
    if (ViewBag.HIDict != null)
    {
        int.TryParse(ViewBag.HIDict.HI, out riskHI);
    }
}


@section LeftMenu {
    @Html.Partial("_DeviceInfoMenu")
}

@section MainContent {
    <h1>SA - @(Model?.SA_Code ?? "N/A")</h1>
    <!-- 전체 박스 -->
    <div class="box_wrap">
        <div class="con_box flex3">
            <div class="product">
                <p class="img">
                    <img src='@Url.Content(Model?.Photo ?? "~/img/default_product.png")' alt="제품 이미지" />
                </p>
                <dl class="product_info">
                    <dt>시리얼번호</dt>
                    <dd>@(Model?.Serial_No ?? "N/A")</dd>

                    <dt>설치일</dt>
                    <dd>
                        @(Model?.Install_Date != null
                            ? ((DateTime)Model.Install_Date).ToString("yyyy-MM-dd")
                            : "N/A")
                    </dd>

                    <dt>가동일</dt>
                    <dd>
                        @(Model?.Operating_Date != null
                            ? ((DateTime)Model.Operating_Date).ToString("yyyy-MM-dd")
                            : "N/A")
                    </dd>

                    <dt>사용기간</dt>
                    <dd>
                        @if (Model?.Operating_Date != null)
                        {
                            int years = DateTime.Now.Year - ((DateTime)Model.Operating_Date).Year;
                            @($"{years}년")
                        }
                        else
                        {
                            @("0년")
                        }
                    </dd>

                    <dt>구입비용</dt>
                    <dd>
                        @(Model != null ? String.Format("{0:N0}원", Model.Price) : "N/A")
                    </dd>

                    <dt>설치장소</dt>
                    <dd>@(Model?.Install_Place ?? "N/A")</dd>

                    <dt>정격전압</dt>
                    <dd>@(Model != null ? Model.Rated_V.ToString() : "N/A")</dd>

                    <dt>정격전류</dt>
                    <dd>@(Model != null ? Model.Rated_A.ToString() : "N/A")</dd>

                    <dt>제작사</dt>
                    <dd>@(Model?.Make_Company ?? "N/A")</dd>

                    <dt>제작번호</dt>
                    <dd>@(Model?.Make_No ?? "N/A")</dd>

                    <dt>예방진단사용</dt>
                    <dd>@(Model != null && Model.Is_Diagnostics ? "예" : "아니오")</dd>

                    <dt>건전도 사용</dt>
                    <dd>@(Model != null && Model.Is_Health ? "예" : "아니오")</dd>
                </dl>
            </div>
        </div>
        <!--전략-->
        <div class="con_box">
            <!--타이틀-->
            <h2>
                <p>전략</p>
            </h2>
            <!--//타이틀-->
        </div>
        <!--전략-->
        <!-- 보통점검 영역 -->
        <div class="con_box">
            <h2><p>보통점검</p></h2>
            @if (lastChk != null)
            {
                <ul class="sub_flex">
                    <li>
                        <h4 class="tit_h4"></h4>
                        <div class="table_list_app small">
                            <table>
                                <colgroup>
                                    <col style="width:50%">
                                    <col style="width:50%">
                                </colgroup>
                                <thead>
                                    <tr>
                                        <th>파라미터</th>
                                        <th>판정</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>도면 일치 여부, 접지선 접속 및 노후 상태, 설치 상태 확인</td>
                                        <td>@lastChk.CHK_1_1</td>
                                    </tr>
                                    <tr>
                                        <td>접지 저항 측정 및 기준값 이내 여부 확인</td>
                                        <td>@lastChk.CHK_2_1</td>
                                    </tr>
                                    <tr>
                                        <td>절연 저항 측정 (전선 및 기기 절연 성능 확인)</td>
                                        <td>@lastChk.CHK_3_1</td>
                                    </tr>
                                    <tr>
                                        <td>절연 내력 시험 (고전압 인가)</td>
                                        <td>@lastChk.CHK_4_1</td>
                                    </tr>
                                    <tr>
                                        <td>보호 계전기 동작 시험 (과전류, 과전압 등)</td>
                                        <td>@lastChk.CHK_5_1</td>
                                    </tr>
                                    <tr>
                                        <td>절연유 내압 및 산가 시험 (유입 변압기)</td>
                                        <td>@lastChk.CHK_6_1</td>
                                    </tr>
                                    <tr>
                                        <td>차단기 개폐 동작 및 차단 성능 확인</td>
                                        <td>@lastChk.CHK_7_1</td>
                                    </tr>
                                    <tr>
                                        <td>발전기 출력 및 성능 운전 시험</td>
                                        <td>@lastChk.CHK_8_1</td>
                                    </tr>
                                    <tr>
                                        <td>전기설비 외관, 작동, 기능 일상 점검</td>
                                        <td>@lastChk.CHK_9_1</td>
                                    </tr>
                                    <tr>
                                        <td>누전 차단기 동작 확인</td>
                                        <td>@lastChk.CHK_10_1</td>
                                    </tr>
                                    <tr>
                                        <td>전원 차단 및 안전 수칙 준수 여부 확인</td>
                                        <td>@lastChk.CHK_11_1</td>
                                    </tr>
                                    <tr>
                                        <td>점검 결과 기록 및 보관</td>
                                        <td>@lastChk.CHK_12_1</td>
                                    </tr>                                    
                                </tbody>
                            </table>
                        </div>
                    </li>
                </ul>
            }
            else
            {
                <p>보통점검 데이터가 없습니다.</p>
            }
        </div>
    </div>
}