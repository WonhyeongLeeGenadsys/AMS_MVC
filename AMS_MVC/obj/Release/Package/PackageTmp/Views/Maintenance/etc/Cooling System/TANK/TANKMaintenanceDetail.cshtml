@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var tankCode = Request.QueryString["tankCode"] ?? "";
    var tblIdx = Request.QueryString["tblIdx"] ?? "";
}

@section LeftMenu {
    @Html.Partial("_MaintenanceMenu")
}

@section MainContent {
    <h1>TANK 유지보수 상세정보</h1>
    <div class="con_box">
        <div class="content_warp">

            <div class="btn_area top right">
                <p>
                    <a href="javascript:void(0);" class="btn red del" onclick="deleteMaintenance('@tankCode', '@tblIdx');">삭제</a>
                    <a href="@Url.Action("TANKMaintenanceUpdate", "TANKMaintenance", new { tankCode = tankCode, tblIdx = tblIdx })" class="btn blue edit">수정</a>
                </p>
            </div>

            <div class="table_app" id="tankMaintenance">
                <table>
                    <colgroup>
                        <col style="width:100px;" />
                        <col style="width:calc(33.3% - 100px);" />
                        <col style="width:100px;" />
                        <col style="width:calc(33.3% - 100px);" />
                        <col style="width:100px;" />
                        <col style="width:calc(33.3% - 100px);" />
                    </colgroup>
                    <tr>
                        <th>보수명</th>
                        <td colspan="5">
                            @Model.MR_Bosu_Name
                        </td>
                    </tr>
                    <tr>
                        <th>날씨</th>
                        <td>
                            @Model.MR_Weather
                        </td>
                        <th>기온</th>
                        <td>
                            @Model.MR_Temp
                        </td>
                        <th>습도</th>
                        <td>
                            @Model.MR_Hum
                        </td>
                    </tr>
                    <tr>
                        <th>내용</th>
                        <td colspan="5">
                            @Model.MR_Content
                        </td>
                    </tr>
                    <tr>
                        <th>상태</th>
                        <td>
                            @Model.MR_Status
                        </td>
                        <th>부품</th>
                        <td>
                            @Model.MR_Part
                        </td>
                        @*<th>업체명</th>
                            <td>
                                @Html.DropDownList("_company", new SelectList(ViewBag.Companies, "Com_Name", "Com_Name"), "제작사를 선택하세요.")
                            </td>*@
                    </tr>
                    <tr>
                        <th>보수자</th>
                        <td>
                            @Model.MR_Worker
                        </td>
                        <th>감독자</th>
                        <td>
                            @Model.MR_Manager
                        </td>
                        <th>보수일</th>
                        <td>
                            @Model.MR_Date
                        </td>
                    </tr>
                </table>
            </div>
            <!--//입력테이블-->
        </div>
    </div>

    <script type="text/javascript">
        function deleteMaintenance(tankCode, tblIdx) {
            if (confirm("정말 삭제하시겠습니까?")) {
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("TANKMaintenanceDelete", "TANKMaintenance")',
                    data: JSON.stringify({ tankCode: tankCode, tblIdx: tblIdx }),
                    contentType: "application/json; charset=utf-8",
                    success: function (response) {
                        if (response.success) {
                            alert("TANK 유지보수 정보가 삭제되었습니다.");
                            window.location.href = '@Url.Action("TANKMaintenanceTotalList", "TANKMaintenance")';
                        } else {
                            alert("TANK 유지보수 정보 삭제 실패: " + response.message);
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error("삭제 중 오류:", xhr.responseText || status, error);
                        alert("삭제 중 오류가 발생했습니다: " + xhr.responseText);
                    }
                });
            }
        }
    </script>
}